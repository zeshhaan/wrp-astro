---
import { getLocale, getDateLocale } from '../i18n/utils';

interface Props {
	date: Date;
	locale?: string;
	showHijri?: boolean;
	monthFormat?: 'short' | 'long';
}

const { date } = Astro.props;
const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const dateLocale = getDateLocale(locale);
const monthFormat = Astro.props.monthFormat ?? 'short';

// Frontmatter carries calendar dates (`2026-08-06`), which Astro coerces to UTC
// midnight. Emitting `...T00:00:00.000Z` would assert a publication *time* the
// content never claimed, and midnight is exactly the value that lands on the
// previous day once a crawler shifts it into a negative-offset timezone. Google
// treats the date alone as sufficient, so emit date-only: it stays byte-for-byte
// consistent with the visible date no matter who reads it.
const isoDate = date.toISOString().slice(0, 10);

const gregorianDate = date.toLocaleDateString(dateLocale, {
	year: 'numeric',
	month: monthFormat,
	day: 'numeric',
});

let hijriDate: string | null = null;

if (locale === 'ar' && Astro.props.showHijri) {
	try {
		hijriDate = date.toLocaleDateString('ar-SA-u-ca-islamic-umalqura', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		});
	} catch {
		hijriDate = null;
	}
}
---

<time datetime={isoDate}>
	{gregorianDate}
	{hijriDate && <><span aria-hidden="true"> / </span><span>{hijriDate}</span></>}
</time>
