---
/**
 * Tally "Get a Quote" popup.
 *
 * Deliberately NOT rendered on the contact pages: someone already looking at a
 * contact form does not need a popup asking them to fill in a contact form.
 * BaseLayout passes `enabled={false}` there.
 *
 * Everything below is Tally's own configuration rather than custom behaviour,
 * which is the point: the widget already handles triggering and frequency.
 *
 *   - `trigger: 'scroll'` fires on engagement rather than on a clock, so the
 *     popup arrives once someone has chosen to keep reading. Exit intent
 *     converts better on desktop but Tally cannot do it on mobile, and this
 *     audience is mostly on a phone.
 *   - `showOnce` is what stops a visitor who closed the popup being asked again
 *     on the next page, and the next. Without it the widget only remembers
 *     submissions, not dismissals.
 *
 * The `source_url` hidden field is what lets you see which pages actually
 * generate enquiries. It is read at runtime rather than rendered server-side so
 * it stays correct for prerendered pages served from cache.
 */
interface Props {
  /** Set false to suppress the popup on a given page. */
  enabled?: boolean;
  /** How far down the page a visitor must scroll before it opens. */
  scrollPercent?: number;
}

const { enabled = true, scrollPercent = 50 } = Astro.props;

const FORM_ID = 'Gxa89p';
---

{
  enabled && (
    <script is:inline define:vars={{ FORM_ID, scrollPercent }}>
      // Evaluated once, at load: Tally reads TallyConfig when embed.js
      // initialises and never re-reads it, so a resize past the breakpoint
      // will not change the behaviour for that page view. Matches Tailwind's
      // `md`, so "phone" here means the same thing it means in the markup.
      const isPhone = window.matchMedia('(max-width: 767px)').matches;

      // Tally reads this global when embed.js initialises, so it has to be set
      // before the script loads.
      window.TallyConfig = {
        formId: FORM_ID,
        popup: {
          width: 420,
          // The backdrop is the whole difference between a modal and a card
          // parked on top of the page. Desktop keeps it off: the popup sits in
          // the margin beside the content, so it can afford to be an offer
          // rather than an interruption. A phone has no margin. The popup
          // already covers about 60% of the screen, and undimmed it reads as
          // page furniture, so there it becomes a real modal.
          overlay: isPhone,
          emoji: { text: '👋', animation: 'wave' },
          open: { trigger: 'scroll', scrollPercent: scrollPercent },
          // The form title carries its own generous spacing, which costs about
          // 100px before the first question in a 420px-wide popup. Hidden here
          // so the popup opens on "What can we do for your car?", while the
          // standalone form page keeps its title for the link and browser tab.
          hideTitle: true,
          // Long enough to read the thank-you note, which carries the phone
          // number for anyone who does not want to wait for a reply.
          autoClose: 8000,
          showOnce: true,
          doNotShowAfterSubmit: true,
          hiddenFields: {
            source_url: window.location.pathname + window.location.search,
          },
        },
      };

      // Tally's backdrop blocks taps but not scrolling. It sets
      // `overflow: hidden` on <body>, and the scrolling element on this page is
      // <html>, so the page keeps moving behind the dim. That is the one thing
      // left between "dimmed popup" and "modal", so lock it here.
      //
      // The backdrop is watched rather than hooked into an open/close callback
      // because Tally exposes no event for a popup it opened itself on scroll.
      // Presence of `.tally-overlay` in the DOM is the only honest signal, and
      // it covers every way the popup can close: the X, the backdrop, autoClose
      // after a submit.
      if (isPhone) {
        let scrollLockedAt = 0;

        const setLocked = (locked) => {
          const root = document.documentElement;
          if (locked === root.classList.contains('tally-modal-open')) return;

          if (locked) {
            scrollLockedAt = window.scrollY;
            root.classList.add('tally-modal-open');
          } else {
            root.classList.remove('tally-modal-open');
            // Chrome keeps scrollTop across an overflow toggle, but Safari has
            // historically dropped it. Restoring is a no-op when it did not.
            window.scrollTo(0, scrollLockedAt);
          }
        };

        new MutationObserver(() => {
          setLocked(!!document.querySelector('.tally-overlay'));
        }).observe(document.body, { childList: true, subtree: true });
      }
    </script>

    <style is:global>
      /* Applied to both elements because which one scrolls depends on the
         browser, and locking only the one that does not is how you ship a
         modal that still scrolls. `overscroll-behavior` stops the gesture
         chaining up to the page once the form itself hits its end. */
      html.tally-modal-open,
      html.tally-modal-open body {
        overflow: hidden;
        overscroll-behavior: none;
      }
    </style>

    <script is:inline async src="https://tally.so/widgets/embed.js" />
  )
}
