---
/**
 * Tally "Get a Quote" popup.
 *
 * Deliberately NOT rendered on the contact pages: someone already looking at a
 * contact form does not need a popup asking them to fill in a contact form.
 * BaseLayout passes `enabled={false}` there.
 *
 * The small scroll controller calls Tally.openPopup() at the moment the form is
 * needed. This matters with Astro client navigation: it lets hidden fields read
 * the current page and attribution at open time instead of freezing the values
 * from the first page in the visit.
 *   - `showOnce` is what stops a visitor who closed the popup being asked again
 *     on the next page, and the next. Without it the widget only remembers
 *     submissions, not dismissals.
 *
 * Tally supplies its conventional `originPage` hidden field automatically. We
 * only pass the site's versioned `attribution` record as a custom hidden field.
 */
import { TALLY_FORM_ID } from '../consts';

interface Props {
  /** Set false to suppress the popup on a given page. */
  enabled?: boolean;
  /** How far down the page a visitor must scroll before it opens. */
  scrollPercent?: number;
}

const { enabled = true, scrollPercent = 50 } = Astro.props;

---

{
  enabled && (
    <script is:inline define:vars={{ FORM_ID: TALLY_FORM_ID, scrollPercent }}>
      if (!window.__wrpTallyPopup) {
        let removeScrollListener = () => {};

        const ensureTally = () => new Promise((resolve, reject) => {
          if (window.Tally) return resolve(window.Tally);
          const existing = document.querySelector('script[src="https://tally.so/widgets/embed.js"]');
          const script = existing || Object.assign(document.createElement('script'), {
            src: 'https://tally.so/widgets/embed.js',
            async: true,
          });
          script.addEventListener('load', () => resolve(window.Tally), { once: true });
          script.addEventListener('error', reject, { once: true });
          if (!existing) document.head.appendChild(script);
        });

        // A page form on screen, such as the homepage form at the foot of the
        // page. Dialog forms are only close buttons.
        const leadFormInView = () => [...document.querySelectorAll('form:not([method="dialog"])')].some((form) => {
          const rect = form.getBoundingClientRect();
          return rect.height > 0 && rect.bottom > 0 && rect.top < window.innerHeight;
        });

        const openPopup = async (shouldOpen) => {
          try {
            const tally = await ensureTally();
            if (!shouldOpen()) return false;
            const isPhone = window.matchMedia('(max-width: 767px)').matches;
            tally.openPopup(FORM_ID, {
              key: 'wrp-quote-popup',
              width: 420,
              overlay: isPhone,
              emoji: { text: '👋', animation: 'wave' },
              hideTitle: true,
              autoClose: 8000,
              showOnce: true,
              doNotShowAfterSubmit: true,
              hiddenFields: {
                attribution: window.WRPAttribution?.serialize() || '',
              },
            });
            return true;
          } catch {
            // The quote links elsewhere on the page remain available when the
            // third-party widget cannot load.
            return false;
          }
        };

        // The popup opens halfway down, so on desktop, where it has no
        // backdrop, it is still in the corner when the visitor reaches a page
        // form further down, and covers that form's button. Close it then,
        // unless they have clicked into the popup to fill it in.
        const watchOpenPopup = () => {
          let usingPopup = false;
          const onBlur = () => setTimeout(() => {
            const active = document.activeElement;
            if (active instanceof HTMLIFrameElement && active.closest(`.tally-form-${FORM_ID}`)) usingPopup = true;
          });
          const onScroll = () => {
            if (usingPopup || !leadFormInView()) return;
            window.Tally?.closePopup(FORM_ID);
            stop();
          };
          const stop = () => {
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('blur', onBlur);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('blur', onBlur);
          removeScrollListener = stop;
        };

        const armForPage = () => {
          removeScrollListener();
          removeScrollListener = () => {};
          if (window.location.pathname.includes('/contact-us')) return;

          let armed = true;
          // Once a visitor starts using a page form, do not interrupt that
          // enquiry with a competing popup, even if they later blur a field.
          let formEngaged = document.activeElement instanceof Element && !!document.activeElement.closest('form');
          let activePage = true;
          const onFormInteraction = (event) => {
            if (event.target instanceof Element && event.target.closest('form')) formEngaged = true;
          };
          document.addEventListener('focusin', onFormInteraction);
          document.addEventListener('input', onFormInteraction);
          document.addEventListener('change', onFormInteraction);
          const onScroll = () => {
            const scrollable = document.documentElement.scrollHeight - window.innerHeight;
            if (!armed || formEngaged || scrollable <= 0 || (window.scrollY / scrollable) * 100 < scrollPercent) return;
            // Nor open over a page form the visitor is looking at. The popup
            // stays armed until they scroll away from it.
            if (leadFormInView()) return;
            armed = false;
            window.removeEventListener('scroll', onScroll);
            void openPopup(() => activePage && !formEngaged && !leadFormInView() && !window.location.pathname.includes('/contact-us')).then((opened) => {
              const stillHere = activePage;
              cleanup();
              if (opened && stillHere) watchOpenPopup();
            });
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          const cleanup = () => {
            activePage = false;
            window.removeEventListener('scroll', onScroll);
            document.removeEventListener('focusin', onFormInteraction);
            document.removeEventListener('input', onFormInteraction);
            document.removeEventListener('change', onFormInteraction);
          };
          removeScrollListener = cleanup;
          onScroll();
        };

        window.__wrpTallyPopup = { armForPage };
        document.addEventListener('astro:page-load', armForPage);
        void ensureTally().catch(() => {});
        armForPage();

      // Tally's backdrop blocks taps but not scrolling. It sets
      // `overflow: hidden` on <body>, and the scrolling element on this page is
      // <html>, so the page keeps moving behind the dim. That is the one thing
      // left between "dimmed popup" and "modal", so lock it here.
      //
      // The backdrop is watched rather than hooked into an open/close callback
      // because Tally exposes no event for a popup it opened itself on scroll.
      // Presence of `.tally-overlay` in the DOM is the only honest signal, and
      // it covers every way the popup can close: the X, the backdrop, autoClose
      // after a submit.
        let scrollLockedAt = 0;

        const setLocked = (locked) => {
          const root = document.documentElement;
          if (locked === root.classList.contains('tally-modal-open')) return;

          if (locked) {
            scrollLockedAt = window.scrollY;
            root.classList.add('tally-modal-open');
          } else {
            root.classList.remove('tally-modal-open');
            // Chrome keeps scrollTop across an overflow toggle, but Safari has
            // historically dropped it. Restoring is a no-op when it did not.
            window.scrollTo(0, scrollLockedAt);
          }
        };

        new MutationObserver(() => {
          setLocked(!!document.querySelector('.tally-overlay'));
        }).observe(document.body, { childList: true, subtree: true });
      }
    </script>

    <style is:global>
      /* Applied to both elements because which one scrolls depends on the
         browser, and locking only the one that does not is how you ship a
         modal that still scrolls. `overscroll-behavior` stops the gesture
         chaining up to the page once the form itself hits its end. */
      html.tally-modal-open,
      html.tally-modal-open body {
        overflow: hidden;
        overscroll-behavior: none;
      }
    </style>
  )
}
