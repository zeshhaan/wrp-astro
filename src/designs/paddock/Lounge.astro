---
/**
 * The WRP Lounge, framed as the paddock club: your car is in the pit below,
 * you're upstairs behind the glass. The two-lane timeline is a real sequence,
 * so it earns its step markers; the checkered finish is the page's one use
 * of the banner motif from the studio.
 */
import Picture from '../shared/Picture.astro';
import { lounge, services } from '../data';

const [billiards, mezzanine, materials, pendants] = lounge.photos;
const [garage, billiardsQuote, , home, waiting] = lounge.quotes;

const time = (slug: string) => services.find((s) => s.slug === slug)?.time ?? '';

const laps = [
  {
    you: 'Coffee or karak, made fresh while the keys change hands.',
    car: 'Check-in. A walk round the car with you, and what you want done.',
  },
  {
    you: 'The materials room. Touch the film, leather and mat samples before you choose.',
    car: 'Inspection. Paint depth measured, chips and swirls marked.',
  },
  {
    you: 'A frame on the full-size billiards table.',
    car: 'Prep. Washed and decontaminated so film, coating or tint bonds properly.',
  },
  {
    you: 'Board games, or the match on the big screen from the sofa.',
    car: 'The work itself: film, coating, tint or correction, then time to cure.',
  },
  {
    you: 'Look down through the glass wall and watch the last pass.',
    car: 'Quality check under the studio lights.',
  },
  {
    you: 'Come downstairs.',
    car: 'Handover. Keys back, and a run through the aftercare.',
  },
];
---

<section class="lounge" id="lounge" aria-labelledby="lounge-title">
  <div class="wrap">
    <div class="opening">
      <div class="copy">
        <h2 id="lounge-title">The WRP Lounge</h2>
        <p class="kicker">Every paddock has a club. Ours is one floor up.</p>
        <p class="pitch">{lounge.pitch}</p>
        <ul class="amenities" role="list">
          {
            lounge.amenities.map((a) => (
              <li>
                <strong>{a.name}</strong>
                <span>{a.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="lead-photo">
        <Picture
          base={billiards.base}
          alt={billiards.alt}
          sizes="(min-width: 60rem) 55vw, 100vw"
          class="pic"
        />
        <figcaption>{billiards.caption}</figcaption>
      </figure>
    </div>

    <figure class="big-quote">
      <blockquote><p>“{garage.text}”</p></blockquote>
      <figcaption>{garage.author}, Google review</figcaption>
    </figure>

    <div class="visit-plan">
      <div class="plan-head">
        <h3>How a visit runs</h3>
        <p>
          A wash takes {time('premium-car-wash')} and tint {time('window-film')}, so most people stay upstairs
          the whole time. PPF ({time('paint-protection-film')}) and ceramic ({time('ceramic-coating')}) take
          longer: stay for the start, and we call you for the handover.
        </p>
      </div>

      <div class="track">
        <p class="lane-label lane-you" aria-hidden="true">You, upstairs</p>
        <p class="lane-label lane-car" aria-hidden="true">Your car, downstairs</p>
        <ol class="laps" role="list">
          {
            laps.map((lap, i) => (
              <li class:list={['lap', { finish: i === laps.length - 1 }]}>
                <p class="you">
                  <span class="tag">You</span>
                  {lap.you}
                </p>
                <span class="rail" aria-hidden="true">
                  <span class="marker">{i + 1}</span>
                </span>
                <p class="car">
                  <span class="tag">Your car</span>
                  {lap.car}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <ul class="gallery" role="list">
      <li class="g-mezz">
        <figure>
          <Picture base={mezzanine.base} alt={mezzanine.alt} sizes="(min-width: 60rem) 40vw, 100vw" class="pic" />
          <figcaption>{mezzanine.caption}</figcaption>
        </figure>
      </li>
      <li class="g-quote">
        <figure>
          <blockquote><p>“{billiardsQuote.text}”</p></blockquote>
          <figcaption>{billiardsQuote.author}</figcaption>
        </figure>
      </li>
      <li class="g-materials">
        <figure>
          <Picture base={materials.base} alt={materials.alt} sizes="(min-width: 60rem) 30vw, 100vw" class="pic" />
          <figcaption>{materials.caption}</figcaption>
        </figure>
      </li>
      <li class="g-pendants">
        <figure>
          <Picture base={pendants.base} alt={pendants.alt} sizes="(min-width: 60rem) 30vw, 100vw" class="pic" />
          <figcaption>{pendants.caption}</figcaption>
        </figure>
      </li>
      <li class="g-quote g-quote-2">
        <figure>
          <blockquote><p>“{home.text}”</p></blockquote>
          <figcaption>{home.author}</figcaption>
        </figure>
        <figure class="small">
          <blockquote><p>“{waiting.text}”</p></blockquote>
          <figcaption>{waiting.author}</figcaption>
        </figure>
      </li>
    </ul>
  </div>
</section>

<style>
  .lounge {
    background: var(--pd-concrete);
    color: var(--pd-tyre);
    padding-block: var(--section);
  }
  .wrap {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
  }
  h2 {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: clamp(3rem, 1.6rem + 5.4vw, 6.75rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
  }
  h3 {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: var(--fs-h3);
    line-height: 1;
  }
  .kicker {
    margin-block: 0.9rem 1.25rem;
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 600;
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.1;
    max-width: 24ch;
  }
  .pitch {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 52ch;
  }

  /* Opening: copy + lead photo */
  .opening {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 60rem) {
    .opening {
      grid-template-columns: 5fr 7fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }
  }
  .amenities {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0.9rem 1.5rem;
  }
  .amenities li {
    display: grid;
    gap: 0.1rem;
    padding-block-start: 0.6rem;
    border-block-start: 3px solid var(--pd-tyre);
  }
  .amenities strong {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .amenities span {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--pd-ink-2);
  }

  figure { margin: 0; }
  .pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--pd-ink-2);
  }
  .lead-photo :global(img) { aspect-ratio: 4 / 3; }

  /* Pull quote */
  .big-quote {
    margin-block: clamp(3rem, 7vw, 6rem);
    max-width: 62rem;
  }
  .big-quote blockquote {
    margin: 0;
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2rem, 1.2rem + 3.2vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .big-quote figcaption {
    margin-block-start: 1rem;
    font-size: 1rem;
    color: var(--pd-ink-2);
  }

  /* Two-lane timeline */
  .visit-plan {
    background: var(--pd-white);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    padding-inline-end: clamp(1.25rem, 3vw, 2.5rem);
  }
  .plan-head {
    display: grid;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }
  .plan-head p {
    max-width: 62ch;
    line-height: 1.5;
    color: var(--pd-ink-2);
  }
  @media (min-width: 60rem) {
    .plan-head {
      grid-template-columns: 4fr 8fr;
      align-items: end;
      gap: 2rem;
    }
  }

  .track { position: relative; }
  .lane-label { display: none; }
  .laps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .tag {
    display: block;
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--pd-grey);
    margin-block-end: 0.1rem;
  }
  .you, .car {
    font-size: 1rem;
    line-height: 1.4;
  }
  .marker {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--pd-tyre);
    color: var(--pd-white);
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1;
    position: relative;
    z-index: 1;
  }
  .finish .marker {
    color: transparent;
    background: repeating-conic-gradient(var(--pd-tyre) 0 25%, var(--pd-white) 0 50%) 0 0 / 0.625rem 0.625rem;
    outline: 2px solid var(--pd-tyre);
  }

  /* Phone: vertical track, marker on the left, you above your car. */
  @media (max-width: 59.99rem) {
    .laps::before {
      content: '';
      position: absolute;
      inset-block: 0.5rem 1.5rem;
      inset-inline-start: calc(1.25rem - 1.5px);
      width: 3px;
      background: var(--pd-tyre);
    }
    .lap {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas: 'm you' 'm car';
      column-gap: 1rem;
      row-gap: 0.6rem;
      padding-block-end: 1.75rem;
    }
    .rail { grid-area: m; }
    .you { grid-area: you; }
    .car {
      grid-area: car;
      padding-block-start: 0.6rem;
      border-block-start: 1px dashed color-mix(in srgb, var(--pd-tyre) 35%, transparent);
    }
    .finish { padding-block-end: 0; }
  }

  /* Wide: two lanes. You on the upper floor, the car below; the line between is the glass. */
  @media (min-width: 60rem) {
    .track {
      display: grid;
      grid-template-columns: 7.5rem 1fr;
      grid-template-rows: auto auto auto;
      column-gap: 1.5rem;
    }
    .lane-label {
      display: block;
      font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
      font-weight: 700;
      font-style: italic;
      font-size: 1.25rem;
      line-height: 1.05;
      grid-column: 1;
      align-self: start;
    }
    .lane-you { grid-row: 1; }
    .lane-car { grid-row: 3; }
    .laps {
      grid-column: 2;
      grid-row: 1 / 4;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: subgrid;
      column-gap: 1.25rem;
      position: relative;
    }
    /* The glass line: each rail runs from its marker to the next one. */
    .rail {
      display: flex;
      align-items: center;
    }
    .lap:not(.finish) .rail::after {
      content: '';
      flex: 1;
      height: 3px;
      margin-inline-end: -1.25rem;
      background: var(--pd-tyre);
    }
    .lap {
      grid-row: 1 / 4;
      display: grid;
      grid-template-rows: subgrid;
      row-gap: 1.1rem;
    }
    .you { grid-row: 1; align-self: end; }
    .rail { grid-row: 2; }
    .car { grid-row: 3; }
    .tag { display: none; }
    .lane-you { align-self: end; }
  }

  /* Gallery */
  .gallery {
    list-style: none;
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .g-quote blockquote {
    margin: 0;
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 600;
    font-style: italic;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .g-quote .small { margin-block-start: 1.5rem; }
  .g-quote .small blockquote { font-size: 1.35rem; }
  .gallery .pic :global(img) { aspect-ratio: 4 / 3; }

  @media (min-width: 40rem) {
    .gallery { grid-template-columns: 1fr 1fr; }
    .g-mezz { grid-column: 1 / -1; }
  }
  @media (min-width: 60rem) {
    .gallery {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
      align-items: start;
    }
    .g-mezz { grid-column: 1 / 8; }
    .g-quote { grid-column: 9 / 13; align-self: center; }
    .g-materials { grid-column: 1 / 5; }
    .g-pendants { grid-column: 5 / 9; }
    .g-quote-2 { grid-column: 9 / 13; align-self: center; }
  }
</style>
