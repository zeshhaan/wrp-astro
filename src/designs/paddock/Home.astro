---
/**
 * Paddock: WRP as a motorsport paddock. Your car goes into the pit; you go
 * to the paddock club (the WRP Lounge) upstairs. The bold moment is the PPF
 * coverage builder; everything else stays disciplined.
 */
import DesignShell from '../shared/DesignShell.astro';
import Picture from '../shared/Picture.astro';
import Btn from './Btn.astro';
import OpenStatus from './OpenStatus.astro';
import CoverageBuilder from './CoverageBuilder.astro';
import Lounge from './Lounge.astro';
import { contact, whatsappLink, services, work, proof, pickQuotes, nav, pages, studio } from '../data';

const hero = studio.bays;
const heroSizes = '(min-width: 60rem) 64vw, 100vw';
const waQuote = whatsappLink('Hi WRP, I’d like a quote. My car is a ');

// Three short quotes from different customers and services.
const wanted = ['Tariq Murad', 'Michael Maninantan', 'Abdul Ansaf'];
const pool = pickQuotes(10);
const quotes = [
  ...wanted.map((name) => pool.find((q) => q.author === name)).filter((q) => q !== undefined),
  ...pool,
]
  .filter((q, i, all) => all.indexOf(q) === i)
  .slice(0, 3);
const serviceName = (slug?: string) => services.find((s) => s.slug === slug)?.short;

const aed = (n: number) => `AED ${n.toLocaleString('en-US')}`;
const year = new Date().getFullYear();
---

<DesignShell
  concept="paddock"
  title="WRP Detailing, Dubai: PPF, ceramic, tint and a lounge to wait in"
  description="Paint protection film, ceramic coating, window film and detailing in Al Qusais, Dubai. Build your PPF coverage, then wait in the WRP Lounge above the bays."
  fonts={['--font-barlow-condensed', '--font-barlow', '--font-montserrat']}
  themeColor="#F4F4F2"
  preloadImage={{ base: hero.base, sizes: heroSizes }}
>
  <a class="skip" href="#content">Skip to content</a>

  <header class="top">
    <div class="top-in">
      <a class="wordmark" href="/" aria-label="WRP home">WRP.</a>
      <nav class="nav" aria-label="Main">
        <ul role="list">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <Btn href={waQuote} size="sm" class="top-cta">WhatsApp us</Btn>
    </div>
  </header>

  <main id="content" tabindex="-1">
    <!-- Hero: the headline is split across the two floors of the building. -->
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">
        <span class="l1">You go upstairs.</span>
        <span class="l2">Your car goes in the pit.</span>
      </h1>
      <figure class="hero-photo">
        <div class="frame">
          <Picture
            base={hero.base}
            alt="Inside WRP: supercars in the bays downstairs, and the glass-walled lounge with its billiards table upstairs"
            sizes={heroSizes}
            loading="eager"
            fetchpriority="high"
            class="pic"
          />
          <span class="tag tag-up" aria-hidden="true">Upstairs: the WRP Lounge</span>
          <span class="tag tag-down" aria-hidden="true">Downstairs: the bays</span>
        </div>
      </figure>
      <div class="hero-side">
        <p class="lede">
          Paint protection film, ceramic coating, window tint and detailing in Al Qusais, Dubai. While we work,
          you wait in the lounge above the bays: billiards, coffee, a big screen and a glass wall onto your car.
        </p>
        <div class="hero-ctas">
          <Btn href={waQuote}>Message us on WhatsApp</Btn>
          <Btn href="#coverage" variant="line">Build your PPF coverage</Btn>
        </div>
        <OpenStatus class="hero-status" />
      </div>
    </section>

    <!-- Pit board: honest numbers only. -->
    <section class="pitboard-wrap" aria-label="WRP at a glance">
      <dl class="pitboard">
        <div class="slot">
          <dt>Google rating</dt>
          <dd><span class="num">{proof.rating}</span></dd>
        </div>
        <div class="slot">
          <dt>Google reviews</dt>
          <dd><span class="num">{proof.reviewCount}</span></dd>
        </div>
        <div class="slot">
          <dt>Longest PPF warranty we offer</dt>
          <dd><span class="num">10</span><span class="unit">-year</span></dd>
        </div>
        <div class="slot slot-films">
          <dt>Our films</dt>
          <dd><span class="num num-words">Avery Dennison <span class="amp">&amp;</span> STEK</span></dd>
        </div>
      </dl>
    </section>

    <!-- Services: a starting grid, staggered like the real thing. -->
    <section class="services" id="services" aria-labelledby="services-title">
      <div class="wrap">
        <header class="sec-head">
          <h2 id="services-title">What happens in the bays</h2>
          <p>Six services, all done by hand in our Al Qusais studio. Prices are where each one starts.</p>
        </header>
        <ul class="grid" role="list">
          {
            services.map((s) => (
              <li class="slot-box">
                <h3>
                  <a href={s.href}>{s.name}</a>
                </h3>
                <p class="line">{s.line}</p>
                <dl class="spec">
                  <div>
                    <dt>Price</dt>
                    <dd>{s.from ? <>From <strong>{aed(s.from)}</strong></> : <strong>Priced after inspection</strong>}</dd>
                  </div>
                  <div>
                    <dt>Time with us</dt>
                    <dd>{s.time}</dd>
                  </div>
                </dl>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <CoverageBuilder />

    <Lounge />

    <!-- Work -->
    <section class="work" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <header class="sec-head sec-head-row">
          <h2 id="work-title">Fresh out of the bays</h2>
          <a class="text-link" href={pages.portfolio}>See the full portfolio</a>
        </header>
        <ul class="work-grid" role="list">
          {
            work.map((w) => (
              <li>
                <figure>
                  <Picture
                    base={w.image}
                    alt={`${w.title} at WRP after ${w.what.toLowerCase()}`}
                    sizes="(min-width: 60rem) 30vw, 50vw"
                    width={1200}
                    height={1600}
                    class="pic"
                  />
                  <figcaption>
                    <strong>{w.title}</strong>
                    <span>{w.what}</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Reviews -->
    <section class="reviews" id="reviews" aria-labelledby="reviews-title">
      <div class="wrap reviews-in">
        <div class="score">
          <h2 id="reviews-title">
            <span class="score-num">{proof.rating}</span>
            <span class="score-line">on Google, from {proof.reviewCount} reviews</span>
          </h2>
          <a class="text-link" href={proof.reviewsUrl}>Read the reviews</a>
        </div>
        <ul class="quotes" role="list">
          {
            quotes.map((q) => (
              <li>
                <figure>
                  <blockquote>
                    <p>“{q.text}”</p>
                  </blockquote>
                  <figcaption>
                    {q.author}
                    {serviceName(q.service) && <span class="svc">{serviceName(q.service)}</span>}
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Visit -->
    <section class="visit" id="visit" aria-labelledby="visit-title">
      <div class="wrap visit-in">
        <div class="visit-copy">
          <h2 id="visit-title">Find the lit sign in Al Qusais</h2>
          <address>
            <span class="addr">{contact.address[0]}</span>
            <span>{contact.address[1]}</span>
          </address>
          <OpenStatus class="visit-status" />
          <table class="hours">
            <caption class="visually-hidden">Opening hours</caption>
            <tbody>
              <tr data-today-row="open">
                <th scope="row">Saturday to Thursday</th>
                <td>9 AM to 9:30 PM</td>
              </tr>
              <tr data-today-row="closed">
                <th scope="row">Friday</th>
                <td>Closed</td>
              </tr>
            </tbody>
          </table>
          <div class="visit-ctas">
            <Btn href={waQuote}>Message us on WhatsApp</Btn>
            <Btn href={contact.mapsUrl} variant="line" target="_blank" rel="noopener">Open in Google Maps</Btn>
          </div>
          <ul class="contact-list" role="list">
            <li><span>Call</span> <a href={contact.phoneHref}>{contact.phoneDisplay}</a></li>
            <li><span>Email</span> <a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><span>Instagram</span> <a href={contact.instagram}>{contact.instagramHandle}</a></li>
          </ul>
        </div>
        <figure class="visit-photo">
          <Picture base={studio.night.base} alt={studio.night.alt} sizes="(min-width: 60rem) 50vw, 100vw" class="pic" />
        </figure>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <p class="foot-mark"><span class="wordmark">WRP.</span> Wrap, reinforce, protect.</p>
      <nav aria-label="Footer">
        <ul role="list" class="foot-links">
          <li><a href={pages.portfolio}>Portfolio</a></li>
          <li><a href={pages.reviews}>Reviews</a></li>
          <li><a href={pages.blog}>Blog</a></li>
          <li><a href={pages.about}>About WRP</a></li>
          <li><a href={pages.contact}>Contact</a></li>
          <li><a href={pages.privacy}>Privacy</a></li>
          <li><a href={pages.terms}>Terms</a></li>
          <li><a href={pages.arabic} lang="ar" hreflang="ar">العربية</a></li>
        </ul>
      </nav>
      <p class="foot-small">© {year} WRP Detailing Solutions, Al Qusais Industrial Area 1, Dubai.</p>
    </div>
  </footer>
</DesignShell>

<style is:global>
  :root {
    --pd-white: #f4f4f2;
    --pd-concrete: #e2e2de;
    --pd-tyre: #161718;
    --pd-signal: #ffd23f;
    --pd-grey: #6b6b6b;
    /* Secondary ink that passes AA on concrete as well as white. */
    --pd-ink-2: #4f4f4f;

    --gutter: clamp(1rem, 4vw, 3rem);
    --maxw: 88rem;
    --section: clamp(4rem, 3rem + 5vw, 8rem);

    --fs-hero: clamp(3.25rem, 1.4rem + 7.4vw, 8rem);
    --fs-h2: clamp(2.5rem, 1.6rem + 3.6vw, 5rem);
    --fs-h3: clamp(1.6rem, 1.3rem + 1vw, 2.25rem);
    --fs-lead: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
  }
  body {
    background: var(--pd-white);
    color: var(--pd-tyre);
    font-family: var(--font-barlow), system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
</style>

<style>
  .wrap {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
  }
  a { color: inherit; }
  a:focus-visible,
  main:focus-visible {
    outline: 3px solid var(--pd-tyre);
    outline-offset: 3px;
  }
  main:focus { outline: none; }

  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    background: var(--pd-signal);
    color: #000;
    padding: 0.75rem 1rem;
    font-weight: 600;
  }
  .skip:focus { top: 1rem; }

  .wordmark {
    font-family: var(--font-montserrat), 'Arial Black', sans-serif;
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  /* Header */
  .top {
    border-block-end: 3px solid var(--pd-tyre);
  }
  .top-in {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'mark . cta' 'nav nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-block-start: 0.6rem;
  }
  .top .wordmark {
    grid-area: mark;
    font-size: 1.9rem;
    line-height: 1;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .top :global(.top-cta) { grid-area: cta; }
  .nav { grid-area: nav; }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.25rem;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: 1.2rem;
    text-decoration: none;
    padding-inline: 0.15rem;
  }
  .nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--pd-signal);
    text-underline-offset: 0.25em;
  }
  @media (min-width: 48rem) {
    .top-in {
      grid-template-areas: 'mark nav cta';
      padding-block: 0.6rem;
      column-gap: 2rem;
    }
    .nav ul { justify-content: center; gap: clamp(1rem, 2.5vw, 2.25rem); }
  }

  /* Hero */
  .hero {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto auto;
    column-gap: 1.5rem;
  }
  h1 {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: var(--fs-hero);
    line-height: 0.86;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .l1, .l2 { display: block; }
  .l1 { padding-block-end: 0.17em; }
  .l2 { padding-block-start: 0.1em; }
  .hero-photo {
    margin: 0 calc(-1 * var(--gutter));
    align-self: end;
  }
  .frame { position: relative; }
  .hero-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 55%;
  }
  .tag {
    position: absolute;
    background: var(--pd-signal);
    color: #000;
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.2rem);
    line-height: 1;
    padding: 0.35em 0.6em 0.4em;
  }
  .tag-up { top: 0.75rem; right: var(--gutter); }
  .tag-down { bottom: 0.75rem; left: var(--gutter); }

  /* With subgrid, the h1's two lines sit either side of the photo: upstairs above, the pit below. */
  @supports (grid-template-rows: subgrid) {
    h1 {
      grid-row: 1 / 4;
      grid-column: 1 / -1;
      display: grid;
      grid-template-rows: subgrid;
      grid-template-columns: subgrid;
    }
    .l1 { grid-row: 1; }
    .l2 { grid-row: 3; }
    .hero-photo { grid-row: 2; grid-column: 1 / -1; }
    .hero-side { grid-row: 4; }
  }
  .hero-side {
    display: grid;
    gap: 1.25rem;
    padding-block-start: 1.25rem;
  }
  .lede {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 50ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto auto;
    }
    .hero-photo {
      margin: 0;
    }
    .hero-photo :global(img) { aspect-ratio: 16 / 10; object-position: 50% 45%; }
    .tag-up { right: 1rem; top: 1rem; }
    .tag-down { left: 1rem; bottom: 1rem; }
    @supports (grid-template-rows: subgrid) {
      .hero-photo { grid-column: 1 / 8; }
      .l1, .l2 { grid-column: 1 / -1; }
      .hero-side {
        grid-row: 2;
        grid-column: 8 / 13;
        align-self: end;
        padding-block-start: 0;
      }
    }
  }

  @media (min-width: 80rem) {
    @supports (grid-template-rows: subgrid) {
      .hero-photo { grid-column: 1 / 9; }
      .hero-side { grid-column: 9 / 13; }
    }
    .hero-photo :global(img) { aspect-ratio: 2 / 1; object-position: 50% 42%; }
  }

  /* Pit board */
  .pitboard-wrap {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
  }
  .pitboard {
    margin: 0;
    background: var(--pd-tyre);
    color: var(--pd-white);
    padding: 0.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .slot {
    background: #000;
    padding: 0.9rem 1rem 1rem;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
  }
  .slot dt {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--pd-signal);
  }
  .slot dd { margin: 0; }
  .num {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .unit {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: 1.4rem;
  }
  .num-words {
    display: block;
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    line-height: 0.95;
  }
  .amp { font-weight: 500; }
  @media (min-width: 48rem) {
    .pitboard { grid-template-columns: 1fr 1fr 1fr 1.6fr; }
    .slot { padding: 1.1rem 1.4rem 1.2rem; }
  }

  /* Section heads */
  .sec-head {
    display: grid;
    gap: 0.9rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
    max-width: 48rem;
  }
  .sec-head p {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--pd-ink-2);
    max-width: 55ch;
  }
  .sec-head-row {
    max-width: none;
    grid-template-columns: 1fr auto;
    align-items: end;
  }
  h2 {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: var(--fs-h2);
    line-height: 0.92;
    letter-spacing: -0.01em;
  }
  .text-link {
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .text-link:hover { text-decoration-color: var(--pd-signal); text-decoration-thickness: 3px; }

  /* Services: starting grid */
  .services { padding-block: var(--section); }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.75rem;
  }
  .slot-box {
    position: relative;
    padding: 1.1rem 1.25rem 0;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    border-block-start: 4px solid var(--pd-tyre);
  }
  /* The painted grid-box bracket: a front line with short side legs. */
  .slot-box::before,
  .slot-box::after {
    content: '';
    position: absolute;
    top: -4px;
    width: 4px;
    height: 2.75rem;
    background: var(--pd-tyre);
  }
  .slot-box::before { left: 0; }
  .slot-box::after { right: 0; }
  .slot-box h3 {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: var(--fs-h3);
    line-height: 0.98;
  }
  .slot-box h3 a {
    text-decoration: none;
  }
  /* Whole slot is the link target. */
  .slot-box h3 a::after {
    content: '';
    position: absolute;
    inset: -4px 0 0 0;
  }
  .slot-box:hover h3 a {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--pd-signal);
    text-underline-offset: 0.15em;
  }
  .slot-box:has(a:focus-visible) {
    outline: 3px solid var(--pd-tyre);
    outline-offset: 6px;
  }
  .slot-box h3 a:focus-visible { outline: none; }
  .line {
    line-height: 1.5;
    max-width: 44ch;
  }
  .spec {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .spec div { display: grid; }
  .spec dt {
    font-size: 0.875rem;
    color: var(--pd-ink-2);
  }
  .spec dd {
    margin: 0;
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.15;
  }
  .spec strong { font-weight: 800; font-style: italic; }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(2rem, 5vw, 5rem);
      row-gap: 3.5rem;
    }
    /* Staggered like a real starting grid: the right-hand column starts half a slot back. */
    .slot-box:nth-child(even) { translate: 0 6rem; }
    .grid { padding-block-end: 6rem; }
  }

  /* Work */
  .work { padding-block: var(--section); }
  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0.75rem;
  }
  .work-grid figure { margin: 0; }
  .work-grid :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .work-grid figcaption {
    margin-block-start: 0.6rem;
    display: grid;
    line-height: 1.25;
  }
  .work-grid figcaption strong {
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: 1.3rem;
  }
  .work-grid figcaption span {
    font-size: 0.9375rem;
    color: var(--pd-ink-2);
  }
  @media (min-width: 60rem) {
    .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 1.5rem; }
