---
/**
 * The hero is the tool. Tick what is wrong with the car; the job card marks
 * the car plan, the fix writes itself below, and the handoff turns it into a
 * WhatsApp message with the car and a day filled in.
 *
 * Native form controls throughout; the script only adds numbering, totals,
 * the message and a polite live summary.
 */
import Picture from '../shared/Picture.astro';
import Plan from './Plan.astro';
import { symptoms, groups, fixes, notes, aed } from './fix';
import { contact, whatsappLink } from '../data';

const clientData = {
  symptoms: symptoms.map(({ id, kind, zones, fixes, short, quote }) => ({ id, kind, zones, fixes, short, quote })),
  fixes: fixes.map(({ id, name, from, fromSuv, minutes, time, quote }) => ({ id, name, from, fromSuv, minutes, time, quote })),
  notes,
  wa: contact.whatsapp,
};

const hello = whatsappLink('Hi WRP, I’d like a quote for my car.');
const days = ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'];
const thisYear = new Date().getFullYear() + 1;
---

<section class="tool" id="diagnose" aria-labelledby="dx-title" data-tool>
  <div class="intro">
    <p class="where">WRP Detailing, Al Qusais, Dubai</p>
    <h1 id="dx-title">What’s wrong with the car?</h1>
    <p class="lede">
      Tick everything that bothers you. We write up the fix as you go: the work, the starting price, how long we keep
      the car, and what someone with the same problem said afterwards.
    </p>
  </div>

  <div class="card" aria-labelledby="card-title">
    <div class="card__head">
      <h2 id="card-title">Your job card</h2>
      <p class="card__count"><span data-count>0</span> <span data-count-word>findings</span></p>
    </div>

    <div class="stage">
      <Plan />
      <p class="stage__readout" aria-hidden="true" data-mini>Tick a problem and it’s marked on the car</p>
    </div>

    <div class="card__controls">
      <fieldset class="view">
        <legend class="visually-hidden">Show the car</legend>
        <label><input type="radio" name="dx-view" value="before" checked /> <span>As it is</span></label>
        <label><input type="radio" name="dx-view" value="after" /> <span>After the work</span></label>
      </fieldset>
      <ul class="key" role="list" aria-label="Drawing key">
        <li><span class="swatch swatch--defect" aria-hidden="true"></span>Problem</li>
        <li><span class="swatch swatch--wish" aria-hidden="true"></span>Your request</li>
        <li><span class="swatch swatch--fixed" aria-hidden="true"></span>Done</li>
      </ul>
    </div>

    <dl class="readout">
      <div>
        <dt>Starting prices add up to</dt>
        <dd><span class="big" data-total>AED 0</span><span class="small" data-inspect></span></dd>
      </div>
      <div>
        <dt>Longest single job</dt>
        <dd><span class="mid" data-longest>Nothing yet</span></dd>
      </div>
    </dl>
    <a class="btn btn--ink card__send" href="#handoff">Add your car and send it to us</a>
  </div>

  <form class="symptoms" id="dx-symptoms" aria-describedby="dx-symptoms-help" novalidate>
    <p id="dx-symptoms-help" class="visually-hidden">Tick as many as apply. The job card and the fix update as you tick.</p>
    {
      groups.map((g) => (
        <fieldset class="group">
          <legend>{g.legend}</legend>
          <div class="tiles">
            {symptoms
              .filter((s) => s.group === g.id)
              .map((s) => (
                <div class="tile" data-kind={s.kind}>
                  <input type="checkbox" id={`s-${s.id}`} name="symptom" value={s.id} aria-describedby={`h-${s.id}`} />
                  <label for={`s-${s.id}`}>{s.label}</label>
                  <p class="tile__hint" id={`h-${s.id}`}>{s.hint}</p>
                  <span class="tile__num" data-num-for={s.id} aria-hidden="true" />
                </div>
              ))}
          </div>
        </fieldset>
      ))
    }
  </form>

  <section class="fix" aria-labelledby="fix-title">
    <div class="fix__head">
      <h2 id="fix-title">The fix</h2>
      <p class="fix__empty" data-fix-empty>
        Tick a problem and the work to fix it appears here, in the order we would do it. Not sure what you’re looking
        at? <a href={hello} target="_blank" rel="noopener">Send us a photo on WhatsApp</a>.
      </p>
    </div>

    <ol class="jobs" role="list">
      {
        fixes.map((f) => (
          <li class="job" data-fix={f.id} hidden>
            <div class="job__n" aria-hidden="true" />
            <div class="job__main">
              <h3>
                <a href={f.href}>{f.name}</a>
              </h3>
              <p class="job__for" data-for />
              <dl class="job__spec">
                <div>
                  <dt>From</dt>
                  <dd data-price data-saloon={f.from ?? ''} data-suv={f.fromSuv ?? ''}>
                    {f.from == null
                      ? 'Priced after inspection'
                      : f.fromSuv
                        ? `${aed(f.from)} saloon, ${aed(f.fromSuv)} SUV`
                        : aed(f.from)}
                  </dd>
                </div>
                <div>
                  <dt>Car stays</dt>
                  <dd>{f.time}</dd>
                </div>
              </dl>
              <ol class="job__steps">
                {f.steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
              <ul class="job__facts" role="list">
                {f.facts.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            </div>
            <div class="job__side">
              {f.image ? (
                <Picture
                  base={f.image.base}
                  alt={f.image.alt}
                  sizes="(min-width: 60rem) 14rem, 40vw"
                  widths={[480, 800]}
                  class="job__photo"
                />
              ) : (
                <div class="job__swatch" role="img" aria-label="Matte black wrap film sample">
                  <span>Matte black</span>
                </div>
              )}
              <blockquote class="job__quote">
                <p data-quote-text>“{f.quote.text}”</p>
                <footer data-quote-by>
                  {f.quote.author}, {f.quote.context}
                </footer>
              </blockquote>
            </div>
          </li>
        ))
      }
    </ol>

    <ul class="notes" role="list">
      {
        notes.map((n) => (
          <li class="note" data-note={n.id} hidden>
            <strong>Worth knowing.</strong> {n.text}
          </li>
        ))
      }
    </ul>
  </section>

  <p class="visually-hidden" role="status" data-live></p>
  <script type="application/json" id="dx-data" set:html={JSON.stringify(clientData)} />
</section>

<section class="handoff" id="handoff" aria-labelledby="handoff-title">
  <div class="handoff__intro">
    <h2 id="handoff-title">Send it to us</h2>
    <p>
      Add the car and a day. WhatsApp opens with your job card written in, and you can change anything before you send
      it. Someone from the studio replies with a price for your car.
    </p>
  </div>

  <form class="send" id="dx-send" novalidate>
    <div class="field field--wide">
      <label for="dx-car">Make and model</label>
      <span class="hint" id="dx-car-hint">For example, Toyota Land Cruiser</span>
      <input id="dx-car" name="car" type="text" autocomplete="off" aria-describedby="dx-car-hint" maxlength="60" />
    </div>
    <div class="field">
      <label for="dx-year">Year</label>
      <span class="hint" id="dx-year-hint">Four digits</span>
      <input
        id="dx-year"
        name="year"
        type="number"
        inputmode="numeric"
        min="1960"
        max={thisYear}
        step="1"
        aria-describedby="dx-year-hint"
        aria-errormessage="dx-year-error"
      />
      <span class="error" id="dx-year-error">Enter a year between 1960 and {thisYear}.</span>
    </div>
    <div class="field">
      <label for="dx-day">Preferred day</label>
      <span class="hint" id="dx-day-hint">We’re closed on Fridays</span>
      <select id="dx-day" name="day" aria-describedby="dx-day-hint">
        <option value="">Any day</option>
        {days.map((d) => <option value={d}>{d}</option>)}
      </select>
    </div>
    <fieldset class="field field--wide body">
      <legend>Body</legend>
      <label><input type="radio" name="body" value="saloon" checked /> <span>Saloon, hatch or coupé</span></label>
      <label><input type="radio" name="body" value="suv" /> <span>SUV or 4x4</span></label>
    </fieldset>
    <label class="field field--wide pickup" for="dx-pickup">
      <input type="checkbox" id="dx-pickup" name="pickup" />
      <span>Please collect the car from me</span>
    </label>

  </form>

  <div class="handoff__out">
    <div class="preview">
      <p class="preview__label" id="dx-preview-label">What we’ll receive</p>
      <output class="preview__text" for="dx-car dx-year dx-day dx-pickup" aria-labelledby="dx-preview-label" data-preview
        >Hi WRP, I’d like a quote for my car.</output
      >
    </div>

    <div class="send__actions">
      <a class="btn btn--ink btn--wa" href={hello} target="_blank" rel="noopener" data-wa>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"
          /></svg
        >
        Send to WRP on WhatsApp
      </a>
      <p class="send__alt">
        Or call <a href={contact.phoneHref}>{contact.phoneDisplay}</a>, Saturday to Thursday, 9 AM to 9:30 PM.
      </p>
    </div>
  </div>
</section>

<script>
  type Quote = { text: string; author: string; context: string };
  type Sym = { id: string; kind: 'defect' | 'wish'; zones: string[]; fixes: string[]; short: string; quote: Quote };
  type Fx = { id: string; name: string; from: number | null; fromSuv?: number; minutes: number; time: string; quote: Quote };
  type Data = { symptoms: Sym[]; fixes: Fx[]; notes: { id: string; requires: string[][]; text: string }[]; wa: string };

  const dataEl = document.getElementById('dx-data');
  const tool = document.querySelector<HTMLElement>('[data-tool]');
  const form = document.getElementById('dx-symptoms') as HTMLFormElement | null;
  const send = document.getElementById('dx-send') as HTMLFormElement | null;

  if (dataEl && tool && form && send) {
    const data: Data = JSON.parse(dataEl.textContent || '{}');
    const symById = new Map(data.symptoms.map((s) => [s.id, s]));
    const plan = tool.querySelector<SVGSVGElement>('[data-plan]')!;
    const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = tool) => root.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) =>
      Array.from(root.querySelectorAll<T>(sel));
    const fmt = (n: number) => `AED ${n.toLocaleString('en-US')}`;

    /** Ticked symptom ids, in the order they were ticked: that order numbers the findings. */
    let order: string[] = $$<HTMLInputElement>('input[name="symptom"]:checked', form).map((i) => i.value);

    const body = () => (send.querySelector<HTMLInputElement>('input[name="body"]:checked')?.value ?? 'saloon') as 'saloon' | 'suv';

    /** Which fixes are on the card, and for which symptoms. Level 3 absorbs Level 2. */
    const plannedFixes = () => {
      const map = new Map<string, string[]>();
      for (const id of order) {
        for (const f of symById.get(id)!.fixes) map.set(f, [...(map.get(f) ?? []), id]);
      }
      if (map.has('detail-2') && map.has('detail-3')) {
        map.set('detail-3', [...map.get('detail-2')!, ...map.get('detail-3')!]);
        map.delete('detail-2');
      }
      // Keep the work order from the page, not the tick order.
      return data.fixes.filter((f) => map.has(f.id)).map((f) => ({ fix: f, for: map.get(f.id)! }));
    };

    const priceOf = (f: Fx) => (f.from == null ? null : body() === 'suv' && f.fromSuv ? f.fromSuv : f.from);

    let liveTimer = 0;
    const announce = (text: string) => {
      window.clearTimeout(liveTimer);
      liveTimer = window.setTimeout(() => {
        $('[data-live]')!.textContent = text;
      }, 500);
    };

    const badge = (n: number, kind: string) => {
      const b = document.createElement('span');
      b.className = `ref ref--${kind}`;
      b.textContent = String(n);
      b.setAttribute('aria-hidden', 'true');
      return b;
    };

    const render = (fromUser = false) => {
      // 1. Numbers on tiles and callouts.
      for (const el of $$('[data-num-for]', tool)) {
        const i = order.indexOf(el.dataset.numFor!);
        el.textContent = i >= 0 ? String(i + 1) : '';
      }
      for (const g of $$<SVGGElement>('[data-callout]', plan)) {
        const i = order.indexOf(g.dataset.callout!);
        g.toggleAttribute('data-on', i >= 0);
        g.querySelector('[data-num]')!.textContent = i >= 0 ? String(i + 1) : '';
      }

      // 2. Zones: a problem outranks a wish.
      const state = new Map<string, 'defect' | 'wish'>();
      for (const id of order) {
        const s = symById.get(id)!;
        for (const z of s.zones) if (state.get(z) !== 'defect') state.set(z, s.kind);
      }
      for (const z of $$<SVGElement>('[data-zone]', plan)) {
        const st = state.get(z.dataset.zone!);
        if (st) z.dataset.state = st;
        else delete z.dataset.state;
      }

      // 3. The fix, in work order.
      const planned = plannedFixes();
      const plannedIds = new Set(planned.map((p) => p.fix.id));
      for (const li of $$('[data-fix]', tool)) {
        const p = planned.find((x) => x.fix.id === li.dataset.fix);
        li.hidden = !p;
        if (!p) continue;
        const forEl = li.querySelector('[data-for]')!;
        forEl.replaceChildren('For ');
        p.for.forEach((sid, k) => {
          const s = symById.get(sid)!;
          if (k) forEl.append(k === p.for.length - 1 ? ' and ' : ', ');
          forEl.append(badge(order.indexOf(sid) + 1, s.kind), ` ${s.short.toLowerCase()}`);
        });
        // The quote comes from someone with the same problem, where we have one.
        const owner = p.for.map((sid) => symById.get(sid)!).find((s) => s.fixes[0] === p.fix.id);
        const q = owner?.quote ?? p.fix.quote;
        li.querySelector('[data-quote-text]')!.textContent = `“${q.text}”`;
        li.querySelector('[data-quote-by]')!.textContent = `${q.author}, ${q.context}`;
        const price = li.querySelector<HTMLElement>('[data-price]')!;
        if (p.fix.fromSuv && p.fix.from != null) {
          price.textContent = `${fmt(priceOf(p.fix)!)} ${body() === 'suv' ? 'SUV' : 'saloon'}`;
        }
      }
      for (const li of $$('[data-note]', tool)) {
        const n = data.notes.find((x) => x.id === li.dataset.note)!;
        li.hidden = !n.requires.every((grp) => grp.some((id) => plannedIds.has(id)));
      }
      $('[data-fix-empty]')!.hidden = order.length > 0;

      // 4. Readouts.
      const priced = planned.filter((p) => p.fix.from != null);
      const total = priced.reduce((sum, p) => sum + priceOf(p.fix)!, 0);
      const inspect = planned.length - priced.length;
      const longest = planned.reduce<Fx | null>((a, p) => (!a || p.fix.minutes >= a.minutes ? p.fix : a), null);
      $('[data-count]')!.textContent = String(order.length);
      $('[data-count-word]')!.textContent = order.length === 1 ? 'finding' : 'findings';
      $('[data-total]')!.textContent = fmt(total);
      $('[data-inspect]')!.textContent = inspect
        ? `plus ${inspect} ${inspect === 1 ? 'job' : 'jobs'} priced after inspection`
        : planned.length
          ? `${body() === 'suv' ? 'SUV' : 'Saloon'} prices, confirmed when we see the car`
          : '';
      $('[data-longest]')!.textContent = longest ? `${longest.time}, ${longest.name.toLowerCase()}` : 'Nothing yet';
      $('[data-mini]')!.textContent = order.length
        ? `${order.length} ${order.length === 1 ? 'finding' : 'findings'}, ${planned.length} ${planned.length === 1 ? 'job' : 'jobs'}, from ${fmt(total)}${inspect ? ' + inspection' : ''}`
        : 'Tick a problem and it’s marked on the car';
      tool.toggleAttribute('data-has-findings', order.length > 0);

      // 5. The message.
      writeMessage(planned);

      if (fromUser) {
        announce(
          order.length
            ? `${order.length} ${order.length === 1 ? 'finding' : 'findings'}. Suggested work: ${planned
                .map((p) => p.fix.name)
                .join(', ')}. Starting prices add up to ${fmt(total)}${inspect ? `, plus ${inspect} priced after inspection` : ''}.`
            : 'Nothing ticked. The job card is empty.',
        );
      }
    };

    const writeMessage = (planned: ReturnType<typeof plannedFixes>) => {
      const car = (send.elements.namedItem('car') as HTMLInputElement).value.trim();
      const yearEl = send.elements.namedItem('year') as HTMLInputElement;
      const year = yearEl.value && yearEl.checkValidity() ? yearEl.value : '';
      const day = (send.elements.namedItem('day') as HTMLSelectElement).value;
      const pickup = (send.elements.namedItem('pickup') as HTMLInputElement).checked;
      const b = body() === 'suv' ? 'SUV or 4x4' : 'saloon, hatch or coupé';

      const lines = ['Hi WRP, I’d like a quote for my car.', ''];
      lines.push(`Car: ${[year, car].filter(Boolean).join(' ') || 'not specified'} (${b})`);
      if (order.length) {
        lines.push('', 'What’s wrong:');
        order.forEach((id, i) => lines.push(`${i + 1}. ${symById.get(id)!.short}`));
        lines.push('', `Suggested on your site: ${planned.map((p) => p.fix.name).join(', ')}`);
      } else {
        lines.push('', 'Not sure what it needs yet. Could you take a look?');
      }
      lines.push(`Preferred day: ${day || 'any day'}`);
      if (pickup) lines.push('Please collect the car from me.');
      const text = lines.join('\n');
      document.querySelector<HTMLElement>('[data-preview]')!.textContent = text;
      document.querySelector<HTMLAnchorElement>('[data-wa]')!.href = `${data.wa}?text=${encodeURIComponent(text)}`;
    };

    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name !== 'symptom') return;
      order = input.checked ? [...order.filter((id) => id !== input.value), input.value] : order.filter((id) => id !== input.value);
      render(true);
    });

    // After view: turn every mark green.
    for (const r of $$<HTMLInputElement>('input[name="dx-view"]', tool)) {
      r.addEventListener('change', () => {
        plan.dataset.view = r.value;
      });
    }
    plan.dataset.view = $<HTMLInputElement>('input[name="dx-view"]:checked')?.value ?? 'before';

    // Handoff: every edit rewrites the message; aria-invalid follows :user-invalid.
    send.addEventListener('submit', (e) => e.preventDefault());
    send.addEventListener('input', () => render());
    send.addEventListener('change', () => render());
    const syncAria = (e: Event) => {
      const el = e.target as HTMLInputElement;
      if (!el.matches?.('input, select')) return;
      if (el.matches(':user-invalid')) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
    };
    send.addEventListener('blur', syncAria, true);
    send.addEventListener('input', (e) => {
      if ((e.target as Element).hasAttribute('aria-invalid')) syncAria(e);
    });

    render();
  }
</script>

<style>
  /* ---------- Layout ---------- */
  .tool {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem var(--dx-gutter) 3rem;
    max-width: var(--dx-max);
    margin-inline: auto;
  }
  @media (max-width: 59.99rem) {
    /* On phones the card dissolves: the drawing sticks under the header while you tick. */
    .tool > .card {
      display: contents;
    }
    .card__head {
      order: 1;
    }
    .stage {
      order: 2;
      position: sticky;
      top: var(--dx-hh);
      z-index: 2;
      margin-inline: calc(var(--dx-gutter) * -1);
      padding: 0.5rem var(--dx-gutter) 0.6rem;
      background: color-mix(in srgb, var(--dx-paper) 94%, transparent);
      backdrop-filter: blur(6px);
      border-block-end: 1px solid var(--dx-rule);
    }
    .symptoms {
      order: 3;
    }
    .card__controls {
      order: 4;
    }
    .readout {
      order: 5;
    }
    .card__send {
      order: 6;
    }
    .fix {
      order: 7;
    }
    .intro {
      order: 0;
    }
  }
  @media (min-width: 60rem) {
    .tool {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      row-gap: 2rem;
      align-items: start;
      padding-block: 2.5rem 4rem;
    }
    .intro,
    .symptoms,
    .fix {
      grid-column: 1;
    }
    .card {
      grid-column: 2;
      grid-row: 1 / span 3;
      position: sticky;
      top: calc(var(--dx-hh) + 1rem);
    }
    .tool[data-has-findings] .stage__readout {
      display: none;
    }
  }

  /* ---------- Intro ---------- */
  .where {
    font-size: var(--dx-s-1);
    color: var(--dx-ink-2);
    margin-block-end: 0.75rem;
  }
  h1 {
    font-family: var(--dx-display);
    font-weight: 900;
    font-size: var(--dx-s5);
    line-height: 0.95;
    letter-spacing: -0.025em;
    max-width: 12ch;
    font-variation-settings: 'SOFT' 50, 'WONK' 0;
  }
  .lede {
    margin-block-start: 1.1rem;
    font-size: var(--dx-s1);
    line-height: 1.5;
    max-width: 38rem;
    color: var(--dx-ink-2);
  }

  /* ---------- Job card ---------- */
  .card {
    background: var(--dx-sheet);
    border: 1px solid var(--dx-rule);
    border-radius: 3px;
    padding: 1.25rem 1.25rem 1.5rem;
    display: grid;
    gap: 1rem;
    box-shadow: 0 1px 0 var(--dx-rule), 0 18px 40px -28px rgb(21 24 29 / 0.35);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-block-end: 2px solid var(--dx-ink);
    padding-block-end: 0.5rem;
  }
  .card__head h2 {
    font-family: var(--dx-display);
    font-weight: 600;
