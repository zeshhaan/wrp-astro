---
import { pages, contact } from '../data';

const links = [
  { label: 'Portfolio', href: pages.portfolio },
  { label: 'Reviews', href: pages.reviews },
  { label: 'Blog', href: pages.blog },
  { label: 'About WRP', href: pages.about },
  { label: 'Contact', href: pages.contact },
  { label: 'Privacy', href: pages.privacy },
  { label: 'Terms', href: pages.terms },
];
---

<footer class="foot">
  <div class="foot__in">
    <p class="mark">WRP.</p>
    <p class="pillars">Wrap, reinforce, protect. Detailing studio in Al Qusais Industrial Area 1, Dubai.</p>
    <nav aria-label="Site">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li><a href={pages.arabic} lang="ar" hreflang="ar">العربية</a></li>
        <li><a href={contact.instagram} target="_blank" rel="noopener">Instagram {contact.instagramHandle}</a></li>
      </ul>
    </nav>
    <p class="small">© {new Date().getFullYear()} WRP Detailing Solutions.</p>
  </div>
</footer>

<style>
  .foot {
    border-block-start: 1px solid #2b3038;
    background: var(--dx-ink);
    color: var(--dx-on-ink-2);
    /* Room for the Design Lab switcher on phones. */
    padding: 2.5rem var(--dx-gutter) calc(2.5rem + 64px);
  }
  .foot__in {
    max-width: var(--dx-max);
    margin-inline: auto;
    display: grid;
    gap: 1rem;
  }
  .mark {
    font-family: var(--dx-mark);
    font-weight: 900;
    font-style: italic;
    font-size: 2rem;
    letter-spacing: -0.04em;
    color: var(--dx-on-ink);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  a {
    display: inline-block;
    padding-block: 0.6rem;
    color: var(--dx-on-ink);
  }
  .small {
    font-size: var(--dx-s-1);
  }
  :focus-visible {
    outline-color: var(--dx-blue-on-ink);
  }
</style>
