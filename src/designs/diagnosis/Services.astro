---
/**
 * For people who already know what they want: the whole service list,
 * in the owner's order of emphasis, with honest starting prices.
 */
import { services, type Service } from '../data';
import { washLevels, wrapService, aed } from './fix';

const bySlug = (slug: string) => services.find((s) => s.slug === slug) as Service;
const rows = [
  bySlug('paint-protection-film'),
  { ...bySlug('premium-car-wash'), name: 'Detailing & premium wash', line: 'Hand-washed and detailed inside and out, in three levels. Level 3 takes off tar and iron and extraction-cleans the carpets.' },
  bySlug('polish'),
  bySlug('ceramic-coating'),
  bySlug('leather-upholstery'),
  bySlug('window-film'),
];
---

<section class="services" id="services" aria-labelledby="services-title">
  <div class="services__head">
    <h2 id="services-title">Already know what you need?</h2>
    <p>Everything we do, with the price it starts from. We confirm the exact price when we see the car.</p>
  </div>

  <ul class="list" role="list">
    {
      rows.map((s) => (
        <li class="row">
          <h3>
            <a href={s.href}>{s.name}</a>
          </h3>
          <p class="line">{s.line}</p>
          <dl class="spec">
            <div>
              <dt>From</dt>
              <dd>{s.from == null ? 'Priced after inspection' : aed(s.from)}</dd>
            </div>
            <div>
              <dt>Car stays</dt>
              <dd>{s.time}</dd>
            </div>
          </dl>
          {s.slug === 'premium-car-wash' && (
            <table class="levels">
              <caption class="visually-hidden">Detailing levels and starting prices</caption>
              <thead>
                <tr>
                  <th scope="col">Level</th>
                  <th scope="col">What it’s for</th>
                  <th scope="col">Saloon</th>
                  <th scope="col">SUV</th>
                </tr>
              </thead>
              <tbody>
                {washLevels.map((l) => (
                  <tr>
                    <th scope="row">{l.name}</th>
                    <td>{l.what}</td>
                    <td>{aed(l.saloon)}</td>
                    <td>{aed(l.suv)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </li>
      ))
    }
    <li class="row">
      <h3><a href={wrapService.href}>{wrapService.name}</a></h3>
      <p class="line">{wrapService.line}</p>
      <dl class="spec">
        <div>
          <dt>From</dt>
          <dd>Priced after inspection</dd>
        </div>
        <div>
          <dt>Car stays</dt>
          <dd>{wrapService.time}</dd>
        </div>
      </dl>
    </li>
  </ul>
</section>

<style>
  .services {
    max-width: var(--dx-max);
    margin-inline: auto;
    padding: 4rem var(--dx-gutter);
  }
  .services__head {
    display: grid;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }
  @media (min-width: 60rem) {
    .services__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
      align-items: end;
    }
  }
  h2 {
    font-family: var(--dx-display);
    font-weight: 900;
    font-size: var(--dx-s4);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .services__head p {
    color: var(--dx-ink-2);
    max-width: 30rem;
  }
  .list {
    border-block-start: 2px solid var(--dx-ink);
  }
  .row {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: 1.4rem;
    border-block-end: 1px solid var(--dx-rule-strong);
  }
  @media (min-width: 52rem) {
    .row {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) minmax(0, 17rem);
      align-items: baseline;
    }
    .levels {
      grid-column: 2 / -1;
    }
  }
  h3 {
    font-family: var(--dx-display);
    font-weight: 600;
    font-size: var(--dx-s2);
    line-height: 1.1;
  }
  h3 a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
  }
  h3 a:hover {
    color: var(--dx-blue);
  }
  .line {
    color: var(--dx-ink-2);
    max-width: 34rem;
  }
  .spec {
    display: flex;
    gap: 0.5rem 1.75rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .spec dt {
    font-size: var(--dx-s-1);
    color: var(--dx-ink-2);
  }
  .spec dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .levels {
    border-collapse: collapse;
    width: 100%;
    margin-block-start: 0.5rem;
    font-size: var(--dx-s-1);
    font-variant-numeric: tabular-nums;
  }
  .levels th,
  .levels td {
    text-align: start;
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-block-start: 1px solid var(--dx-rule);
    vertical-align: top;
  }
  .levels thead th {
    color: var(--dx-ink-2);
    font-weight: 500;
    border: 0;
  }
  .levels tbody th {
    font-weight: 700;
    white-space: nowrap;
  }
  .levels td:nth-child(3),
  .levels td:nth-child(4) {
    font-weight: 600;
    white-space: nowrap;
  }
</style>
