---
import { whatsappLink } from '../data';

const links = [
  { label: 'Diagnose', href: '#diagnose' },
  { label: 'Services', href: '#services' },
  { label: 'Work', href: '#work' },
  { label: 'Reviews', href: '#proof' },
  { label: 'Lounge', href: '#lounge' },
  { label: 'Visit', href: '#visit' },
];
const hello = whatsappLink('Hi WRP, I’d like a quote for my car.');
---

<a class="skip" href="#main">Skip to content</a>
<header class="head">
  <div class="head__in">
    <a class="mark" href="#diagnose" aria-label="WRP Detailing, back to the top">WRP.</a>

    <nav aria-label="Primary" class="nav">
      <button class="nav__toggle" type="button" popovertarget="dx-nav" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
          ><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"
          ></path></svg
        >
        <span>Menu</span>
      </button>
      <ul id="dx-nav" class="nav__list" popover role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--ink head__cta" href={hello} target="_blank" rel="noopener">
      <span class="long">Message us on WhatsApp</span><span class="short">WhatsApp</span>
    </a>
  </div>
</header>

<script>
  // Close the phone menu after a jump.
  const list = document.getElementById('dx-nav');
  list?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a') && list.matches(':popover-open')) list.hidePopover();
  });
</script>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 50;
    padding: 0.75rem 1rem;
    background: var(--dx-ink);
    color: var(--dx-sheet);
    font-weight: 600;
  }
  .skip:focus {
    top: 0.5rem;
  }
  .head {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--dx-paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--dx-rule);
  }
  .head__in {
    max-width: var(--dx-max);
    margin-inline: auto;
    padding-inline: var(--dx-gutter);
    height: var(--dx-hh);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .mark {
    font-family: var(--dx-mark);
    font-weight: 900;
    font-style: italic;
    font-size: 1.6rem;
    letter-spacing: -0.04em;
    text-decoration: none;
    margin-inline-end: auto;
    padding-block: 0.4rem;
  }
  .nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--dx-rule-strong);
    border-radius: 3px;
    background: transparent;
    font-weight: 600;
    cursor: pointer;
  }
  .nav__list {
    margin: 0;
    padding: 0.5rem;
    list-style: none;
  }
  .nav__list a {
    display: block;
    padding: 0.75rem 1rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.0625rem;
  }
  .nav__list a:hover {
    color: var(--dx-blue);
  }
  /* Phone menu: a popover sheet under the header. */
  .nav__list:popover-open {
    position: fixed;
    inset: calc(var(--dx-hh) + 0.5rem) var(--dx-gutter) auto auto;
    width: min(16rem, calc(100vw - 2 * var(--dx-gutter)));
    background: var(--dx-sheet);
    color: var(--dx-ink);
    border: 1px solid var(--dx-rule-strong);
    border-radius: 3px;
    box-shadow: 0 20px 40px -20px rgb(21 24 29 / 0.4);
  }
  /* No popover support: show the links inline and drop the button. */
  @supports not selector(:popover-open) {
    .nav__toggle {
      display: none;
    }
    .nav__list {
      display: flex;
      flex-wrap: wrap;
    }
  }
  .short {
    display: none;
  }
  @media (max-width: 30rem) {
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .nav__toggle span {
      display: none;
    }
  }
  @media (min-width: 60rem) {
    .nav__toggle {
      display: none;
    }
    .nav__list,
    .nav__list:popover-open {
      display: flex;
      position: static;
      inset: auto;
      width: auto;
      background: none;
      border: 0;
      box-shadow: none;
      padding: 0;
      gap: 0.25rem;
      margin-inline-end: 0.75rem;
      overflow: visible;
    }
    .nav__list[popover] {
      /* On desktop the list is always shown, whatever the popover state. */
      display: flex;
      inset: auto;
      position: static;
      color: inherit;
    }
    .nav__list a {
      padding: 0.6rem 0.7rem;
      font-size: 0.9375rem;
      font-weight: 500;
    }
  }
</style>
