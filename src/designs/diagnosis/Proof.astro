---
/**
 * What you can hold us to: each promise sits next to the review that proves it.
 */
import { proof } from '../data';
import { commitments } from './fix';
---

<section class="proof" id="proof" aria-labelledby="proof-title">
  <div class="proof__head">
    <h2 id="proof-title">What you can hold us to</h2>
    <p class="rating">
      <span class="rating__n">{proof.rating}</span>
      <span class="rating__txt">
        on Google from {proof.reviewCountDisplay} reviews.
        <a href={proof.reviewsUrl}>Read them all</a>
      </span>
    </p>
  </div>

  <ol class="promises" role="list">
    {
      commitments.map((c) => (
        <li>
          <h3>{c.claim}</h3>
          <p class="detail">{c.detail}</p>
          <blockquote>
            <p>“{c.quote.text}”</p>
            <footer>{c.quote.author}</footer>
          </blockquote>
        </li>
      ))
    }
    <li class="films">
      <h3>Film you can name, warranty in writing</h3>
      <p class="detail">
        We fit Avery Dennison and STEK paint protection film. Self-healing, with a warranty of up to 10 years.
      </p>
      <ul class="logos" role="list">
        {
          proof.films.map((f) => (
            <li>
              <img src={f.logo} alt={f.name} width="160" height="48" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </li>
  </ol>
</section>

<style>
  .proof {
    max-width: var(--dx-max);
    margin-inline: auto;
    padding: 4rem var(--dx-gutter);
  }
  .proof__head {
    display: grid;
    gap: 1.25rem;
    margin-block-end: 2.5rem;
  }
  @media (min-width: 60rem) {
    .proof__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      column-gap: 4rem;
    }
  }
  h2 {
    font-family: var(--dx-display);
    font-weight: 900;
    font-size: var(--dx-s4);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .rating {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  .rating__n {
    font-family: var(--dx-display);
    font-weight: 600;
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    line-height: 0.9;
    font-variant-numeric: lining-nums;
    color: var(--dx-fixed);
  }
  .rating__txt {
    font-size: var(--dx-s1);
    line-height: 1.4;
    max-width: 14rem;
  }
  .rating a {
    display: inline-block;
    font-weight: 600;
    color: var(--dx-blue);
    padding-block: 0.25rem;
  }
  .promises {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: 0;
    border-block-start: 2px solid var(--dx-ink);
  }
  .promises > li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem 1.5rem 1.75rem 0;
    border-block-end: 1px solid var(--dx-rule-strong);
  }
  @media (min-width: 40rem) {
    .promises > li {
      padding-inline-start: 1.5rem;
      border-inline-start: 1px solid var(--dx-rule-strong);
      margin-inline-start: -1px;
    }
  }
  h3 {
    font-family: var(--dx-display);
    font-weight: 600;
    font-size: var(--dx-s2);
    line-height: 1.15;
  }
  h3::before {
    content: '';
    display: block;
    width: 0.8rem;
    height: 0.45rem;
    border-inline-start: 2.5px solid var(--dx-fixed);
    border-block-end: 2.5px solid var(--dx-fixed);
    rotate: -45deg;
    margin-block-end: 0.75rem;
    margin-inline-start: 0.15rem;
  }
  .detail {
    color: var(--dx-ink-2);
  }
  blockquote {
    margin-block-start: 0.5rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 3px solid var(--dx-rule-strong);
  }
  blockquote p {
    font-family: var(--dx-display);
    font-style: italic;
    line-height: 1.45;
  }
  blockquote footer {
    margin-block-start: 0.3rem;
    font-size: var(--dx-s-1);
    color: var(--dx-ink-2);
  }
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-block-start: 0.75rem;
  }
  .logos img {
    height: 2.25rem;
    width: auto;
    mix-blend-mode: multiply;
  }
</style>
