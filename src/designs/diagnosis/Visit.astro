---
import Picture from '../shared/Picture.astro';
import { contact, studio, whatsappLink } from '../data';

const { open, close, closedDays, timeZone } = contact.schedule;
const hello = whatsappLink('Hi WRP, I’d like to bring my car in.');
---

<section class="visit" id="visit" aria-labelledby="visit-title">
  <div class="visit__in">
    <div class="info">
      <h2 id="visit-title">Bring it to Al&nbsp;Qusais</h2>
      <p
        class="status"
        data-open-status
        data-open={open}
        data-close={close}
        data-closed-days={closedDays.join(',')}
        data-tz={timeZone}
        hidden
      >
        <span class="status__dot" aria-hidden="true"></span>
        <span class="status__text"></span>
      </p>
      <dl class="facts">
        <div>
          <dt>Address</dt>
          <dd>{contact.address[0]}<br />{contact.address[1]}</dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd>{contact.hours}<br />{contact.closed}</dd>
        </div>
        <div>
          <dt>Phone and WhatsApp</dt>
          <dd><a href={contact.phoneHref}>{contact.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        </div>
      </dl>
      <div class="actions">
        <a class="btn btn--light" href={hello} target="_blank" rel="noopener">Message us on WhatsApp</a>
        <a class="btn btn--line" href={contact.mapsUrl} target="_blank" rel="noopener">Directions in Google Maps</a>
      </div>
      <p class="parking">Parking is easy outside the studio. Or ask us to collect the car.</p>
    </div>
    <figure class="night">
      <Picture base={studio.night.base} alt={studio.night.alt} sizes="(min-width: 60rem) 36rem, 100vw" />
      <figcaption>The studio at night. Photo by customer Mark Ban.</figcaption>
    </figure>
  </div>
</section>

<script>
  // Live open/closed status in Dubai time (js/model-partial-time-concepts: Temporal where available, Intl otherwise).
  const el = document.querySelector<HTMLElement>('[data-open-status]');
  if (el) {
    const tz = el.dataset.tz ?? 'Asia/Dubai';
    const toMin = (hhmm: string) => {
      const [h, m] = hhmm.split(':').map(Number);
      return h * 60 + m;
    };
    const open = toMin(el.dataset.open ?? '09:00');
    const close = toMin(el.dataset.close ?? '21:30');
    const closed = (el.dataset.closedDays ?? '').split(',').filter(Boolean).map(Number);
    const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const clock = (min: number) => {
      const h = Math.floor(min / 60);
      const m = min % 60;
      return `${((h + 11) % 12) + 1}${m ? ':' + String(m).padStart(2, '0') : ''} ${h < 12 ? 'AM' : 'PM'}`;
    };
    const now = () => {
      const T = (globalThis as any).Temporal;
      if (T?.Now?.zonedDateTimeISO) {
        const z = T.Now.zonedDateTimeISO(tz);
        return { day: z.dayOfWeek % 7, min: z.hour * 60 + z.minute };
      }
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      }).formatToParts(new Date());
      const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
      return {
        day: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday')),
        min: Number(get('hour')) * 60 + Number(get('minute')),
      };
    };
    const render = () => {
      const { day, min } = now();
      const openToday = !closed.includes(day);
      let text: string;
      let isOpen = false;
      if (openToday && min >= open && min < close) {
        isOpen = true;
        text = close - min <= 60 ? `Open now, closing soon at ${clock(close)}` : `Open now until ${clock(close)}`;
      } else if (openToday && min < open) {
        text = `Closed now. Opens today at ${clock(open)}`;
      } else {
        let ahead = 1;
        while (closed.includes((day + ahead) % 7) && ahead < 7) ahead++;
        const when = ahead === 1 ? 'tomorrow' : days[(day + ahead) % 7];
        text = `${openToday ? 'Closed now' : `Closed on ${days[day]}s`}. Opens ${when} at ${clock(open)}`;
      }
      el.querySelector('.status__text')!.textContent = text;
      el.classList.toggle('is-open', isOpen);
      el.hidden = false;
    };
    render();
    // Re-check on the minute (js/manage-recurring-intervals), and when the tab comes back.
    window.setTimeout(() => {
      render();
      window.setInterval(render, 60_000);
    }, 60_000 - (Date.now() % 60_000));
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') render();
    });
  }
</script>

<style>
  .visit {
    background: var(--dx-ink);
    color: var(--dx-on-ink);
    padding: 4rem var(--dx-gutter) 4.5rem;
  }
  .visit__in {
    max-width: var(--dx-max);
    margin-inline: auto;
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 60rem) {
    .visit__in {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: start;
    }
  }
  .info {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  h2 {
    font-family: var(--dx-display);
    font-weight: 900;
    font-size: var(--dx-s4);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: var(--dx-s1);
  }
  .status[hidden] {
    display: none;
  }
  .status__dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: #8a919c;
    flex: none;
  }
  .status.is-open .status__dot {
    background: #5fd49a;
    box-shadow: 0 0 0 4px rgb(95 212 154 / 0.2);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem 2rem;
    margin: 0;
  }
  dt {
    font-size: var(--dx-s-1);
    color: var(--dx-on-ink-2);
  }
  dd {
    margin: 0.15rem 0 0;
    font-weight: 500;
  }
  dd a {
    display: inline-block;
    padding-block: 0.2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .parking {
    color: var(--dx-on-ink-2);
  }
  .night :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }
  figcaption {
    margin-block-start: 0.5rem;
    font-size: var(--dx-s-1);
    color: var(--dx-on-ink-2);
  }
  :focus-visible {
    outline-color: var(--dx-blue-on-ink);
  }
</style>
