---
/** The lounge: one short section near the end. Nice to have, not why people come. */
import Picture from '../shared/Picture.astro';
import { lounge } from '../data';

const photo = lounge.photos[0];
const quote = lounge.quotes[0];
---

<section class="lounge" id="lounge" aria-labelledby="lounge-title">
  <Picture base={photo.base} alt={photo.alt} sizes="(min-width: 60rem) 32rem, 100vw" class="lounge__photo" />
  <div class="lounge__text">
    <h2 id="lounge-title">Staying while we work?</h2>
    <p>
      A detail or window film takes hours, not days, so you might prefer to wait. Upstairs, behind a glass wall over the
      bays, there’s a lounge with billiards, board games, coffee and karak, a big-screen TV and cold air-conditioning.
    </p>
    <blockquote>
      <p>“{quote.text}”</p>
      <footer>{quote.author}</footer>
    </blockquote>
    <p class="credit">{photo.caption}</p>
  </div>
</section>

<style>
  .lounge {
    max-width: var(--dx-max);
    margin-inline: auto;
    padding: 3.5rem var(--dx-gutter);
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 52rem) {
    .lounge {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 3rem;
    }
  }
  .lounge__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }
  .lounge__text {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }
  h2 {
    font-family: var(--dx-display);
    font-weight: 900;
    font-size: var(--dx-s3);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .lounge__text > p {
    color: var(--dx-ink-2);
  }
  blockquote {
    border-inline-start: 3px solid var(--dx-rule-strong);
    padding-inline-start: 0.75rem;
  }
  blockquote p {
    font-family: var(--dx-display);
    font-style: italic;
    font-size: var(--dx-s1);
    line-height: 1.4;
  }
  blockquote footer {
    margin-block-start: 0.3rem;
    font-size: var(--dx-s-1);
    color: var(--dx-ink-2);
  }
  .credit {
    font-size: var(--dx-s-1);
    color: var(--dx-ink-2);
  }
</style>
