---
import Picture from '../shared/Picture.astro';
import { work, pages } from '../data';

const customer = [
  {
    title: 'Toyota FJ Cruiser',
    what: 'Ceramic coating for a desert off-roader',
    image: '/review-images/leno_thomas_1',
    credit: 'Photo by customer Leno Thomas',
  },
  {
    title: 'Nissan SUV',
    what: 'Level 3 detail',
    image: '/review-images/ritha_farzana_3',
    credit: 'Photo by customer Ritha Farzana',
  },
];
const items = [
  { ...work[0], credit: '' },
  customer[0],
  { ...work[2], credit: '' },
  { ...work[4], credit: '' },
  customer[1],
];
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="work__head">
    <h2 id="work-title">Signed off and handed back</h2>
    <p>
      Recent cars from the studio floor. Two of these photos were taken by the owners when they collected them.
    </p>
  </div>
  <ul class="grid" role="list">
    {
      items.map((w, i) => (
        <li class={i === 0 ? 'lead' : ''}>
          <figure>
            <Picture
              base={w.image}
              alt={`${w.title} after ${w.what.toLowerCase()} at WRP`}
              sizes={i === 0 ? '(min-width: 60rem) 40rem, 100vw' : '(min-width: 60rem) 20rem, 50vw'}
            />
            <figcaption>
              <strong>{w.title}</strong>
              <span>{w.what}</span>
              {w.credit && <span class="credit">{w.credit}</span>}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
  <p class="more"><a href={pages.portfolio}>See the full portfolio</a></p>
</section>

<style>
  .work {
    max-width: var(--dx-max);
    margin-inline: auto;
    padding: 4rem var(--dx-gutter);
  }
  .work__head {
    display: grid;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }
  @media (min-width: 60rem) {
    .work__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
      align-items: end;
    }
  }
  h2 {
    font-family: var(--dx-display);
    font-weight: 900;
    font-size: var(--dx-s4);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .work__head p {
    color: var(--dx-ink-2);
    max-width: 30rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .lead {
    grid-column: 1 / -1;
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .lead {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
  figure {
    display: grid;
    gap: 0.6rem;
    height: 100%;
    align-content: start;
  }
  figure :global(img) {
    width: 100%;
  }
  /* The lead photo fills its two rows without its own height setting them. */
  .lead figure :global(picture) {
    position: relative;
    min-height: 18rem;
  }
  .lead figure :global(img) {
    position: absolute;
    inset: 0;
    height: 100%;
  }
  figure :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }
  .lead figure {
    grid-template-rows: 1fr auto;
  }
  .lead figure :global(img) {
    aspect-ratio: auto;
    object-fit: cover;
    min-height: 16rem;
  }
  figcaption {
    display: grid;
    gap: 0.1rem;
    font-size: var(--dx-s-1);
    color: var(--dx-ink-2);
    border-block-start: 1px solid var(--dx-rule-strong);
    padding-block-start: 0.5rem;
  }
  figcaption strong {
    font-size: 1rem;
    color: var(--dx-ink);
  }
  .credit {
    font-style: italic;
  }
  .more {
    margin-block-start: 1.75rem;
  }
  .more a {
    font-weight: 600;
    color: var(--dx-blue);
    display: inline-block;
    padding-block: 0.5rem;
  }
</style>
