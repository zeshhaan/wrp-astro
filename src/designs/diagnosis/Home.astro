---
/**
 * Diagnosis: start from what is wrong with the car, not from a service list.
 * The hero is the tool (an inspection job card that writes itself); proof,
 * work, the full service list, the lounge and the visit details follow.
 */
import DesignShell from '../shared/DesignShell.astro';
import Header from './Header.astro';
import Tool from './Tool.astro';
import Proof from './Proof.astro';
import Work from './Work.astro';
import Services from './Services.astro';
import Lounge from './Lounge.astro';
import Visit from './Visit.astro';
import Footer from './Footer.astro';
---

<DesignShell
  concept="diagnosis"
  title="WRP Detailing, Dubai: tell us what’s wrong with the car"
  description="Stone chips, swirls, faded paint, stains, a hot cabin? Tick what’s wrong and see the fix: PPF, paint correction, ceramic coating, detailing, window film or upholstery, with starting prices. Al Qusais, Dubai."
  fonts={['--font-fraunces', '--font-archivo', '--font-montserrat']}
  themeColor="#eef0f3"
>
  <Header />
  <main id="main" tabindex="-1">
    <Tool />
    <div class="band">
      <Proof />
    </div>
    <Work />
    <div class="band">
      <Services />
    </div>
    <Lounge />
    <Visit />
  </main>
  <Footer />
</DesignShell>

<style is:global>
  :root[data-concept='diagnosis'] {
    /* Inspection-report paper and ink */
    --dx-paper: #eef0f3; /* cool report paper, the page */
    --dx-sheet: #fbfcfd; /* the job card sheet */
    --dx-sheet-2: #e4e8ee; /* cabin floor on the drawing */
    --dx-ink: #15181d;
    --dx-ink-2: #4b525d; /* secondary text, 7:1 on paper */
    --dx-ink-3: #8a919c; /* drawing lines only, never text */
    --dx-rule: #d3d8df;
    --dx-rule-strong: #a9b0ba;
    --dx-glass: #dde6ef;
    /* Instrument blue: interaction, requests, work order */
    --dx-blue: #1f45c4;
    --dx-blue-wash: #d6def8;
    --dx-blue-tint: #eef2fd;
    --dx-blue-on-ink: #8fa9ff;
    /* Defect orange: only ever marks a problem */
    --dx-defect: #f0561d;
    --dx-defect-ink: #c2410c;
    --dx-defect-wash: #fcdccd;
    --dx-defect-tint: #fff3ec;
    /* Fixed green */
    --dx-fixed: #1c6b47;
    --dx-fixed-wash: #cfe6d9;
    --dx-on-ink: #f1f3f6;
    --dx-on-ink-2: #b4bbc6;

    --dx-display: var(--font-fraunces), 'Fraunces', Georgia, serif;
    --dx-ui: var(--font-archivo), 'Archivo', system-ui, sans-serif;
    --dx-mark: var(--font-montserrat), 'Montserrat', system-ui, sans-serif;

    /* Type scale (1.25, fluid at the top) */
    --dx-s-1: 0.875rem;
    --dx-s1: 1.125rem;
    --dx-s2: 1.4rem;
    --dx-s3: clamp(1.75rem, 1.4rem + 1.4vw, 2.35rem);
    --dx-s4: clamp(2.25rem, 1.6rem + 2.8vw, 3.6rem);
    --dx-s5: clamp(2.9rem, 1.6rem + 5.4vw, 6rem);

    --dx-hh: 3.75rem;
    --dx-gutter: 1rem;
    --dx-max: 80rem;
    --dx-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --dx-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    color-scheme: light;
    scroll-padding-top: calc(var(--dx-hh) + 0.5rem);
  }
  @media (min-width: 40rem) {
    :root[data-concept='diagnosis'] {
      --dx-gutter: 2rem;
      --dx-hh: 4rem;
    }
  }
  :root[data-concept='diagnosis'] body {
    background: var(--dx-paper);
    color: var(--dx-ink);
    font-family: var(--dx-ui);
    font-size: 1rem;
    line-height: 1.55;
    accent-color: var(--dx-ink);
  }
  :where(:root[data-concept='diagnosis'] a) {
    color: inherit;
  }
  :where(:root[data-concept='diagnosis']) :is(a, button, input, select, summary):focus-visible {
    outline: 3px solid var(--dx-blue);
    outline-offset: 3px;
  }
  :root[data-concept='diagnosis'] ::selection {
    background: var(--dx-blue-wash);
    color: var(--dx-ink);
  }
  :root[data-concept='diagnosis'] main:focus {
    outline: none;
  }

  /* Buttons: flat, squared, a job-card stamp more than a pill. */
  :root[data-concept='diagnosis'] .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.7rem 1.25rem;
    border-radius: 3px;
    border: 1.5px solid transparent;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 160ms var(--dx-ease), color 160ms var(--dx-ease);
  }
  :root[data-concept='diagnosis'] .btn--ink {
    background: var(--dx-ink);
    color: var(--dx-sheet);
  }
  :root[data-concept='diagnosis'] .btn--ink:hover {
    background: var(--dx-blue);
  }
  :root[data-concept='diagnosis'] .btn--light {
    background: var(--dx-sheet);
    color: var(--dx-ink);
  }
  :root[data-concept='diagnosis'] .btn--light:hover {
    background: #fff;
  }
  :root[data-concept='diagnosis'] .btn--line {
    border-color: currentColor;
  }
  :root[data-concept='diagnosis'] .btn--line:hover {
    background: rgb(255 255 255 / 0.08);
  }
  :root[data-concept='diagnosis'] .head__cta {
    min-height: 2.75rem;
    padding-block: 0.5rem;
    font-size: 0.9375rem;
  }
</style>

<style>
  .band {
    background: var(--dx-sheet);
    border-block: 1px solid var(--dx-rule);
  }
</style>
