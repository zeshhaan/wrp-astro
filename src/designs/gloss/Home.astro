---
/**
 * Gloss: light moving across paint.
 * The page is painted in colours sampled from cars WRP has finished; it shifts
 * colour as you scroll, and a specular highlight moves across the giant wordmark.
 */
import DesignShell from '../shared/DesignShell.astro';
import Picture from '../shared/Picture.astro';
import Chips from './Chips.astro';
import Lounge from './Lounge.astro';
import Work from './Work.astro';
import { contact, whatsappLink, proof, pickQuotes, nav, pages, studio, services, paintColours as P } from '../data';
import { stage, stages, paintCss } from './paint';

const quotes = pickQuotes(4);
const serviceName = (slug?: string) => {
  const s = services.find((x) => x.slug === slug);
  return s ? s.name.toLowerCase() : '';
};
const wa = whatsappLink('Hi WRP, I would like a quote for my car.');
const heroChips = [
  { c: P.lotusBurgundy, n: 'Lotus Exige burgundy' },
  { c: P.subaruBlue, n: 'Subaru WRX STI blue' },
  { c: P.porscheGreen, n: 'Porsche 911 green' },
  { c: P.boxsterGrey, n: 'Porsche Boxster grey' },
  { c: P.lexusBlack, n: 'Lexus LX black' },
];
const year = new Date().getFullYear();
const footerLinks = [
  { label: 'Portfolio', href: pages.portfolio },
  { label: 'Reviews', href: pages.reviews },
  { label: 'Blog', href: pages.blog },
  { label: 'About WRP', href: pages.about },
  { label: 'Contact', href: pages.contact },
  { label: 'Privacy', href: pages.privacy },
  { label: 'Terms', href: pages.terms },
];
---

<DesignShell
  concept="gloss"
  title="WRP Detailing: paint protection film, ceramic coating and detailing in Dubai"
  description="Paint protection film, ceramic coating, window film and detailing in Al Qusais, Dubai. Wait upstairs in the WRP Lounge while we work. Rated 5.0 on Google."
  fonts={['--font-syne', '--font-inter', '--font-montserrat']}
  themeColor={P.lotusBurgundy}
>
  <style is:global>
    body { background: #5e1622; }
  </style>
  <style is:inline set:html={paintCss()}></style>

  <div class="gloss-page" data-gloss>
    <a class="skip" href="#main">Skip to content</a>

    <header class="bar">
      <a class="logo" href="#top" aria-label="WRP, back to top">WRP.</a>
      <nav class="bar-nav" aria-label="Page sections">
        <ul role="list">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn-solid bar-cta" href={wa}>
        <span class="long">Message us on WhatsApp</span><span class="short">WhatsApp us</span>
      </a>
    </header>

    <main id="main">
      <section class="hero" id="top" data-hero {...stage('hero')} aria-labelledby="hero-title">
        <div class="hero-inner">
          <div class="hero-copy">
            <h1 id="hero-title">Paint protection film, ceramic coating and detailing in Dubai</h1>
            <p class="lede">
              We wrap, reinforce and protect cars from our studio in Al Qusais. You can wait upstairs in the lounge
              while we work.
            </p>
            <div class="actions">
              <a class="btn btn-solid" href={wa}>Message us on WhatsApp</a>
              <a class="btn btn-line" href="#services">See services and prices</a>
            </div>
          </div>
          <div class="hero-note">
            <a class="rating" href={proof.reviewsUrl}>
              <strong>{proof.rating}</strong>
              <span>on Google, from {proof.reviewCountDisplay} reviews</span>
            </a>
            <div class="fan-note">
              <ul class="fan" role="list" aria-label="Paint colours used on this page">
                {
                  heroChips.map((c, i) => (
                    <li style={`--c:${c.c};--i:${i - 2}`}>
                      <span class="visually-hidden">{c.n}</span>
                    </li>
                  ))
                }
              </ul>
              <p>
                This page is painted in colours taken from cars we have finished. Scroll, and it changes paint
                with them.
              </p>
            </div>
          </div>
        </div>
        <p class="mark" aria-hidden="true">WRP.</p>
      </section>

      <Chips />
      <Lounge />
      <Work />

      <section class="reviews" id="reviews" {...stage('reviews')} aria-labelledby="reviews-title">
        <div class="wrap reviews-grid">
          <div class="score">
            <h2 id="reviews-title">
              <span class="score-num">{proof.rating}</span>
              <span class="score-line">on Google, from {proof.reviewCountDisplay} reviews</span>
            </h2>
            <p>Every review below is copied word for word from Google.</p>
            <a class="btn btn-line" href={proof.reviewsUrl}>Read all the reviews</a>
          </div>
          <ul class="quotes" role="list">
            {
              quotes.map((q) => (
                <li>
                  <figure>
                    <blockquote>
                      <p>“{q.text}”</p>
                    </blockquote>
                    <figcaption>{q.author.trim()}{serviceName(q.service) && `, on ${serviceName(q.service)}`}</figcaption>
                  </figure>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <div class="finish" {...stage('visit')}>
        <section class="films wrap" aria-labelledby="films-title">
          <div class="films-copy">
            <h2 id="films-title">Films we fit</h2>
            <p>
              Paint protection and window films from Avery Dennison and STEK, cut and fitted in our studio. Paint
              protection film comes with up to a 10-year warranty.
            </p>
          </div>
          <ul class="logos" role="list">
            {
              proof.films.map((f) => (
                <li>
                  <img src={f.logo} alt={f.name} width="260" height="85" loading="lazy" decoding="async" />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="visit wrap" id="visit" aria-labelledby="visit-title">
          <div class="visit-copy">
            <h2 id="visit-title">Visit the studio</h2>
            <p class="status" data-open-status hidden></p>
            <dl class="facts">
              <div>
                <dt>Address</dt>
                <dd>
                  {contact.address[0]}<br />{contact.address[1]}<br />
                  <a href={contact.mapsUrl} rel="noopener">Open in Google Maps</a>
                </dd>
              </div>
              <div>
                <dt>Hours</dt>
                <dd>{contact.hours}<br />{contact.closed}</dd>
              </div>
              <div>
                <dt>Phone</dt>
                <dd><a href={contact.phoneHref}>{contact.phoneDisplay}</a></dd>
              </div>
              <div>
                <dt>WhatsApp</dt>
                <dd><a href={wa}>{contact.phoneDisplay}</a></dd>
              </div>
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
              </div>
              <div>
                <dt>Instagram</dt>
                <dd><a href={contact.instagram} rel="noopener">{contact.instagramHandle}</a></dd>
              </div>
            </dl>
            <div class="actions">
              <a class="btn btn-solid" href={wa}>Message us on WhatsApp</a>
              <a class="btn btn-line" href={contact.phoneHref}>Call {contact.phoneDisplay}</a>
            </div>
          </div>
          <figure class="night">
            <Picture
              base={studio.night.base}
              alt={studio.night.alt}
              sizes="(min-width: 60rem) 45vw, 100vw"
              imgClass="night-img"
            />
            <figcaption>Look for the lit sign after dark. Photo by customer Mark Ban.</figcaption>
          </figure>
        </section>
      </div>
    </main>

    <footer class="foot" data-foot>
      <div class="wrap foot-grid">
        <div>
          <p class="foot-logo">WRP.</p>
          <p class="foot-tag">Wrap, reinforce, protect. Detailing studio in Al Qusais, Dubai.</p>
        </div>
        <nav aria-label="Site">
          <ul role="list" class="foot-links">
            {footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            <li><a href={pages.arabic} lang="ar" dir="rtl" hreflang="ar">العربية</a></li>
          </ul>
        </nav>
        <p class="foot-small">
          © {year} WRP Detailing Solutions. Paint colours on this page are sampled from photos of cars we have worked
          on.
        </p>
      </div>
    </footer>

    <p class="readout" aria-hidden="true">
      <span class="readout-chip"></span>
      <span>Paint: <span data-readout>{stages[0]!.name}</span></span>
    </p>
  </div>
</DesignShell>

<style>
  @property --paint {
    syntax: '<color>';
    inherits: true;
    initial-value: #5e1622;
  }
  @property --sheen {
    syntax: '<number>';
    inherits: true;
    initial-value: 0.3;
  }

  /* ---------- Page paint ---------- */
  .gloss-page {
    --paint: #5e1622;
    --display: var(--font-syne), 'Arial Black', system-ui, sans-serif;
    --text: var(--font-inter), system-ui, sans-serif;
    --wordmark: var(--font-montserrat), 'Arial Black', system-ui, sans-serif;
    --gutter: clamp(1rem, 0.4rem + 3vw, 3rem);
    --max: 88rem;
    --step--1: 0.875rem;
    --step-0: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    --step-1: clamp(1.125rem, 1.05rem + 0.4vw, 1.375rem);
    --step-2: clamp(1.375rem, 1.15rem + 1vw, 1.875rem);
    --step-3: clamp(2rem, 1.35rem + 2.8vw, 3.5rem);
    --step-4: clamp(2.5rem, 1.4rem + 4.8vw, 5.5rem);
    --step-h2: clamp(2.1rem, 1.3rem + 3vw, 4rem);
    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    background-color: var(--paint);
    font-family: var(--text);
    font-size: var(--step-0);
    line-height: 1.6;
  }

  /* Text colour always follows the paint underneath it (black or white, whichever reads). */
  .gloss-page,
  .gloss-page :global([data-stage]) {
    --ink: oklch(from var(--paint) clamp(0, (0.623 - l) * 1000, 1) 0 h);
    --ink-soft: color-mix(in oklab, var(--ink) 86%, var(--paint));
    --line: color-mix(in oklab, var(--ink) 28%, transparent);
    color: var(--ink);
  }
  @supports (color: contrast-color(red)) {
    .gloss-page,
    .gloss-page :global([data-stage]) {
      --ink: contrast-color(var(--paint));
    }
  }

  /* Static mode: each stage paints itself. */
  .gloss-page :global([data-stage]) {
    --paint: var(--own);
    background-color: var(--paint);
    position: relative;
  }
  /* Live modes: stages go clear so the page's animated paint shows through. */
  .gloss-page:global(.paint-js) :global([data-stage]) {
    --paint: inherit;
    background-color: transparent;
  }
  .gloss-page:global(.paint-js) {
    transition: --paint 0.9s cubic-bezier(0.3, 0.6, 0.2, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .gloss-page :global([data-stage]) {
        --paint: inherit;
        background-color: transparent;
      }
    }
  }

  /* Clear coat: a faint studio-light reflection at the top and shade at the bottom of the viewport. */
  .gloss-page::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.07),
      rgb(255 255 255 / 0) 30%,
      rgb(0 0 0 / 0) 70%,
      rgb(0 0 0 / 0.07)
    );
  }

  .gloss-page :global(.wrap) {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
  }

  .skip {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    z-index: 50;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: var(--paint);
    font-weight: 600;
  }
  .skip:focus {
    top: 0.75rem;
  }

  .gloss-page :global(a) {
    color: inherit;
  }
  .gloss-page :global(:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .gloss-page :global(h1),
  .gloss-page :global(h2) {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* ---------- Buttons ---------- */
  .gloss-page :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1.35rem;
    border-radius: 3px;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
  }
  /* Solid buttons invert the paint; a band of light crosses them on hover. */
  .gloss-page :global(.btn-solid) {
    background: linear-gradient(
        100deg,
        transparent 42%,
        color-mix(in oklab, var(--paint) 28%, transparent) 50%,
        transparent 58%
      )
      no-repeat var(--ink);
    background-size: 300% 100%;
    background-position: 100% 0;
    color: var(--paint);
  }
  .gloss-page :global(.btn-solid:hover) {
    background-position: 0% 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gloss-page :global(.btn-solid) {
      transition: background-position 0.8s cubic-bezier(0.3, 0.6, 0.2, 1);
    }
  }
  .gloss-page :global(.btn-line) {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .gloss-page :global(.btn-line:hover) {
    background: color-mix(in oklab, var(--ink) 10%, transparent);
  }

  /* ---------- Header ---------- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding: 0.6rem var(--gutter);
    background: color-mix(in oklab, var(--paint) 90%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
  }
  .logo {
    font-family: var(--wordmark);
    font-style: italic;
    font-weight: 900;
    font-size: 1.75rem;
    letter-spacing: -0.03em;
    line-height: 1;
    text-decoration: none;
    padding: 0.4rem 0.2rem;
  }
  .bar-nav ul {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
  }
  .bar-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.8rem;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 3px;
  }
  .bar-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1.5px;
  }
  .bar-cta {
    min-height: 2.75rem;
    padding-block: 0.5rem;
    font-size: 0.95rem;
  }
  .bar-cta .short {
    display: none;
  }
  @media (max-width: 60rem) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-bottom: 0;
    }
    .bar-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-inline: calc(-1 * var(--gutter));
      overflow-x: auto;
      scrollbar-width: none;
    }
    .bar-nav ul {
      justify-content: space-between;
      gap: 0;
      padding-inline: calc(var(--gutter) - 0.55rem);
    }
    .bar-nav a {
      padding-inline: 0.55rem;
    }
    .bar-cta .long {
      display: none;
    }
    .bar-cta .short {
      display: inline;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    --band: calc(var(--sheen) * 130% - 15%);
    overflow: clip;
    min-height: calc(100svh - 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
  }
  /* Soft reflection of a studio light on the panel. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 38% 90% at calc(var(--sheen) * 100%) -20%,
      rgb(255 255 255 / 0.13),
      rgb(255 255 255 / 0) 70%
    );
  }
  .hero-inner {
    position: relative;
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    padding-block: clamp(2rem, 1rem + 5vh, 5rem) 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 7rem);
    align-items: start;
  }
  h1 {
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.02;
    max-width: 17ch;
  }
  .lede {
    margin-top: 1.25rem;
    max-width: 38ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero-note {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding-top: 0.5rem;
  }
  .rating {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    min-height: 2.75rem;
  }
  .rating strong {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 1;
  }
  .rating span {
    max-width: 11ch;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .fan-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: end;
    max-width: 30rem;
  }
  .fan-note p {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 34ch;
  }
  /* A tiny fan deck of the five car paints. */
  .fan {
    position: relative;
    width: 4.5rem;
    height: 5.25rem;
  }
  .fan li {
    position: absolute;
    left: 1.5rem;
    bottom: 0;
    width: 1.5rem;
    height: 5rem;
    border-radius: 2px;
    background: var(--c);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.55),
      0 4px 10px rgb(0 0 0 / 0.25);
    transform-origin: 50% 88%;
    rotate: calc(var(--i) * 13deg);
  }
  .fan li::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.45rem;
    width: 0.3rem;
    height: 0.3rem;
    margin-left: -0.15rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.8);
  }

  /* The giant wordmark, lit by a moving softbox. */
  .mark {
    position: relative;
    align-self: end;
    margin-bottom: -0.16em;
    padding-inline: calc(var(--gutter) * 0.5);
    font-family: var(--wordmark);
    font-style: italic;
    font-weight: 900;
    font-size: clamp(7rem, 33vw, 36rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
    user-select: none;
    color: transparent;
    background-image:
      linear-gradient(
        104deg,
        rgb(255 255 255 / 0) calc(var(--band) - 18%),
        rgb(255 255 255 / 0.35) calc(var(--band) - 5%),
        rgb(255 255 255 / 0.92) var(--band),
        rgb(255 255 255 / 0.35) calc(var(--band) + 2.5%),
        rgb(255 255 255 / 0) calc(var(--band) + 9%)
      ),
      linear-gradient(
        104deg,
        rgb(255 255 255 / 0) calc(var(--band) + 13%),
        rgb(255 255 255 / 0.55) calc(var(--band) + 14.2%),
        rgb(255 255 255 / 0) calc(var(--band) + 15.6%)
      ),
      linear-gradient(
        180deg,
        oklch(from var(--paint) calc(l + 0.15) calc(c * 1.1) h) 0%,
        oklch(from var(--paint) calc(l + 0.06) c h) 45%,
        oklch(from var(--paint) calc(l - 0.03) c h) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 -1px 0 rgb(255 255 255 / 0.18)) drop-shadow(0 18px 30px rgb(0 0 0 / 0.25));
  }
  @media (prefers-reduced-motion: no-preference) {
    @media (pointer: fine) {
      .hero {
        animation: sheen-in 1.8s cubic-bezier(0.25, 0.7, 0.2, 1) 0.25s backwards;
      }
    }
    @media (pointer: coarse) {
      @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
        .hero {
          animation: sheen-scroll linear both;
          animation-timeline: scroll(root);
          animation-range: 0 85vh;
        }
      }
    }
  }
  @keyframes sheen-in {
    from {
      --sheen: -0.25;
    }
  }
  @keyframes sheen-scroll {
    from {
      --sheen: 0.12;
    }
    to {
      --sheen: 1.1;
    }
  }

  @media (max-width: 60rem) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-top: 0.5rem;
      padding-bottom: 3rem;
    }
    .hero {
      min-height: auto;
      grid-template-rows: auto 1fr;
    }
    /* On phones the lit wordmark leads, so the light is the first thing you see. */
    .mark {
      grid-row: 1;
      align-self: start;
      margin: 0.5rem 0 0;
      font-size: clamp(6rem, 33vw, 20rem);
      line-height: 0.95;
      padding-inline: calc(var(--gutter) * 0.6);
    }
  }

  /* ---------- Reviews ---------- */
  .reviews {
    padding-block: clamp(4rem, 3rem + 6vw, 9rem);
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 3rem clamp(2rem, 6vw, 7rem);
    align-items: start;
  }
  .score {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .score-num {
    display: block;
    font-weight: 800;
    font-size: clamp(6rem, 3rem + 12vw, 13rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .score-line {
    display: block;
    margin-top: 0.75rem;
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.15;
    max-width: 14ch;
  }
  .score p {
    color: var(--ink-soft);
    max-width: 32ch;
  }
  .quotes {
    display: grid;
    gap: 2.5rem;
  }
  .quotes li + li {
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .quotes blockquote p {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.2;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }
  .quotes li:first-child blockquote p {
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 1.05;
    max-width: 22ch;
  }
  .quotes figcaption {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  @media (max-width: 60rem) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Films + visit ---------- */
  .finish {
    padding-block: clamp(4rem, 3rem + 5vw, 8rem) clamp(4rem, 3rem + 4vw, 7rem);
  }
  .films {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem 4rem;
    align-items: center;
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    border-bottom: 1px solid var(--line);
  }
  .films h2,
  .visit h2 {
    font-size: var(--step-3);
  }
  .films p {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--ink-soft);
  }
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem 3rem;
  }
  .logos img {
    height: 3.25rem;
    width: auto;
    mix-blend-mode: multiply;
  }
  .visit {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
    align-items: start;
  }
  .status {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }
  .status::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: currentColor;
  }
  .status[data-state='open']::before {
    background: #1d7a3e;
    box-shadow: 0 0 0 3px rgb(29 122 62 / 0.18);
  }
  .facts {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 2rem;
  }
  .facts dt {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .facts dd {
    margin-top: 0.3rem;
    overflow-wrap: anywhere;
  }
  .facts a {
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    display: inline-block;
    padding-block: 0.35rem;
  }
  .visit .actions {
    margin-top: 2.25rem;
  }
  .night {
    margin: 0;
  }
  .night :global(.night-img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 3px;
  }
  .night figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  @media (max-width: 60rem) {
    .films,
    .visit {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 30rem) {
    .facts {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Footer (always Lexus black) ---------- */
  .foot {
    --paint: #0a0a0a;
    --ink: #fff;
    --ink-soft: #d9d9d9;
    position: relative;
    background: var(--paint);
    color: var(--ink);
    padding-block: 3.5rem 6rem;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 2rem 4rem;
  }
  .foot-logo {
    font-family: var(--wordmark);
    font-style: italic;
    font-weight: 900;
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .foot-tag {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    max-width: 30ch;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
  }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.6rem;
    text-decoration: none;
  }
  .foot-links a:hover {
    text-decoration: underline;
  }
  .foot-small {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  @media (max-width: 45rem) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Paint readout ---------- */
  .readout {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 15;
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.9rem 0.45rem 0.45rem;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paint);
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.18);
  }
  .readout:global(.is-away) {
    opacity: 0;
    visibility: hidden;
  }
  .readout {
    transition: opacity 0.3s, visibility 0.3s;
  }
  .readout-chip {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 2px;
    background: var(--paint);
  }
  @media (min-width: 64rem) {
    .readout {
      display: inline-flex;
    }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('[data-gloss]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nativeScroll = CSS.supports('(animation-timeline: view()) and (animation-range: entry)');

  if (page) {
    const stages = [...page.querySelectorAll<HTMLElement>('[data-stage]')];
    const readout = page.querySelector<HTMLElement>('[data-readout]');
    // Firefox and older Safari: drive the paint with an observer instead of a scroll timeline.
    const liveCss = nativeScroll && !reduce;
    const jsPaint = !nativeScroll && !reduce;
    if (jsPaint) page.classList.add('paint-js');

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          if (readout) readout.textContent = el.dataset.paintName ?? '';
          // Native mode animates --paint in CSS; otherwise the observer sets it (the header and readout follow).
          if (!liveCss && el.dataset.paint) page.style.setProperty('--paint', el.dataset.paint);
        }
      },
      // A thin line across the middle of the viewport decides which paint is "on".
      { rootMargin: '-50% 0px -50% 0px' }
    );
    stages.forEach((s) => io.observe(s));

    // Tuck the paint readout away once the footer (always black) comes into view.
    const foot = page.querySelector('[data-foot]');
    const readoutBox = readout?.closest<HTMLElement>('.readout');
    if (foot && readoutBox) {
      new IntersectionObserver(([e]) => readoutBox.classList.toggle('is-away', !!e?.isIntersecting)).observe(foot);
    }

    // Specular highlight follows the pointer across the hero (mouse and pen only).
    const hero = page.querySelector<HTMLElement>('[data-hero]');
    if (hero && !reduce && matchMedia('(pointer: fine)').matches) {
      let target = 0.3;
      let current = 0.3;
      let raf = 0;
      const tick = () => {
        current += (target - current) * 0.1;
        hero.style.setProperty('--sheen', current.toFixed(4));
        raf = Math.abs(target - current) > 0.001 ? requestAnimationFrame(tick) : 0;
      };
      const kick = () => {
        if (!raf) raf = requestAnimationFrame(tick);
      };
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        target = (e.clientX - r.left) / r.width;
        kick();
      });
      hero.addEventListener('pointerleave', () => {
        target = 0.3;
        kick();
      });
    }
  }

  // Open / closed right now, in Dubai time.
  const status = document.querySelector<HTMLElement>('[data-open-status]');
  if (status) {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Dubai',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const day = get('weekday');
    const mins = Number(get('hour')) * 60 + Number(get('minute'));
    const isFriday = day === 'Fri';
    const open = !isFriday && mins >= 9 * 60 && mins < 21 * 60 + 30;
    let text: string;
    if (open) text = 'Open now, until 9:30 PM';
    else if (isFriday) text = 'Closed today. Open tomorrow from 9 AM';
    else if (mins < 9 * 60) text = 'Closed now. Opens today at 9 AM';
    else text = day === 'Thu' ? 'Closed now. Opens Saturday at 9 AM' : 'Closed now. Opens tomorrow at 9 AM';
    status.textContent = text;
    status.dataset.state = open ? 'open' : 'closed';
    status.hidden = false;
  }
</script>
