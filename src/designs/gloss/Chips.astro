---
/**
 * Services as a paint fan deck: one chip per service, each painted in the colour
 * of a car that had that service at WRP (or the film / leather itself).
 */
import { services, paintColours as P } from '../data';
import { stage, smoke, saddle } from './paint';

const chipColour: Record<string, { c: string; label: string }> = {
  'paint-protection-film': { c: P.boxsterGrey, label: 'Porsche Boxster grey, full PPF' },
  'ceramic-coating': { c: P.porscheGreen, label: 'Porsche 911 green, ceramic coated' },
  'window-film': { c: smoke, label: 'Tint film smoke' },
  polish: { c: P.lotusBurgundy, label: 'Lotus Exige burgundy, corrected' },
  'premium-car-wash': { c: P.subaruBlue, label: 'Subaru WRX STI blue, hand washed' },
  'leather-upholstery': { c: saddle, label: 'Saddle leather' },
};
const price = (n: number | null) => (n === null ? 'Priced after inspection' : `From AED ${n.toLocaleString('en-US')}`);
---

<section class="services" id="services" {...stage('services')} aria-labelledby="services-title">
  <div class="wrap head">
    <h2 id="services-title">Six ways we look after your car</h2>
    <p>
      Pick a chip for the full details. Prices are where each service starts; polishing and upholstery are priced
      once we have seen the car.
    </p>
  </div>

  <div class="deck-frame">
    <ul class="deck" role="list" data-deck>
      <li class="edge edge-l" aria-hidden="true"></li>
      {
        services.map((s) => {
          const chip = chipColour[s.slug] ?? { c: P.lexusBlack, label: '' };
          return (
            <li class="slot" id={`chip-${s.slug}`} style={`--chip:${chip.c}`}>
              <article class="chip">
                <div class="face">
                  <h3>
                    <a href={s.href}>{s.name}</a>
                  </h3>
                  <p class="line">{s.line}</p>
                  <p class="price">{price(s.from)}</p>
                  <p class="time">Takes {s.time}</p>
                </div>
                <p class="label">
                  <span class="rivet" aria-hidden="true" />
                  <span>
                    <span class="visually-hidden">Chip colour: </span>
                    {chip.label}
                  </span>
                </p>
              </article>
            </li>
          );
        })
      }
      <li class="edge edge-r" aria-hidden="true"></li>
    </ul>
  </div>

  <div class="wrap deck-nav" data-deck-nav>
    <p class="hint">Swipe for all six</p>
    <div class="dots">
      {
        services.map((s) => (
          <button
            type="button"
            class="dot"
            style={`--chip:${chipColour[s.slug]?.c}`}
            data-target={`chip-${s.slug}`}
            aria-label={`Show ${s.name}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  @property --chip-band {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 130%;
  }
  .services {
    padding-block: clamp(4rem, 3rem + 5vw, 8rem) clamp(3.5rem, 2.5rem + 4vw, 7rem);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.25rem 4rem;
    align-items: end;
  }
  .head h2 {
    font-size: var(--step-h2);
    max-width: 15ch;
  }
  .head p {
    max-width: 42ch;
    color: var(--ink-soft);
  }
  @media (max-width: 60rem) {
    .head {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- The deck ---------- */
  .deck-frame {
    width: min(100%, calc(var(--max) + 2 * var(--gutter)));
    margin-inline: auto;
  }
  .deck {
    --gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 2.5rem var(--gutter) 1.5rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--ink) 35%, transparent) transparent;
    container-type: scroll-state;
    container-name: deck;
  }
  .slot {
    flex: 1 0 clamp(15rem, 70vw, 17.5rem);
    min-width: 0;
    margin-inline-end: var(--gap);
    scroll-snap-align: start;
    container-type: scroll-state;
    container-name: slot;
    --focus: var(--ink);
  }
  .slot:last-of-type {
    margin-inline-end: 0;
  }
  @media (min-width: 80rem) {
    .slot {
      flex-basis: 0;
    }
  }

  /* Soft edges that only show when there is more deck to scroll to. */
  .edge {
    position: sticky;
    z-index: 2;
    flex: 0 0 0;
    width: 0;
    margin: -2.5rem 0 -1.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .edge::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3.5rem;
  }
  .edge-l {
    left: 0;
    margin-left: calc(-1 * var(--gutter));
    margin-right: var(--gutter);
  }
  .edge-l::after {
    left: 0;
    background: linear-gradient(to right, var(--paint), transparent);
  }
  .edge-r {
    right: 0;
    margin-left: var(--gutter);
    margin-right: calc(-1 * var(--gutter));
  }
  .edge-r::after {
    right: 0;
    background: linear-gradient(to left, var(--paint), transparent);
  }
  @container deck scroll-state(scrollable: left) {
    .edge-l {
      opacity: 1;
    }
  }
  @container deck scroll-state(scrollable: right) {
    .edge-r {
      opacity: 1;
    }
  }

  /* ---------- A chip ---------- */
  .chip {
    --paint: var(--chip);
    --ink: oklch(from var(--paint) clamp(0, (0.623 - l) * 1000, 1) 0 h);
    --ink-soft: color-mix(in oklab, var(--ink) 86%, var(--paint));
    --chip-band: 130%;
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    height: 100%;
    min-height: clamp(26rem, 24rem + 6vw, 30rem);
    border-radius: 4px;
    overflow: clip;
    color: var(--ink);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.06),
      0 12px 28px -14px rgb(0 0 0 / 0.45);
    transform-origin: 1.4rem calc(100% - 1.6rem);
  }
  @supports (color: contrast-color(red)) {
    .chip {
      --ink: contrast-color(var(--paint));
    }
  }
  .face {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem 1.25rem 1.5rem;
    background-color: var(--paint);
    /* Clear coat: a lighter top edge and a band of light parked off the chip. */
    background-image:
      linear-gradient(
        112deg,
        transparent calc(var(--chip-band) - 22%),
        rgb(255 255 255 / 0.28) calc(var(--chip-band) - 4%),
        rgb(255 255 255 / 0.5) var(--chip-band),
        transparent calc(var(--chip-band) + 7%)
      ),
      linear-gradient(180deg, rgb(255 255 255 / 0.12), transparent 35%, rgb(0 0 0 / 0.1));
  }
  .chip h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.4rem, 1.25rem + 0.5vw, 1.65rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .chip h3 a {
    text-decoration: none;
  }
  /* The whole chip is the link's hit area. */
  .chip h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .chip h3 a:focus-visible {
    outline: none;
  }
  .chip:has(h3 a:focus-visible) {
    outline: 3px solid var(--focus, #000);
    outline-offset: 4px;
  }
  .line {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .price {
    margin-top: auto;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.15;
  }
  .time {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-top: -0.4rem;
  }
  .label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3.25rem;
    padding: 0.6rem 1rem 0.6rem 0.95rem;
    background: #fbfbf9;
    color: #1b1b1b;
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .rivet {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: #d9dad6;
    box-shadow:
      inset 0 1px 2px rgb(0 0 0 / 0.45),
      0 1px 0 rgb(255 255 255 / 0.9);
  }

  /* Pull a chip out of the deck: it tips on its rivet and light crosses it. */
  @media (prefers-reduced-motion: no-preference) {
    .chip {
      transition:
        translate 0.45s cubic-bezier(0.3, 0.7, 0.2, 1),
        rotate 0.45s cubic-bezier(0.3, 0.7, 0.2, 1),
        box-shadow 0.45s,
        --chip-band 0.9s cubic-bezier(0.3, 0.6, 0.2, 1);
    }
    .slot:hover .chip,
    .chip:has(a:focus-visible) {
      translate: 0 -0.9rem;
      rotate: -2.5deg;
      --chip-band: -20%;
      box-shadow:
        0 1px 0 rgb(0 0 0 / 0.06),
        0 26px 40px -18px rgb(0 0 0 / 0.55);
    }
    /* On touch, the chip that snaps into place catches the light. */
    @media (hover: none) {
      @container slot scroll-state(snapped: x) {
        .chip {
          translate: 0 -0.6rem;
          --chip-band: 35%;
        }
      }
    }
  }

  /* ---------- Deck navigation (only when the deck scrolls) ---------- */
  .deck-nav {
    display: flex;
    flex-wrap: wrap-reverse;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    margin-top: 0.5rem;
  }
  .hint {
    white-space: nowrap;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .dots {
    display: flex;
    gap: 0;
    margin-inline: -0.5rem;
  }
  .dot {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .dot::before {
    content: '';
    width: 0.85rem;
    height: 1.6rem;
    border-radius: 2px;
    background: var(--chip);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--ink) 25%, transparent);
    transition: height 0.2s;
  }
  .dot[aria-current='true']::before {
    height: 2.2rem;
    box-shadow: 0 0 0 2px var(--ink);
  }
  @media (min-width: 80rem) {
    .deck-nav {
      display: none;
    }
    .deck {
      overflow-x: visible;
    }
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  const nav = document.querySelector<HTMLElement>('[data-deck-nav]');
  if (deck && nav) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dots = [...nav.querySelectorAll<HTMLButtonElement>('[data-target]')];
    dots.forEach((dot) =>
      dot.addEventListener('click', () => {
        const slot = document.getElementById(dot.dataset.target ?? '');
        if (!slot) return;
        deck.scrollTo({
          left: slot.offsetLeft - deck.offsetLeft - parseFloat(getComputedStyle(deck).scrollPaddingInlineStart || '0'),
          behavior: reduce ? 'auto' : 'smooth',
        });
      })
    );
    // Mark the chip nearest the start of the deck as current.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          dots.forEach((d) => d.setAttribute('aria-current', String(d.dataset.target === e.target.id)));
        }
      },
      { root: deck, rootMargin: '0px -60% 0px 0px', threshold: 0.3 }
    );
    deck.querySelectorAll('.slot').forEach((s) => io.observe(s));
  }
</script>
