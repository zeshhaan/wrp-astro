---
/**
 * Minimal document shell for Design Lab concepts.
 *
 * Deliberately does NOT import src/styles/global.css: each concept owns its
 * whole visual system in scoped styles, so the comparison is honest. Concepts
 * pass the font variables they need; only those are loaded.
 */
import { Font } from 'astro:assets';
import LabBar from './LabBar.astro';
import { getConcept } from '../registry';

type FontVar =
  | '--font-bricolage'
  | '--font-geist'
  | '--font-syne'
  | '--font-inter'
  | '--font-instrument-serif'
  | '--font-instrument-sans'
  | '--font-barlow-condensed'
  | '--font-barlow'
  | '--font-montserrat'
  | '--font-playfair';

interface Props {
  concept: string;
  title: string;
  description: string;
  fonts: FontVar[];
  /** Browser UI colour; match the concept's first screen. */
  themeColor: string;
  /** Hero image to preload for LCP, as a responsive base path. */
  preloadImage?: { base: string; sizes: string; widths?: number[] };
  colorScheme?: 'light' | 'dark' | 'light dark';
}

const { concept, title, description, fonts, themeColor, preloadImage, colorScheme = 'light' } = Astro.props;
const meta = getConcept(concept);
const widths = preloadImage?.widths ?? [480, 800, 1200];
---

<!doctype html>
<html lang="en" dir="ltr" data-concept={concept}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Design Lab pages are for internal review only. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content={colorScheme} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          fetchpriority="high"
          imagesrcset={widths.map((w) => `${preloadImage.base}-${w}w.avif ${w}w`).join(', ')}
          imagesizes={preloadImage.sizes}
        />
      )
    }
    {fonts.map((f, i) => <Font cssVariable={f} preload={i < 2} />)}
    <style is:global>
      /* Shared reset only. All look-and-feel lives in each concept. */
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
      body { margin: 0; min-height: 100dvh; -webkit-font-smoothing: antialiased; }
      img, picture, svg, video { display: block; max-width: 100%; }
      img { height: auto; }
      input, button, textarea, select { font: inherit; color: inherit; }
      h1, h2, h3, h4, p, figure, blockquote, ul, ol, dl, dd { margin: 0; }
      ul[role='list'], ol[role='list'] { list-style: none; padding: 0; }
      :where(h1, h2, h3) { text-wrap: balance; }
      :where(p, li, blockquote) { text-wrap: pretty; }
      :target { scroll-margin-block-start: 5rem; }
      .visually-hidden {
        clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; width: 1px;
        overflow: hidden; position: absolute; white-space: nowrap;
      }
      @media (prefers-reduced-motion: no-preference) {
        html { scroll-behavior: smooth; }
      }
      /* Cross-document view transitions between lab pages (progressive enhancement). */
      @view-transition { navigation: auto; }
    </style>
  </head>
  <body>
    <slot />
    {meta && <LabBar current={meta.id} />}
    <script>
      // Concept forms are mock-ups: never send real leads from a design preview.
      document.addEventListener('submit', (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-demo-form')) return;
        event.preventDefault();
        const status = form.querySelector<HTMLElement>('[data-demo-status]');
        if (status) {
          status.hidden = false;
          status.textContent =
            'Design preview: this form is not connected yet. It will post to the live enquiry API once a concept is chosen.';
        }
      });
    </script>
  </body>
</html>
