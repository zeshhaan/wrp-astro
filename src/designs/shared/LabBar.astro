---
/**
 * Floating bar on Design Lab pages so reviewers can hop between the Studio
 * pages in one Preview. Isolated styles (all under .wrp-lab) so it never
 * borrows the page's look.
 */
const links = [
  { href: '/design-lab/studio/', label: 'Home' },
  { href: '/design-lab/studio/quote/', label: 'Quote' },
  { href: '/design-lab/studio/quote/one-page/', label: 'One-page quote' },
  { href: '/design-lab/studio/headers/', label: 'Headers' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');

// On the header candidates, the bar switches between A, B and C and between
// English and Arabic instead.
const header = path.match(/^\/design-lab\/studio\/headers\/([abc])\/(ar\/)?$/);
const lang = header?.[2] ? 'ar/' : '';
const headerLinks = header
  ? [
      ...['a', 'b', 'c'].map((id) => ({ href: `/design-lab/studio/headers/${id}/${lang}`, label: `Header ${id.toUpperCase()}` })),
      { href: `/design-lab/studio/headers/${header[1]}/${lang ? '' : 'ar/'}`, label: lang ? 'English' : 'العربية' },
    ]
  : undefined;
---

<nav class:list={['wrp-lab', header?.[1] === 'b' && 'wrp-lab--lift']} aria-label="Design Lab pages" data-lab-bar>
  <a class="wrp-lab__home" href={header ? '/design-lab/studio/headers/' : '/design-lab/'}>{header ? 'Headers' : 'Design Lab'}</a>
  {(headerLinks ?? links).map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
  <button type="button" class="wrp-lab__hide" aria-label="Hide the Design Lab bar" data-lab-hide>×</button>
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-lab-bar]');
  try {
    if (sessionStorage.getItem('wrp-lab-hidden') === '1') bar?.setAttribute('hidden', '');
  } catch {}
  bar?.querySelector('[data-lab-hide]')?.addEventListener('click', () => {
    bar.setAttribute('hidden', '');
    try { sessionStorage.setItem('wrp-lab-hidden', '1'); } catch {}
  });
</script>

<style>
  .wrp-lab {
    position: fixed;
    inset-block-end: max(12px, env(safe-area-inset-bottom));
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgb(20 20 20 / 0.86);
    backdrop-filter: blur(10px);
    color: #fff;
    font: 500 12px/1 system-ui, -apple-system, 'Segoe UI', sans-serif;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
    white-space: nowrap;
  }
  .wrp-lab[hidden] { display: none; }
  /* Header B docks its navigation at the bottom of phones: sit above it. */
  @media (max-width: 63.99rem) {
    .wrp-lab--lift { inset-block-end: calc(5.25rem + env(safe-area-inset-bottom)); }
  }
  .wrp-lab a, .wrp-lab button {
    color: inherit;
    text-decoration: none;
    border: 0;
    background: none;
    border-radius: 999px;
    padding: 8px 10px;
    cursor: pointer;
    font: inherit;
  }
  .wrp-lab a:hover, .wrp-lab button:hover { background: rgb(255 255 255 / 0.12); }
  .wrp-lab a:focus-visible, .wrp-lab button:focus-visible { outline: 2px solid #fff; outline-offset: 1px; }
  .wrp-lab__home { opacity: 0.7; }
  .wrp-lab a[aria-current='page'] { background: rgb(255 255 255 / 0.16); }
  @media print { .wrp-lab { display: none; } }
</style>
