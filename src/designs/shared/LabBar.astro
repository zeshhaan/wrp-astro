---
/**
 * Floating switcher so reviewers can hop between concepts in one Preview.
 * Isolated styles (all under .wrp-lab) so it never borrows a concept's look.
 */
import { concepts } from '../registry';

interface Props { current: string }
const { current } = Astro.props;
const i = concepts.findIndex((c) => c.id === current);
const prev = concepts[(i - 1 + concepts.length) % concepts.length];
const next = concepts[(i + 1) % concepts.length];
---

<nav class="wrp-lab" aria-label="Design Lab concepts" data-lab-bar>
  <a class="wrp-lab__home" href="/design-lab/">Design Lab</a>
  <a class="wrp-lab__step" href={`/design-lab/${prev.id}/`} aria-label={`Previous concept: ${prev.name}`}>‹</a>
  <span class="wrp-lab__name">{i + 1}/{concepts.length} · {concepts[i].name}</span>
  <a class="wrp-lab__step" href={`/design-lab/${next.id}/`} aria-label={`Next concept: ${next.name}`}>›</a>
  <button type="button" class="wrp-lab__hide" aria-label="Hide the Design Lab bar" data-lab-hide>×</button>
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-lab-bar]');
  try {
    if (sessionStorage.getItem('wrp-lab-hidden') === '1') bar?.setAttribute('hidden', '');
  } catch {}
  bar?.querySelector('[data-lab-hide]')?.addEventListener('click', () => {
    bar.setAttribute('hidden', '');
    try { sessionStorage.setItem('wrp-lab-hidden', '1'); } catch {}
  });
</script>

<style>
  .wrp-lab {
    position: fixed;
    inset-block-end: max(12px, env(safe-area-inset-bottom));
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgb(20 20 20 / 0.86);
    backdrop-filter: blur(10px);
    color: #fff;
    font: 500 12px/1 system-ui, -apple-system, 'Segoe UI', sans-serif;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
    white-space: nowrap;
  }
  .wrp-lab[hidden] { display: none; }
  .wrp-lab a, .wrp-lab button {
    color: inherit;
    text-decoration: none;
    border: 0;
    background: none;
    border-radius: 999px;
    padding: 8px 10px;
    cursor: pointer;
    font: inherit;
  }
  .wrp-lab a:hover, .wrp-lab button:hover { background: rgb(255 255 255 / 0.12); }
  .wrp-lab a:focus-visible, .wrp-lab button:focus-visible { outline: 2px solid #fff; outline-offset: 1px; }
  .wrp-lab__home { opacity: 0.7; }
  .wrp-lab__step { font-size: 16px; padding-inline: 12px; }
  .wrp-lab__name { padding-inline: 4px; }
  @media print { .wrp-lab { display: none; } }
</style>
