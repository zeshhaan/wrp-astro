---
/**
 * Other surfaces, other cuts. Each specimen opens with its own cross-section
 * strip in its material's colours: glass with film on the inside face, leather
 * over foam with the stitch line, and the whole car as a strip of every surface.
 */
import Picture from '../shared/Picture.astro';
import Said from './Said.astro';
import { aed, ask, quotes, svc, washLevels } from './layers';

const tint = svc('window-film');
const trim = svc('leather-upholstery');
const wash = svc('premium-car-wash');
---

<section class="surfaces" id="surfaces" aria-labelledby="surfaces-title">
  <div class="ly-wrap">
    <header class="intro">
      <h2 class="ly-h2" id="surfaces-title">Other surfaces, other cuts.</h2>
      <p>
        Paint is only part of the car. We tint the glass, redo the seats and mats, and clean every surface, inside and
        out.
      </p>
    </header>

    <div class="pair">
      <!-- Glass -->
      <article class="spec spec--glass" aria-labelledby="glass-title">
        <div class="cut cut--glass" aria-hidden="true">
          <span class="c c--out ly-note">Outside</span>
          <span class="c c--pane"></span>
          <span class="c c--tint"></span>
          <span class="c c--in ly-note">Cabin</span>
        </div>
        <div class="spec__body">
          <h3 id="glass-title">Window film</h3>
          <p class="spec__line">
            Nano-ceramic film on the inside face of the glass. The cabin stays cooler in the Dubai sun, and your phone,
            GPS and key still work.
          </p>
          <dl class="readings">
            <div><dt>UV blocked</dt><dd>99%</dd></div>
            <div><dt>Heat rejected</dt><dd>up to 80%</dd></div>
            <div><dt>Phone signal</dt><dd>safe</dd></div>
          </dl>
          <dl class="terms">
            <div><dt>From</dt><dd>{aed(tint.from!)}</dd></div>
            <div><dt>Your car stays</dt><dd>{tint.time}</dd></div>
          </dl>
          <Said q={quotes.tint} />
          <div class="actions">
            <a class="ly-btn" href={ask('window tint')} target="_blank" rel="noopener">Ask for a tint quote</a>
            <a class="ly-link" href={tint.href}>Window film options</a>
          </div>
        </div>
      </article>

      <!-- Leather & fabric -->
      <article class="spec spec--hide" aria-labelledby="hide-title">
        <div class="cut cut--hide" aria-hidden="true">
          <span class="c c--leather"><span class="stitch"></span></span>
          <span class="c c--foam"></span>
          <span class="c c--frame"></span>
        </div>
        <div class="spec__body">
          <h3 id="hide-title">Seats, stitching and floor mats</h3>
          <p class="spec__line">
            Re-stitching, custom seat covers in genuine or synthetic leather, and floor mats made to measure. Choose
            from real samples in our materials room before we cut anything.
          </p>
          <figure class="samples">
            <Picture
              base="/review-images/venkat_k_3"
              alt="WRP materials room: rolls of film, a leather seat and floor mat samples on the shelves"
              sizes="(min-width: 56rem) 34rem, 100vw"
            />
            <figcaption>The materials room. Photo by customer Venkat K.</figcaption>
          </figure>
          <dl class="terms">
            <div><dt>Price</dt><dd>After we see the seats</dd></div>
            <div><dt>Your car stays</dt><dd>{trim.time}</dd></div>
          </dl>
          <Said q={quotes.stitching} />
          <Said q={quotes.mats} />
          <div class="actions">
            <a class="ly-btn" href={ask('seat stitching, seat covers or floor mats')} target="_blank" rel="noopener">
              Ask about my seats
            </a>
            <a class="ly-link" href={trim.href}>Upholstery details</a>
          </div>
        </div>
      </article>
    </div>

    <!-- The whole car -->
    <article class="spec spec--car" aria-labelledby="car-title">
      <div class="cut cut--car" aria-hidden="true">
        <span style="--c:var(--ly-green)"><i class="ly-note">paint</i></span>
        <span style="--c:#cfe3dc"><i class="ly-note">glass</i></span>
        <span style="--c:#8a5a3c"><i class="ly-note">leather</i></span>
        <span style="--c:#3a3f44"><i class="ly-note">wheels</i></span>
        <span style="--c:#9aa3aa"><i class="ly-note">engine</i></span>
        <span style="--c:#5b534a"><i class="ly-note">carpets</i></span>
      </div>
      <div class="car">
        <div class="car__copy">
          <h3 id="car-title">Detailing and premium wash: every surface at once</h3>
          <p class="spec__line">
            Hand wash only, with pH-neutral products and filtered rinse water, never a brush machine. Three levels,
            priced by the size of the car. Level 3, the full detail, is the one customers name in their reviews.
          </p>
          <div class="levels" role="region" aria-labelledby="levels-cap" tabindex="0">
            <table>
              <caption id="levels-cap" class="visually-hidden">Wash and detailing levels, prices in AED</caption>
              <thead>
                <tr><th scope="col">Level</th><th scope="col">Sedan</th><th scope="col">SUV</th><th scope="col">What it adds</th></tr>
              </thead>
              <tbody>
                {
                  washLevels.map((l) => (
                    <tr>
                      <th scope="row">{l.name}</th>
                      <td>{aed(l.sedan)}</td>
                      <td>{aed(l.suv)}</td>
                      <td>{l.adds}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="actions">
            <a class="ly-btn" href={ask('a detail / premium wash (which level do you recommend?)')} target="_blank" rel="noopener">
              Book a wash level
            </a>
            <a class="ly-link" href={wash.href}>Compare the three levels</a>
          </div>
        </div>
        <div class="car__side">
          <figure class="foam">
            <Picture
              base="/portfolio/team-washing-subaru-sti-foam"
              alt="Two WRP detailers hand-washing a blue Subaru WRX STI covered in foam"
              sizes="(min-width: 56rem) 28rem, 100vw"
              width={1200}
              height={1471}
            />
          </figure>
          <Said q={quotes.detail} />
          <Said q={quotes.level3} />
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .surfaces {
    background: var(--ly-day);
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .intro {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .intro p {
    font-size: 1.125rem;
    max-width: 50ch;
    color: var(--ly-ink-2);
  }
  .pair {
    display: grid;
    gap: 1.5rem;
  }
  .spec {
    background: var(--ly-paper);
    border-radius: 4px;
    overflow: hidden;
  }
  .spec__body {
    padding: 1.5rem;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .spec h3 {
    font-weight: 800;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .spec__line {
    font-size: 1.0625rem;
    max-width: 50ch;
  }

  /* ---------- The cross-section strips ---------- */
  .cut {
    display: grid;
  }
  .cut--glass {
    grid-template-rows: 1.9rem 3rem 0.55rem 1.9rem;
    background: linear-gradient(180deg, #f6f1df, var(--ly-paper));
  }
  .c--out,
  .c--in {
    display: flex;
    align-items: center;
    padding-inline: 1.5rem;
    font-size: 0.875rem;
    color: var(--ly-ink-2);
  }
  .c--out {
    background: radial-gradient(40% 180% at 90% 0%, rgb(241 196 108 / 0.55), transparent 70%);
  }
  .c--pane {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.8), transparent 12%, transparent 88%, rgb(255 255 255 / 0.5)),
      linear-gradient(100deg, transparent 40%, rgb(255 255 255 / 0.4) 48%, transparent 56%),
      #cfe3dc;
    box-shadow: inset 0 0 0 1px rgb(40 80 70 / 0.18);
  }
  .c--tint {
    background: #3b4148;
  }
  .c--in {
    background: #e7e9ea;
  }
  .readings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    border-block: 1px solid var(--ly-rule);
    padding-block: 1rem;
  }
  .readings dt {
    font-size: 0.8125rem;
    color: var(--ly-ink-2);
    order: 2;
  }
  .readings div {
    display: flex;
    flex-direction: column;
  }
  .readings dd {
    font-weight: 900;
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 1.875rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .cut--hide {
    grid-template-rows: 2.2rem 2.6rem 1.1rem;
  }
  .c--leather {
    position: relative;
    background:
      radial-gradient(circle at 30% 40%, rgb(255 255 255 / 0.08) 0 1px, transparent 1.6px) 0 0 / 5px 5px,
      linear-gradient(180deg, #9b6a49, #7b4e32);
  }
  .stitch {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 0;
    border-top: 2px dashed #f0dcc0;
  }
  .c--foam {
    background:
      radial-gradient(circle at 50% 50%, rgb(0 0 0 / 0.06) 0 2px, transparent 2.5px) 0 0 / 9px 9px,
      #eadfca;
  }
  .c--frame {
    background: #5a5550;
  }
  .samples {
    margin: 0;
  }
  .samples :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 3px;
  }
  .samples figcaption {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ly-ink-2);
  }
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
  }
  .terms dt {
    font-size: 0.875rem;
    color: var(--ly-ink-2);
  }
  .terms dd {
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .spec--glass :global(.ly-said) {
    color: #2d5a50;
  }
  .spec--hide :global(.ly-said) {
    color: #6d4329;
  }
  .spec :global(.ly-said footer) {
    color: var(--ly-ink-2);
  }

  /* ---------- The whole car ---------- */
  .spec--car {
    margin-top: 1.5rem;
  }
  .cut--car {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    height: 3.25rem;
  }
  .cut--car span {
    background: var(--c);
    display: flex;
    align-items: flex-end;
    padding: 0.3rem 0.5rem;
  }
  .cut--car i {
    font-size: 0.8125rem;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cut--car span:nth-child(2) i {
    color: var(--ly-ink);
  }
  .car {
    padding: 1.5rem;
    display: grid;
    gap: 2rem;
  }
  .car__copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .levels {
    overflow-x: auto;
  }
  .levels:focus-visible {
    outline: 3px solid var(--ly-film-ink);
    outline-offset: 2px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    min-width: 34rem;
  }
  th,
  td {
    text-align: start;
    vertical-align: top;
    padding: 0.75rem 0.75rem 0.75rem 0;
    border-bottom: 1px solid var(--ly-rule);
  }
  thead th {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ly-ink-2);
    padding-block: 0 0.5rem;
  }
  tbody th {
    font-weight: 800;
    white-space: nowrap;
  }
  tbody td:nth-child(2),
  tbody td:nth-child(3) {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  tbody tr:last-child th::after {
    content: 'the full detail';
    display: block;
    font-family: var(--ly-note);
    font-style: italic;
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--ly-ink-2);
  }
  .car__side {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .foam {
    margin: 0;
  }
  .foam :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 60%;
    border-radius: 3px;
  }
  .car__side :global(.ly-said) {
    color: var(--ly-green);
  }

  @media (min-width: 56rem) {
    .pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
    .spec__body,
    .car {
      padding: 2rem;
    }
    .car {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 3rem;
    }
  }
</style>
