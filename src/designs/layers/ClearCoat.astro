---
import Said from './Said.astro';
import { ask, depths, quotes, svc } from './layers';

const s = svc('polish');
const d = depths.clear;

// An illustrative surface profile: swirls and wash marks are valleys in the top of the clear coat.
const W = 640;
const surface = (() => {
  // [centre x, half width, depth]: irregular, like real marring seen in section.
  const valleys = [
    [34, 9, 5], [70, 14, 8], [104, 6, 4], [150, 18, 11], [196, 8, 5], [236, 12, 7], [262, 5, 3],
    [306, 20, 13], [350, 9, 6], [388, 7, 4], [430, 15, 9], [474, 6, 5], [512, 11, 7], [560, 17, 12],
    [598, 7, 4], [624, 9, 6],
  ];
  const d = ['M0 40'];
  for (const [x, w, depth] of valleys) {
    d.push(`L${x - w} 40`, `C${x - w * 0.4} 40 ${x - w * 0.35} ${40 + depth} ${x} ${40 + depth}`,
      `C${x + w * 0.35} ${40 + depth} ${x + w * 0.4} 40 ${x + w} 40`);
  }
  d.push(`L${W} 40`);
  return d.join(' ');
})();
---

<section
  class="layer clear"
  id="clear"
  aria-labelledby="clear-title"
  data-layer="clear"
  data-um-from={d.from}
  data-um-to={d.to}
  data-um-name="in the clear coat"
>
  <div class="edge" aria-hidden="true"></div>
  <div class="ly-wrap grid">
    <div class="copy">
      <p class="depth ly-note">{d.from} to {d.to} µm down</p>
      <h2 class="ly-h2" id="clear-title">Swirls live in the top few microns of the clear coat.</h2>
      <p class="line">
        Wash marks, holograms and light scratches are all valleys in the clear coat. Polishing and paint correction
        take a few microns off the top to level them out, and the gloss comes back. There are only 35 to 50 microns to
        work with and they don’t grow back, so we measure the paint depth with a gauge before we start.
      </p>
      <ul class="facts" role="list">
        {s.facts.map((f) => <li>{f}</li>)}
      </ul>
      <dl class="offer">
        <div><dt>Price</dt><dd>After we measure the paint</dd></div>
        <div><dt>Your car stays</dt><dd>{s.time}</dd></div>
      </dl>
      <p class="order ly-note">
        Correct first, protect second: film and ceramic seal in whatever is underneath them.
      </p>
      <div class="actions">
        <a class="ly-btn" href={ask('polish / paint correction')} target="_blank" rel="noopener">
          Ask about polishing my car
        </a>
        <a class="ly-link" href={s.href}>Correction levels and questions</a>
      </div>
    </div>

    <div class="side">
      <figure class="profile">
        <svg viewBox={`0 0 ${W} 150`} role="img" aria-labelledby="profile-cap" preserveAspectRatio="none">
          <rect x="0" y="40" width={W} height="78" fill="url(#cc-amber)"></rect>
          <rect x="0" y="118" width={W} height="32" fill="#2f5d3a"></rect>
          <!-- What correction removes: the thin top band, down to the deepest valley we level. -->
          <path class="profile__removed" d={`${surface} L${W} 40 L${W} 50 L0 50 Z`} fill="#f7e3b4"></path>
          <path class="profile__rough" d={surface} fill="none" stroke="#5f410c" stroke-width="2"
            vector-effect="non-scaling-stroke"></path>
          <line class="profile__level" x1="0" y1="50" x2={W} y2="50" stroke="#1b2026" stroke-width="2"
            stroke-dasharray="7 5" vector-effect="non-scaling-stroke"></line>
          <defs>
            <linearGradient id="cc-amber" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#f1d596"></stop>
              <stop offset="1" stop-color="#e2b056"></stop>
            </linearGradient>
          </defs>
        </svg>
        <div class="profile__keys" aria-hidden="true">
          <span class="k k--rough">Before: swirls and marks</span>
          <span class="k k--level">After: levelled, a few µm lower</span>
          <span class="k k--colour">Colour coat, untouched</span>
        </div>
        <figcaption id="profile-cap">
          The top of the clear coat, magnified and simplified. Correction polishes down to the dashed line and no
          further.
        </figcaption>
      </figure>
      <Said q={quotes.polish} about="after a polish" />
    </div>
  </div>
</section>

<style>
  .clear {
    background: var(--ly-amber-bg);
    padding-block: 0 clamp(3.5rem, 8vw, 6rem);
  }
  .edge {
    height: 8px;
    background: linear-gradient(180deg, #f3d9a0, var(--ly-amber));
    box-shadow: inset 0 -1px 0 rgb(95 65 12 / 0.25);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
  }
  .depth {
    font-size: 1.0625rem;
    color: var(--ly-amber-ink);
    margin-bottom: 0.5rem;
  }
  .ly-h2 {
    max-width: 17ch;
  }
  .line {
    margin-top: 1.25rem;
    max-width: 54ch;
    font-size: 1.0625rem;
  }
  .facts {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-weight: 500;
  }
  .facts li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .facts li::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border: 1.5px solid var(--ly-ink);
    border-radius: 50%;
    background: #f7e3b4;
  }
  .offer {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
  }
  .offer dt {
    font-size: 0.875rem;
    color: var(--ly-amber-ink);
  }
  .offer dd {
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
  }
  .order {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    max-width: 40ch;
  }
  .actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .side {
    display: grid;
    gap: 2rem;
    align-content: start;
    color: var(--ly-ink);
  }
  .profile svg {
    width: 100%;
    height: clamp(9rem, 22vw, 12rem);
    border-radius: 3px;
    background: var(--ly-amber-bg);
  }
  .profile__keys {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .k {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .k::before {
    content: '';
    width: 1.75rem;
    flex: none;
  }
  .k--rough::before {
    height: 0;
    border-top: 2px solid var(--ly-amber-ink);
  }
  .k--level::before {
    height: 0;
    border-top: 2px dashed var(--ly-ink);
  }
  .k--colour::before {
    height: 0.6rem;
    background: var(--ly-green);
  }
  .profile figcaption {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    max-width: 46ch;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }
    .side {
      padding-top: 2.5rem;
    }
  }

  /* Decorative: the rough top is polished away as the figure crosses the viewport.
     Progressive enhancement only (scroll-entry-exit-effects): without support the
     "before" line and the dashed "after" line are both shown, which still explains it. */
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .profile {
        view-timeline: --profile block;
      }
      .profile__removed,
      .profile__rough {
        animation: polish-away linear both;
        animation-timeline: --profile;
        animation-range: cover 35% cover 65%;
      }
    }
  }
  @keyframes polish-away {
    to {
      opacity: 0;
    }
  }
</style>
