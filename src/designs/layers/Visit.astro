---
import Picture from '../shared/Picture.astro';
import { contact, studio } from '../data';
import { hello } from './layers';

const { open, close, closedDays, timeZone } = contact.schedule;
---

<section class="visit" id="visit" aria-labelledby="visit-title">
  <div class="ly-wrap grid">
    <div class="info">
      <h2 class="ly-h2" id="visit-title">Bring the car to Al&nbsp;Qusais</h2>
      <p
        class="status"
        data-open-status
        data-open={open}
        data-close={close}
        data-closed-days={closedDays.join(',')}
        data-tz={timeZone}
        hidden
      >
        <span class="status__dot" aria-hidden="true"></span>
        <span class="status__text"></span>
      </p>
      <dl class="facts">
        <div>
          <dt>Address</dt>
          <dd>{contact.address[0]}<br />{contact.address[1]}</dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd>{contact.hours}<br />{contact.closed}</dd>
        </div>
        <div>
          <dt>Phone and WhatsApp</dt>
          <dd><a href={contact.phoneHref}>{contact.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        </div>
      </dl>
      <div class="actions">
        <a class="ly-btn" href={hello} target="_blank" rel="noopener">Message us on WhatsApp</a>
        <a class="ly-link" href={contact.mapsUrl} target="_blank" rel="noopener">Directions in Google Maps</a>
      </div>
      <p class="more">
        See what’s in the bays this week on Instagram at <a href={contact.instagram} target="_blank" rel="noopener"
          >{contact.instagramHandle}</a
        >. Parking is easy.
      </p>
    </div>
    <figure class="night">
      <Picture base={studio.night.base} alt={studio.night.alt} sizes="(min-width: 56rem) 34rem, 100vw" />
      <figcaption>The studio at night. Photo by customer Mark Ban.</figcaption>
    </figure>
  </div>
</section>

<script>
  // Live "open now" status in Dubai time (Intl.DateTimeFormat; no Temporal needed for this).
  const el = document.querySelector<HTMLElement>('[data-open-status]');
  if (el) {
    const tz = el.dataset.tz ?? 'Asia/Dubai';
    const toMin = (hhmm: string) => {
      const [h, m] = hhmm.split(':').map(Number);
      return h * 60 + m;
    };
    const open = toMin(el.dataset.open ?? '09:00');
    const close = toMin(el.dataset.close ?? '21:30');
    const closed = (el.dataset.closedDays ?? '').split(',').filter(Boolean).map(Number);
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: tz,
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
    const now = Number(get('hour')) * 60 + Number(get('minute'));
    const isOpen = !closed.includes(day) && now >= open && now < close;
    const text = el.querySelector<HTMLElement>('.status__text');
    if (text) {
      text.textContent = isOpen
        ? 'Open now in Dubai, until 9:30 PM'
        : closed.includes(day)
          ? 'Closed today (Friday). Open tomorrow from 9 AM'
          : now < open
            ? 'Closed now. Opens at 9 AM Dubai time'
            : closed.includes((day + 1) % 7)
              ? 'Closed now. Opens Saturday at 9 AM'
              : 'Closed now. Opens tomorrow at 9 AM';
    }
    el.dataset.state = isOpen ? 'open' : 'closed';
    el.hidden = false;
  }
</script>

<style>
  .visit {
    background: var(--ly-paper);
    padding-block: clamp(4rem, 9vw, 6.5rem) clamp(5rem, 10vw, 7rem);
    border-top: 1px solid var(--ly-rule);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
  }
  .status {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }
  .status__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--ly-metal);
  }
  .status[data-state='open'] .status__dot {
    background: #2e8b4e;
    box-shadow: 0 0 0 3px rgb(46 139 78 / 0.2);
  }
  .facts {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.25rem 2rem;
  }
  .facts dt {
    font-size: 0.875rem;
    color: var(--ly-ink-2);
  }
  .facts dd {
    font-size: 1.125rem;
    font-weight: 500;
  }
  .facts a {
    display: inline-block;
    padding-block: 0.4rem;
  }
  .actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .more {
    margin-top: 1.25rem;
    max-width: 48ch;
    color: var(--ly-ink-2);
  }
  .night {
    margin: 0;
  }
  .night :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 3px;
  }
  .night figcaption {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ly-ink-2);
  }
  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: center;
    }
  }
</style>
