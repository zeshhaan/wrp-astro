---
import { navLinks, hello } from './layers';
---

<a class="skip" href="#main">Skip to content</a>
<header class="bar">
  <div class="bar__inner">
    <a class="mark" href="#main" aria-label="WRP, back to top">WRP.</a>
    <nav class="bar__nav" aria-label="Sections">
      <ul role="list">
        {navLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <!-- Mobile home of the micron gauge readout (filled by Gauge.astro's script). -->
    <p class="bar__depth" data-depth-mini aria-hidden="true">
      <span class="bar__um"><span data-depth-num>0</span> µm</span>
      <span class="bar__in ly-note" data-depth-name>at the surface</span>
    </p>
    <a class="cta" href={hello} target="_blank" rel="noopener">
      <svg class="cta__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M12 3.2a8.6 8.6 0 0 0-7.4 13l-1.2 4.4 4.5-1.2A8.6 8.6 0 1 0 12 3.2Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"></path>
        <path
          d="M9.1 7.9c.3 0 .5.1.6.4l.7 1.6c.1.2 0 .5-.1.7l-.5.6c.6 1.2 1.6 2.2 2.9 2.9l.6-.5c.2-.2.5-.2.7-.1l1.6.7c.3.1.4.4.4.7-.1 1.1-1 1.9-2.1 1.8-3.3-.4-5.9-3-6.3-6.3-.1-1.1.7-2 1.9-2.1Z"
          fill="currentColor"></path>
      </svg>
      <span class="cta__long">WhatsApp us</span>
      <span class="cta__short">Chat</span>
    </a>
  </div>
</header>

<style>
  .skip {
    position: fixed;
    left: 1rem;
    top: 0.75rem;
    z-index: 60;
    padding: 0.75rem 1rem;
    background: var(--ly-ink);
    color: var(--ly-paper);
    border-radius: 0.25rem;
    translate: 0 -200%;
  }
  .skip:focus-visible {
    translate: 0 0;
  }
  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    container: bar / scroll-state;
  }
  .bar__inner {
    height: var(--ly-hh);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: 1rem;
    background: var(--ly-day);
    transition: box-shadow 0.2s;
  }
  /* Progressive enhancement (state-aware-sticky-headers): a hairline only once stuck. */
  @container bar scroll-state(stuck: top) {
    .bar__inner {
      box-shadow: 0 1px 0 var(--ly-rule);
    }
  }
  .mark {
    font-family: var(--ly-mark);
    font-weight: 900;
    font-style: italic;
    font-size: 1.625rem;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    color: var(--ly-ink);
    padding-block: 0.6rem;
  }
  .bar__nav {
    display: none;
    margin-inline-start: auto;
  }
  .bar__nav ul {
    display: flex;
    gap: 0.125rem;
  }
  .bar__nav a {
    display: block;
    padding: 0.7rem 0.7rem;
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .bar__nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /* Mobile depth readout: sits in the middle of the bar during the journey only. */
  .bar__depth {
    flex: 1;
    min-width: 0;
    display: grid;
    justify-items: center;
    line-height: 1.1;
    opacity: 0;
    transition: opacity 0.25s;
  }
  :global(:root[data-ly-depth='on']) .bar__depth {
    opacity: 1;
  }
  .bar__um {
    font-weight: 800;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .bar__in {
    font-size: 0.8125rem;
    color: var(--ly-ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .cta {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.5rem 0.85rem;
    border-radius: 0.25rem;
    background: var(--ly-green);
    color: #fff;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s;
  }
  .bar__depth + .cta {
    margin-inline-start: 0;
  }
  .cta:hover {
    background: var(--ly-green-deep);
  }
  .cta__long {
    display: none;
  }
  @media (max-width: 22rem) {
    .cta__short {
      position: absolute;
      clip-path: inset(50%);
      width: 1px;
      height: 1px;
      overflow: hidden;
      white-space: nowrap;
    }
  }
  @media (min-width: 64rem) {
    .bar__inner {
      padding-inline: 2rem;
    }
    .bar__nav {
      display: block;
    }
    .bar__depth {
      display: none;
    }
    .cta {
      margin-inline-start: 0.75rem;
      padding-inline: 1rem 1.15rem;
    }
    .cta__long {
      display: inline;
    }
    .cta__short {
      display: none;
    }
  }
</style>
