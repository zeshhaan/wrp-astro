---
/**
 * Operational proof, close to the offers: how a job runs from the first message
 * to the keys. Every step is something customers describe in their reviews.
 */
import { said } from './layers';

const steps = [
  {
    title: 'Tell us the car and the job',
    body: 'On WhatsApp or the form at the top. We reply with honest options and a price, and we won’t push extras.',
    q: said('Ameena Shajahan', 'They kept me updated, delivered on time, and didn’t try to push any unnecessary extras.'),
  },
  {
    title: 'We inspect and measure',
    body: 'We look at the paint under proper light and read its depth with a gauge, then confirm the price before we start.',
    q: said('Sujith Prasad', 'They explained every step of the process clearly and offered helpful suggestions without any pressure.'),
  },
  {
    title: 'Pickup if you need it',
    body: 'Can’t bring the car in? Ask about collection and return when you book.',
    q: said('vinod kumar', 'They have picked up the car from my location and delivered with very much care and timely updates'),
  },
  {
    title: 'Photos and videos as we work',
    body: 'You follow the job from wherever you are, layer by layer.',
    q: said('Leno Thomas', 'The team kept me updated throughout the process with pictures and videos…'),
  },
  {
    title: 'Checked, then ready on time',
    body: 'We go over the car again before handover, at the time we gave you when you dropped it off.',
    q: said('Leno Thomas', 'Car was delivered exactly on the promised time.'),
  },
];
---

<section class="process" id="process" aria-labelledby="process-title">
  <div class="ly-wrap">
    <h2 class="ly-h2" id="process-title">While we have your car</h2>
    <ol class="steps" role="list">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step__n" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p class="step__body">{s.body}</p>
            <blockquote class="step__said">
              <p class="ly-note">“{s.q.text}”</p>
              <footer>{s.q.author}</footer>
            </blockquote>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--ly-paper);
    padding-block: clamp(4rem, 9vw, 6.5rem);
    border-top: 1px solid var(--ly-rule);
  }
  .steps {
    margin-top: clamp(2rem, 5vw, 3rem);
    display: grid;
    gap: 2rem;
    counter-reset: none;
  }
  .step {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ly-ink);
  }
  .step__n {
    font-weight: 900;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: var(--ly-film-ink);
  }
  .step h3 {
    font-weight: 800;
    font-size: 1.1875rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .step__body {
    font-size: 1rem;
    color: var(--ly-ink-2);
  }
  .step__said {
    margin-top: 0.5rem;
  }
  .step__said p {
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ly-film-ink);
  }
  .step__said footer {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--ly-ink-2);
  }
  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }
</style>
