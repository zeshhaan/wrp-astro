---
import { ask, depths } from './layers';

const d = depths.primer;
---

<section
  class="layer metal on-dark"
  id="metal"
  aria-labelledby="metal-title"
  data-layer="metal"
  data-um-from={d.from}
  data-um-to={d.to}
  data-um-name="down to the metal"
>
  <div class="primer" aria-hidden="true"></div>
  <div class="ly-wrap body">
    <p class="depth ly-note">{d.from} µm and deeper: primer, then the panel itself</p>
    <h2 class="ly-h2" id="metal-title">Below this line, a stone chip means the body shop.</h2>
    <p class="line">
      Under the colour sits the primer, then the steel or aluminium panel. A chip that gets this far needs touch-up
      paint or a respray. Everything above this line is what we’re here to protect, and the front of the car takes most
      of the hits.
    </p>
    <div class="actions">
      <a class="btn-light" href={ask('paint protection film on the front of the car')} target="_blank" rel="noopener">
        Protect the front of my car
      </a>
      <a class="ly-link" href="#surfaces">Next: glass, leather and the whole car</a>
    </div>
  </div>
</section>

<style>
  .metal {
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, var(--ly-metal), #515b64);
    color: #fff;
    padding-block: 0 clamp(4rem, 9vw, 7rem);
  }
  .primer {
    height: clamp(4rem, 9vw, 6rem);
    background:
      radial-gradient(circle at 20% 40%, rgb(255 255 255 / 0.12) 0 1px, transparent 1.5px) 0 0 / 7px 7px,
      var(--ly-primer);
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.2);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .depth {
    font-size: 1.0625rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .ly-h2 {
    max-width: 18ch;
  }
  .line {
    margin-top: 1.25rem;
    max-width: 56ch;
    font-size: 1.0625rem;
    color: #f0f3f5;
  }
  .actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .btn-light {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.7rem 1.35rem;
    border-radius: 0.25rem;
    background: var(--ly-paper);
    color: var(--ly-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .btn-light:hover {
    background: #fff;
  }
  .actions :global(.ly-link) {
    color: #fff;
  }
</style>
