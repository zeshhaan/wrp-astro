---
import { contact, pages, services } from '../data';

const year = new Date().getFullYear();
const pageLinks = [
  { label: 'Portfolio', href: pages.portfolio },
  { label: 'Reviews', href: pages.reviews },
  { label: 'About WRP', href: pages.about },
  { label: 'Blog', href: pages.blog },
  { label: 'Contact', href: pages.contact },
  { label: 'العربية', href: pages.arabic, lang: 'ar' },
];
---

<footer class="foot on-dark">
  <div class="ly-wrap grid">
    <div class="brand">
      <p class="mark">WRP.</p>
      <p class="tag ly-note">Wrap, reinforce, protect. Every layer, done properly.</p>
      <p class="addr">
        {contact.address.join(', ')}<br />{contact.hoursShort}. {contact.closed}<br />
        <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
      </p>
    </div>
    <nav aria-label="Services">
      <p class="h">Services</p>
      <ul role="list">
        {services.map((s) => <li><a href={s.href}>{s.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="More from WRP">
      <p class="h">WRP</p>
      <ul role="list">
        {pageLinks.map((l) => <li><a href={l.href} lang={l.lang}>{l.label}</a></li>)}
        <li><a href={contact.instagram} target="_blank" rel="noopener">Instagram {contact.instagramHandle}</a></li>
      </ul>
    </nav>
  </div>
  <div class="ly-wrap legal">
    <p>© {year} WRP Detailing Solutions, Dubai.</p>
    <p><a href={pages.privacy}>Privacy</a> <a href={pages.terms}>Terms</a></p>
  </div>
</footer>

<style>
  .foot {
    background: var(--ly-steel);
    color: var(--ly-on-dark);
    padding-block: 3.5rem 6rem;
    border-top: 6px solid var(--ly-metal);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
  }
  .mark {
    font-family: var(--ly-mark);
    font-weight: 900;
    font-style: italic;
    font-size: 2.5rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .tag {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    color: var(--ly-on-dark-2);
  }
  .addr {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .h {
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  ul {
    display: grid;
  }
  li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    text-decoration: none;
    font-size: 0.9375rem;
  }
  li a:hover,
  .legal a:hover {
    text-decoration: underline;
  }
  .legal {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(230 234 237 / 0.15);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: 0.875rem;
    color: var(--ly-on-dark-2);
  }
  .legal a {
    display: inline-block;
    padding: 0.5rem 0.25rem;
    margin-inline-end: 0.75rem;
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 3fr);
    }
  }
</style>
