---
/** One short section, well down the page: the building has a layer upstairs too. */
import Picture from '../shared/Picture.astro';
import { lounge } from '../data';

const photo = lounge.photos[0];
const quote = lounge.quotes[0];
const picks = ['Billiards', 'Board games', 'Coffee & karak', 'Big-screen TV', 'Air-conditioned'];
const amenities = lounge.amenities.filter((a) => picks.includes(a.name));
---

<section class="lounge" id="lounge" aria-labelledby="lounge-title">
  <div class="ly-wrap grid">
    <figure class="photo">
      <Picture base={photo.base} alt={photo.alt} sizes="(min-width: 56rem) 36rem, 100vw" />
      <figcaption>{photo.caption}</figcaption>
    </figure>
    <div class="copy">
      <p class="where ly-note">{lounge.where}</p>
      <h2 class="ly-h2" id="lounge-title">Waiting? There’s a lounge upstairs.</h2>
      <p class="line">
        If you’d rather stay while we work, the WRP Lounge sits on the mezzanine above the bays, behind a glass wall.
      </p>
      <ul class="list" role="list">
        {amenities.map((a) => <li>{a.name}</li>)}
      </ul>
      <blockquote class="ly-said">
        <p>“{quote.text}”</p>
        <footer>{quote.author.replace(/\.$/, '')}. Google review.</footer>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .lounge {
    background: var(--ly-day);
    padding-block: clamp(4rem, 9vw, 6.5rem);
    border-top: 1px solid var(--ly-rule);
  }
  .grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .photo {
    margin: 0;
  }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 3px;
  }
  .photo figcaption {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ly-ink-2);
  }
  .where {
    font-size: 1.0625rem;
    color: var(--ly-ink-2);
    margin-bottom: 0.5rem;
  }
  .ly-h2 {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
  }
  .line {
    margin-top: 1rem;
    font-size: 1.0625rem;
    max-width: 44ch;
  }
  .list {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .list li {
    padding: 0.35rem 0.7rem;
    border: 1.5px solid rgb(27 32 38 / 0.25);
    border-radius: 4px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .copy :global(.ly-said) {
    margin-top: 1.5rem;
    color: #1d5c46;
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4rem;
    }
  }
</style>
