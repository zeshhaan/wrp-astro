---
import Picture from '../shared/Picture.astro';
import Icon from './Icon.astro';
import { aboutChecklist } from './content';
import { aboutChecklistAr } from './contentAr';
import type { Locale } from '@/i18n/translations';

interface Props {
  locale?: Locale;
  /** Overrides the in-site links, e.g. to the Arabic Studio pages. */
  link?: (href: string) => string;
}
const { locale = 'en', link = (href: string) => href } = Astro.props;
const ar = locale === 'ar';
const w = ar
  ? {
      eyebrow: 'عن WRP Detailing Solutions',
      title: 'استوديو دبي الأول لحماية الطلاء والعناية بالسيارات',
      p1: 'WRP اختصار لـ Wrap وReinforce وProtect: غلّف، عزّز، احمِ. نحن استوديو متخصص في الحفاظ على السيارات، نعمل من منطقة القصيص الصناعية ١ في دبي. من التركيب الدقيق لأفلام STEK الشفافة لحماية الطلاء وطلاءات السيراميك الزجاجية بصلابة 9H، إلى تصحيح الطلاء على عدة مراحل وأفلام النوافذ العازلة للحرارة وخياطة الجلد حسب الطلب والغسيل اليدوي الآمن، ينفّذ فنيون معتمدون كل خدمة تحت إضاءة الاستوديو.',
      p2: 'نلتزم بالشفافية الكاملة: أسعار واضحة مسبقاً، وشرح وافٍ لكل الخيارات، وتحديثات فورية بالصور والفيديو وسيارتك في ورشتنا. وعندما نحدد لك موعد التسليم، تكون سيارتك جاهزة ومنجزة بإتقان، دون استثناء.',
      list: aboutChecklistAr,
      more: 'المزيد عن WRP',
      alt: 'فنيان من WRP يعملان على كبوت لكزس سوداء أمام جدار شعار WRP',
    }
  : {
      eyebrow: 'About WRP Detailing Solutions',
      title: 'Dubai’s premier paint protection & car detailing studio',
      p1: 'WRP stands for Wrap, Reinforce, Protect. We are a specialized automotive preservation studio operating from Al Qusais Industrial Area 1, Dubai. From precision STEK clear bra installations and 9H ceramic glass coatings to multi-stage paint correction, heat-rejection window films, custom leather stitching, and safe-touch hand washes, every service is executed under studio lighting by certified technicians.',
      p2: 'We prioritize complete transparency: clear upfront pricing, full option walkthroughs, and real-time photo/video updates while your vehicle is in our bay. When we give you a completion time, your car is ready, done properly, without exception.',
      list: aboutChecklist,
      more: 'More about WRP',
      alt: 'Two WRP detailers working on the bonnet of a black Lexus in front of the WRP logo wall',
    };
---

<section class="about st-section st-light" id="about" aria-labelledby="about-title">
  <div class="st-wrap about__grid">
    <div class="about__text">
      <p class="st-eyebrow st-eyebrow--dark">{w.eyebrow}</p>
      <h2 id="about-title" class="st-h2">{w.title}</h2>
      <p>{w.p1}</p>
      <p>{w.p2}</p>
      <ul class="about__list" role="list">
        {
          w.list.map((item) => (
            <li>
              <span class="about__tick">
                <Icon name="check" size={16} />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
      <a class="st-btn st-btn--dark" href={link('/more-about-wrp/')}>{w.more}</a>
    </div>
    <figure class="about__media">
      <Picture
        base="/portfolio/team-detailing-black-lexus-hood"
        alt={w.alt}
        sizes="(min-width: 60rem) 40vw, 100vw"
        width={1200}
        height={1680}
      />
    </figure>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: center;
  }
  .about__text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    max-inline-size: 38rem;
  }
  .about__text p:not(.st-eyebrow) {
    color: var(--st-ink-2);
  }
  .about__list {
    display: grid;
    gap: 0.7rem;
    margin: 0.5rem 0 0.75rem;
    padding: 0;
    list-style: none;
    font-weight: 500;
  }
  .about__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .about__tick {
    display: inline-grid;
    place-items: center;
    flex: none;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border-radius: 50%;
    background: var(--st-accent);
    color: var(--st-on-accent);
  }
  .about__media {
    position: relative;
  }
  .about__media :global(img) {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 30%;
  }
  @media (min-width: 60rem) {
    .about__grid {
      grid-template-columns: 1.1fr 1fr;
    }
    .about__media :global(img) {
      aspect-ratio: 4 / 5;
    }
  }
</style>
