---
/**
 * Header variant D, "Arrivals board": a centred masthead with the pages split
 * either side of the logo, and under it a rail that shows all six services at
 * once, each with its starting price, like a departures board. Point at one and
 * its cell lights up with a photo of that work. The rail is the part that
 * sticks: once the masthead has scrolled away a small logo slides into the
 * rail's first slot, so the services and the quote button stay in reach on
 * every screen. On phones the rail scrolls sideways under the logo.
 *
 * Only the rail is sticky and its slots never change size, so nothing on the
 * page moves when it locks. Every destination is a plain <a href> in the
 * server HTML.
 */
import Icon from '../Icon.astro';
import WrpLogo from '@/components/WrpLogo.astro';
import Strip from './parts/Strip.astro';
import MenuSheet from './parts/MenuSheet.astro';
import type { HeaderNav } from './nav';

interface Props {
  nav: HeaderNav;
  altHref: string;
  quoteHref: string;
}

const { nav, altHref, quoteHref } = Astro.props;
const w = nav.words;
const [start, end] = [nav.pages.slice(0, 3), nav.pages.slice(3)];
---

<a class="skip" href="#main">{w.skip}</a>

<div class="ab" dir={nav.dir} lang={nav.locale}>
  <Strip nav={nav} altHref={altHref} />

  <header class="ab-mast" data-ab-mast>
    <div class="st-wrap ab-mast__inner">
      <div class="ab-mast__side">
        <button class="ab-sq ab-narrow" type="button" commandfor="ab-menu" command="show-modal" aria-controls="ab-menu">
          <Icon name="menu" size={22} />
          <span class="visually-hidden">{w.menu}</span>
        </button>
        <nav class="ab-pages" aria-label="Main">
          <ul role="list">{start.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
        </nav>
      </div>
      <a class="ab-logo" href={nav.home} aria-label={w.home}>
        <WrpLogo class="ab-logo__mark" />
      </a>
      <div class="ab-mast__side ab-mast__side--end">
        <nav class="ab-pages" aria-label="More">
          <ul role="list">{end.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
        </nav>
        <button class="ab-sq ab-narrow" type="button" data-contact-modal>
          <Icon name="whatsapp" size={22} />
          <span class="visually-hidden">{w.whatsapp}</span>
        </button>
      </div>
    </div>
  </header>

  <nav class="ab-rail" aria-label={nav.servicesLabel} data-ab-rail>
    <div class="ab-rail__inner">
      <div class="ab-rail__slot">
        <span class="ab-rail__label" aria-hidden="true">{nav.servicesLabel}</span>
        <a class="ab-rail__mark" href={nav.home} aria-label={w.home} tabindex="-1" data-ab-mark>
          <WrpLogo class="ab-rail__logo" />
        </a>
      </div>
      <ul role="list" class="ab-rail__list">
        {
          nav.services.map((s, i) => (
            <li>
              <a class="ab-cell" href={s.href} style={`--img: url('${s.image}-480w.webp')`}>
                <span class="ab-cell__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="ab-cell__name">{s.short}</span>
                <span class="ab-cell__price">{s.price}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="ab-rail__quote" href={quoteHref}>
        {w.quote}
        <Icon name="arrow-right" size={16} class="ab-arrow" />
      </a>
    </div>
  </nav>
</div>

<MenuSheet id="ab-menu" nav={nav} altHref={altHref} quoteHref={quoteHref} />

<script>
  // Once the masthead has scrolled away, the rail swaps its "Services" label
  // for a small logo. The slot keeps its size, so nothing moves.
  const mast = document.querySelector('[data-ab-mast]');
  const rail = document.querySelector<HTMLElement>('[data-ab-rail]');
  const mark = document.querySelector<HTMLElement>('[data-ab-mark]');
  if (mast && rail) {
    new IntersectionObserver(([entry]) => {
      const stuck = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      rail.toggleAttribute('data-stuck', stuck);
      mark?.setAttribute('tabindex', stuck ? '0' : '-1');
    }).observe(mast);
  }
</script>

<style>
  .skip {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--st-accent);
    color: var(--st-on-accent);
    font-weight: 600;
  }
  .skip:focus {
    inset-block-start: 0.5rem;
  }

  /* No box of its own, so the rail sticks against the page, not this wrapper. */
  .ab {
    display: contents;
    --ab-font: var(--st-head-font);
    --ab-track: 0.06em;
    --ab-case: uppercase;
  }
  .ab:lang(ar) {
    --ab-font: var(--font-ibm-plex-arabic), system-ui, sans-serif;
    --ab-track: 0;
    --ab-case: none;
  }
  :global([dir='rtl'] .ab-arrow) {
    transform: scaleX(-1);
  }

  /* Masthead */
  .ab-mast {
    background: var(--st-coal);
    color: var(--st-white);
  }
  .ab-mast__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-block-size: 4.5rem;
  }
  .ab-mast__side {
    display: flex;
    align-items: center;
  }
  .ab-mast__side--end {
    justify-content: flex-end;
  }
  .ab-logo {
    display: grid;
    align-content: center;
    min-block-size: 2.75rem;
    color: var(--st-white);
  }
  .ab-logo__mark {
    display: block;
    block-size: 2.6rem;
    inline-size: auto;
  }
  .ab-pages {
    display: none;
  }
  .ab-pages ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ab-pages a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.85rem;
    color: var(--st-on-dark);
    font-family: var(--ab-font);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: var(--ab-track);
    text-transform: var(--ab-case);
    text-decoration: none;
  }
  .ab-pages a:hover {
    color: var(--st-white);
  }
  .ab-pages a::after {
    content: '';
    position: absolute;
    inset-inline: 0.85rem;
    inset-block-end: 0.5rem;
    block-size: 1px;
    background: var(--st-accent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }
  .ab-pages a:hover::after {
    transform: scaleX(1);
  }
  .ab-sq {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--st-line-dark);
    background: none;
    color: var(--st-white);
    cursor: pointer;
  }
  @media (min-width: 64rem) {
    .ab-mast__inner {
      min-block-size: 5.5rem;
    }
    .ab-logo__mark {
      block-size: 3.4rem;
    }
    .ab-pages {
      display: block;
    }
    .ab-narrow {
      display: none;
    }
  }

  /* The rail: always on screen once it reaches the top. */
  .ab-rail {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--st-black) 94%, transparent);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--st-line-dark);
    color: var(--st-white);
  }
  .ab-rail__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-inline: var(--st-gutter-x);
  }
  .ab-rail__slot,
  .ab-rail__quote {
    display: none;
  }
  .ab-rail__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    margin: 0 calc(-1 * var(--st-gutter-x));
    padding: 0 var(--st-gutter-x);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--st-gutter-x);
    scrollbar-width: none;
  }
  .ab-rail__list::-webkit-scrollbar {
    display: none;
  }
  .ab-rail__list > li {
    scroll-snap-align: start;
    border-inline-start: 1px solid var(--st-line-dark);
  }
  .ab-rail__list > li:last-child {
    border-inline-end: 1px solid var(--st-line-dark);
  }
  .ab-cell {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'num name' 'num price';
    align-content: center;
    column-gap: 0.6rem;
    block-size: 100%;
    min-block-size: 3.75rem;
    min-inline-size: 8rem;
    padding: 0.5rem 0.85rem;
    overflow: hidden;
    color: var(--st-white);
    text-decoration: none;
  }
  /* The photo only loads when someone points at the cell. */
  .ab-cell::before,
  .ab-cell::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .ab-cell::after {
    background: linear-gradient(90deg, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0.45));
  }
  .ab-cell:hover::before,
  .ab-cell:focus-visible::before {
    background: var(--img) center / cover no-repeat;
    opacity: 1;
    z-index: -2;
  }
  .ab-cell:hover::after,
  .ab-cell:focus-visible::after {
    opacity: 1;
  }
  .ab-cell__num {
    grid-area: num;
    align-self: start;
    padding-block-start: 0.2rem;
    color: var(--st-accent);
    font-family: var(--st-head-font);
    font-size: 0.6875rem;
  }
  .ab-cell__name {
    grid-area: name;
    font-family: var(--ab-font);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: var(--ab-track);
    text-transform: var(--ab-case);
    white-space: nowrap;
  }
  .ab-cell__price {
    grid-area: price;
    color: var(--st-mute);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .ab-cell:hover .ab-cell__name {
    color: var(--st-accent);
  }
  .ab-cell:hover .ab-cell__price {
    color: var(--st-on-dark);
  }

  @media (min-width: 64rem) {
    /* Edge to edge on wide screens: six cells with prices need every pixel. */
    .ab-rail__inner {
      grid-template-columns: 7.5rem minmax(0, 1fr) auto;
      padding-inline: 0;
    }
    .ab-rail__list {
      grid-auto-columns: 1fr;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .ab-cell {
      min-block-size: 4.25rem;
      padding-inline: 1rem;
    }
    .ab-rail__slot {
      position: relative;
      display: grid;
      align-items: center;
      padding-inline-start: var(--st-pad);
    }
    .ab-rail__label,
    .ab-rail__mark {
      grid-area: 1 / 1;
      transition:
        opacity 0.3s ease,
        translate 0.3s ease;
    }
    .ab-rail__label {
      color: var(--st-accent);
      font-family: var(--ab-font);
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      text-transform: var(--ab-case);
    }
    .ab-rail__mark {
      display: grid;
      align-content: center;
      min-block-size: 2.75rem;
      color: var(--st-white);
      opacity: 0;
      translate: 0 0.5rem;
      visibility: hidden;
    }
    .ab-rail__logo {
      block-size: 2.1rem;
      inline-size: auto;
    }
    .ab-rail[data-stuck] .ab-rail__label {
      opacity: 0;
      translate: 0 -0.5rem;
    }
    .ab-rail[data-stuck] .ab-rail__mark {
      opacity: 1;
      translate: 0 0;
      visibility: visible;
    }
    .ab-rail__quote {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-inline-start: 1.25rem;
      padding-inline: 1.25rem 1rem;
      background: var(--st-red);
      color: var(--st-white);
      font-family: var(--ab-font);
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: var(--ab-track);
      text-transform: var(--ab-case);
      text-decoration: none;
      white-space: nowrap;
    }
    .ab-rail__quote:hover {
      background: var(--st-red-hover);
    }
  }
  @media (min-width: 64rem) and (max-width: 80rem) {
    /* Laptops: no room for the label slot beside six priced cells. */
    .ab-rail__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      padding-inline-start: var(--st-pad);
    }
    .ab-rail__slot {
      display: none;
    }
  }
  @media (max-width: 96rem) {
    .ab-cell__num {
      display: none;
    }
  }
</style>
