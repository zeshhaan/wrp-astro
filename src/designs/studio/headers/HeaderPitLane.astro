---
/**
 * Header variant B, "Pit Lane": a floating capsule that hangs over the hero
 * like an instrument cluster. It carries a live "open now" light (Dubai time),
 * slips away while you scroll down and comes back the moment you scroll up.
 * Services opens a price board as a native popover. On phones the navigation
 * moves to a dock at the bottom of the screen, in thumb reach, with the quote
 * button raised in the middle; Services and More open bottom sheets.
 *
 * Every destination is a plain <a href> in the server HTML (popover and sheets
 * are only hidden with CSS), so crawlers see the full link set.
 */
import Icon from '../Icon.astro';
import WrpLogo from '@/components/WrpLogo.astro';
import type { HeaderNav } from './nav';

interface Props {
  nav: HeaderNav;
  altHref: string;
  quoteHref: string;
}

const { nav, altHref, quoteHref } = Astro.props;
const w = nav.words;
const altLang = nav.locale === 'ar' ? 'en' : 'ar';
const statusWords = JSON.stringify({
  open: `${w.openNow} · ${w.until}`,
  openShort: w.openNow,
  closed: `${w.closedNow} · ${w.opensAt}`,
  closedSat: `${w.closedNow} · ${w.opensSat}`,
  closedShort: w.closedNow,
});
---

<a class="skip" href="#main">{w.skip}</a>

<header class="pl" dir={nav.dir} lang={nav.locale} data-hdr="pit-lane" data-pl>
  <div class="pl-island" data-pl-island>
    <a class="pl-logo" href={nav.home} aria-label={w.home}>
      <WrpLogo class="pl-logo__mark" />
    </a>

    <nav class="pl-nav" aria-label="Main">
      <ul role="list" class="pl-nav__list">
        <li>
          <button class="pl-nav__link" type="button" popovertarget="pl-board" data-pl-board-btn>
            {nav.servicesLabel}
            <Icon name="chevron-down" size={15} class="pl-chev" />
          </button>
          <div class="pl-board" id="pl-board" popover data-pl-board>
            <p class="pl-board__head">
              <span>{nav.servicesLabel}</span>
              <span>{w.from}</span>
            </p>
            <ul role="list" class="pl-board__list">
              {
                nav.services.map((s) => (
                  <li>
                    <a class="pl-board__row" href={s.href}>
                      <span class="pl-board__name">{s.name}</span>
                      <span class="pl-board__dots" aria-hidden="true" />
                      <span class="pl-board__price">{s.price.replace(`${w.from} `, '')}</span>
                      {s.time && <span class="pl-board__time">{s.time}</span>}
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="pl-board__foot">
              <span>{w.talk}</span>
              <button type="button" class="pl-board__wa" data-contact-modal data-pl-board-close><Icon name="whatsapp" size={18} />{w.whatsapp}</button>
            </p>
          </div>
        </li>
        {
          nav.pages.map((p) => (
            <li>
              <a class="pl-nav__link" href={p.href}>{p.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="pl-status" data-pl-status data-schedule={JSON.stringify(nav.schedule)} data-words={statusWords}>
      <span class="pl-status__dot" aria-hidden="true"></span>
      <span class="pl-status__long" data-pl-status-long>{nav.hours}</span>
      <span class="pl-status__short" data-pl-status-short>{nav.hours}</span>
    </p>

    <a class="pl-lang" href={altHref} hreflang={altLang}>{nav.langLabel}</a>
    <a class="pl-icon pl-wide" href={nav.phone.href} aria-label={`${w.call} ${nav.phone.display}`}><Icon name="phone" size={18} /></a>
    <button class="pl-icon pl-wide" type="button" data-contact-modal aria-label={w.whatsapp}><Icon name="whatsapp" size={19} /></button>
    <a class="pl-quote pl-wide" href={quoteHref}>{w.quote}<Icon name="arrow-right" size={16} class="pl-arrow" /></a>
  </div>
</header>

<nav class="pl-dock" dir={nav.dir} lang={nav.locale} aria-label="Quick actions">
  <button type="button" class="pl-dock__btn" commandfor="pl-services" command="show-modal" data-pl-sheet-open="pl-services">
    <Icon name="grid" size={22} /><span>{nav.servicesLabel}</span>
  </button>
  <a class="pl-dock__btn" href={nav.phone.href}><Icon name="phone" size={22} /><span>{w.call}</span></a>
  <a class="pl-dock__quote" href={quoteHref}><span>{w.quote}</span></a>
  <button type="button" class="pl-dock__btn" data-contact-modal><Icon name="whatsapp" size={22} /><span>WhatsApp</span></button>
  <button type="button" class="pl-dock__btn" commandfor="pl-more" command="show-modal" data-pl-sheet-open="pl-more">
    <Icon name="menu" size={22} /><span>{w.menu}</span>
  </button>
</nav>

<dialog class="pl-sheet" id="pl-services" dir={nav.dir} lang={nav.locale} aria-label={nav.servicesLabel}>
  <div class="pl-sheet__grab" aria-hidden="true"></div>
  <div class="pl-sheet__top">
    <p class="pl-sheet__title">{nav.servicesLabel}</p>
    <button class="pl-sheet__close" type="button" commandfor="pl-services" command="close" data-pl-sheet-close>
      <Icon name="close" size={22} /><span class="visually-hidden">{w.close}</span>
    </button>
  </div>
  <ul role="list" class="pl-sheet__list">
    {
      nav.services.map((s) => (
        <li>
          <a href={s.href}>
            <span class="pl-sheet__name">{s.name}</span>
            <span class="pl-sheet__meta">{s.price}{s.time && ` · ${s.time}`}</span>
            <Icon name="arrow-right" size={18} class="pl-arrow" />
          </a>
        </li>
      ))
    }
  </ul>
</dialog>

<dialog class="pl-sheet" id="pl-more" dir={nav.dir} lang={nav.locale} aria-label={w.menu}>
  <div class="pl-sheet__grab" aria-hidden="true"></div>
  <div class="pl-sheet__top">
    <WrpLogo class="pl-sheet__logo" label="WRP by YACO Automotive" />
    <button class="pl-sheet__close" type="button" commandfor="pl-more" command="close" data-pl-sheet-close>
      <Icon name="close" size={22} /><span class="visually-hidden">{w.close}</span>
    </button>
  </div>
  <ul role="list" class="pl-sheet__pages">
    {nav.pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
  </ul>
  <div class="pl-sheet__info">
    <a href={nav.rating.href}><Icon name="star" size={16} />{nav.rating.value} · {nav.rating.count} {w.reviews}</a>
    <a href={nav.maps.href} target="_blank" rel="noopener"><Icon name="pin" size={16} />{nav.maps.label}</a>
    <span><Icon name="clock" size={16} />{nav.hours} · {w.closed}</span>
    <a class="pl-sheet__lang" href={altHref} hreflang={altLang}>{nav.langLabel}</a>
  </div>
</dialog>

<script>
  import { dubaiOpenState, type Schedule } from './openStatus';

  // Live "open now" light, in Dubai time.
  const status = document.querySelector<HTMLElement>('[data-pl-status]');
  const paint = () => {
    if (!status) return;
    const words = JSON.parse(status.dataset.words ?? '{}') as Record<string, string>;
    const { open, opensSaturday } = dubaiOpenState(JSON.parse(status.dataset.schedule ?? '{}') as Schedule);
    status.dataset.open = String(open);
    status.querySelector('[data-pl-status-long]')!.textContent = open ? words.open : opensSaturday ? words.closedSat : words.closed;
    status.querySelector('[data-pl-status-short]')!.textContent = open ? words.openShort : words.closedShort;
  };
  paint();
  window.setInterval(paint, 60_000);

  // Slip away on the way down, come back on the way up.
  const header = document.querySelector<HTMLElement>('[data-pl]');
  const board = document.querySelector<HTMLElement>('[data-pl-board]');
  let last = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      header?.toggleAttribute('data-compact', y > 24);
      const hide = y > 320 && y > last + 4;
      if (hide && board?.matches(':popover-open')) board.hidePopover();
      if (hide) header?.setAttribute('data-away', '');
      else if (y < last - 4 || y <= 320) header?.removeAttribute('data-away');
      last = y;
    },
    { passive: true },
  );

  // The contact modal must not open underneath the price board.
  document.querySelector('[data-pl-board-close]')?.addEventListener('click', () => board?.hidePopover());
  const boardBtn = document.querySelector<HTMLButtonElement>('[data-pl-board-btn]');
  board?.addEventListener('toggle', (event) => {
    boardBtn?.setAttribute('aria-expanded', String((event as ToggleEvent).newState === 'open'));
  });

  // Bottom sheets: modal <dialog>s with Invoker Commands, a manual fallback,
  // light dismiss on the backdrop, and the contact modal never underneath.
  const hasCommands = 'commandForElement' in HTMLButtonElement.prototype;
  document.querySelectorAll<HTMLDialogElement>('dialog.pl-sheet').forEach((sheet) => {
    if (!hasCommands) {
      document.querySelector(`[data-pl-sheet-open="${sheet.id}"]`)?.addEventListener('click', () => sheet.showModal());
      sheet.querySelector('[data-pl-sheet-close]')?.addEventListener('click', () => sheet.close());
    }
    sheet.addEventListener('click', (event) => {
      if (event.target === sheet) sheet.close();
    });
  });
</script>

<style>
  .skip {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--st-gold);
    color: var(--st-black);
    font-weight: 600;
  }
  .skip:focus {
    inset-block-start: 0.5rem;
  }

  .pl,
  .pl-dock,
  .pl-sheet {
    --pl-font: var(--st-head-font);
    --pl-track: 0.05em;
    --pl-case: uppercase;
    --pl-glass: color-mix(in srgb, var(--st-coal) 82%, transparent);
    --pl-green: #4ade80;
    --pl-red: #f87171;
  }
  :is(.pl, .pl-dock, .pl-sheet):lang(ar) {
    --pl-font: var(--font-ibm-plex-arabic), system-ui, sans-serif;
    --pl-track: 0;
    --pl-case: none;
    font-family: var(--font-ibm-plex-arabic), system-ui, sans-serif;
  }
  :global([dir='rtl'] .pl-arrow) {
    transform: scaleX(-1);
  }

  /* A zero-height sticky rail: the capsule floats over the hero below it. */
  .pl {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    block-size: 0;
    padding-inline: var(--st-pad);
  }
  .pl-island {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    max-inline-size: var(--st-max);
    min-block-size: 3.75rem;
    /* Offset with inset, not margin: a margin would collapse through the zero-height rail. */
    inset-block-start: 0.75rem;
    margin-inline: auto;
    padding: 0.4rem 0.5rem 0.4rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    background: var(--pl-glass);
    backdrop-filter: blur(16px) saturate(1.3);
    box-shadow:
      0 12px 40px rgb(0 0 0 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
    color: var(--st-white);
    transition:
      translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.35s ease,
      min-block-size 0.25s ease,
      max-inline-size 0.35s ease;
  }
  .pl-island:dir(rtl) {
    padding: 0.4rem 1.25rem 0.4rem 0.5rem;
  }
  .pl[data-compact] .pl-island {
    min-block-size: 3.25rem;
  }
  .pl[data-away] .pl-island {
    translate: 0 calc(-100% - 1.5rem);
    opacity: 0;
  }
  .pl-logo {
    display: grid;
    align-content: center;
    min-block-size: 2.75rem;
    margin-inline-end: auto;
    color: var(--st-white);
  }
  .pl-logo__mark {
    display: block;
    block-size: 2.4rem;
    inline-size: auto;
  }

  .pl-nav {
    display: none;
  }
  .pl-nav__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pl-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-block-size: 2.75rem;
    padding-inline: 0.8rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--st-on-dark);
    font-family: var(--pl-font);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: var(--pl-track);
    text-transform: var(--pl-case);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .pl-nav__link:hover,
  .pl-nav__link[aria-expanded='true'] {
    background: rgb(255 255 255 / 0.08);
    color: var(--st-white);
  }
  .pl-nav__link :global(.pl-chev) {
    transition: rotate 0.2s ease;
  }
  .pl-nav__link[aria-expanded='true'] :global(.pl-chev) {
    rotate: 180deg;
  }

  /* Price board: a native popover in the top layer, under the capsule. */
  .pl-board {
    position: fixed;
    inset: 5.25rem auto auto 50%;
    translate: -50% 0;
    inline-size: min(40rem, calc(100vw - 2rem));
    margin: 0;
    padding: 1.25rem 1.5rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--st-coal) 94%, transparent);
    backdrop-filter: blur(16px);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.55);
    color: var(--st-white);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pl-board {
      transition:
        opacity 0.2s ease,
        translate 0.2s ease,
        display 0.2s allow-discrete,
        overlay 0.2s allow-discrete;
      opacity: 0;
      translate: -50% -0.5rem;
    }
    .pl-board:popover-open {
      opacity: 1;
      translate: -50% 0;
    }
    @starting-style {
      .pl-board:popover-open {
        opacity: 0;
        translate: -50% -0.5rem;
      }
    }
  }
  .pl-board__head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.6rem;
    border-block-end: 1px solid var(--st-line-dark);
    color: var(--st-gold);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .pl-board__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pl-board__row {
    display: grid;
    grid-template-columns: auto 1fr auto 5.5rem;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.75rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 0.75rem;
    color: var(--st-white);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .pl-board__row:hover,
  .pl-board__row:focus-visible {
    background: rgb(255 255 255 / 0.06);
  }
  .pl-board__name {
    font-family: var(--pl-font);
    font-size: 1.125rem;
    letter-spacing: var(--pl-track);
    text-transform: var(--pl-case);
  }
  .pl-board__dots {
    block-size: 1px;
    border-block-end: 1px dotted rgb(255 255 255 / 0.25);
    translate: 0 -0.25rem;
  }
  .pl-board__price {
    color: var(--st-gold);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .pl-board__time {
    color: var(--st-mute);
    font-size: 0.8125rem;
    text-align: end;
  }
  .pl-board__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 0.5rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--st-line-dark);
    color: var(--st-mute);
    font-size: 0.875rem;
  }
  .pl-board__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2.5rem;
    padding-inline: 1rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    background: none;
    color: var(--st-white);
    font-weight: 600;
    cursor: pointer;
  }
  .pl-board__wa:hover {
    border-color: var(--st-gold);
    color: var(--st-gold);
  }

  /* Live status light */
  .pl-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline: 0.5rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    color: var(--st-on-dark);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .pl-status__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--st-mute);
  }
  .pl-status[data-open='true'] .pl-status__dot {
    background: var(--pl-green);
    box-shadow: 0 0 0 0 rgb(74 222 128 / 0.6);
    animation: pl-pulse 2.4s ease-out infinite;
  }
  .pl-status[data-open='false'] .pl-status__dot {
    background: var(--pl-red);
  }
  @keyframes pl-pulse {
    70% {
      box-shadow: 0 0 0 0.5rem rgb(74 222 128 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(74 222 128 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pl-status__dot {
      animation: none !important;
    }
    .pl-island {
      transition: none;
    }
  }
  .pl-status__long {
    display: none;
  }

  .pl-lang {
    display: inline-grid;
    place-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.7rem;
    color: var(--st-white);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .pl-icon {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.06);
    color: var(--st-white);
    cursor: pointer;
  }
  .pl-icon:hover {
    background: rgb(255 255 255 / 0.14);
  }
  .pl-quote {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    margin-inline-start: 0.25rem;
    padding-inline: 1.25rem 1rem;
    border-radius: 999px;
    background: var(--st-gold);
    color: var(--st-black);
    font-family: var(--pl-font);
    font-weight: 500;
    letter-spacing: var(--pl-track);
    text-transform: var(--pl-case);
    text-decoration: none;
    white-space: nowrap;
  }
  .pl-quote:hover {
    background: #dcbb78;
  }
  .pl-wide {
    display: none;
  }

  @media (min-width: 64rem) {
    .pl-nav {
      display: block;
    }
    .pl-wide {
      display: inline-flex;
    }
    .pl-icon.pl-wide {
      display: inline-grid;
    }
    .pl-island {
      padding-inline-start: 1.5rem;
    }
  }
  @media (min-width: 64rem) and (max-width: 82rem) {
    /* Tight laptops: the short status and no phone icon keep the capsule on one line. */
    .pl-icon.pl-wide {
      display: none;
    }
  }
  @media (min-width: 82rem) {
    .pl-status__long {
      display: inline;
    }
    .pl-status__short {
      display: none;
    }
  }

  /* Phone dock */
  .pl-dock {
    position: fixed;
    inset: auto 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr auto 1fr 1fr;
    align-items: end;
    padding: 0.35rem 0.5rem max(0.35rem, env(safe-area-inset-bottom));
    border-block-start: 1px solid rgb(255 255 255 / 0.08);
    background: var(--pl-glass);
    backdrop-filter: blur(16px) saturate(1.3);
    color: var(--st-on-dark);
  }
  .pl-dock__btn {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    min-block-size: 3.25rem;
    padding: 0.35rem 0.1rem;
    border: 0;
    background: none;
    color: inherit;
    font-size: 0.6875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .pl-dock__btn :global(svg) {
    color: var(--st-white);
  }
  .pl-dock__quote {
    display: grid;
    place-items: center;
    align-self: center;
    block-size: 4rem;
    max-inline-size: 7.5rem;
    margin-block-start: -1.75rem;
    padding: 0.4rem 0.75rem;
    border: 4px solid var(--st-black);
    border-radius: 1.25rem;
    background: var(--st-gold);
    color: var(--st-black);
    font-family: var(--pl-font);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: var(--pl-track);
    text-align: center;
    text-transform: var(--pl-case);
    text-decoration: none;
    box-shadow: 0 8px 24px rgb(201 164 92 / 0.35);
  }
  @media (min-width: 64rem) {
    .pl-dock {
      display: none;
    }
  }
  /* Room for the dock at the end of the page. */
  @media (max-width: 63.99rem) {
    :global(body:has(.pl-dock)) {
      padding-block-end: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }

  /* Bottom sheets */
  .pl-sheet {
    inset: auto 0 0;
    margin: 0;
    inline-size: 100%;
    max-inline-size: none;
    max-block-size: 85dvh;
    padding: 0.5rem var(--st-pad) max(1.5rem, env(safe-area-inset-bottom));
    border: 0;
    border-radius: 1.5rem 1.5rem 0 0;
    background: var(--st-coal);
    color: var(--st-white);
    overflow-y: auto;
  }
  .pl-sheet::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(2px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pl-sheet[open] {
      animation: pl-up 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    @keyframes pl-up {
      from {
        translate: 0 100%;
      }
    }
  }
  .pl-sheet__grab {
    inline-size: 2.5rem;
    block-size: 0.25rem;
    margin: 0.25rem auto 0.75rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.25);
  }
  .pl-sheet__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
