---
/**
 * Header variant C, "Pillars": an editorial masthead. A paper-white bar with
 * the logo centred between two halves of the navigation, a brass line that
 * fills as you read and a running head naming the section you're in.
 * Services opens "the WRP index": a full-screen page set in three columns
 * under giant outlined W, R and P letters (Wrap, Reinforce, Protect, as the
 * live homepage groups them). Point at a service and its letter fills with
 * that car's photo.
 *
 * The pillar names link to the /wrap/, /reinforce/ and /protect/ pages, which
 * the live navigation doesn't link today.
 *
 * Every destination is a plain <a href> in the server HTML (the index is a
 * <dialog> that is only hidden until opened), so crawlers see the full link set.
 */
import Icon from '../Icon.astro';
import WrpLogo from '@/components/WrpLogo.astro';
import type { HeaderNav } from './nav';

interface Props {
  nav: HeaderNav;
  altHref: string;
  quoteHref: string;
}

const { nav, altHref, quoteHref } = Astro.props;
const w = nav.words;
const altLang = nav.locale === 'ar' ? 'en' : 'ar';
const [left, right] = [nav.pages.slice(0, 2), nav.pages.slice(2)];
---

<a class="skip" href="#main">{w.skip}</a>

<header class="pc" dir={nav.dir} lang={nav.locale} data-hdr="pillars" data-pc>
  <div class="st-wrap pc__inner">
    <div class="pc__side">
      <button class="pc__index" type="button" commandfor="pc-index" command="show-modal" aria-controls="pc-index" data-pc-open>
        <span class="pc__wrp" aria-hidden="true"><span>W</span><span>R</span><span>P</span></span>
        <span class="pc__index-label">{nav.servicesLabel}</span>
      </button>
      <nav class="pc__nav" aria-label="Main">
        <ul role="list">
          {left.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <a class="pc__logo" href={nav.home} aria-label={w.home}>
      <WrpLogo class="pc__mark" />
    </a>

    <div class="pc__side pc__side--end">
      <nav class="pc__nav" aria-label="More">
        <ul role="list">
          {right.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </nav>
      <a class="pc__lang" href={altHref} hreflang={altLang}>{nav.langLabel}</a>
      <a class="pc__quote" href={quoteHref}>
        <span class="pc__quote-label">{w.quote}</span>
        <Icon name="arrow-right" size={18} class="pc-arrow" />
      </a>
    </div>
  </div>
  <div class="pc__rule" aria-hidden="true">
    <span class="pc__progress" data-pc-progress></span>
    <span class="st-wrap pc__run"><span class="pc__run-tab" data-pc-run></span></span>
  </div>
</header>

<dialog class="pi" id="pc-index" dir={nav.dir} lang={nav.locale} aria-label={w.index}>
  <div class="st-wrap pi__top">
    <WrpLogo class="pi__mark" label="WRP by YACO Automotive" />
    <p class="pi__title">{w.index}</p>
    <button class="pi__close" type="button" commandfor="pc-index" command="close" data-pc-close>
      <span>{w.close}</span>
      <Icon name="close" size={22} />
    </button>
  </div>

  <nav class="st-wrap pi__cols" aria-label={nav.servicesLabel}>
    {
      nav.pillars.map((p) => (
        <section class="pi__col" data-pi-col>
          <p class="pi__letter" aria-hidden="true" data-pi-letter>
            {p.letter}
          </p>
          <h2 class="pi__pillar">
            <a href={p.href}>
              {p.name}
              <Icon name="arrow-right" size={14} class="pc-arrow" />
            </a>
          </h2>
          <ul role="list" class="pi__list">
            {p.services.map((s) => (
              <li>
                <a href={s.href} data-pi-shot={`${s.image}-800w.webp`}>
                  <span class="pi__name">{s.name}</span>
                  <span class="pi__price">{s.price}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>

  <div class="st-wrap pi__foot">
    <ul role="list" class="pi__pages">
      {nav.pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
    </ul>
    <div class="pi__contact">
      <a class="pi__cta" href={quoteHref}>{w.quote}<Icon name="arrow-right" size={18} class="pc-arrow" /></a>
      <button type="button" class="pi__wa" data-contact-modal data-pc-close-first><Icon name="whatsapp" size={18} />{w.whatsapp}</button>
      <a href={nav.phone.href}><Icon name="phone" size={16} /><bdo dir="ltr">{nav.phone.display}</bdo></a>
      <span>{nav.hours} · {w.closed}</span>
      <a href={altHref} hreflang={altLang} class="pi__lang">{nav.langLabel}</a>
    </div>
  </div>
</dialog>

<script>
  // Reading progress and the running head (the section now under the bar).
  const header = document.querySelector<HTMLElement>('[data-pc]');
  const bar = document.querySelector<HTMLElement>('[data-pc-progress]');
  const run = document.querySelector<HTMLElement>('[data-pc-run]');
  const sections = [...document.querySelectorAll<HTMLElement>('main section[aria-labelledby]')]
    .map((el) => ({ el, title: document.getElementById(el.getAttribute('aria-labelledby') ?? '')?.textContent?.trim() ?? '' }))
    .filter((s) => s.title);
  const tick = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    bar?.style.setProperty('--p', String(max > 0 ? window.scrollY / max : 0));
    header?.toggleAttribute('data-scrolled', window.scrollY > 24);
    const line = (header?.getBoundingClientRect().bottom ?? 0) + 8;
    const current = sections.filter((s) => s.el.getBoundingClientRect().top <= line).pop();
    if (run) run.textContent = window.scrollY > 200 && current ? current.title : '';
  };
  tick();
  window.addEventListener('scroll', () => requestAnimationFrame(tick), { passive: true });

  // The index: a modal <dialog> with Invoker Commands and a manual fallback.
  const index = document.getElementById('pc-index') as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>('[data-pc-open]');
  if (index && opener) {
    if (!('commandForElement' in HTMLButtonElement.prototype)) {
      opener.addEventListener('click', () => index.showModal());
      index.querySelector('[data-pc-close]')?.addEventListener('click', () => index.close());
    }
    const sync = () => opener.setAttribute('aria-expanded', String(index.open));
    sync();
    index.addEventListener('close', sync);
    new MutationObserver(sync).observe(index, { attributes: true, attributeFilter: ['open'] });
    index.querySelector('[data-pc-close-first]')?.addEventListener('click', () => index.close());

    // A service fills its pillar's letter with that car's photo.
    index.querySelectorAll<HTMLElement>('[data-pi-col]').forEach((col) => {
      const letter = col.querySelector<HTMLElement>('[data-pi-letter]');
      col.querySelectorAll<HTMLAnchorElement>('[data-pi-shot]').forEach((link) => {
        const fill = () => {
          letter?.style.setProperty('--shot', `url("${link.dataset.piShot}")`);
          letter?.setAttribute('data-filled', '');
        };
        link.addEventListener('pointerenter', fill);
        link.addEventListener('focus', fill);
      });
      const clear = () => letter?.removeAttribute('data-filled');
      col.addEventListener('pointerleave', clear);
      col.addEventListener('focusout', (event) => {
        if (!col.contains(event.relatedTarget as Node | null)) clear();
      });
    });
  }
</script>

<style>
  .skip {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--st-gold);
    color: var(--st-black);
    font-weight: 600;
  }
  .skip:focus {
    inset-block-start: 0.5rem;
  }

  .pc,
  .pi {
    --pc-font: var(--st-head-font);
    --pc-track: 0.12em;
    --pc-case: uppercase;
  }
  :is(.pc, .pi):lang(ar) {
    --pc-font: var(--font-ibm-plex-arabic), system-ui, sans-serif;
    --pc-track: 0;
    --pc-case: none;
    font-family: var(--font-ibm-plex-arabic), system-ui, sans-serif;
  }
  :global([dir='rtl'] .pc-arrow) {
    transform: scaleX(-1);
  }

  /* Masthead */
  .pc {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--st-paper);
    color: var(--st-ink);
    transition: box-shadow 0.3s ease;
  }
  .pc[data-scrolled] {
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
  }
  .pc__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-block-size: var(--st-head);
  }
  .pc__side {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pc__side--end {
    justify-content: flex-end;
  }
  .pc__logo {
    display: grid;
    align-content: center;
    min-block-size: 2.75rem;
    color: var(--st-ink);
  }
  .pc__mark {
    display: block;
    block-size: 2.6rem;
    inline-size: auto;
  }
  @media (min-width: 64rem) {
    .pc__mark {
      block-size: 3.1rem;
    }
  }

  .pc__index {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    padding: 0 0.9rem 0 0.5rem;
    border: 1px solid var(--st-ink);
    background: none;
    color: var(--st-ink);
    font-family: var(--pc-font);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--pc-track);
    text-transform: var(--pc-case);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .pc__index:dir(rtl) {
    padding: 0 0.5rem 0 0.9rem;
  }
  .pc__index:hover {
    background: var(--st-ink);
    color: var(--st-paper);
  }
  .pc__wrp {
    display: inline-flex;
    gap: 1px;
    font-family: var(--st-head-font);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .pc__wrp span {
    display: grid;
    place-items: center;
    inline-size: 1.35rem;
    block-size: 1.6rem;
    background: var(--st-ink);
    color: var(--st-paper);
    transition: background-color 0.2s ease;
  }
  .pc__index:hover .pc__wrp span {
    background: var(--st-gold);
    color: var(--st-black);
  }


  .pc__nav {
    display: none;
  }
  .pc__nav ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pc__nav a,
  .pc__lang {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.7rem;
    color: var(--st-ink);
    font-family: var(--pc-font);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--pc-track);
    text-transform: var(--pc-case);
    text-decoration: none;
  }
  .pc__nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0.7rem;
    inset-block-end: 0.55rem;
    block-size: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .pc__nav a:hover::after {
    transform: scaleX(1);
  }
  .pc__lang {
    display: none;
    color: var(--st-ink-2);
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.875rem;
  }

  .pc__quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding-inline: 0.75rem;
    background: var(--st-ink);
    color: var(--st-paper);
    font-family: var(--pc-font);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--pc-track);
    text-transform: var(--pc-case);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .pc__quote:hover {
    background: var(--st-gold);
    color: var(--st-black);
  }
  /* Phones: icon-only buttons, with the label kept for screen readers. */
  @media (max-width: 39.99rem) {
    .pc__index-label,
    .pc__quote-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (min-width: 40rem) {
    .pc__quote {
      padding-inline: 1.1rem 0.9rem;
    }
  }
  @media (min-width: 76rem) {
    .pc__nav,
    .pc__lang {
      display: block;
    }
    .pc__nav a {
      display: inline-flex;
    }
    .pc__lang {
      display: inline-flex;
    }
  }

  /* Hairline, reading progress and running head */
  .pc__rule {
    position: relative;
    block-size: 1px;
    background: var(--st-line-light);
  }
  .pc__progress {
    position: absolute;
    inset: 0;
    background: var(--st-gold-deep);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  .pc__progress:dir(rtl) {
    transform-origin: right;
  }
  /* Running head: a small tab hanging under the bar at the reading edge. */
  .pc__run {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 1px;
    pointer-events: none;
  }
  .pc__run-tab {
    display: inline-block;
    max-inline-size: min(28rem, 100%);
    padding: 0.3rem 0.75rem;
    overflow: hidden;
    background: var(--st-paper);
    color: var(--st-ink);
    font-family: var(--pc-font);
    font-size: 0.6875rem;
    letter-spacing: var(--pc-track);
    text-transform: var(--pc-case);
    text-overflow: ellipsis;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.2);
  }
  .pc__run-tab:empty {
    display: none;
  }
  .pc__run-tab::before {
    content: '§ ';
    color: var(--st-gold-deep);
  }

  /* The WRP index */
  .pi {
    inset: 0;
    margin: 0;
    inline-size: 100%;
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    padding: 0 0 6rem;
    border: 0;
    background: var(--st-black);
    color: var(--st-white);
    overflow-y: auto;
  }
  .pi::backdrop {
    background: var(--st-black);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pi[open] {
      animation: pi-curtain 0.5s cubic-bezier(0.7, 0, 0.2, 1);
    }
    .pi[open] .pi__col {
      animation: pi-rise 0.6s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    }
    .pi[open] .pi__col:nth-child(2) {
      animation-delay: 0.22s;
    }
    .pi[open] .pi__col:nth-child(3) {
      animation-delay: 0.29s;
    }
    @keyframes pi-curtain {
      from {
        clip-path: inset(0 0 100% 0);
      }
    }
    @keyframes pi-rise {
      from {
        opacity: 0;
        translate: 0 2rem;
      }
    }
  }
  .pi__top {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-block-size: var(--st-head);
    border-block-end: 1px solid var(--st-line-dark);
  }
  .pi__mark {
    block-size: 2.4rem;
    inline-size: auto;
  }
  .pi__title {
    margin-inline-start: auto;
    color: var(--st-mute);
    font-family: var(--pc-font);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: var(--pc-case);
    display: none;
  }
  .pi__close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-block-size: 2.75rem;
    margin-inline-start: auto;
    padding-inline: 0.9rem;
    border: 1px solid var(--st-line-dark);
    background: none;
    color: var(--st-white);
    font-family: var(--pc-font);
    font-size: 0.8125rem;
    letter-spacing: var(--pc-track);
    text-transform: var(--pc-case);
    cursor: pointer;
  }
  .pi__close span {
    display: none;
  }
  @media (min-width: 48rem) {
    .pi__title {
      display: block;
    }
    .pi__close {
      margin-inline-start: 1.5rem;
    }
    .pi__close span {
      display: inline;
    }
  }

  .pi__cols {
    display: grid;
    gap: 2rem;
    padding-block: 1.5rem 2.5rem;
  }
  .pi__col {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'letter pillar' 'letter list';
    align-items: start;
    align-content: start;
    column-gap: 1.25rem;
  }
  .pi__letter {
    grid-area: letter;
    margin: 0;
    font-family: var(--st-head-font);
    font-size: 6.5rem;
    font-weight: 700;
    line-height: 0.82;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--st-gold);
    background-position: center;
    background-size: cover;
    -webkit-background-clip: text;
    background-clip: text;
    transition: -webkit-text-stroke-color 0.3s ease;
  }
  .pi__letter[data-filled] {
    -webkit-text-stroke-color: transparent;
    background-image: linear-gradient(rgb(0 0 0 / 0.1), rgb(0 0 0 / 0.1)), var(--shot);
  }
  .pi__pillar {
    grid-area: pillar;
    margin-block-end: 0.5rem;
    color: var(--st-gold);
    font-family: var(--pc-font);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: var(--pc-case);
  }
  .pi__pillar a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    color: inherit;
    text-decoration: none;
  }
  .pi__pillar a:hover {
    color: var(--st-white);
  }
  .pi__list {
    grid-area: list;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pi__list a {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.6rem;
    border-block-end: 1px solid var(--st-line-dark);
    color: var(--st-white);
    text-decoration: none;
  }
  .pi__name {
    font-family: var(--pc-font);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: var(--pc-case);
    transition: color 0.2s ease;
  }
  .pi__list a:hover .pi__name,
  .pi__list a:focus-visible .pi__name {
    color: var(--st-gold);
  }
  .pi__price {
    color: var(--st-mute);
    font-size: 0.8125rem;
  }

  @media (min-width: 60rem) {
    .pi__cols {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      padding-block: 2.5rem 3rem;
    }
    .pi__col {
      grid-template-columns: 1fr;
      grid-template-areas: 'letter' 'pillar' 'list';
      padding-inline: 2rem;
      border-inline-start: 1px solid var(--st-line-dark);
    }
    .pi__col:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
    .pi__letter {
      font-size: clamp(10rem, 19vw, 17rem);
      margin-block-end: 1rem;
    }
    .pi__name {
      font-size: 1.625rem;
    }
  }

  .pi__foot {
    display: grid;
    gap: 1.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--st-line-dark);
  }
  .pi__pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pi__pages a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--st-white);
    font-family: var(--pc-font);
    font-size: 1.25rem;
    letter-spacing: var(--pc-track);
    text-transform: var(--pc-case);
    text-decoration: none;
  }
  .pi__pages a:hover {
    color: var(--st-gold);
  }
  .pi__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    color: var(--st-mute);
    font-size: 0.875rem;
  }
  .pi__contact > a,
  .pi__contact > span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-block-size: 2.75rem;
    color: inherit;
    text-decoration: none;
  }
  .pi__contact :global(svg) {
    color: var(--st-gold);
  }
  .pi__contact > .pi__cta {
    padding-inline: 1.25rem 1rem;
    background: var(--st-gold);
    color: var(--st-black);
    font-family: var(--pc-font);
    font-size: 0.9375rem;
    letter-spacing: var(--pc-track);
    text-transform: var(--pc-case);
  }
  .pi__contact > .pi__cta :global(svg) {
    color: inherit;
  }
  .pi__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-block-size: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--st-line-dark);
    background: none;
    color: var(--st-white);
    font-weight: 600;
    cursor: pointer;
  }
  .pi__lang {
    color: var(--st-white) !important;
    font-weight: 600;
  }
  @media (min-width: 60rem) {
    .pi__foot {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
