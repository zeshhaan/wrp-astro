---
import type { Locale } from "@/i18n/translations";
import { localizeUrl } from "@/i18n/utils";
import { getReviewsWithImages } from '@/lib/reviews';

/**
 * Third-party 3D models shown on this site. CC BY models must stay listed here
 * for as long as they are served, with the exact attribution the author asks for.
 * Only CC0 or CC BY (no NC, no ND) models are allowed.
 */
const models: { name: string; author: string; source: string; licence: string; licenceUrl: string; changes: string; changesAr: string }[] = [
  {
    name: '"Generic passenger car pack"',
    author: 'Comrade1280',
    source: 'https://skfb.ly/6sUFy',
    licence: 'CC BY 4.0',
    licenceUrl: 'https://creativecommons.org/licenses/by/4.0/',
    changesAr: 'عدّل فريق WRP اتجاه المجسّمات الأربعة، وقسّم الهياكل إلى أجزاء يمكنك تغيير لونها، ثم ضغط الملفات لتُعرض على الموقع.',
    changes: 'Modified by WRP: four bodies re-oriented, split into paintable panels and recompressed for the web.',
  },
];

const software: { name: string; licence: string; url: string }[] = [
  { name: 'Astro', licence: 'MIT', url: 'https://github.com/withastro/astro' },
  { name: 'React', licence: 'MIT', url: 'https://github.com/facebook/react' },
  { name: 'Alpine.js', licence: 'MIT', url: 'https://github.com/alpinejs/alpine' },
  { name: 'Tailwind CSS', licence: 'MIT', url: 'https://github.com/tailwindlabs/tailwindcss' },
  { name: 'Radix UI', licence: 'MIT', url: 'https://github.com/radix-ui/primitives' },
  { name: 'Lucide icons', licence: 'ISC', url: 'https://github.com/lucide-icons/lucide' },
  { name: 'three.js', licence: 'MIT', url: 'https://github.com/mrdoob/three.js' },
  { name: 'glTF Transform', licence: 'MIT', url: 'https://github.com/donmccurdy/glTF-Transform' },
  { name: 'meshoptimizer', licence: 'MIT', url: 'https://github.com/zeux/meshoptimizer' },
  { name: 'Yet Another React Lightbox', licence: 'MIT', url: 'https://github.com/igordanchenko/yet-another-react-lightbox' },
  { name: 'sharp', licence: 'Apache-2.0', url: 'https://github.com/lovell/sharp' },
];

const fonts = ['Playfair Display', 'Inter', 'Montserrat', 'Noto Naskh Arabic', 'IBM Plex Sans Arabic'];

const photographers = [...new Set(getReviewsWithImages().map((r) => r.reviewerName.trim()))].sort((a, b) =>
  a.localeCompare(b),
);
interface Props {
  locale?: Locale;
  link?: (href: string) => string;
}
const { locale = 'en', link = (href: string) => href } = Astro.props;
const ar = locale === 'ar';
const separator = ar ? '، ' : ', ';
---

<p>
  {ar ? 'نشكر كل من ساهم بصوره أو بتصميمه أو ببرامجه في هذا الموقع. إذا وجدت عملاً لك ولم نذكر اسمك بالشكل الصحيح، راسلنا على' : 'This website is built with work shared by other people. Thank you to everyone listed here. If you see your work on this site and it is not credited correctly, email'}{' '}
  <a href="mailto:info@wrpdetailing.ae">info@wrpdetailing.ae</a>{' '}
  {ar ? 'وسنصحّح ذلك.' : 'and we will fix it.'}
</p>

<h2>{ar ? 'مجسّمات السيارات ثلاثية الأبعاد' : '3D car models'}</h2>
<ul>
  {
    models.map((m) => (
      <li>
        <strong>{m.name}</strong> {ar ? 'من تصميم' : 'by'} {m.author}.{' '}
        {m.licenceUrl ? (
          <a href={m.licenceUrl} target="_blank" rel="noopener noreferrer">{m.licence}</a>
        ) : (
          m.licence
        )}
        {m.source && (
          <>
            {' '}·{' '}
            <a href={m.source} target="_blank" rel="noopener noreferrer">{ar ? 'المصدر' : 'Source'}</a>
          </>
        )}
        <br />
        <span>{ar ? m.changesAr : m.changes}</span>
      </li>
    ))
  }
</ul>

<h2>{ar ? 'صور عملائنا' : 'Customer photos'}</h2>
<p>
  {ar ? 'بعض صور الاستوديو والاستراحة والسيارات بعد انتهاء العمل نشرها عملاؤنا في تقييماتهم على Google. نشكرهم على مشاركة هذه الصور.' : 'Some photos of our studio, lounge and finished cars were shared by customers in their Google reviews. Thank you to:'}
</p>
<p>{photographers.join(separator)}.</p>

<h2>{ar ? 'الخطوط' : 'Fonts'}</h2>
<p>
  {fonts.join(separator)}{ar ? '، وكلها متاحة بموجب رخصة' : ', all under the'}
  <a href="https://openfontlicense.org/" target="_blank" rel="noopener noreferrer">SIL Open Font License 1.1</a>.
</p>

<h2>{ar ? 'البرامج مفتوحة المصدر' : 'Open-source software'}</h2>
<ul>
  {
    software.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a> ({s.licence})
      </li>
    ))
  }
</ul>

<p>
  {ar ? 'أسماء السيارات وطرازاتها ملك لأصحابها. نذكرها هنا للتعريف بالسيارات التي نعمل عليها. يمكنك أيضاً الاطلاع على' : 'Car makes and models named on this site belong to their owners and are mentioned only to describe the cars we work on. See also our'}{' '}
  <a href={link(localizeUrl('/privacy/', locale))}>{ar ? 'سياسة الخصوصية' : 'Privacy Policy'}</a>
  {ar ? ' و' : ' and '}
  <a href={link(localizeUrl('/terms/', locale))}>{ar ? 'شروط الاستخدام' : 'Terms'}</a>.
</p>
