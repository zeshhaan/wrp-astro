---
/**
 * Body of the live credits.astro (everything after its <h1>), word for word,
 * for the Studio legal page. Copied 2026-10-26; only the Tailwind classes are
 * gone and site links go through link() so previews stay in the Design Lab.
 */
import { getReviewsWithImages } from '@/lib/reviews';

/**
 * Third-party 3D models shown on this site. CC BY models must stay listed here
 * for as long as they are served, with the exact attribution the author asks for.
 * Only CC0 or CC BY (no NC, no ND) models are allowed.
 */
const models: { name: string; author: string; source: string; licence: string; licenceUrl: string; changes: string }[] = [
  {
    name: '"Generic passenger car pack"',
    author: 'Comrade1280',
    source: 'https://skfb.ly/6sUFy',
    licence: 'CC BY 4.0',
    licenceUrl: 'https://creativecommons.org/licenses/by/4.0/',
    changes: 'Modified by WRP: four bodies re-oriented, split into paintable panels and recompressed for the web.',
  },
];

const software: { name: string; licence: string; url: string }[] = [
  { name: 'Astro', licence: 'MIT', url: 'https://github.com/withastro/astro' },
  { name: 'React', licence: 'MIT', url: 'https://github.com/facebook/react' },
  { name: 'Alpine.js', licence: 'MIT', url: 'https://github.com/alpinejs/alpine' },
  { name: 'Tailwind CSS', licence: 'MIT', url: 'https://github.com/tailwindlabs/tailwindcss' },
  { name: 'Radix UI', licence: 'MIT', url: 'https://github.com/radix-ui/primitives' },
  { name: 'Lucide icons', licence: 'ISC', url: 'https://github.com/lucide-icons/lucide' },
  { name: 'three.js', licence: 'MIT', url: 'https://github.com/mrdoob/three.js' },
  { name: 'glTF Transform', licence: 'MIT', url: 'https://github.com/donmccurdy/glTF-Transform' },
  { name: 'meshoptimizer', licence: 'MIT', url: 'https://github.com/zeux/meshoptimizer' },
  { name: 'Yet Another React Lightbox', licence: 'MIT', url: 'https://github.com/igordanchenko/yet-another-react-lightbox' },
  { name: 'sharp', licence: 'Apache-2.0', url: 'https://github.com/lovell/sharp' },
];

const fonts = ['Playfair Display', 'Inter', 'Montserrat', 'Noto Naskh Arabic', 'IBM Plex Sans Arabic'];

const photographers = [...new Set(getReviewsWithImages().map((r) => r.reviewerName.trim()))].sort((a, b) =>
  a.localeCompare(b),
);
interface Props {
  link?: (href: string) => string;
}
const { link = (href: string) => href } = Astro.props;
---

<p>
  This website is built with work shared by other people. Thank you to everyone listed here. If you see your
  work on this site and it is not credited correctly, email
  <a href="mailto:info@wrpdetailing.ae">info@wrpdetailing.ae</a>
  and we will fix it.
</p>

<h2>3D car models</h2>
<ul>
  {
    models.map((m) => (
      <li>
        <strong>{m.name}</strong> by {m.author}.{' '}
        {m.licenceUrl ? (
          <a href={m.licenceUrl} target="_blank" rel="noopener noreferrer">{m.licence}</a>
        ) : (
          m.licence
        )}
        {m.source && (
          <>
            {' '}·{' '}
            <a href={m.source} target="_blank" rel="noopener noreferrer">Source</a>
          </>
        )}
        <br />
        <span>{m.changes}</span>
      </li>
    ))
  }
</ul>

<h2>Customer photos</h2>
<p>
  Some photos of our studio, lounge and finished cars were shared by customers in their Google reviews. Thank you to:
</p>
<p>{photographers.join(', ')}.</p>

<h2>Fonts</h2>
<p>
  {fonts.join(', ')}, all under the
  <a href="https://openfontlicense.org/" target="_blank" rel="noopener noreferrer">SIL Open Font License 1.1</a>.
</p>

<h2>Open-source software</h2>
<ul>
  {
    software.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a> ({s.licence})
      </li>
    ))
  }
</ul>

<p>
  Car makes and models named on this site belong to their owners and are mentioned only to describe the cars we work on.
  See also our <a href={link("/privacy/")}>Privacy Policy</a> and
  <a href={link("/terms/")}>Terms</a>.
</p>
