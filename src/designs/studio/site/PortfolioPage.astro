---
/**
 * Studio version of the portfolio (/portfolio/), English or Arabic: the live
 * page's copy word for word, then all our work in one masonry wall, each
 * photo tagged with its service. The photos are gathered from the whole site
 * wherever a `portfolio` switch says so (service pages, blog posts, reviews,
 * portfolio projects): see ./portfolio/work.ts. One lightbox holds them all.
 *
 * The wall is server-rendered in full (CSS columns without JavaScript). The
 * inline script lays it out Pinterest-style, left to right into the shortest
 * column, shows the first photos and adds more as the visitor scrolls.
 */
import StudioPage from './StudioPage.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import EndCta from './sections/EndCta.astro';
import Lightbox from './portfolio/Lightbox.astro';
import Picture from '../../shared/Picture.astro';
import { localizeUrl } from '@/i18n/utils';
import type { Locale } from '@/i18n/translations';
import { loadWork } from './portfolio/work';
import { isLabPath, studioQuoteHref, toLab } from './routes';
import { say, trail } from './say';

export type PortfolioCopy = {
  title: string;
  description: string;
  crumbs: string[];
  h1: string;
  lede: string;
  cta: { h2: string; text: string; button: string };
};

interface Props {
  copy: PortfolioCopy;
  locale?: Locale;
}

const { copy, locale = 'en' } = Astro.props;
const isLab = isLabPath(Astro.url.pathname);
const link = (href: string) => (isLab ? toLab(href) : href);
const { photos, slides, viewService } = await loadWork(locale);
---

<StudioPage title={copy.title} description={copy.description} locale={locale} livePath={localizeUrl('/portfolio/', locale)}>
  <section class="pf-hero">
    <div class="st-wrap pf-hero__inner">
      <Breadcrumbs crumbs={trail(locale, copy.crumbs, ['/', '/portfolio/'])} link={link} />
      <h1 class="pf-hero__title">{copy.h1}</h1>
      <p class="pf-hero__lede">{copy.lede}</p>
    </div>
  </section>

  <div class="pf st-black">
    <div class="st-wrap">
      <div class="pf__wall" role="list" aria-label={copy.h1} data-pf-wall>
        {
          photos.map((p, i) => (
            <div class="pf__item" role="listitem" data-pf-item style={`--r: ${(p.height / p.width).toFixed(4)}`}>
              <div class="pf__card">
                <Picture
                  base={p.base}
                  widths={p.widths}
                  alt={p.alt}
                  sizes="(min-width: 110rem) 20vw, (min-width: 80rem) 25vw, (min-width: 48rem) 33vw, 50vw"
                  width={p.width}
                  height={p.height}
                  loading={i < 4 ? 'eager' : 'lazy'}
                  class="pf__photo"
                />
                <span class="pf__tag">{p.service.short}</span>
                <div class="pf__caption">
                  <h2 class="pf__title">{p.title}</h2>
                  {p.note && <p class="pf__sub">{p.note}</p>}
                </div>
                <button type="button" class="pf__open" data-pf-open={i} aria-label={`${p.title}, ${p.service.short}`} />
              </div>
            </div>
          ))
        }
      </div>
      <div class="pf__end" data-pf-end aria-hidden="true"></div>
    </div>
  </div>
  <script is:inline>
    (() => {
      // Pinterest-style wall: photos go left to right (right to left in
      // Arabic) into the shortest column, judged by each photo's shape (--r =
      // height / width), so nothing moves once placed. The first FIRST photos
      // show at once; STEP more join each time the end of the wall nears.
      const FIRST = 16;
      const STEP = 12;
      const wall = document.querySelector('[data-pf-wall]');
      const end = document.querySelector('[data-pf-end]');
      if (!wall || !end || !('IntersectionObserver' in window)) return;
      const items = [...wall.querySelectorAll('[data-pf-item]')];
      const ratio = (el) => parseFloat(el.style.getPropertyValue('--r')) || 1;
      const cols = () => parseInt(getComputedStyle(wall).getPropertyValue('--cols'), 10) || 2;
      let shown = Math.min(FIRST, items.length);
      let lanes = [];
      let heights = [];
      const place = (from, to, fresh) => {
        for (let k = from; k < to; k++) {
          const lane = heights.indexOf(Math.min(...heights));
          heights[lane] += ratio(items[k]) + 0.04; // + the gap, roughly
          if (fresh) items[k].classList.add('is-new');
          lanes[lane].append(items[k]);
        }
      };
      const layout = () => {
        const n = cols();
        lanes = Array.from({ length: n }, () => {
          const lane = document.createElement('div');
          lane.className = 'pf__lane';
          lane.setAttribute('role', 'none');
          return lane;
        });
        heights = lanes.map(() => 0);
        place(0, shown, false);
        wall.replaceChildren(...lanes);
        wall.classList.add('is-lanes');
      };
      layout();
      let n = cols();
      addEventListener('resize', () => {
        if (cols() !== n) {
          n = cols();
          items.forEach((el) => el.classList.remove('is-new'));
          layout();
        }
      });
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          const next = Math.min(shown + STEP, items.length);
          place(shown, next, true);
          shown = next;
          io.unobserve(end);
          // Observing again reports at once if the end is still near, so a
          // tall screen keeps filling.
          if (shown < items.length) requestAnimationFrame(() => io.observe(end));
        },
        { rootMargin: '0px 0px 800px 0px' },
      );
      if (shown < items.length) io.observe(end);
    })();
  </script>

  <Lightbox slides={slides} label={copy.h1} linkLabel={viewService} />

  <EndCta heading={copy.cta.h2} text={copy.cta.text} button={say(locale, copy.cta.button)} href={studioQuoteHref} />
</StudioPage>

<style>
  .pf-hero {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    padding-block: 8.5rem 1rem;
    background: var(--st-black);
  }
  .pf-hero__inner {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .pf-hero__inner > :global(.crumbs) {
    margin-block-end: 0.75rem;
  }
  .pf-hero__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(2.8rem, 1.6rem + 5vw, 5.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .pf-hero__lede {
    max-inline-size: 40rem;
    color: var(--st-on-dark);
    font-size: 1.125rem;
  }

  .pf {
    padding-block: 2rem 4rem;
  }
  /* Columns: 2 on phones, then 3, 4 and 5 as the screen widens. Without
     JavaScript the wall is plain CSS columns; the script turns it into
     lanes filled left to right. */
  .pf__wall {
    --cols: 2;
    --gap: 0.5rem;
    columns: var(--cols);
    column-gap: var(--gap);
  }
  @media (min-width: 40rem) {
    .pf__wall {
      --gap: 1rem;
    }
  }
  @media (min-width: 48rem) {
    .pf__wall {
      --cols: 3;
    }
  }
  @media (min-width: 80rem) {
    .pf__wall {
      --cols: 4;
    }
  }
  @media (min-width: 110rem) {
    .pf__wall {
      --cols: 5;
    }
  }
  .pf__wall.is-lanes {
    display: flex;
    gap: var(--gap);
    align-items: flex-start;
    columns: auto;
  }
  .pf__wall :global(.pf__lane) {
    display: grid;
    flex: 1 1 0;
    gap: var(--gap);
    min-inline-size: 0;
  }
  .pf__item {
    break-inside: avoid;
    margin-block-end: var(--gap);
  }
  .is-lanes .pf__item {
    margin-block-end: 0;
  }
  .pf__item.is-new {
    animation: pf-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes pf-in {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }
  .pf__end {
    block-size: 1px;
  }
  .pf__card {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    position: relative;
    overflow: hidden;
    background: var(--st-coal);
    color: var(--st-white);
  }
  .pf__card :global(.pf__photo img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1 / var(--r);
    object-fit: cover;
    transition: transform 0.6s;
  }
  .pf__card:hover :global(.pf__photo img) {
    transform: scale(1.04);
  }
  /* The whole card opens the lightbox. */
  .pf__open {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .pf__open:focus-visible {
    outline-offset: -3px;
  }
  /* The service the photo shows, top corner. */
  .pf__tag {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    padding: 0.2rem 0.55rem;
    background: rgb(12 13 15 / 0.72);
    backdrop-filter: blur(6px);
    color: var(--st-white);
    font-family: var(--st-head-font);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-inline-start: 2px solid var(--st-red);
  }
  @media (min-width: 40rem) {
    .pf__tag {
      inset-block-start: 0.75rem;
      inset-inline-start: 0.75rem;
      font-size: 0.75rem;
    }
  }
  .pf__caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: grid;
    gap: 0.2rem;
    padding: 2.5rem 0.75rem 0.7rem;
    background: linear-gradient(to top, rgb(12 13 15 / 0.92), rgb(12 13 15 / 0.55) 60%, transparent);
  }
  @media (min-width: 40rem) {
    .pf__caption {
      padding: 3rem 1rem 0.9rem;
    }
  }
  .pf__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(0.9rem, 0.8rem + 0.4vw, 1.15rem);
    line-height: 1.15;
    text-transform: uppercase;
    /* Long blog titles stop at two lines. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .pf__sub {
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
    color: var(--st-on-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .pf__card :global(.pf__photo img) {
      transition: none;
    }
    .pf__item.is-new {
      animation: none;
    }
  }
</style>
