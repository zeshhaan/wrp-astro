---
/**
 * Studio version of the portfolio (/portfolio/), English or Arabic: the live
 * page's copy word for word, then our work grouped by service (PPF, ceramic
 * coating, window film, …), each group linking to its service page. The
 * photos are gathered from the whole site wherever a `portfolio` switch says
 * so (service pages, blog posts, reviews, portfolio projects): see
 * ./portfolio/work.ts. One lightbox holds every photo on the page.
 */
import StudioPage from './StudioPage.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import EndCta from './sections/EndCta.astro';
import Lightbox from './portfolio/Lightbox.astro';
import Picture from '../../shared/Picture.astro';
import Icon from '../Icon.astro';
import { localizeUrl, toLocalNum } from '@/i18n/utils';
import type { Locale } from '@/i18n/translations';
import { loadWork } from './portfolio/work';
import { isLabPath, studioQuoteHref, toLab } from './routes';
import { say, trail } from './say';

export type PortfolioCopy = {
  title: string;
  description: string;
  crumbs: string[];
  h1: string;
  lede: string;
  cta: { h2: string; text: string; button: string };
};

interface Props {
  copy: PortfolioCopy;
  locale?: Locale;
}

const { copy, locale = 'en' } = Astro.props;
const isLab = isLabPath(Astro.url.pathname);
const link = (href: string) => (isLab ? toLab(href) : href);
const num = (n: number) => toLocalNum(String(n), locale);
const { groups, slides, viewService } = await loadWork(locale);
---

<StudioPage title={copy.title} description={copy.description} locale={locale} livePath={localizeUrl('/portfolio/', locale)}>
  <section class="pf-hero">
    <div class="st-wrap pf-hero__inner">
      <Breadcrumbs crumbs={trail(locale, copy.crumbs, ['/', '/portfolio/'])} link={link} />
      <h1 class="pf-hero__title">{copy.h1}</h1>
      <p class="pf-hero__lede">{copy.lede}</p>
    </div>
  </section>

  <nav class="pf-jump" aria-label={copy.h1}>
    <div class="st-wrap">
      <ul class="pf-jump__list" role="list">
        {
          groups.map((g) => (
            <li>
              <a class="pf-jump__chip" href={`#${g.slug}`}>
                {g.short} <span class="pf-jump__n">{num(g.photos.length)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="pf st-black">
    {
      groups.map((g, gi) => (
        <section class="pf__group" id={g.slug} aria-labelledby={`${g.slug}-t`}>
          <div class="st-wrap">
            <header class="pf__head">
              <h2 class="pf__h2" id={`${g.slug}-t`}>
                {g.name}
              </h2>
              <span class="pf__count" aria-hidden="true">
                <Icon name="camera" size={16} /> {num(g.photos.length)}
              </span>
              <a class="pf__more" href={link(g.href)}>
                {viewService} <Icon name="arrow-right" size={18} class="flip" />
              </a>
            </header>
            <ul class="pf__grid" role="list">
              {g.photos.map((p, i) => (
                <li class="pf__item">
                  <div class="pf__card">
                    <Picture
                      base={p.base}
                      widths={p.widths}
                      alt={p.alt}
                      sizes="(min-width: 64rem) 33vw, 50vw"
                      width={p.width}
                      height={p.height}
                      loading={gi === 0 && i < 3 ? 'eager' : 'lazy'}
                      class="pf__photo"
                    />
                    <div class="pf__caption">
                      <h3 class="pf__title">{p.title}</h3>
                      {p.note && <p class="pf__sub">{p.note}</p>}
                    </div>
                    <button type="button" class="pf__open" data-pf-open={g.start + i} aria-label={p.title} />
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <Lightbox slides={slides} label={copy.h1} />

  <EndCta heading={copy.cta.h2} text={copy.cta.text} button={say(locale, copy.cta.button)} href={studioQuoteHref} />
</StudioPage>

<style>
  .pf-hero {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    padding-block: 8.5rem 1rem;
    background: var(--st-black);
  }
  .pf-hero__inner {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .pf-hero__inner > :global(.crumbs) {
    margin-block-end: 0.75rem;
  }
  .pf-hero__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(2.8rem, 1.6rem + 5vw, 5.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .pf-hero__lede {
    max-inline-size: 40rem;
    color: var(--st-on-dark);
    font-size: 1.125rem;
  }

  /* Service chips: jump to a group; sticky under the header while scrolling. */
  .pf-jump {
    position: sticky;
    inset-block-start: var(--st-head);
    z-index: 5;
    background: rgb(12 13 15 / 0.92);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--st-line-dark);
  }
  .pf-jump__list {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding-block: 0.75rem;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }
  .pf-jump__chip {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--st-line-dark);
    border-radius: 999px;
    background: var(--st-coal);
    color: var(--st-on-dark);
    font-family: var(--st-head-font);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s;
  }
  .pf-jump__chip:hover {
    border-color: var(--st-white);
    color: var(--st-white);
  }
  .pf-jump__n {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .pf {
    padding-block: 1rem 4rem;
  }
  .pf__group {
    padding-block-start: 3rem;
    scroll-margin-block-start: calc(var(--st-head) + 4.5rem);
  }
  .pf__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    margin-block-end: 1.25rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid var(--st-line-dark);
  }
  .pf__h2 {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .pf__count {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    color: var(--st-mute);
    font-size: 0.9375rem;
  }
  .pf__more {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    margin-inline-start: auto;
    color: var(--st-white);
    font-family: var(--st-head-font);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .pf__more:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  /* Two columns even on phones, so each service is a short scroll. */
  .pf__grid {
    columns: 2;
    column-gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .pf__grid {
      column-gap: 1rem;
    }
  }
  @media (min-width: 64rem) {
    .pf__grid {
      columns: 3;
    }
  }
  .pf__item {
    break-inside: avoid;
    margin-block-end: 0.5rem;
  }
  @media (min-width: 40rem) {
    .pf__item {
      margin-block-end: 1rem;
    }
  }
  .pf__card {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    position: relative;
    overflow: hidden;
    background: var(--st-coal);
    color: var(--st-white);
  }
  /* The whole card opens the lightbox. */
  .pf__open {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .pf__open:focus-visible {
    outline-offset: -3px;
  }
  .pf__card :global(.pf__photo img) {
    inline-size: 100%;
    block-size: auto;
    transition: transform 0.6s;
  }
  .pf__card:hover :global(.pf__photo img) {
    transform: scale(1.04);
  }
  .pf__caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: grid;
    gap: 0.2rem;
    padding: 2.5rem 0.75rem 0.7rem;
    background: linear-gradient(to top, rgb(12 13 15 / 0.92), rgb(12 13 15 / 0.55) 60%, transparent);
  }
  @media (min-width: 40rem) {
    .pf__caption {
      padding: 3.5rem 1.25rem 1.1rem;
    }
  }
  .pf__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(0.95rem, 0.8rem + 0.7vw, 1.4rem);
    line-height: 1.15;
    text-transform: uppercase;
    /* Long blog titles stop at two lines. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .pf__sub {
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    color: var(--st-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .pf__card :global(.pf__photo img),
    .pf-jump__chip {
      transition: none;
    }
  }
</style>
