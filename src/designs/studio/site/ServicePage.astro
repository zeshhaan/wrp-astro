---
/**
 * Studio service page. Renders one entry of the `services` collection with
 * exactly the copy, structure and structured data of the live
 * src/pages/services/[slug].astro (same sections, same order, same headings,
 * same fallbacks, Service + BreadcrumbList + FAQPage JSON-LD), in Studio's
 * design. Only the look changes: nothing here is new copy.
 *
 * Arabic follows the live src/pages/ar/services/[slug].astro, which differs
 * from the English page in places (no work gallery, its own quick answer,
 * headings from translations, prices in د.إ): `ar` marks each difference.
 */
import type { CollectionEntry } from 'astro:content';
import StudioPage from './StudioPage.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PageHero from './sections/PageHero.astro';
import WorkGallery from './sections/WorkGallery.astro';
import ReviewQuote from './sections/ReviewQuote.astro';
import ReviewCards from './sections/ReviewCards.astro';
import PostCards from './sections/PostCards.astro';
import ServiceCards from './sections/ServiceCards.astro';
import LeadForm from './sections/LeadForm.astro';
import Faq from './sections/Faq.astro';
import EndCta from './sections/EndCta.astro';
import Picture from '../../shared/Picture.astro';
import Icon from '../Icon.astro';
import LucideIcon from '@/components/Icon.astro';
import ServiceSchema from '@/components/ServiceSchema.astro';
import { localizeUrl, toLocalNum } from '@/i18n/utils';
import { t, type Locale } from '@/i18n/translations';
import { isLabPath, studioQuoteHref, toLab } from './routes';
import { fillSpans } from './fill';
import Swap from './sections/Swap.astro';

interface Props {
  service: CollectionEntry<'services'>;
  locale?: Locale;
  /** The quote form on the right of the hero (default). False puts a quote button there instead. */
  heroForm?: boolean;
}

const { service, locale = 'en', heroForm = true } = Astro.props;
const slug = service.id.replace(/^ar\//, '');
const isLab = isLabPath(Astro.url.pathname);
const link = (href: string) => (isLab ? toLab(href) : href);
const {
  title,
  subtitle,
  description,
  heroImage,
  metaTitle,
  heroTitle,
  heroDescription,
  realTimeWork,
  mainHeading,
  mainDescription1,
  mainDescription2,
  mainImage,
  mainImageAlt,
  iconFeatures,
  startingPrice,
  showPackages,
  packagesHeading,
  packagesSubheading,
  packages,
  comparison,
  additionalSection,
  processHeading,
  processSubheading,
  process,
  benefits,
  benefitsHeading,
  faqs,
  ctaHeading,
  ctaDescription,
} = service.data;

// The live page's fixed strings, word for word.
const words = {
  en: {
    quickAnswer: 'Quick answer',
    getQuote: 'GET A QUOTE',
    whyChoose: 'Why Choose WRP',
    whyService: 'Why Choose This Service?',
    benefitsSub: "The ultimate protection for Dubai's luxury vehicles",
    solution: 'Solution:',
    packages: 'Our Packages',
    packagesSub: 'Choose the package that best suits your needs',
    sedan: 'Sedan',
    suv: 'SUV',
    getStarted: 'GET STARTED',
    compare: 'Compare levels',
    included: 'Included',
    notIncluded: 'Not included',
    pricing: 'PRICING',
    startingFrom: 'Starting from AED',
    pricingNote: 'Every vehicle is unique. Contact us for a personalized assessment and detailed quote tailored to your car.',
    getYourQuote: 'GET YOUR QUOTE',
    callUs: 'CALL US',
    process: 'Our Process',
    processSub: 'Step by step excellence',
    ctaDescription: 'Our team will help you find the perfect solution',
    experience: (name: string) => `Experience ${name}`,
    reviewsHeading: (name: string) => `What Clients Say About ${name}`,
    heroAlt: (name: string, sub: string) =>
      `${name} service - Professional automotive ${sub.toLowerCase()} at WRP Detailing Studio luxury car detailing studio`,
  },
} as const;
const w = words.en;
const ar = locale === 'ar';
const num = (n: string | number) => toLocalNum(n, locale);
/** A price as each live page writes it: "AED 1,500" or "١٬٥٠٠ د.إ". */
const money = (n: number) => (ar ? `${num(n.toLocaleString())} د.إ` : `AED ${n.toLocaleString()}`);

const imgBase = (src: string) => src.replace(/\.(jpe?g|png|webp|avif)$/i, '');

// Same values as the live page (OG card, schema price range, quick answer, crumbs).
const ogImage = `/og/service/${slug}.jpg`;
const hasRealPricing = startingPrice || (packages && packages.length > 0);
const lowPrice = hasRealPricing ? startingPrice || Math.min(...packages!.map((p) => p.price)) : undefined;
const highPrice = hasRealPricing
  ? packages && packages.length > 0
    ? Math.max(...packages.map((p) => Math.max(p.price, p.priceSuv ?? p.price)))
    : lowPrice! * 4
  : undefined;
const quickAnswerDescription = description ? `${description.charAt(0).toLowerCase()}${description.slice(1).replace(/\.$/, '')}` : title;
const quickAnswer = ar
  ? `إجابة سريعة: خدمة ${title} في WRP Detailing Studio بدبي مناسبة لمن يريد ${description ? description.replace(/\.$/, '') : title}.${startingPrice ? ` الأسعار تبدأ من ${num(startingPrice.toLocaleString())} د.إ.` : ''}`
  : service.data.quickAnswer
    ? service.data.quickAnswer
    : `${title} at WRP Detailing Studio in Dubai is for owners who want ${quickAnswerDescription}.${startingPrice ? ` Pricing starts from AED ${startingPrice.toLocaleString()}.` : ''}`;
const quickLabel = ar ? 'إجابة سريعة' : w.quickAnswer;
const getQuote = ar ? t(locale, 'services.getQuote') : w.getQuote;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://wrpdetailing.ae';
const breadcrumbs = [
  { name: t(locale, 'common.home'), url: `${siteUrl}${localizeUrl('/', locale)}` },
  { name: t(locale, 'nav.services'), url: `${siteUrl}${localizeUrl('/#services', locale)}` },
  { name: title, url: `${siteUrl}${localizeUrl(`/services/${slug}/`, locale)}` },
];
const heroBase = imgBase(heroImage);
// With a form in the hero, every quote button on the page leads to it instead
// of the separate quote page (and the hero drops its own button).
const quoteHref = heroForm ? '#quote' : studioQuoteHref;
---

<StudioPage
  title={ar ? `${title} | WRP Detailing Studio` : metaTitle || `${title} | WRP Detailing Studio`}
  description={description}
  ogImage={ogImage}
  locale={locale}
  heroForm={heroForm}
  livePath={`${localizeUrl(`/services/${slug}/`, locale)}`}
  preloads={[
    {
      href: `${heroBase}-1200w.avif`,
      type: 'image/avif',
      imagesrcset: `${heroBase}-800w.avif 800w, ${heroBase}-1200w.avif 1200w`,
      imagesizes: '100vw',
    },
  ]}
>
  <ServiceSchema
    serviceName={title}
    serviceType={title}
    description={description}
    lowPrice={lowPrice}
    highPrice={highPrice}
    serviceUrl={`https://wrpdetailing.ae${localizeUrl(`/services/${slug}/`, locale)}`}
  />

  <PageHero
    image={heroBase}
    imageAlt={ar ? title : w.heroAlt(title, subtitle)}
    eyebrow={subtitle}
    title={(!ar && heroTitle) || title}
    lede={(!ar && heroDescription) || description}
    long={!ar && Boolean(heroTitle)}
  >
    <Breadcrumbs slot="crumbs" crumbs={breadcrumbs} link={link} />
    {
      heroForm ? (
        <LeadForm slot="aside" service={title} locale={locale} />
      ) : (
        <a class="st-btn st-btn--primary" href={quoteHref} data-quote>
          {getQuote}
          <Icon name="arrow-right" size={18} class="flip" />
        </a>
      )
    }
  </PageHero>

  <section class="qa st-light" aria-label={quickLabel}>
    <div class="st-wrap">
      <div class="qa__card">
        <p class="st-eyebrow st-eyebrow--dark">{quickLabel}</p>
        <p class="qa__text">{quickAnswer}</p>
      </div>
    </div>
  </section>

  {
    mainHeading && mainDescription1 && (
      <section class="intro st-section st-light">
        <div class="st-wrap intro__grid">
          <div class="intro__text">
            <h2 class="st-h2">{mainHeading}</h2>
            <p class="intro__p">{mainDescription1}</p>
            {mainDescription2 && <p class="intro__p">{mainDescription2}</p>}
            {iconFeatures && iconFeatures.length > 0 && (
              <ul class="feats" role="list">
                {iconFeatures.map((feature) => (
                  <li class="feat">
                    <span class="feat__icon">
                      <LucideIcon name={`lucide:${feature.icon}`} width="22" height="22" />
                    </span>
                    <div>
                      <h3 class="feat__title">{feature.title}</h3>
                      <p class="feat__desc">{feature.description}</p>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <Picture
            base={imgBase(mainImage || heroImage)}
            alt={mainImageAlt || (ar ? title : `${title} Detail`)}
            sizes="(min-width: 56rem) 45vw, 100vw"
            width={1200}
            height={1500}
            class="intro__img"
          />
        </div>
      </section>
    )
  }

  {/* Arabic puts the packages, comparison and price before these, as live does. */}
  <Swap swap={ar}>
    <Fragment slot="a">
      {
        additionalSection && (
          <section class="cards st-section st-dark">
            <div class="st-wrap">
              <header class="st-head st-head--center">
                <h2 class="st-h2">{additionalSection.heading || (ar ? '' : w.whyChoose)}</h2>
                {additionalSection.subheading && <p class="st-intro">{additionalSection.subheading}</p>}
              </header>
              <div class="fill">
              <ul class="fill__grid" role="list">
                {additionalSection.cards.map((card, i, all) => (
                  <li class="cell" style={fillSpans(all.length, 2)[i].style}>
                    <article class:list={['card', card.image && 'card--photo']}>
                    {card.image && (
                      <Picture
                        base={imgBase(card.image)}
                        alt={card.imageAlt || card.title}
                        sizes="(min-width: 56rem) 40vw, 100vw"
                        widths={[480, 800]}
                        width={800}
                        height={500}
                        class="card__img"
                      />
                    )}
                    <div class="card__body">
                      <h3 class="card__title">{card.title}</h3>
                      <p class="card__desc">{card.description}</p>
                      {!ar && card.solution && (
                        <p class="card__solution">
                          {w.solution} {card.solution}
                        </p>
                      )}
                    </div>
                    </article>
                  </li>
                ))}
              </ul>
              </div>
            </div>
          </section>
        )
      }

      {
        benefits && benefits.length > 0 && !additionalSection && (
          <section class="cards st-section st-dark">
            <div class="st-wrap">
              <header class="st-head st-head--center">
                <h2 class="st-h2">{benefitsHeading || (ar ? t(locale, 'services.benefits') : w.whyService)}</h2>
                {!ar && <p class="st-intro">{w.benefitsSub}</p>}
              </header>
              <div class="fill">
              <ol class="fill__grid" role="list">
                {benefits.map((benefit, i, all) => (
                  <li class="cell" style={fillSpans(all.length, 3)[i].style}>
                    <article class="card card--num">
                    <div class="card__body">
                      <span class="card__num" aria-hidden="true">{num(String(i + 1).padStart(2, '0'))}</span>
                      <h3 class="card__title">{benefit.title}</h3>
                      <p class="card__desc">{benefit.description}</p>
                    </div>
                    </article>
                  </li>
                ))}
              </ol>
              </div>
            </div>
          </section>
        )
      }

      {
        !ar && realTimeWork && realTimeWork.items.length > 0 && (
          <WorkGallery heading={realTimeWork.heading} subheading={realTimeWork.subheading} items={realTimeWork.items} name={title} class="st-white" />
        )
      }
    </Fragment>
    <Fragment slot="b">
      {
        showPackages && packages && packages.length > 0 && (
          <section class="pk st-section st-light">
            <div class="st-wrap">
              <header class="st-head st-head--center">
                <h2 class="st-h2">{packagesHeading || (ar ? t(locale, 'services.process') : w.packages)}</h2>
                {(packagesSubheading || !ar) && <p class="st-intro">{packagesSubheading || w.packagesSub}</p>}
              </header>
              <ul class="pk__grid" role="list">
                {packages.map((pkg) => (
                  <li class:list={['pk__card', pkg.badge && 'pk__card--pick']}>
                    {pkg.badge && <p class="pk__badge">{pkg.badge}</p>}
                    <h3 class="pk__name">{pkg.name}</h3>
                    {pkg.tagline && <p class="pk__tag">{pkg.tagline}</p>}
                    {pkg.priceSuv ? (
                      <div class="pk__prices">
                        <p>
                          <span class="pk__body">{ar ? t(locale, 'services.sedan') : w.sedan}</span>
                          <span class="pk__price">{money(pkg.price)}</span>
                        </p>
                        <p>
                          <span class="pk__body">{ar ? t(locale, 'services.suv') : w.suv}</span>
                          <span class="pk__price">{money(pkg.priceSuv)}</span>
                        </p>
                      </div>
                    ) : (
                      <p class="pk__price pk__price--one">{money(pkg.price)}</p>
                    )}
                    <ul class="pk__feats" role="list">
                      {pkg.features.map((feature) => (
                        <li>
                          <Icon name="check" size={18} />
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                    <a class:list={['st-btn', pkg.badge ? 'st-btn--primary' : 'st-btn--dark']} href={quoteHref} data-quote>
                      {ar ? t(locale, 'services.bookNow') : w.getStarted}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      {
        comparison && comparison.rows.length > 0 && (
          <section class="cmp st-section st-white">
            <div class="st-wrap">
              <header class="st-head st-head--center">
                <h2 class="st-h2">{comparison.heading || (ar ? '' : w.compare)}</h2>
                {comparison.subheading && <p class="st-intro">{comparison.subheading}</p>}
              </header>
              <div class="cmp__scroll" tabindex="0" role="region" aria-label={comparison.heading || w.compare}>
                <table class="cmp__table">
                  <thead>
                    <tr>
                      <th scope="col">{ar ? t(locale, 'services.included') : w.included}</th>
                      {comparison.columns.map((col) => (
                        <th scope="col">{col}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {comparison.rows.map((row) => (
                      <tr>
                        <th scope="row">
                          <span>{row.label}</span>
                          {row.note && <span class="cmp__note">{row.note}</span>}
                        </th>
                        {row.values.map((value) => (
                          <td>
                            {value === 'yes' ? (
                              <>
                                <Icon name="check" size={18} class="cmp__yes" />
                                <span class="visually-hidden">{ar ? t(locale, 'services.included') : w.included}</span>
                              </>
                            ) : value === 'no' ? (
                              <>
                                <span aria-hidden="true" class="cmp__no">
                                  &mdash;
                                </span>
                                <span class="visually-hidden">{ar ? t(locale, 'services.notIncluded') : w.notIncluded}</span>
                              </>
                            ) : (
                              <span class="cmp__val">{value}</span>
                            )}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>
        )
      }

      {
        !showPackages && startingPrice && (
          <section class="price st-section st-black">
            <div class="st-wrap price__inner">
              <p class="st-eyebrow">{ar ? t(locale, 'services.startingFrom').toUpperCase() : w.pricing}</p>
              <p class="price__amount">{ar ? money(startingPrice) : `${w.startingFrom} ${startingPrice.toLocaleString()}`}</p>
              {!ar && <p class="price__note">{w.pricingNote}</p>}
              <div class="price__actions">
                <a class="st-btn st-btn--primary" href={quoteHref} data-quote>
                  {ar ? getQuote : w.getYourQuote}
                  <Icon name="arrow-right" size={18} class="flip" />
                </a>
                {!ar && (
                  <a class="st-btn st-btn--ghost" href="https://dub.sh/wrp-phone" target="_blank" rel="noopener noreferrer">
                    <Icon name="phone" size={18} />
                    {w.callUs}
                  </a>
                )}
              </div>
            </div>
          </section>
        )
      }
    </Fragment>
  </Swap>

  {
    process && process.length > 0 && (
      <section class="steps st-section st-white">
        <div class="st-wrap">
          <header class="st-head st-head--center">
            <h2 class="st-h2">{processHeading || (ar ? t(locale, 'services.process') : w.process)}</h2>
            {(processSubheading || !ar) && <p class="st-intro">{processSubheading || w.processSub}</p>}
          </header>
          <div class="steps__box">
          <ol class="steps__list" role="list" style={`--n:${process.length}`}>
            {process.map((step) => (
              <li class="step">
                <span class="step__num">{num(String(step.step).padStart(2, '0'))}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__desc">{step.description}</p>
              </li>
            ))}
          </ol>
          </div>
        </div>
      </section>
    )
  }

  <Faq
    heading={t(locale, 'services.faqs')}
    items={faqs.map((faq) => ({ q: faq.question, a: faq.answer }))}
    schema={{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }}
  >
    {
      !ar && (
        <>
          {t(locale, 'services.faqMore')} <a href={link(localizeUrl('/contact-us/', locale))}>{t(locale, 'services.faqContact')}</a>
        </>
      )
    }
  </Faq>

  <ReviewQuote serviceSlug={slug} locale={locale} />
  <ReviewCards serviceSlug={slug} heading={ar ? title : w.reviewsHeading(title)} locale={locale} link={link} />
  <PostCards serviceId={slug} locale={locale} link={link} />
  <ServiceCards currentService={slug} locale={locale} link={link} />

  <EndCta
    heading={ctaHeading || (ar ? title : w.experience(title))}
    text={ctaDescription || (ar ? t(locale, 'contact.teamReady') : w.ctaDescription)}
    button={getQuote}
    href={quoteHref}
  />
</StudioPage>

<style>
  /* Quick answer: a card that overlaps the bottom of the hero. */
  .qa {
    padding-block-end: 0.5rem;
  }
  .qa__card {
    position: relative;
    display: grid;
    gap: 0.6rem;
    max-inline-size: 56rem;
    margin-block-start: -2.5rem;
    padding: 1.5rem 1.5rem 1.6rem;
    background: var(--st-white);
    border-inline-start: 4px solid var(--st-accent);
    box-shadow: 0 18px 40px -24px rgb(12 13 15 / 0.45);
  }
  .qa__text {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
    color: var(--st-ink);
  }
  @media (min-width: 48rem) {
    .qa__card {
      padding: 2rem 2.25rem;
    }
  }

  /* What it is: text beside a tall photo. */
  .intro__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .intro__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4.5rem;
    }
  }
  .intro__text {
    display: grid;
    gap: 1.25rem;
  }
  .intro__p {
    color: var(--st-ink-2);
    font-size: 1.0625rem;
  }
  .intro :global(.intro__img img) {
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .feats {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1.25rem 1.5rem;
    margin: 0.75rem 0 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-block-start: 1px solid var(--st-line-light);
  }
  .feat {
    display: flex;
    gap: 0.85rem;
    align-items: start;
  }
  .feat__icon {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    background: var(--st-black);
    color: var(--st-accent);
  }
  .feat__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .feat__desc {
    font-size: 0.9rem;
    color: var(--st-ink-2);
  }

  /* Why-us / benefit cards on dark. Each card responds to its own width. */
  .cell {
    container-type: inline-size;
    display: flex;
  }
  .card {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--st-card-dark);
    border-block-end: 3px solid var(--st-accent);
  }
  .card :global(.card__img img) {
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .card__body {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.5rem;
  }
  .card__num {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 2rem;
    line-height: 1;
    color: var(--st-accent);
  }
  .card__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .card__desc {
    color: var(--st-on-dark);
    font-size: 0.9625rem;
  }
  .card__solution {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--st-mute);
  }
  @container (min-width: 30rem) {
    .card__body {
      padding: 2rem;
    }
    .card__title {
      font-size: 1.55rem;
    }
  }
  /* A card given a whole row turns sideways: photo beside the text. */
  @container (min-width: 44rem) {
    .card--photo {
      flex-direction: row;
    }
    .card--photo :global(.card__img) {
      flex: 0 0 50%;
    }
    .card--photo :global(.card__img img) {
      block-size: 100%;
      aspect-ratio: auto;
      min-block-size: 18rem;
    }
    .card__body {
      align-content: center;
      padding: 2.5rem;
    }
  }

  /* Packages. */
  .pk__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }
  .pk__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 2rem 1.75rem 1.75rem;
    background: var(--st-white);
    border: 1px solid var(--st-line-light);
    border-block-start: 4px solid var(--st-ink);
  }
  .pk__card--pick {
