---
/**
 * The hero lead form, in four candidate layouts (picked in the Design Lab):
 *
 *  a "Card"      A white card: name, mobile, car, one button. The plain default.
 *  b "Two-step"  Dark glass panel. Step 1 asks only about the car (and the
 *                level, when the service has levels); step 2 asks who to reply
 *                to. A small first ask that people finish more often.
 *  c "Callback"  The least typing: a mobile number and "Call me back", with a
 *                "WhatsApp me instead" switch. For people who'd rather talk.
 *  d "Choices"   Taps before typing: car size and how to reply are chips, then
 *                name, mobile and car.
 *
 * All four post the same fields (name, phone, vehicle, service, plus
 * level/size/reply where asked) with the visitor's attribution, and fire the
 * `wrp:lead` event the live forms fire. On a Design Lab page the form is a
 * mock-up (`data-demo-form`): it validates and shows the thank-you state but
 * sends nothing. When the redesign goes live it posts to the lead handler.
 *
 * Plain HTML first: native validation (styled only after the visitor has
 * touched a field, via :user-invalid), the right mobile keyboards and
 * autofill (inputmode/autocomplete), and a real <form> that works without
 * the script. The script adds the steps, the inline errors and the
 * no-reload submit.
 */
import Icon from '../../Icon.astro';
import { contact, proof, whatsappLink } from '../../../data';

export type LeadVariant = 'a' | 'b' | 'c' | 'd';

interface Props {
  variant: LeadVariant;
  /** The service this page is about, sent with the lead. */
  service: string;
  /** Levels the visitor can pick from in the two-step form (package names). */
  levels?: string[];
  /** Mock-up only: never sends. True on Design Lab pages. */
  demo?: boolean;
  id?: string;
}

const { variant, service, levels = [], demo = true, id = 'quote' } = Astro.props;
const wa = whatsappLink(`Hi WRP, I would like a quote for ${service}.`);
const f = (name: string) => `${id}-${name}`;

const words = {
  title: 'Get a quick quote',
  lede: 'Tell us the car and what you want done. We’ll reply with a price and a time.',
  name: 'Your name',
  phone: 'Mobile or WhatsApp',
  phoneHint: '05X XXX XXXX',
  car: 'Car (make, model, year)',
  carHint: 'e.g. Land Cruiser 2024',
  send: 'Get my quote',
  next: 'Next',
  back: 'Back',
  step: (n: number) => `Step ${n} of 2`,
  stepCar: 'What car is it?',
  stepYou: 'Where should we send the price?',
  level: 'Which level?',
  levelUnsure: 'Not sure',
  callTitle: 'Want a price? We’ll call you.',
  callLede: 'Leave your number and we’ll call you back with a price.',
  callMe: 'Call me back',
  waInstead: 'WhatsApp me instead',
  size: 'Car size',
  sizes: ['Sedan', 'SUV', 'Other'],
  reply: 'Reply by',
  replies: ['WhatsApp', 'Phone call'],
  or: 'or',
  waUs: 'WhatsApp us',
  rating: `${proof.rating} on Google · ${proof.reviewCountDisplay} reviews`,
  thanks: 'Thank you. We’ve got it.',
  thanksLine: 'We’ll reply with a price and a time.',
  demoNote: 'Design preview: nothing was sent.',
  error: 'Something went wrong. Please WhatsApp or call us.',
  required: 'Please fill this in.',
  phoneInvalid: 'Please enter a mobile number.',
};
---

<form
  id={id}
  class:list={['lf', `lf--${variant}`]}
  method="post"
  action="/api/contact"
  aria-labelledby={f('title')}
  data-lead
  data-lead-variant={variant}
  data-demo-form={demo ? '' : undefined}
  data-msg-required={words.required}
  data-msg-phone={words.phoneInvalid}
  data-msg-error={words.error}
>
  <input type="hidden" name="service" value={service} />
  <input type="hidden" name="locale" value="en" />

  <div class="lf__body" data-lead-body>
    {
      variant === 'a' && (
        <>
          <header class="lf__head">
            <h2 id={f('title')} class="lf__title">{words.title}</h2>
            <p class="lf__lede">{words.lede}</p>
          </header>
          <div class="lf__field">
            <label for={f('name')}>{words.name}</label>
            <input id={f('name')} name="name" type="text" autocomplete="name" required enterkeyhint="next" />
          </div>
          <div class="lf__field">
            <label for={f('phone')}>{words.phone}</label>
            <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder={words.phoneHint} pattern="[+0-9 ()\-]{7,}" required enterkeyhint="next" />
          </div>
          <div class="lf__field">
            <label for={f('car')}>{words.car}</label>
            <input id={f('car')} name="vehicle" type="text" autocomplete="off" placeholder={words.carHint} enterkeyhint="send" />
          </div>
          <button class="st-btn st-btn--gold lf__send" type="submit">
            {words.send} <Icon name="arrow-right" size={18} class="flip" />
          </button>
          <p class="lf__alt">
            {words.or} <a href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />{words.waUs}</a>
            <span class="lf__dot" aria-hidden="true">·</span>
            <span class="lf__stars" aria-hidden="true"><Icon name="star" size={13} /></span>{words.rating}
          </p>
        </>
      )
    }

    {
      variant === 'b' && (
        <>
          <header class="lf__head">
            <p class="lf__step" data-lead-steplabel>{words.step(1)}</p>
            <h2 id={f('title')} class="lf__title">{words.title}</h2>
            <span class="lf__bar" aria-hidden="true"><span data-lead-progress /></span>
          </header>
          <fieldset class="lf__pane" data-lead-step="1">
            <legend class="lf__q">{words.stepCar}</legend>
            <div class="lf__field">
              <label for={f('car')}>{words.car}</label>
              <input id={f('car')} name="vehicle" type="text" autocomplete="off" placeholder={words.carHint} required enterkeyhint="next" />
            </div>
            {levels.length > 0 && (
              <fieldset class="lf__chips">
                <legend>{words.level}</legend>
                {[...levels, words.levelUnsure].map((level, i) => (
                  <label class="lf__chip">
                    <input type="radio" name="level" value={level} checked={i === levels.length} />
                    <span>{level}</span>
                  </label>
                ))}
              </fieldset>
            )}
            <button class="st-btn st-btn--gold lf__send" type="button" data-lead-next>
              {words.next} <Icon name="arrow-right" size={18} class="flip" />
            </button>
          </fieldset>
          <fieldset class="lf__pane" data-lead-step="2" hidden>
            <legend class="lf__q">{words.stepYou}</legend>
            <div class="lf__field">
              <label for={f('name')}>{words.name}</label>
              <input id={f('name')} name="name" type="text" autocomplete="name" required enterkeyhint="next" />
            </div>
            <div class="lf__field">
              <label for={f('phone')}>{words.phone}</label>
              <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder={words.phoneHint} pattern="[+0-9 ()\-]{7,}" required enterkeyhint="send" />
            </div>
            <div class="lf__row">
              <button class="lf__back" type="button" data-lead-back>
                <Icon name="arrow-left" size={16} class="flip" /> {words.back}
              </button>
              <button class="st-btn st-btn--gold lf__send" type="submit">
                {words.send} <Icon name="arrow-right" size={18} class="flip" />
              </button>
            </div>
          </fieldset>
        </>
      )
    }

    {
      variant === 'c' && (
        <>
          <header class="lf__head">
            <h2 id={f('title')} class="lf__title">{words.callTitle}</h2>
            <p class="lf__lede">{words.callLede}</p>
          </header>
          <div class="lf__inline">
            <div class="lf__field">
              <label for={f('phone')} class="visually-hidden">{words.phone}</label>
              <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder={words.phoneHint} pattern="[+0-9 ()\-]{7,}" required enterkeyhint="send" />
            </div>
            <button class="st-btn st-btn--gold lf__send" type="submit">
              <Icon name="phone" size={18} />
              <span data-lead-cta data-call={words.callMe} data-wa={words.send}>{words.callMe}</span>
            </button>
          </div>
          <label class="lf__switch">
            <input type="checkbox" name="reply" value="WhatsApp" role="switch" data-lead-wa />
            <span class="lf__track" aria-hidden="true" />
            {words.waInstead}
          </label>
          <p class="lf__alt">
            {words.or} <a href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />{words.waUs}</a>
            <span class="lf__dot" aria-hidden="true">·</span>
            <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
          </p>
        </>
      )
    }

    {
      variant === 'd' && (
        <>
          <header class="lf__head">
            <h2 id={f('title')} class="lf__title">{words.title}</h2>
          </header>
          <fieldset class="lf__chips lf__chips--seg">
            <legend>{words.size}</legend>
            {words.sizes.map((size, i) => (
              <label class="lf__chip">
                <input type="radio" name="size" value={size} checked={i === 0} />
                <span>{size}</span>
              </label>
            ))}
          </fieldset>
          <div class="lf__two">
            <div class="lf__field">
              <label for={f('name')}>{words.name}</label>
              <input id={f('name')} name="name" type="text" autocomplete="name" required enterkeyhint="next" />
            </div>
            <div class="lf__field">
              <label for={f('phone')}>{words.phone}</label>
              <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder={words.phoneHint} pattern="[+0-9 ()\-]{7,}" required enterkeyhint="next" />
            </div>
          </div>
          <div class="lf__field">
            <label for={f('car')}>{words.car}</label>
            <input id={f('car')} name="vehicle" type="text" autocomplete="off" placeholder={words.carHint} enterkeyhint="send" />
          </div>
          <fieldset class="lf__chips lf__chips--seg">
            <legend>{words.reply}</legend>
            {words.replies.map((reply, i) => (
              <label class="lf__chip">
                <input type="radio" name="reply" value={reply} checked={i === 0} />
                <span>
                  <Icon name={i === 0 ? 'whatsapp' : 'phone'} size={16} />
                  {reply}
                </span>
              </label>
            ))}
          </fieldset>
          <button class="st-btn st-btn--gold lf__send" type="submit">
            {words.send} <Icon name="arrow-right" size={18} class="flip" />
          </button>
        </>
      )
    }
    <p class="lf__error" role="alert" data-lead-error hidden></p>
  </div>

  <div class="lf__done" data-lead-done hidden tabindex="-1">
    <span class="lf__tick" aria-hidden="true"><Icon name="check" size={26} /></span>
    <p class="lf__title">{words.thanks}</p>
    <p class="lf__lede">{words.thanksLine}</p>
    {demo && <p class="lf__demo">{words.demoNote}</p>}
    <a class="st-btn st-btn--ghost lf__wa" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" />{words.waUs}</a>
  </div>
</form>

<script>
  type Attribution = { serialize?: () => string | null };

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-lead]')) {
    const body = form.querySelector<HTMLElement>('[data-lead-body]')!;
    const done = form.querySelector<HTMLElement>('[data-lead-done]')!;
    const error = form.querySelector<HTMLElement>('[data-lead-error]')!;
    const steps = [...form.querySelectorAll<HTMLElement>('[data-lead-step]')];
    const stepLabel = form.querySelector<HTMLElement>('[data-lead-steplabel]');
    const progress = form.querySelector<HTMLElement>('[data-lead-progress]');
    const msg = form.dataset;
    // The script shows its own messages; without it the browser validates.
    form.noValidate = true;

    // Inline message under a field that fails native validation.
    const check = (input: HTMLInputElement) => {
      const field = input.closest('.lf__field');
      let note = field?.querySelector<HTMLElement>('.lf__note');
      const bad = !input.checkValidity();
      if (field && bad && !note) {
        note = document.createElement('p');
        note.className = 'lf__note';
        note.id = `${input.id}-note`;
        field.append(note);
        input.setAttribute('aria-describedby', note.id);
      }
      if (note) {
        note.textContent = bad ? (input.validity.valueMissing ? msg.msgRequired! : msg.msgPhone!) : '';
        note.hidden = !bad;
      }
      input.setAttribute('aria-invalid', String(bad));
      return !bad;
    };
    const valid = (scope: ParentNode) => {
      const inputs = [...scope.querySelectorAll<HTMLInputElement>('input[required], input[pattern]')];
      const results = inputs.map(check);
      const first = inputs[results.indexOf(false)];
      first?.focus();
      return !first;
    };
    // A message clears as soon as the field is fixed (while typing, so nothing
    // shifts under the pointer on the way to the button) and appears when the
    // visitor leaves a field they've filled in wrongly.
    form.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.getAttribute('aria-invalid') === 'true') check(input);
    });
    form.addEventListener('focusout', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.matches?.('input[required], input[pattern]') && input.value && !input.checkValidity()) check(input);
    });

    // Two-step layout.
    const show = (n: number) => {
      steps.forEach((s) => (s.hidden = s.dataset.leadStep !== String(n)));
      if (stepLabel) stepLabel.textContent = stepLabel.textContent!.replace(/\d(?= of)/, String(n));
      progress?.style.setProperty('--p', n === 1 ? '50%' : '100%');
      steps[n - 1]?.querySelector<HTMLInputElement>('input:not([type=radio])')?.focus();
    };
    form.querySelector('[data-lead-next]')?.addEventListener('click', () => {
      if (valid(steps[0])) show(2);
    });
    form.querySelector('[data-lead-back]')?.addEventListener('click', () => show(1));
    // Enter in step 1 goes to step 2 rather than submitting.
    steps[0]?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target as HTMLElement).matches('input:not([type=radio])')) {
        e.preventDefault();
        if (valid(steps[0])) show(2);
      }
    });

    // Callback: the button says what will happen.
    const wa = form.querySelector<HTMLInputElement>('[data-lead-wa]');
    const cta = form.querySelector<HTMLElement>('[data-lead-cta]');
    wa?.addEventListener('change', () => {
      if (cta) cta.textContent = wa.checked ? cta.dataset.wa! : cta.dataset.call!;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      if (!valid(form)) return;
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]:not([hidden])');
      try {
        if (!form.hasAttribute('data-demo-form')) {
          button?.setAttribute('disabled', '');
          const data = new FormData(form);
          const attribution = (window as Window & { WRPAttribution?: Attribution }).WRPAttribution?.serialize?.();
          if (attribution) data.set('attribution', attribution);
          const res = await fetch(form.action, { method: 'POST', body: data });
          const json = await res.json().catch(() => ({}));
          if (!res.ok || !json.success) throw new Error(json.error);
          document.dispatchEvent(new CustomEvent('wrp:lead', { detail: { form: `hero-${form.dataset.leadVariant}` } }));
        }
        body.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        error.textContent = msg.msgError!;
        error.hidden = false;
      } finally {
        button?.removeAttribute('disabled');
      }
    });
  }
</script>

<style>
  /* The steps, thank-you panel and messages use the hidden attribute. */
  .lf [hidden] {
    display: none !important;
  }
  .lf {
    --lf-bg: var(--st-white);
    --lf-ink: var(--st-ink);
    --lf-mute: var(--st-ink-2);
    --lf-line: #c9cbc6;
    --lf-field: var(--st-white);
    --lf-accent: var(--st-gold-deep);
    container-type: inline-size;
    position: relative;
    inline-size: 100%;
    max-inline-size: 30rem;
    margin-inline-start: auto;
    color: var(--lf-ink);
    color-scheme: light;
  }
  .lf__body,
  .lf__done {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 0.9rem + 1.5vw, 2rem);
    background: var(--lf-bg);
  }
  .lf__head {
    display: grid;
    gap: 0.4rem;
  }
  .lf__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 1.9rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .lf__lede {
    font-size: 0.9375rem;
    color: var(--lf-mute);
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .lf__pane {
    display: grid;
    gap: 1rem;
  }
  .lf__q {
    padding: 0;
    margin-block-end: 0.25rem;
    font-weight: 600;
    font-size: 1rem;
  }
  .lf__field {
    display: grid;
    gap: 0.35rem;
  }
  .lf__field label,
  .lf__chips legend {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .lf__field input {
    inline-size: 100%;
    min-block-size: 3rem;
    padding: 0.65rem 0.85rem;
    border: 1.5px solid var(--lf-line);
    border-radius: 0;
    background: var(--lf-field);
    color: var(--lf-ink);
    font-size: 1rem; /* 16px: no zoom-on-focus on iOS */
    transition: border-color 0.15s;
  }
  .lf__field input::placeholder {
    color: color-mix(in srgb, var(--lf-mute) 70%, transparent);
  }
  .lf__field input:focus-visible {
    outline: 3px solid var(--st-gold);
    outline-offset: 0;
    border-color: var(--lf-ink);
  }
  /* Only after the visitor has interacted, never on first paint. */
  .lf__field input:user-invalid,
  .lf__field input[aria-invalid='true'] {
    border-color: #b42318;
  }
  .lf__note {
    font-size: 0.8125rem;
    color: #b42318;
  }
  .lf__send {
    inline-size: 100%;
  }
  .lf__send:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .lf__alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--lf-mute);
  }
  .lf__alt a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
    color: var(--lf-ink);
    text-underline-offset: 3px;
  }
  .lf__stars {
    color: var(--lf-accent);
  }
  .lf__error {
    padding: 0.6rem 0.8rem;
    background: #fdecea;
    color: #8a1c13;
    font-size: 0.875rem;
  }
  .lf__done {
    justify-items: center;
    text-align: center;
    gap: 0.6rem;
    padding-block: 2.5rem;
  }
  .lf__done:focus {
    outline: none;
  }
  .lf__tick {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border-radius: 50%;
    background: var(--st-gold);
    color: var(--st-black);
  }
  .lf__demo {
    font-size: 0.75rem;
    color: var(--lf-mute);
  }
  .lf__wa {
    margin-block-start: 0.75rem;
  }
  .lf--a .lf__wa,
  .lf--d .lf__wa {
    border-color: var(--lf-ink);
    color: var(--lf-ink);
  }

  /* Chips: radio inputs styled as buttons. */
  .lf__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .lf__chips legend {
    inline-size: 100%;
    margin-block-end: 0.45rem;
    float: inline-start;
  }
  .lf__chip {
    position: relative;
    flex: 1 1 auto;
  }
  .lf__chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .lf__chip span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-block-size: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 1.5px solid var(--lf-line);
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .lf__chip input:checked + span {
    border-color: var(--lf-ink);
    background: var(--lf-ink);
    color: var(--lf-bg);
  }
  .lf__chip input:focus-visible + span {
    outline: 3px solid var(--st-gold);
    outline-offset: 2px;
  }
  .lf__chips--seg {
    gap: 0;
  }
  .lf__chips--seg .lf__chip + .lf__chip span {
    border-inline-start-width: 0;
  }
  .lf__chips--seg .lf__chip input:checked + span {
    position: relative;
  }

  /* a: Card. White, gold rule on top, a soft shadow off the photo. */
  .lf--a .lf__body {
    border-block-start: 4px solid var(--st-gold);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }

  /* b: Two-step, dark glass over the photo. */
  .lf--b {
    --lf-bg: rgb(12 13 15 / 0.62);
    --lf-ink: var(--st-white);
    --lf-mute: var(--st-on-dark);
    --lf-line: rgb(255 255 255 / 0.28);
    --lf-field: rgb(255 255 255 / 0.06);
    --lf-accent: var(--st-gold);
    color-scheme: dark;
  }
  .lf--b .lf__body,
  .lf--b .lf__done {
    border: 1px solid rgb(255 255 255 / 0.14);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }
  .lf--b .lf__step {
    font-family: var(--st-head-font);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--st-gold);
  }
  .lf__bar {
    display: block;
    block-size: 3px;
    margin-block-start: 0.6rem;
    background: rgb(255 255 255 / 0.15);
  }
  .lf__bar span {
    display: block;
    block-size: 100%;
    inline-size: var(--p, 50%);
    background: var(--st-gold);
    transition: inline-size 0.3s;
  }
  .lf--b .lf__chip input:checked + span {
    background: var(--st-gold);
    border-color: var(--st-gold);
    color: var(--st-black);
  }
  .lf__row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .lf__row .lf__send {
    flex: 1;
  }
  .lf__back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-block-size: 3rem;
    padding: 0 0.5rem;
    border: 0;
