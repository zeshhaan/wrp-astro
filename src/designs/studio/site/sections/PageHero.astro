---
/**
 * Inner-page hero: a dark photo band with the breadcrumb trail, eyebrow, H1,
 * lede and actions. Same language as the homepage hero (condensed uppercase
 * title, brass eyebrow, scrim over a photo) at inner-page height. On phones the
 * header sits clear over the top of it, as on the homepage.
 */
import Picture from '../../../shared/Picture.astro';

interface Props {
  /** Photo as a pre-optimised base path ('/foo' → /foo-800w.avif etc.). */
  image: string;
  imageAlt: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Long titles (a full sentence) get a smaller size. */
  long?: boolean;
}

const { image, imageAlt, eyebrow, title, lede, long = false } = Astro.props;
---

<section class="ph" aria-labelledby="ph-title">
  <Picture
    base={image}
    alt={imageAlt}
    sizes="100vw"
    widths={[800, 1200]}
    width={1920}
    height={1080}
    loading="eager"
    fetchpriority="high"
    class="ph__bg"
  />
  <div class="st-wrap ph__inner">
    <slot name="crumbs" />
    {eyebrow && <p class="st-eyebrow ph__eyebrow">{eyebrow}</p>}
    <h1 id="ph-title" class:list={['ph__title', long && 'ph__title--long']}>{title}</h1>
    {lede && <p class="ph__lede">{lede}</p>}
    {Astro.slots.has('default') && <div class="ph__actions"><slot /></div>}
  </div>
</section>

<style>
  .ph {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-block-size: min(38rem, 82svh);
    padding-block: 8rem 4.5rem;
    background: var(--st-black);
    color: var(--st-white);
    overflow: hidden;
  }
  .ph :global(.ph__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .ph :global(.ph__bg img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  /* Darker at the start edge and the bottom, where the text sits. */
  .ph::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(12 13 15 / 0.92), rgb(12 13 15 / 0.35) 70%, rgb(12 13 15 / 0.55)),
      linear-gradient(to right, rgb(12 13 15 / 0.7), transparent 75%);
  }
  :global([dir='rtl']) .ph::before {
    background:
      linear-gradient(to top, rgb(12 13 15 / 0.92), rgb(12 13 15 / 0.35) 70%, rgb(12 13 15 / 0.55)),
      linear-gradient(to left, rgb(12 13 15 / 0.7), transparent 75%);
  }
  .ph__inner {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .ph__inner > :global(.crumbs) {
    margin-block-end: 0.75rem;
  }
  .ph__title {
    max-inline-size: 22ch;
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(2.6rem, 1.5rem + 4.6vw, 5rem);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: 0.005em;
  }
  .ph__title--long {
    max-inline-size: 26ch;
    font-size: clamp(2.1rem, 1.3rem + 3.2vw, 3.9rem);
    line-height: 1.02;
  }
  .ph__lede {
    max-inline-size: 40rem;
    color: var(--st-on-dark);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
  }
  .ph__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }
</style>
