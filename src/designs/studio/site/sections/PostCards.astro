---
/**
 * Blog posts related to a service, as Studio photo cards. Studio version of
 * src/components/RelatedPosts.astro: same selection (posts tagged with the
 * service, newest first, up to 3), heading, subtitle and card text.
 */
import Picture from '../../../shared/Picture.astro';
import { scrimStops } from '../../../shared/easedGradient';
import Icon from '../../Icon.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { localizeUrl } from '@/i18n/utils';
import { t, type Locale } from '@/i18n/translations';
import { getLocalizedBlogPosts } from '@/i18n/content';

interface Props {
  serviceId: string;
  locale?: Locale;
  link?: (href: string) => string;
}

const { serviceId, locale = 'en', link = (href: string) => href } = Astro.props;
const all = await getLocalizedBlogPosts(locale);
const related = all
  .filter((post) => post.data.relatedServices.includes(serviceId as never))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  guide: 'Guide',
  news: 'News',
  update: 'Update',
  event: 'Event',
  listicle: 'Listicle',
};
const coverBase = (src: string) => src.replace(/\.(jpe?g|png|webp)$/i, '');
const scrim = `linear-gradient(to bottom, ${scrimStops({ rgb: '12 13 15', from: 18, to: 78, max: 0.94 })}, rgb(12 13 15 / 0.94) 100%)`;
---

{
  related.length > 0 && (
    <section class="pc st-section st-light" aria-labelledby="pc-title">
      <div class="st-wrap">
        <header class="st-head st-head--center">
          <h2 id="pc-title" class="st-h2">{t(locale, 'blog.relatedPosts')}</h2>
          <p class="st-intro">{t(locale, 'blog.latestSubtitle')}</p>
        </header>
        <ul class="pc__list" role="list" data-count={related.length}>
          {related.map((post) => (
            <li class="pc__card" style={`--scrim:${scrim}`}>
              {post.data.heroImage && (
                <Picture
                  base={coverBase(post.data.heroImage)}
                  alt={post.data.title}
                  sizes="(min-width: 60rem) 30vw, (min-width: 40rem) 50vw, 100vw"
                  widths={[480, 800]}
                  width={800}
                  height={450}
                  class="pc__cover"
                />
              )}
              <p class="pc__meta">
                {post.data.category && <span class="pc__cat">{categoryLabels[post.data.category] || post.data.category}</span>}
                <FormattedDate date={post.data.pubDate} locale={locale} />
                {post.data.readingTime && <span>{post.data.readingTime} min</span>}
              </p>
              <h3 class="pc__title">
                <a href={link(localizeUrl(`/blog/${post.id.replace(/^ar\//, '')}/`, locale))}>{post.data.title}</a>
              </h3>
              <p class="pc__desc">{post.data.description}</p>
              <span class="pc__more" aria-hidden="true">
                {t(locale, 'blog.readMore')} <Icon name="arrow-right" size={16} />
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .pc__list {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pc__list[data-count='1'] {
    max-inline-size: 30rem;
    margin-inline: auto;
  }
  .pc__list[data-count='2'] {
    max-inline-size: 52rem;
    margin-inline: auto;
  }
  .pc__card {
    position: relative;
    display: grid;
    align-content: end;
    gap: 0.6rem;
    min-block-size: 25rem;
    padding: 1.5rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--st-black);
    color: var(--st-white);
  }
  .pc__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--scrim);
  }
  .pc__card :global(.pc__cover) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .pc__card :global(.pc__cover img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .pc__card:hover :global(.pc__cover img) {
    transform: scale(1.04);
  }
  .pc__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--st-on-dark);
  }
  .pc__cat {
    font-family: var(--st-head-font);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--st-gold);
  }
  .pc__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 1.45rem;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .pc__title a {
    color: inherit;
    text-decoration: none;
  }
  /* The whole card is the link. */
  .pc__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pc__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 0.9375rem;
    color: var(--st-on-dark);
  }
  .pc__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: 0.25rem;
    font-family: var(--st-head-font);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9375rem;
    color: var(--st-gold);
  }
  .pc__card:focus-within {
    outline: 3px solid var(--st-gold-deep);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .pc__card :global(.pc__cover img) {
      transition: none;
    }
  }
</style>
