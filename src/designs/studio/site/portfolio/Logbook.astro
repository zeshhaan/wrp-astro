---
/**
 * Portfolio design B, "Logbook": the studio's job sheets. The hero lists every
 * project like a workshop log (a photo follows the pointer down the list);
 * each project then gets its own chapter: a large photo with its gallery
 * beside a paper job card (number, description, services ticked off with
 * links, the WRP stamp). A rail on wide screens shows where you are.
 */
import Breadcrumbs from '../Breadcrumbs.astro';
import Picture from '../../../shared/Picture.astro';
import Icon from '../../Icon.astro';
import WrpLogo from '@/components/WrpLogo.astro';
import type { PortfolioCopy } from '../PortfolioPage.astro';
import type { PortfolioData } from './data';
import type { Locale } from '@/i18n/translations';
import { toLocalNum } from '@/i18n/utils';
import { trail } from '../say';

interface Props {
  copy: PortfolioCopy;
  locale: Locale;
  data: PortfolioData;
  link: (href: string) => string;
}

const { copy, locale, data, link } = Astro.props;
const { projects, words } = data;
const num = (n: number) => toLocalNum(String(n).padStart(2, '0'), locale);
const total = num(projects.length);
---

<section class="log-hero" data-log-hero>
  <div class="st-wrap log-hero__inner">
    <Breadcrumbs crumbs={trail(locale, copy.crumbs, ['/', '/portfolio/'])} link={link} />
    <div class="log-hero__head">
      <h1 class="log-hero__title">{copy.h1}</h1>
      <p class="log-hero__lede">{copy.lede}</p>
    </div>
    <ol class="log-index" role="list">
      {
        projects.map((p, i) => (
          <li>
            <a class="log-index__row" href={`#job-${p.id}`} data-log-peek={`${p.hero}-480w.webp`}>
              <span class="log-index__n">{num(i + 1)}</span>
              <span class="log-index__title">{p.title}</span>
              <span class="log-index__sub">{p.subtitle}</span>
              <Icon name="arrow-right" size={20} class="log-index__arrow flip" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <img class="log-peek" alt="" aria-hidden="true" data-log-peekimg />
</section>

<div class="log-jobs st-light" data-log-jobs>
  <nav class="log-rail" aria-label={copy.h1}>
    <ol role="list">
      {
        projects.map((p, i) => (
          <li>
            <a href={`#job-${p.id}`} data-log-dot={p.id} aria-label={p.title}>
              {num(i + 1)}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    projects.map((p, i) => (
      <article class:list={['log-job st-wrap', i % 2 === 1 && 'log-job--flip']} id={`job-${p.id}`} data-log-job={p.id} aria-labelledby={`job-${p.id}-t`}>
        <div class="log-job__photos">
          <button type="button" class="log-job__main" data-pf-open={p.start} aria-label={`${words.view}: ${p.title}`}>
            <Picture
              base={p.hero}
              alt={p.alt}
              sizes="(min-width: 64rem) 55vw, 100vw"
              width={p.heroSize.width}
              height={p.heroSize.height}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </button>
          {p.gallery.length > 1 && (
            <ul class="log-job__thumbs" role="list">
              {p.gallery.slice(1).map((g, k) => (
                <li>
                  <button type="button" data-pf-open={p.start + k + 1} aria-label={`${p.title} ${k + 2}`}>
                    <Picture base={g} alt="" sizes="10rem" widths={[480]} width={480} height={640} />
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="log-sheet">
          <p class="log-sheet__no">
            <span>{num(i + 1)}</span>
            <span class="log-sheet__of">/ {total}</span>
          </p>
          <h2 class="log-sheet__title" id={`job-${p.id}-t`}>
            {p.title}
          </h2>
          <p class="log-sheet__sub">{p.subtitle}</p>
          <p class="log-sheet__desc">{p.description}</p>
          <p class="log-sheet__label">{words.services}</p>
          <ul class="log-sheet__list" role="list">
            {p.services.map((s) => (
              <li>
                <Icon name="check" size={18} class="log-sheet__tick" />
                <a href={link(s.href)}>{s.name}</a>
              </li>
            ))}
          </ul>
          <button type="button" class="st-btn st-btn--dark log-sheet__btn" data-pf-open={p.start}>
            <Icon name="camera" size={18} /> {words.view} ({toLocalNum(String(p.gallery.length), locale)})
          </button>
          <span class="log-stamp" aria-hidden="true">
            <WrpLogo class="log-stamp__logo" label="" mono />
            <Icon name="check" size={22} />
          </span>
        </div>
      </article>
    ))
  }
</div>

<script>
  // A photo follows the pointer down the hero's project list (mouse only).
  for (const hero of document.querySelectorAll<HTMLElement>('[data-log-hero]')) {
    const img = hero.querySelector<HTMLImageElement>('[data-log-peekimg]')!;
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) continue;
    for (const row of hero.querySelectorAll<HTMLElement>('[data-log-peek]')) {
      row.addEventListener('pointerenter', () => {
        img.src = row.dataset.logPeek!;
        hero.dataset.peeking = '';
      });
      row.addEventListener('pointerleave', () => delete hero.dataset.peeking);
    }
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      img.style.translate = `${e.clientX - r.left}px ${e.clientY - r.top}px`;
    });
  }

  // The rail marks the chapter in view.
  for (const jobs of document.querySelectorAll<HTMLElement>('[data-log-jobs]')) {
    const dots = new Map([...jobs.querySelectorAll<HTMLElement>('[data-log-dot]')].map((d) => [d.dataset.logDot!, d]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          dots.forEach((d, id) => (id === (e.target as HTMLElement).dataset.logJob ? d.setAttribute('aria-current', 'step') : d.removeAttribute('aria-current')));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    jobs.querySelectorAll('[data-log-job]').forEach((j) => io.observe(j));
    // Show the rail only while the chapters are on screen.
    new IntersectionObserver(([e]) => jobs.toggleAttribute('data-in', e.isIntersecting), { rootMargin: '-30% 0px -30% 0px' }).observe(jobs);
  }
</script>

<style>
  .log-hero {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    position: relative;
    padding-block: 9rem 3.5rem;
    background: var(--st-black);
    overflow: hidden;
  }
  .log-hero__inner {
    display: grid;
    gap: 1.5rem;
  }
  .log-hero__head {
    display: grid;
    gap: 1.25rem;
    align-items: end;
  }
  @media (min-width: 64rem) {
    .log-hero__head {
      grid-template-columns: auto minmax(0, 26rem);
      justify-content: space-between;
      gap: 3rem;
    }
  }
  .log-hero__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(3.2rem, 1.4rem + 8vw, 8.5rem);
    line-height: 0.88;
    text-transform: uppercase;
  }
  .log-hero__lede {
    color: var(--st-on-dark);
    font-size: 1.125rem;
  }

  /* The workshop log: one row per project. */
  .log-index {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--st-line-dark);
  }
  .log-index__row {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-block-end: 1px solid var(--st-line-dark);
    color: var(--st-white);
    text-decoration: none;
    transition: padding 0.25s ease, color 0.2s;
  }
  @media (min-width: 48rem) {
    .log-index__row {
      grid-template-columns: 4rem minmax(0, 1.2fr) minmax(0, 1fr) auto;
    }
  }
  .log-index__n {
    font-family: var(--st-head-font);
    font-size: 0.9rem;
    color: var(--st-mute);
  }
  .log-index__title {
    font-family: var(--st-head-font);
    font-weight: 500;
    font-size: clamp(1.35rem, 1rem + 1.6vw, 2.4rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .log-index__sub {
    grid-column: 2;
    color: var(--st-mute);
    font-size: 0.9375rem;
  }
  @media (min-width: 48rem) {
    .log-index__sub {
      grid-column: auto;
    }
  }
  .log-index :global(.log-index__arrow) {
    grid-row: 1;
    grid-column: -2;
    align-self: center;
    color: var(--st-mute);
    transition: color 0.2s, translate 0.25s;
  }
  .log-index__row:hover,
  .log-index__row:focus-visible {
    padding-inline-start: 0.75rem;
  }
  .log-index__row:hover .log-index__n,
  .log-index__row:hover :global(.log-index__arrow) {
    color: var(--st-red);
  }
  .log-peek {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 1;
    inline-size: 13rem;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    margin: -8.5rem 0 0 -6.5rem;
    opacity: 0;
    scale: 0.85;
    rotate: -4deg;
    pointer-events: none;
    transition: opacity 0.25s, scale 0.25s;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.5);
  }
  [data-peeking] .log-peek {
    opacity: 1;
    scale: 1;
  }

  /* Chapters */
  .log-jobs {
    position: relative;
    padding-block: 2rem 4rem;
  }
  .log-job {
    display: grid;
    gap: 1.5rem;
    padding-block: 2rem;
  }
  @media (min-width: 64rem) {
    .log-job {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
      padding-block: 4rem;
    }
    .log-job--flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }
    .log-job--flip .log-job__photos {
      order: 2;
    }
  }
  .log-job__photos {
    display: grid;
    gap: 0.75rem;
  }
  .log-job__main,
  .log-job__thumbs button {
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    background: var(--st-light);
    overflow: hidden;
    cursor: zoom-in;
  }
  .log-job__main :global(img) {
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  @media (min-width: 64rem) {
    .log-job__main :global(img) {
      max-block-size: 80vh;
    }
  }
  .log-job__main:hover :global(img) {
    transform: scale(1.03);
  }
  .log-job__thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .log-job__thumbs :global(img) {
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* The paper job card. */
  .log-sheet {
    position: relative;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: 1.75rem 1.5rem 2rem;
    background: var(--st-white);
    border-block-start: 4px solid var(--st-red);
    box-shadow: 0 1px 0 var(--st-line-light), 0 1.25rem 2.5rem -1.5rem rgb(0 0 0 / 0.25);
  }
  @media (min-width: 64rem) {
    .log-sheet {
      position: sticky;
      inset-block-start: calc(var(--st-head) + 2rem);
      padding: 2.5rem 2.25rem;
    }
  }
  .log-sheet__no {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(3rem, 2rem + 3vw, 4.75rem);
    line-height: 1;
    color: var(--st-ink);
  }
  .log-sheet__of {
    font-size: 1rem;
    font-weight: 500;
    color: var(--st-ink-2);
  }
  .log-sheet__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.75rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .log-sheet__sub {
    font-family: var(--st-head-font);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--st-red);
  }
  .log-sheet__desc {
    max-inline-size: 32rem;
    margin-block: 0.25rem 0.75rem;
    color: var(--st-ink-2);
    font-size: 1.0625rem;
  }
  .log-sheet__label {
    font-family: var(--st-head-font);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--st-ink-2);
  }
  .log-sheet__list {
    display: grid;
    gap: 0;
    inline-size: 100%;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    border-block-start: 1px dashed var(--st-line-light);
  }
  .log-sheet__list li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.6rem;
    border-block-end: 1px dashed var(--st-line-light);
  }
  .log-sheet__list :global(.log-sheet__tick) {
    flex: none;
    padding: 0.15rem;
    border: 1.5px solid var(--st-red);
    color: var(--st-red);
    inline-size: 1.4rem;
    block-size: 1.4rem;
  }
  .log-sheet__list a {
    color: var(--st-ink);
    font-family: var(--st-head-font);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .log-sheet__list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .log-stamp {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-end: 1.5rem;
    display: grid;
    place-items: center;
    gap: 0.1rem;
    inline-size: 5.5rem;
    block-size: 5.5rem;
    border: 2.5px solid var(--st-red);
    border-radius: 50%;
    color: var(--st-red);
    rotate: -12deg;
    opacity: 0.85;
    align-content: center;
  }
  .log-stamp :global(.log-stamp__logo) {
    inline-size: 3.6rem;
    block-size: auto;
    color: var(--st-red);
  }

  /* Progress rail on wide screens. */
  .log-rail {
    display: none;
  }
  @media (min-width: 88rem) {
    .log-rail {
      position: fixed;
      inset-block-start: 50%;
      inset-inline-start: 1rem;
      z-index: 5;
      display: block;
      translate: 0 -50%;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    [data-in] > .log-rail {
      opacity: 1;
      pointer-events: auto;
    }
    .log-rail ol {
      display: grid;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .log-rail a {
      display: block;
      padding: 0.2rem 0.4rem;
      border-inline-start: 2px solid var(--st-line-light);
      color: var(--st-ink-2);
      font-family: var(--st-head-font);
      font-size: 0.8125rem;
      text-decoration: none;
    }
    .log-rail a[aria-current] {
      border-color: var(--st-red);
      color: var(--st-ink);
      font-weight: 600;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .log-index__row,
    .log-peek,
    .log-job__main :global(img) {
      transition: none;
    }
  }
</style>
