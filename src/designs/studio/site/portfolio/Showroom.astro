---
/**
 * Portfolio design A, "Showroom": the featured cars take turns on a lit stage
 * beside the page title, then every project sits in a bento grid that the
 * visitor narrows by service (PPF, ceramic coating, …). Hovering or focusing a
 * card brings up its one-line description and service tags.
 */
import Breadcrumbs from '../Breadcrumbs.astro';
import Picture from '../../../shared/Picture.astro';
import Icon from '../../Icon.astro';
import type { PortfolioCopy } from '../PortfolioPage.astro';
import type { PortfolioData } from './data';
import type { Locale } from '@/i18n/translations';
import { toLocalNum } from '@/i18n/utils';
import { trail } from '../say';

interface Props {
  copy: PortfolioCopy;
  locale: Locale;
  data: PortfolioData;
  link: (href: string) => string;
}

const { copy, locale, data, link } = Astro.props;
const { projects, services, words } = data;
const num = (n: number) => toLocalNum(String(n).padStart(2, '0'), locale);
const featured = projects.filter((p) => p.featured);
---

<section class="pa-hero">
  <div class="st-wrap pa-hero__grid">
    <div class="pa-hero__text">
      <Breadcrumbs crumbs={trail(locale, copy.crumbs, ['/', '/portfolio/'])} link={link} />
      <h1 class="pa-hero__title">{copy.h1}</h1>
      <p class="pa-hero__lede">{copy.lede}</p>
      <ol class="pa-tabs" role="list" data-pa-tabs>
        {
          featured.map((p, i) => (
            <li>
              <button type="button" class="pa-tab" data-pa-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="pa-tab__n">{num(i + 1)}</span>
                <span class="pa-tab__name">{p.title}</span>
                <span class="pa-tab__bar" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="pa-stage" data-pa-stage>
      {
        featured.map((p, i) => (
          <figure class="pa-slide" data-pa-slide={i} data-on={i === 0 ? '' : undefined}>
            <Picture
              base={p.hero}
              alt={p.alt}
              sizes="(min-width: 64rem) 40vw, 100vw"
              width={p.heroSize.width}
              height={p.heroSize.height}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              class="pa-slide__photo"
            />
            <figcaption class="pa-slide__cap">
              <strong>{p.title}</strong>
              <span>{p.subtitle}</span>
            </figcaption>
            <button type="button" class="pa-slide__open" data-pf-open={p.start} aria-label={`${words.view}: ${p.title}`}>
              <Icon name="camera" size={16} /> {toLocalNum(String(p.gallery.length), locale)}
            </button>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section class="pa-work st-section st-black" data-pa-work>
  <div class="st-wrap">
    <div class="pa-filter" role="group" aria-label={words.services} data-pa-filter>
      <button type="button" class="pa-chip" data-pa-chip="" aria-pressed="true">
        {words.all} <span class="pa-chip__n">{num(projects.length)}</span>
      </button>
      {
        services.map(({ service, count }) => (
          <button type="button" class="pa-chip" data-pa-chip={service.slug} aria-pressed="false">
            {service.name} <span class="pa-chip__n">{num(count)}</span>
          </button>
        ))
      }
    </div>

    <ul class="pa-grid" role="list">
      {
        projects.map((p, i) => (
          <li class:list={['pa-card', i === 0 && 'pa-card--big', i === 1 && 'pa-card--tall']} data-services={p.services.map((s) => s.slug).join(' ')} style={`view-transition-name: pa-${i}`}>
            <Picture
              base={p.hero}
              alt={p.alt}
              sizes={i < 2 ? '(min-width: 64rem) 50vw, 100vw' : '(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw'}
              width={p.heroSize.width}
              height={p.heroSize.height}
              class="pa-card__photo"
            />
            <button type="button" class="pa-card__open" data-pf-open={p.start} aria-label={`${p.title} ${p.subtitle}`} />
            {p.gallery.length > 1 && (
              <span class="pa-card__count" aria-hidden="true">
                <Icon name="camera" size={14} /> {toLocalNum(String(p.gallery.length), locale)}
              </span>
            )}
            <div class="pa-card__body">
              <span class="pa-card__n" aria-hidden="true">{num(i + 1)}</span>
              <h2 class="pa-card__title">{p.title}</h2>
              <p class="pa-card__sub">{p.subtitle}</p>
              <p class="pa-card__desc">{p.description}</p>
              <ul class="pa-card__tags" role="list">
                {p.services.map((s) => (
                  <li>
                    <a href={link(s.href)}>{s.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // The stage: the featured cars take turns every 5 seconds, unless the
  // visitor prefers less motion or is pointing at / focused on the stage.
  for (const tabs of document.querySelectorAll<HTMLElement>('[data-pa-tabs]')) {
    const stage = document.querySelector<HTMLElement>('[data-pa-stage]')!;
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[data-pa-tab]')];
    const slides = [...stage.querySelectorAll<HTMLElement>('[data-pa-slide]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer = 0;
    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.toggleAttribute('data-on', k === current));
      buttons.forEach((b, k) => b.setAttribute('aria-pressed', String(k === current)));
    };
    const play = () => {
      if (still) return;
      window.clearInterval(timer);
      tabs.dataset.playing = '';
      timer = window.setInterval(() => show(current + 1), 5000);
    };
    const pause = () => {
      window.clearInterval(timer);
      delete tabs.dataset.playing;
    };
    buttons.forEach((b, k) =>
      b.addEventListener('click', () => {
        show(k);
        pause();
      }),
    );
    for (const el of [stage, tabs]) {
      el.addEventListener('pointerenter', pause);
      el.addEventListener('pointerleave', play);
      el.addEventListener('focusin', pause);
    }
    play();
  }

  // The service filter. Cards that do not match leave the grid; with view
  // transitions, the rest glide into their new places.
  for (const work of document.querySelectorAll<HTMLElement>('[data-pa-work]')) {
    const chips = [...work.querySelectorAll<HTMLButtonElement>('[data-pa-chip]')];
    const cards = [...work.querySelectorAll<HTMLElement>('[data-services]')];
    const apply = (slug: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.paChip === slug)));
      cards.forEach((c) => (c.hidden = !!slug && !c.dataset.services!.split(' ').includes(slug)));
    };
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const slug = chip.dataset.paChip ?? '';
        const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
        if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(() => apply(slug));
        else apply(slug);
      });
    }
  }
</script>

<style>
  .pa-hero {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    padding-block: 9rem 2rem;
    background:
      radial-gradient(60rem 30rem at 75% 0%, rgb(255 255 255 / 0.07), transparent 70%),
      var(--st-black);
    overflow: hidden;
  }
  .pa-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  @media (min-width: 64rem) {
    .pa-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 4rem;
      align-items: center;
    }
  }
  .pa-hero__text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .pa-hero__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(3.2rem, 1.6rem + 7vw, 7.5rem);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .pa-hero__lede {
    max-inline-size: 30rem;
    color: var(--st-on-dark);
    font-size: 1.125rem;
  }

  /* Featured tabs with a progress bar while the stage is playing. */
  .pa-tabs {
    display: grid;
    inline-size: 100%;
    max-inline-size: 30rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--st-line-dark);
  }
  .pa-tab {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: baseline;
    inline-size: 100%;
    padding: 0.85rem 0;
    border: 0;
    border-block-end: 1px solid var(--st-line-dark);
    background: none;
    color: var(--st-mute);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: color 0.2s;
  }
  .pa-tab:hover,
  .pa-tab[aria-pressed='true'] {
    color: var(--st-white);
  }
  .pa-tab__n {
    font-family: var(--st-head-font);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }
  .pa-tab__name {
    font-family: var(--st-head-font);
    font-size: 1.25rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .pa-tab__bar {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: -1px;
    block-size: 2px;
    inline-size: 0;
    background: var(--st-red);
  }
  .pa-tab[aria-pressed='true'] .pa-tab__bar {
    inline-size: 100%;
  }
  [data-playing] .pa-tab[aria-pressed='true'] .pa-tab__bar {
    animation: pa-progress 5s linear;
  }
  @keyframes pa-progress {
    from {
      inline-size: 0;
    }
    to {
      inline-size: 100%;
    }
  }

  /* The stage: a lit showroom bay, slides crossfade with a slow push-in. */
  .pa-stage {
    position: relative;
    aspect-ratio: 4 / 5;
    inline-size: 100%;
    overflow: hidden;
    background: var(--st-coal);
  }
  @media (min-width: 64rem) {
    .pa-stage {
      aspect-ratio: auto;
      block-size: clamp(30rem, calc(100svh - 12rem), 42rem);
    }
  }
  .pa-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .pa-slide[data-on] {
    opacity: 1;
    z-index: 1;
  }
  /* Studio lighting: dark floor under the caption, a little shade up top. */
  .pa-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgb(12 13 15 / 0.85), transparent 35%),
      linear-gradient(to bottom, rgb(12 13 15 / 0.45), transparent 20%);
  }
  .pa-slide :global(picture),
  .pa-slide :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }
  .pa-slide :global(img) {
    object-position: 50% 80%;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    scale: 1.08;
    transition: scale 6s ease-out;
  }
  .pa-slide[data-on] :global(img) {
    scale: 1;
  }
  .pa-slide__cap {
    position: absolute;
    inset-inline: 1.25rem;
    inset-block-end: 1.25rem;
    z-index: 3;
    display: grid;
    gap: 0.15rem;
  }
  .pa-slide__cap strong {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .pa-slide__cap span {
    color: var(--st-on-dark);
  }
  .pa-slide__open {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
    z-index: 3;
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.5);
    background: rgb(12 13 15 / 0.55);
    color: var(--st-white);
    font: inherit;
    font-size: 0.875rem;
    cursor: zoom-in;
    backdrop-filter: blur(6px);
  }
  .pa-slide__open:hover {
    background: var(--st-white);
    color: var(--st-black);
  }

  /* Filter chips: sticky under the header while the grid scrolls. */
  .pa-work {
    padding-block-start: 2rem;
  }
  .pa-filter {
    position: sticky;
    inset-block-start: calc(var(--st-head) + 0.5rem);
    z-index: 5;
    display: flex;
    gap: 0.5rem;
    margin-block-end: 1.5rem;
    padding-block: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
    background: linear-gradient(var(--st-black) 70%, transparent);
  }
  .pa-chip {
    flex: none;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--st-line-dark);
    border-radius: 999px;
    background: var(--st-coal);
    color: var(--st-on-dark);
    font-family: var(--st-head-font);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .pa-chip:hover {
    border-color: var(--st-white);
    color: var(--st-white);
  }
  .pa-chip[aria-pressed='true'] {
    border-color: var(--st-white);
    background: var(--st-white);
    color: var(--st-black);
  }
  .pa-chip__n {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  /* Bento grid: the first project takes a double tile, the second a tall
     (desktop) or wide (phone) one, so every row comes out full. */
  .pa-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 64rem) {
    .pa-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(16rem, 24vw, 21rem);
      gap: 1rem;
    }
  }
  .pa-card {
    --st-accent: var(--st-white); /* dark surface */
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--st-coal);
    color: var(--st-white);
  }
  .pa-card[hidden] {
    display: none;
  }
  .pa-card--big,
  .pa-card--tall {
    grid-column: span 2;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 64rem) {
    .pa-card {
      aspect-ratio: auto;
    }
    .pa-card--big {
      grid-row: span 2;
    }
    .pa-card--tall {
      grid-column: span 1;
      grid-row: span 2;
    }
  }
  .pa-card :global(.pa-card__photo),
  .pa-card :global(.pa-card__photo img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 80%;
  }
  .pa-card :global(.pa-card__photo img) {
    transition: transform 0.7s ease, filter 0.5s;
  }
  .pa-card:hover :global(.pa-card__photo img),
  .pa-card:focus-within :global(.pa-card__photo img) {
    transform: scale(1.05);
    filter: brightness(0.7);
  }
  .pa-card__open {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .pa-card__open:focus-visible {
    outline-offset: -3px;
  }
  .pa-card__count {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
    padding: 0.25rem 0.55rem;
    background: rgb(12 13 15 / 0.75);
    font-size: 0.8125rem;
    pointer-events: none;
  }
  .pa-card__body {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 2;
    display: grid;
    gap: 0.25rem;
    padding: 4rem 1rem 1rem;
    background: linear-gradient(to top, rgb(12 13 15 / 0.95), rgb(12 13 15 / 0.6) 55%, transparent);
    pointer-events: none;
  }
  .pa-card__n {
    font-family: var(--st-head-font);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--st-mute);
  }
  .pa-card__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .pa-card:is(.pa-card--big, .pa-card--tall) .pa-card__title {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.4rem);
  }
  .pa-card__sub {
    font-size: 0.875rem;
    color: var(--st-on-dark);
  }
  /* Description and tags slide up on hover/focus; touch screens show the tags
     (and the big cards' description) all the time. */
  .pa-card__desc {
    max-inline-size: 30rem;
    font-size: 0.9375rem;
    color: var(--st-on-dark);
    overflow: hidden;
  }
  .pa-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    pointer-events: auto;
  }
  .pa-card__tags a {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 1px solid rgb(255 255 255 / 0.45);
    color: var(--st-white);
    font-size: 0.75rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pa-card__tags a:hover {
    border-color: var(--st-red);
    background: var(--st-red);
  }
  @media (hover: hover) {
    .pa-card__desc {
      max-block-size: 0;
      opacity: 0;
      transition: max-block-size 0.35s ease, opacity 0.35s ease;
    }
    .pa-card__tags {
      opacity: 0;
      transition: opacity 0.35s ease;
    }
    .pa-card:hover .pa-card__desc,
    .pa-card:focus-within .pa-card__desc {
      max-block-size: 6rem;
      opacity: 1;
    }
    .pa-card:hover .pa-card__tags,
    .pa-card:focus-within .pa-card__tags {
      opacity: 1;
    }
  }
  @media (hover: none) {
    .pa-card:not(.pa-card--big, .pa-card--tall) .pa-card__desc {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .pa-card:not(.pa-card--big, .pa-card--tall) .pa-card__tags {
      display: none;
    }
    .pa-card__body {
      padding: 3rem 0.75rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pa-slide,
    .pa-slide :global(img),
    .pa-card :global(.pa-card__photo img),
    .pa-card__desc,
    .pa-card__tags {
      transition: none;
    }
    .pa-slide :global(img) {
      scale: 1;
    }
  }
</style>
