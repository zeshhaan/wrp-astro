---
/** Design Lab switcher pinned to the bottom of each portfolio concept: A / B / C, the live page, English / Arabic. */
import { portfolioConcepts, type PortfolioConceptId } from './concepts';
import type { Locale } from '@/i18n/translations';

interface Props {
  concept: PortfolioConceptId;
  locale: Locale;
}

const { concept, locale } = Astro.props;
const root = '/design-lab/studio/portfolio-concepts';
const href = (id: string, l: Locale) => `${root}/${id}/${l === 'ar' ? 'ar/' : ''}`;
---

<nav class="labbar" aria-label="Design Lab" dir="ltr" lang="en">
  <a href={`${root}/`} class="labbar__home">Portfolio concepts</a>
  {
    portfolioConcepts.map((c) => (
      <a href={href(c.id, locale)} aria-current={c.id === concept ? 'page' : undefined}>
        {c.id.toUpperCase()}
        <span class="labbar__name"> {c.name}</span>
      </a>
    ))
  }
  <a href={locale === 'ar' ? '/ar/portfolio/' : '/portfolio/'}>Live</a>
  <a href={href(concept, locale === 'ar' ? 'en' : 'ar')} lang={locale === 'ar' ? 'en' : 'ar'}>{locale === 'ar' ? 'English' : 'العربية'}</a>
</nav>

<style>
  .labbar {
    position: fixed;
    inset-block-end: 0.75rem;
    left: 50%;
    z-index: 60;
    display: flex;
    gap: 0.25rem;
    max-inline-size: calc(100vw - 1.5rem);
    padding: 0.3rem;
    translate: -50% 0;
    overflow-x: auto;
    border: 1px solid #3a3f45;
    border-radius: 999px;
    background: rgb(12 13 15 / 0.92);
    font-family: system-ui, sans-serif;
    font-size: 0.8125rem;
    backdrop-filter: blur(8px);
    scrollbar-width: none;
  }
  .labbar a {
    flex: none;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    color: #d4d7db;
    text-decoration: none;
    white-space: nowrap;
  }
  .labbar a:hover {
    color: #fff;
  }
  .labbar a[aria-current] {
    background: #fff;
    color: #0c0d0f;
    font-weight: 600;
  }
  .labbar__home {
    color: #a3a8ae !important;
  }
  @media (max-width: 40rem) {
    .labbar__name,
    .labbar__home {
      display: none;
    }
    .labbar {
      inset-block-end: 4.75rem;
    }
  }
</style>
