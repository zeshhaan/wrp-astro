---
/**
 * Portfolio design C, "Inspection light": the hero is the team at work in the
 * dark, lit only where the visitor points, like the swirl-finder lamp a
 * detailer sweeps over paint. Below, a turntable of every project: the car in
 * the middle comes up in full colour and its job details show underneath.
 * Last, a contact sheet of every photo, ready to open.
 */
import Breadcrumbs from '../Breadcrumbs.astro';
import Picture from '../../../shared/Picture.astro';
import Icon from '../../Icon.astro';
import type { PortfolioCopy } from '../PortfolioPage.astro';
import type { PortfolioData } from './data';
import type { Locale } from '@/i18n/translations';
import { toLocalNum } from '@/i18n/utils';
import { trail } from '../say';

interface Props {
  copy: PortfolioCopy;
  locale: Locale;
  data: PortfolioData;
  link: (href: string) => string;
}

const { copy, locale, data, link } = Astro.props;
const { projects, slides, words } = data;
const num = (n: number) => toLocalNum(String(n).padStart(2, '0'), locale);
// The team at work: one photo on phones, three side by side on wider screens.
const heroPhotos = ['/portfolio/team-washing-black-sports-car', '/portfolio/team-washing-subaru-sti-foam', '/portfolio/team-detailing-black-lexus-hood'];
// Every photo once, opening the lightbox at its first place in the sequence.
const sheet = [...new Map(slides.map((s, i) => [s.src, { ...s, index: i }])).values()].sort((a, b) => a.index - b.index);
---

<section class="in-hero" data-in-hero>
  {
    ['dim', 'lit'].map((layer) => (
      <div class={`in-hero__photo in-hero__photo--${layer}`} aria-hidden="true">
        {heroPhotos.map((photo, k) => (
          <Picture
            base={photo}
            alt=""
            sizes="(min-width: 48rem) 34vw, 100vw"
            width={3024}
            height={4032}
            loading={k === 0 ? 'eager' : 'lazy'}
            fetchpriority={k === 0 && layer === 'lit' ? 'high' : undefined}
          />
        ))}
      </div>
    ))
  }
  <div class="in-hero__ring" aria-hidden="true"></div>
  <div class="st-wrap in-hero__inner">
    <Breadcrumbs crumbs={trail(locale, copy.crumbs, ['/', '/portfolio/'])} link={link} />
    <div class="in-hero__text">
      <h1 class="in-hero__title">{copy.h1}</h1>
      <p class="in-hero__lede">{copy.lede}</p>
    </div>
  </div>
</section>

<section class="in-turn st-black" aria-label={copy.h1} data-in-turn>
  <div class="in-turn__rail" data-in-rail tabindex="-1">
    {
      projects.map((p, i) => (
        <figure class="in-car" data-in-car={i} data-lit={i === 0 ? '' : undefined}>
          <button type="button" class="in-car__open" data-pf-open={p.start} aria-label={`${p.title} ${p.subtitle}`}>
            <Picture
              base={p.hero}
              alt={p.alt}
              sizes="(min-width: 64rem) 24rem, 72vw"
              width={p.heroSize.width}
              height={p.heroSize.height}
              loading={i < 3 ? 'eager' : 'lazy'}
              class="in-car__photo"
            />
          </button>
          <figcaption class="in-car__cap">
            <span class="in-car__n">{num(i + 1)}</span>
            <strong>{p.title}</strong>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="st-wrap in-turn__foot">
    <div class="in-panel" data-in-panels>
      {
        projects.map((p, i) => (
          <div class="in-panel__item" data-in-panel={i} hidden={i !== 0}>
            <p class="in-panel__sub">{p.subtitle}</p>
            <p class="in-panel__desc">{p.description}</p>
            <ul class="in-panel__tags" role="list">
              {p.services.map((s) => (
                <li>
                  <a href={link(s.href)}>{s.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="in-turn__nav">
      <span class="in-turn__count" aria-hidden="true"><span data-in-now>{num(1)}</span> / {num(projects.length)}</span>
      <button type="button" class="in-turn__btn" data-in-step="-1" aria-label="Previous">
        <Icon name="arrow-left" size={22} class="flip" />
      </button>
      <button type="button" class="in-turn__btn" data-in-step="1" aria-label="Next">
        <Icon name="arrow-right" size={22} class="flip" />
      </button>
    </div>
  </div>
</section>

<section class="in-sheet st-section st-black" aria-labelledby="in-sheet-t">
  <div class="st-wrap">
    <p class="in-sheet__label" id="in-sheet-t">
      <Icon name="camera" size={18} /> {toLocalNum(String(sheet.length), locale)} {words.photos}
    </p>
    <ol class="in-sheet__grid" role="list">
      {
        sheet.map((s, k) => (
          <li class="in-frame">
            <button type="button" data-pf-open={s.index} aria-label={`${s.title} ${s.subtitle}`}>
              <img src={s.src.replace('-1200w.webp', '-480w.webp')} alt="" loading="lazy" width="480" height="640" />
            </button>
            <span class="in-frame__n" aria-hidden="true">{num(k + 1)}A</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // The inspection lamp: follows the pointer (or finger); drifts on its own
  // until the visitor moves, and stays put for reduced motion.
  for (const hero of document.querySelectorAll<HTMLElement>('[data-in-hero]')) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let user = false;
    let raf = 0;
    const set = (x: number, y: number) => {
      hero.style.setProperty('--x', `${x}px`);
      hero.style.setProperty('--y', `${y}px`);
    };
    const drift = (t: number) => {
      if (user) return;
      const r = hero.getBoundingClientRect();
      set(r.width * (0.55 + 0.25 * Math.sin(t / 2300)), r.height * (0.45 + 0.18 * Math.sin(t / 1700)));
      raf = requestAnimationFrame(drift);
    };
    const r = hero.getBoundingClientRect();
    set(r.width * 0.62, r.height * 0.42);
    if (!still) raf = requestAnimationFrame(drift);
    hero.addEventListener('pointermove', (e) => {
      user = true;
      cancelAnimationFrame(raf);
      const box = hero.getBoundingClientRect();
      set(e.clientX - box.left, e.clientY - box.top);
    });
    // Pause the drift while the hero is off screen.
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      if (e.isIntersecting && !user && !still) raf = requestAnimationFrame(drift);
    }).observe(hero);
  }

  // The turntable: the card nearest the middle is lit, its details show.
  for (const turn of document.querySelectorAll<HTMLElement>('[data-in-turn]')) {
    const rail = turn.querySelector<HTMLElement>('[data-in-rail]')!;
    const cars = [...rail.querySelectorAll<HTMLElement>('[data-in-car]')];
    const panels = [...turn.querySelectorAll<HTMLElement>('[data-in-panel]')];
    const now = turn.querySelector<HTMLElement>('[data-in-now]')!;
    const arabic = document.documentElement.lang === 'ar';
    let current = 0;
    const light = (i: number) => {
      if (i === current) return;
      current = i;
      cars.forEach((c, k) => c.toggleAttribute('data-lit', k === i));
      panels.forEach((p, k) => (p.hidden = k !== i));
      const n = String(i + 1).padStart(2, '0');
      now.textContent = arabic ? n.replace(/\d/g, (d) => '٠١٢٣٤٥٦٧٨٩'[Number(d)]) : n;
    };
    const pick = () => {
      const mid = rail.getBoundingClientRect().left + rail.clientWidth / 2;
      let best = 0;
      let dist = Infinity;
      cars.forEach((c, k) => {
        const b = c.getBoundingClientRect();
        const d = Math.abs(b.left + b.width / 2 - mid);
        if (d < dist) [best, dist] = [k, d];
      });
      light(best);
    };
    let ticking = false;
    rail.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          pick();
          ticking = false;
        });
      },
      { passive: true },
    );
    const go = (i: number) => {
      const target = cars[Math.max(0, Math.min(cars.length - 1, i))];
      const r = rail.getBoundingClientRect();
      const b = target.getBoundingClientRect();
      // scrollBy, not scrollIntoView, so the page itself never jumps.
      rail.scrollBy({ left: b.left + b.width / 2 - (r.left + r.width / 2), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    for (const b of turn.querySelectorAll<HTMLButtonElement>('[data-in-step]')) b.addEventListener('click', () => go(current + Number(b.dataset.inStep)));
    // A click on a card that is not in the middle brings it there first.
    for (const [k, c] of cars.entries()) {
      c.querySelector('button')!.addEventListener(
        'click',
        (e) => {
          if (k === current) return;
          e.stopPropagation();
          go(k);
        },
        { capture: true },
      );
    }
    // Mouse drag to turn (touch already scrolls).
    let down: { x: number; left: number } | null = null;
    let moved = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = { x: e.clientX, left: rail.scrollLeft };
      moved = false;
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - down.x;
      if (Math.abs(dx) > 5) {
        moved = true;
        rail.dataset.dragging = '';
      }
      rail.scrollLeft = down.left - dx;
    });
    addEventListener('pointerup', () => {
      if (!down) return;
      down = null;
      delete rail.dataset.dragging;
      if (moved) go(current);
    });
    rail.addEventListener('click', (e) => moved && (e.stopPropagation(), e.preventDefault(), (moved = false)), { capture: true });
    
  }
</script>

<style>
  /* Hero: the dark studio, lit where the lamp points. */
  .in-hero {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    --x: 60%;
    --y: 40%;
    --r: clamp(9rem, 22vw, 17rem);
    position: relative;
    display: grid;
    min-block-size: min(52rem, 100svh);
    background: var(--st-black);
    overflow: hidden;
    isolation: isolate;
  }
  .in-hero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 3px;
  }
  .in-hero__photo :global(picture) {
    display: block;
    min-inline-size: 0;
  }
  .in-hero__photo :global(picture:not(:first-child)) {
    display: none;
  }
  @media (min-width: 48rem) {
    .in-hero__photo :global(picture:not(:first-child)) {
      display: block;
    }
  }
  .in-hero__photo :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 72%;
  }
  .in-hero__photo--dim :global(img) {
    filter: grayscale(1) brightness(0.22);
  }
  .in-hero__photo--lit {
    z-index: -1;
    mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 0%, #000 55%, transparent 100%);
  }
  .in-hero__ring {
    position: absolute;
    inset-block-start: var(--y);
    inset-inline-start: var(--x);
    z-index: -1;
    inline-size: calc(var(--r) * 1.15);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 50%;
    translate: -50% -50%;
    pointer-events: none;
  }
  /* --x is measured from the left edge on both scripts. */
  :global([dir='rtl']) .in-hero__ring {
    inset-inline-start: auto;
    left: var(--x);
  }
  .in-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(12 13 15 / 0.95), transparent 45%), linear-gradient(to bottom, rgb(12 13 15 / 0.6), transparent 25%);
    pointer-events: none;
  }
  .in-hero__inner {
    display: grid;
    grid-template-rows: auto 1fr;
    padding-block: 7.5rem 3rem;
  }
  .in-hero__text {
    display: grid;
    gap: 1rem;
    align-self: end;
  }
  .in-hero__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(3.6rem, 1.5rem + 9.5vw, 10rem);
    line-height: 0.85;
    text-transform: uppercase;
  }
  .in-hero__lede {
    max-inline-size: 34rem;
    color: var(--st-on-dark);
    font-size: 1.125rem;
  }

  /* Turntable */
  .in-turn {
    padding-block: 3rem 2rem;
  }
  .in-turn__rail {
    display: flex;
    gap: 1rem;
    padding-block: 1.5rem;
    padding-inline: calc(50% - min(36vw, 12rem));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }
  .in-turn__rail[data-dragging] {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .in-turn__rail::-webkit-scrollbar {
    display: none;
  }
  .in-car {
    flex: none;
    inline-size: min(72vw, 24rem);
    margin: 0;
    scroll-snap-align: center;
    transition: scale 0.45s ease, opacity 0.45s ease;
    scale: 0.88;
    opacity: 0.55;
  }
  .in-car[data-lit] {
    scale: 1;
    opacity: 1;
  }
  .in-car__open {
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    background: var(--st-coal);
    overflow: hidden;
    cursor: zoom-in;
  }
  .in-car:not([data-lit]) .in-car__open {
    cursor: pointer;
  }
  .in-car__open :global(img) {
    display: block;
    inline-size: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(1) brightness(0.65);
    transition: filter 0.6s ease;
    -webkit-user-drag: none;
    user-select: none;
  }
  .in-car[data-lit] .in-car__open :global(img),
  .in-car__open:hover :global(img),
  .in-car__open:focus-visible :global(img) {
    filter: none;
  }
  .in-car__cap {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding-block-start: 0.85rem;
  }
  .in-car__n {
    font-family: var(--st-head-font);
    font-size: 0.875rem;
    color: var(--st-red);
  }
  .in-car__cap strong {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(1.3rem, 1rem + 1vw, 1.8rem);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .in-turn__foot {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 48rem) {
    .in-turn__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }
  .in-panel {
    min-block-size: 8rem;
    border-inline-start: 3px solid var(--st-red);
    padding-inline-start: 1.25rem;
  }
  .in-panel__item[hidden] {
    display: none;
  }
  .in-panel__item {
    display: grid;
    gap: 0.5rem;
    animation: in-fade 0.4s ease;
  }
  @keyframes in-fade {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }
  .in-panel__sub {
    font-family: var(--st-head-font);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .in-panel__desc {
    max-inline-size: 38rem;
    color: var(--st-on-dark);
  }
  .in-panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .in-panel__tags a {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--st-line-dark);
    color: var(--st-white);
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .in-panel__tags a:hover {
    border-color: var(--st-white);
  }
  .in-turn__nav {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .in-turn__count {
    margin-inline-end: 0.75rem;
    font-family: var(--st-head-font);
    font-size: 1.1rem;
    color: var(--st-mute);
  }
  .in-turn__count span {
    color: var(--st-white);
  }
  .in-turn__btn {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border: 1px solid var(--st-line-dark);
    border-radius: 50%;
    background: none;
    color: var(--st-white);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .in-turn__btn:hover {
    background: var(--st-white);
    color: var(--st-black);
  }

  /* Contact sheet: film edges, frame numbers, a grease-pencil circle on hover. */
  .in-sheet {
    padding-block-start: 2rem;
  }
  .in-sheet__label {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-block-end: 1.25rem;
    font-family: var(--st-head-font);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--st-mute);
  }
  .in-sheet__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem 0.4rem;
    margin: 0;
    padding: 1.1rem 0.6rem;
    list-style: none;
    background:
      radial-gradient(circle at 50% 50%, var(--st-black) 0.22rem, transparent 0.24rem) 0 0.2rem / 1.1rem 0.7rem repeat-x,
      radial-gradient(circle at 50% 50%, var(--st-black) 0.22rem, transparent 0.24rem) 0 calc(100% - 0.2rem) / 1.1rem 0.7rem repeat-x,
      #1b1d20;
  }
  @media (min-width: 40rem) {
    .in-sheet__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .in-sheet__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .in-frame {
    position: relative;
  }
  .in-frame button {
    position: relative;
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .in-frame img {
    display: block;
    inline-size: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: filter 0.3s;
  }
  .in-frame button::after {
    content: '';
    position: absolute;
    inset: -6% -4%;
    border: 3px solid var(--st-red);
    border-radius: 48% 52% 46% 54% / 55% 45% 55% 45%;
    rotate: -6deg;
    opacity: 0;
    scale: 0.9;
    transition: opacity 0.2s, scale 0.2s;
    pointer-events: none;
  }
  .in-frame button:hover::after,
  .in-frame button:focus-visible::after {
    opacity: 1;
    scale: 1;
  }
  .in-frame__n {
    position: absolute;
    inset-block-end: -1.35rem;
    inset-inline-start: 0.1rem;
    font-family: var(--st-head-font);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--st-mute);
  }

  @media (prefers-reduced-motion: reduce) {
    .in-car,
    .in-car__open :global(img),
    .in-frame img,
    .in-frame button::after {
      transition: none;
    }
    .in-panel__item {
      animation: none;
    }
  }
</style>
