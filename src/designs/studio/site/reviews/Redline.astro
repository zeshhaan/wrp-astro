---
/**
 * Concept A, Redline: the reviews page as a car's instrument cluster.
 * The rating is a rev counter whose needle swings to 5.0 and bounces off the
 * limiter (press Rev to do it again), the review count rolls up on an
 * odometer and the 5-star share is a full tank. Below: the scrolling reviews,
 * customer photos on a pit-lane strip with a lap line, every review behind
 * a gear-gate filter, and a push-to-start quote button.
 *
 * Every number and label is real text in a <dl>; the dials are drawn around
 * it and hidden from screen readers. Reduced motion parks the needle at 5.0
 * and stops everything else moving.
 */
import { t, type Locale } from '@/i18n/translations';
import { localizeUrl } from '@/i18n/utils';
import ReviewCard from '../sections/ReviewCard.astro';
import ReviewScript from '../sections/ReviewScript.astro';
import Icon from '../../Icon.astro';
import Marquee from './Marquee.astro';
import Wall from './Wall.astro';
import GoogleG from './GoogleG.astro';
import { reviewsPage, serviceFilters } from './data';

interface Props {
  locale?: Locale;
  link: (href: string) => string;
}

const { locale = 'en', link } = Astro.props;
const d = reviewsPage(locale);
const { num } = d;
const ar = locale === 'ar';

// The rev counter: 0 to 5 over 240 degrees, red from 4.5.
const cx = 120;
const cy = 120;
const angle = (v: number) => -120 + (v / 5) * 240;
const point = (v: number, r: number) => {
  const a = ((angle(v) - 90) * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const arc = (from: number, to: number, r: number) => {
  const [x1, y1] = point(from, r);
  const [x2, y2] = point(to, r);
  const large = angle(to) - angle(from) > 180 ? 1 : 0;
  return `M${x1} ${y1} A${r} ${r} 0 ${large} 1 ${x2} ${y2}`;
};
const ticks = Array.from({ length: 21 }, (_, i) => i / 4);
const odometer = String(parseInt(d.displayCount, 10)).split('');
const words = ar
  ? { rev: 'تسارع', photos: 'صور العملاء', prev: 'السابق', next: 'التالي', filter: 'اعرض تقييمات عن', all: 'الكل' }
  : { rev: 'Rev it', photos: 'Customer photos', prev: 'Previous photos', next: 'Next photos', filter: 'Show reviews about', all: 'All' };
---

<section class="rl" data-redline>
  <div class="st-wrap rl__inner">
    <h1 class="rl__title">{t(locale, 'reviews.whatClientsSay')}</h1>
    <p class="rl__count">{num(d.displayCount)} {t(locale, 'reviews.verifiedOnGoogle')}</p>

    <dl class="rl__cluster">
      <div class="rl__dial rl__odo">
        <dt>{t(locale, 'reviews.reviews')}</dt>
        <dd>
          <span class="visually-hidden">{num(d.displayCount)}</span>
          <span class="rl__wheels" aria-hidden="true" dir="ltr">
            {
              odometer.map((digit, i) => (
                <span class="rl__wheel" style={`--to:${digit};--i:${i}`}>
                  <span class="rl__digits">{Array.from({ length: 10 }, (_, n) => <span>{num(n)}</span>)}</span>
                </span>
              ))
            }
            <span class="rl__plus">+</span>
          </span>
        </dd>
      </div>

      <div class="rl__dial rl__tach">
        <dt>{t(locale, 'reviews.statsRating')}</dt>
        <dd>
          <svg class="rl__gauge" viewBox="0 0 240 180" aria-hidden="true">
            <path d={arc(0, 5, 100)} class="rl__track" />
            <path d={arc(4.5, 5, 100)} class="rl__red" />
            {
              ticks.map((v) => {
                const major = Number.isInteger(v);
                const [x1, y1] = point(v, major ? 84 : 90);
                const [x2, y2] = point(v, 100);
                const [lx, ly] = point(v, 68);
                return (
                  <>
                    <line x1={x1} y1={y1} x2={x2} y2={y2} class:list={['rl__tick', major && 'rl__tick--major', v >= 4.5 && 'rl__tick--red']} />
                    {major && (
                      <text x={lx} y={ly} class:list={['rl__num', v === 5 && 'rl__num--red']}>
                        {num(v)}
                      </text>
                    )}
                  </>
                );
              })
            }
            <g class="rl__needle">
              <line x1={cx} y1={cy + 14} x2={cx} y2={cy - 92} />
            </g>
            <circle cx={cx} cy={cy} r="9" class="rl__hub" />
          </svg>
          <span class="rl__readout">
            <span class="rl__score">{num(d.business.rating.toFixed(1))}</span>
            <span class="rl__google">
              <GoogleG size={20} />
              <span class="rl__stars" role="img" aria-label="5 out of 5 stars">{Array.from({ length: 5 }, () => <Icon name="star" size={16} />)}</span>
            </span>
          </span>
        </dd>
      </div>

      <div class="rl__dial rl__fuel">
        <dt>{t(locale, 'reviews.statsFiveStar')}</dt>
        <dd>
          <span class="rl__pct">{num('100%')}</span>
          <span class="rl__tank" aria-hidden="true">
            <span class="rl__e">E</span>
            {Array.from({ length: 10 }, (_, i) => <span class="rl__cell" style={`--i:${i}`} />)}
            <span class="rl__f">F</span>
          </span>
        </dd>
      </div>
    </dl>

    <button type="button" class="rl__rev" data-rev>
      <span class="rl__rev-dot" aria-hidden="true"></span>
      {words.rev}
    </button>
  </div>
</section>

<Marquee rows={d.rows} locale={locale} class="st-dark" />

{
  d.withImages.length > 0 && (
    <section class="st-section st-white pit">
      <div class="st-wrap">
        <header class="pit__head">
          <div class="st-head">
            <h2 class="st-h2">{t(locale, 'reviews.seeResults')}</h2>
            <p class="st-intro">{t(locale, 'reviews.customerPhotos')}</p>
          </div>
          <p class="pit__nav">
            <button type="button" class="pit__btn" data-pit="-1">
              <Icon name="arrow-left" size={20} class="flip" />
              <span class="visually-hidden">{words.prev}</span>
            </button>
            <button type="button" class="pit__btn" data-pit="1">
              <Icon name="arrow-right" size={20} class="flip" />
              <span class="visually-hidden">{words.next}</span>
            </button>
          </p>
        </header>
      </div>
      <ul class="pit__lane" role="list" tabindex="0" aria-label={words.photos} data-pit-lane>
        {d.withImages.map((r) => (
          <li class="pit__car">
            <ReviewCard review={r} locale={locale} max={260} highlight photos="all" />
          </li>
        ))}
      </ul>
      <div class="st-wrap" aria-hidden="true">
        <div class="pit__lap">
          <span class="pit__flag" />
          <span class="pit__kart" data-pit-kart />
        </div>
      </div>
    </section>
  )
}

<section class="st-section st-light" id="all-reviews">
  <div class="st-wrap">
    <header class="st-head st-head--center">
      <h2 class="st-h2">{t(locale, 'reviews.allReviews')}</h2>
      <p class="st-intro">{t(locale, 'reviews.everyReview')}</p>
    </header>
    <Wall reviews={d.textOnly} filters={serviceFilters(d.textOnly, locale)} locale={locale} look="gear" legend={words.filter} allLabel={words.all} />
  </div>
</section>

<section class="st-section st-black start">
  <div class="st-wrap start__inner">
    <h2 class="st-h2">{t(locale, 'reviews.readyDifference')}</h2>
    <p class="start__text">{d.joinLine}</p>
    <a class="start__btn" href={link(localizeUrl('/contact-us/', locale))}>
      <span class="start__ring" aria-hidden="true">
        <span>ENGINE</span>
        <span>START · STOP</span>
      </span>
      <span class="start__label">{t(locale, 'home.hero.getQuote')}</span>
    </a>
  </div>
</section>
<ReviewScript />

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // Start the cluster once it is on screen; Rev replays the needle's bounce.
  const hero = document.querySelector<HTMLElement>('[data-redline]');
  if (hero) {
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      hero.classList.add('is-on');
      io.disconnect();
    }).observe(hero);
    hero.querySelector('[data-rev]')?.addEventListener('click', () => {
      hero.classList.remove('is-rev');
      void hero.offsetWidth;
      hero.classList.add('is-rev');
    });
  }

  // Pit lane: arrows move one card; the kart rides the lap line with scroll.
  const lane = document.querySelector<HTMLElement>('[data-pit-lane]');
  const kart = document.querySelector<HTMLElement>('[data-pit-kart]');
  if (lane) {
    const rtl = getComputedStyle(lane).direction === 'rtl';
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-pit]')) {
      btn.addEventListener('click', () => {
        const step = (lane.querySelector<HTMLElement>('.pit__car')?.offsetWidth ?? 320) + 16;
        lane.scrollBy({ left: Number(btn.dataset.pit) * step * (rtl ? -1 : 1), behavior: reduce.matches ? 'auto' : 'smooth' });
      });
    }
    const move = () => {
      const max = lane.scrollWidth - lane.clientWidth;
      const p = max > 0 ? Math.abs(lane.scrollLeft) / max : 0;
      kart?.style.setProperty('--p', String(p));
    };
    lane.addEventListener('scroll', move, { passive: true });
    move();
  }
</script>

<style>
  /* Hero: the instrument cluster */
  .rl {
    padding-block: 8.5rem 4rem;
    background:
      radial-gradient(ellipse 60% 50% at 50% 62%, rgb(212 20 28 / 0.16), transparent 70%),
      radial-gradient(ellipse at 50% 0%, rgb(255 255 255 / 0.12), transparent 60%),
      var(--st-black);
    text-align: center;
    overflow: hidden;
  }
  .rl__inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .rl__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(2.6rem, 1.5rem + 4.6vw, 5rem);
    line-height: 0.98;
    text-transform: uppercase;
  }
  .rl__count {
    color: var(--st-on-dark);
    font-size: 1.125rem;
  }
  .rl__cluster {
    display: grid;
    grid-template-areas: 'tach tach' 'odo fuel';
    gap: 1.25rem;
    align-items: end;
    inline-size: min(100%, 62rem);
    margin: 1.5rem 0 0;
  }
  @media (min-width: 52rem) {
    .rl__cluster {
      grid-template-areas: 'odo tach fuel';
      grid-template-columns: 1fr 1.7fr 1fr;
    }
  }
  .rl__dial {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 0.6rem;
  }
  .rl__dial dt {
    font-family: var(--st-head-font);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--st-mute);
  }
  .rl__dial dd {
    margin: 0;
  }
  .rl__odo {
    grid-area: odo;
  }
  .rl__tach {
    grid-area: tach;
  }
  .rl__fuel {
    grid-area: fuel;
  }

  /* Odometer: each wheel rolls a few turns, then lands on its digit. */
  .rl__wheels {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 6px;
    background: var(--st-coal);
    border: 1px solid var(--st-line-dark);
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    line-height: 1;
  }
  .rl__wheel {
    display: block;
    block-size: 1.2em;
    inline-size: 0.85em;
    overflow: hidden;
    background: linear-gradient(var(--st-black), var(--st-card-dark) 50%, var(--st-black));
  }
  .rl__digits {
    display: grid;
    translate: 0 calc(var(--to) * -1.2em);
  }
  .rl__digits > span {
    display: grid;
    place-items: center;
    block-size: 1.2em;
  }
  .rl__plus {
    padding-inline: 0.15em;
    color: var(--st-white);
  }

  /* Rev counter */
  .rl__tach dd {
    position: relative;
    inline-size: min(100%, 26rem);
  }
  .rl__gauge {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }
  .rl__track,
  .rl__red {
    fill: none;
    stroke-width: 3;
  }
  .rl__track {
    stroke: var(--st-line-dark);
  }
  .rl__red {
    stroke: var(--st-red);
    stroke-width: 10;
  }
  .rl__tick {
    stroke: var(--st-mute);
    stroke-width: 1.5;
  }
  .rl__tick--major {
    stroke: var(--st-white);
    stroke-width: 3;
  }
  .rl__tick--red {
    stroke: var(--st-red);
  }
  .rl__num {
    fill: var(--st-on-dark);
    font-family: var(--st-head-font);
    font-size: 15px;
    font-weight: 500;
    text-anchor: middle;
    dominant-baseline: middle;
  }
  .rl__num--red {
    fill: #ff5a5f;
  }
  .rl__needle {
    transform-origin: 120px 120px;
    rotate: -120deg;
  }
  .rl__needle line {
    stroke: var(--st-red);
    stroke-width: 4;
    stroke-linecap: square;
  }
  .rl__hub {
    fill: var(--st-black);
    stroke: var(--st-white);
    stroke-width: 3;
  }
  .rl__readout {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin-block-start: -2.75rem;
  }
  .rl__google {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .rl__score {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(2.75rem, 2rem + 3vw, 4rem);
    line-height: 1;
  }
  .rl__stars {
    display: inline-flex;
    gap: 3px;
    color: var(--st-white);
  }
  .rl__stars :global(svg) {
    fill: currentColor;
  }

  /* Fuel: ten cells, all lit */
  .rl__pct {
    display: block;
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    line-height: 1.2;
  }
  .rl__tank {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-block-start: 0.4rem;
    font-family: var(--st-head-font);
    font-size: 0.8125rem;
    color: var(--st-mute);
  }
  .rl__e {
    margin-inline-end: 0.3rem;
  }
  .rl__f {
    margin-inline-start: 0.3rem;
    color: var(--st-white);
  }
  .rl__cell {
    inline-size: 0.6rem;
    block-size: 1.3rem;
    background: var(--st-white);
  }
  .rl__cell:last-of-type {
    background: var(--st-red);
  }

  .rl__rev {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-block-size: 2.75rem;
    margin-block-start: 0.5rem;
    padding: 0.5rem 1.2rem;
    border: 1.5px solid rgb(255 255 255 / 0.6);
    background: transparent;
    color: var(--st-white);
    font-family: var(--st-head-font);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
  }
  .rl__rev:hover {
    border-color: var(--st-white);
    background: rgb(255 255 255 / 0.08);
  }
  .rl__rev-dot {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: var(--st-red);
    box-shadow: 0 0 0 3px rgb(212 20 28 / 0.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rl__digits {
      translate: 0 0;
    }
    .rl.is-on .rl__digits {
      translate: 0 calc(var(--to) * -1.2em);
      transition: translate calc(1.1s + var(--i) * 0.35s) cubic-bezier(0.2, 0.9, 0.25, 1.05);
    }
    .rl__cell {
      opacity: 0.12;
    }
    .rl.is-on .rl__cell {
      opacity: 1;
      transition: opacity 0.15s calc(0.6s + var(--i) * 0.09s);
    }
    .rl.is-on .rl__needle {
      animation: rl-sweep 1.9s cubic-bezier(0.3, 0, 0.2, 1) 0.3s both;
    }
    .rl.is-rev .rl__needle {
      animation: rl-rev 1.4s ease-out both;
    }
    .rl.is-rev .rl__cluster {
      animation: rl-shake 0.5s linear 0.25s;
    }
    .rl.is-rev .rl__rev-dot {
      animation: rl-blink 0.25s steps(1) 4;
    }
  }
  /* Reduced motion, or after the sweep: parked at 5.0. */
  .rl.is-on .rl__needle,
  .rl.is-rev .rl__needle {
    rotate: 120deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .rl__needle {
      rotate: 120deg;
    }
    .rl__rev {
      display: none;
    }
  }
  @keyframes rl-sweep {
    0% {
      rotate: -120deg;
    }
    55% {
      rotate: 127deg;
    }
    63% {
      rotate: 113deg;
    }
    71% {
      rotate: 124deg;
    }
    80% {
      rotate: 116deg;
    }
    90% {
      rotate: 121.5deg;
    }
    100% {
      rotate: 120deg;
    }
  }
  @keyframes rl-rev {
    0% {
      rotate: 120deg;
    }
    12% {
      rotate: 40deg;
    }
    28% {
      rotate: 128deg;
    }
    36% {
      rotate: 111deg;
    }
    44% {
      rotate: 127deg;
    }
    52% {
      rotate: 112deg;
    }
    60% {
      rotate: 125deg;
    }
    75% {
      rotate: 117deg;
    }
    100% {
      rotate: 120deg;
    }
  }
  @keyframes rl-shake {
    25% {
      translate: -2px 1px;
    }
    50% {
      translate: 2px -1px;
    }
    75% {
      translate: -1px -1px;
    }
  }
  @keyframes rl-blink {
    50% {
      opacity: 0.2;
    }
  }

  /* Pit lane: the photo reviews in one row you can drive along */
  .pit__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 2rem;
  }
  .pit__head .st-head {
    margin: 0;
  }
  .pit__nav {
    display: flex;
    gap: 0.5rem;
  }
  .pit__btn {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border: 1.5px solid var(--st-ink);
    background: var(--st-white);
    color: var(--st-ink);
    cursor: pointer;
  }
  .pit__btn:hover {
    background: var(--st-ink);
    color: var(--st-white);
  }
  .pit__lane {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    margin: 0;
    padding: 0.25rem var(--st-gutter-x) 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--st-gutter-x);
    scrollbar-width: none;
  }
  .pit__lane::-webkit-scrollbar {
    display: none;
  }
  .pit__lane:focus-visible {
    outline: 3px solid var(--st-ink);
    outline-offset: -3px;
  }
  .pit__car {
    flex: none;
    inline-size: min(82vw, 22rem);
    scroll-snap-align: start;
  }
  .pit__lap {
    position: relative;
    block-size: 1rem;
    margin-block-start: 1rem;
    background: repeating-linear-gradient(90deg, var(--st-ink) 0 14px, transparent 14px 28px) 0 50% / 100% 2px no-repeat;
  }
  .pit__flag {
    position: absolute;
    inset-inline-end: 0;
    inset-block: 0;
    inline-size: 1rem;
    background: conic-gradient(var(--st-ink) 25%, var(--st-white) 0 50%, var(--st-ink) 0 75%, var(--st-white) 0) 0 0 / 0.5rem 0.5rem;
    outline: 1px solid var(--st-ink);
  }
  .pit__kart {
    --p: 0;
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--p) * (100% - 2.25rem));
    inline-size: 1.75rem;
    background: var(--st-red);
    clip-path: polygon(0 20%, 70% 20%, 100% 50%, 70% 80%, 0 80%);
  }
  :global([dir='rtl']) .pit__kart {
    scale: -1 1;
  }

  /* Push to start */
  .start {
    text-align: center;
  }
  .start__inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .start__text {
    color: var(--st-on-dark);
    font-size: 1.0625rem;
    margin-block-end: 1rem;
  }
  .start__btn {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 11rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, #e3262e, var(--st-red) 55%, #8f0c12);
    color: var(--st-white);
    text-decoration: none;
    box-shadow:
      0 0 0 10px var(--st-coal),
      0 0 0 12px var(--st-line-dark),
      0 0 0 13px var(--st-mute),
      0 18px 40px rgb(0 0 0 / 0.6);
    transition: scale 0.12s, box-shadow 0.3s;
  }
  .start__btn:hover {
    box-shadow:
      0 0 0 10px var(--st-coal),
      0 0 0 12px var(--st-line-dark),
      0 0 0 13px var(--st-white),
      0 0 50px rgb(212 20 28 / 0.6);
  }
  .start__btn:active {
    scale: 0.95;
  }
  .start__btn:focus-visible {
    outline-offset: 18px;
  }
  .start__ring {
    position: absolute;
    inset: 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    font-family: var(--st-head-font);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
  }
  .start__label {
    max-inline-size: 7rem;
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .start__btn {
      transition: none;
    }
  }
</style>
