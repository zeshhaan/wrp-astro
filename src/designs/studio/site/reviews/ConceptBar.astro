---
/** Lab only: a bar at the foot of each reviews concept to switch between them. */
import { reviewConcepts, type ReviewConceptId } from './concepts';

interface Props {
  current: ReviewConceptId;
}
const { current } = Astro.props;
---

<nav class="cb" aria-label="Reviews page concepts">
  <a class="cb__all" href="/design-lab/studio/review-concepts/">All concepts</a>
  {
    reviewConcepts.map((c) => (
      <a href={`/design-lab/studio/review-concepts/${c.id}/`} aria-current={c.id === current ? 'page' : undefined}>
        <b>{c.id.toUpperCase()}</b> {c.name}
      </a>
    ))
  }
</nav>

<style>
  .cb {
    position: fixed;
    inset-block-end: 0.75rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 60;
    display: flex;
    gap: 2px;
    max-inline-size: calc(100vw - 1.5rem);
    overflow-x: auto;
    padding: 3px;
    background: var(--st-white);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.45);
    font-family: var(--st-head-font);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cb a {
    flex: none;
    padding: 0.55rem 0.8rem;
    color: var(--st-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .cb a:hover {
    background: var(--st-paper);
  }
  .cb a[aria-current] {
    background: var(--st-red);
    color: var(--st-white);
  }
  .cb a:focus-visible {
    outline: 3px solid var(--st-ink);
    outline-offset: -3px;
  }
  .cb__all {
    border-inline-end: 1px solid var(--st-line-light);
  }
</style>
