---
import Picture from '../shared/Picture.astro';
import Icon from './Icon.astro';
import { proof, whyPoints } from './content';
---

<section class="why st-section st-light" id="why" aria-labelledby="why-title">
  <div class="st-wrap why__grid">
    <div class="why__aside">
      <header class="st-head why__head">
        <p class="st-eyebrow st-eyebrow--dark">In our customers’ words</p>
        <h2 id="why-title" class="st-h2">Why choose WRP</h2>
        <p class="st-intro">The four things our customers mention most in their Google reviews.</p>
      </header>
      <a class="rating" href={proof.reviewsUrl}>
        <span class="rating__score">{proof.rating}</span>
        <span class="rating__meta">
          <span class="rating__stars" role="img" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }, () => <Icon name="star" size={16} />)}
          </span>
          <span class="rating__count">{proof.reviewCountDisplay} Google reviews</span>
        </span>
        <Icon name="arrow-right" size={20} class="rating__arrow" />
      </a>
      <figure class="why__photo">
        <Picture
          base="/review-images/leno_thomas_2"
          widths={[480, 800]}
          alt="Grey Toyota FJ Cruiser with a fresh ceramic coating, front view in the WRP studio"
          sizes="(min-width: 60rem) 34vw, 100vw"
        />
        <figcaption>Leno Thomas’s FJ Cruiser after its ceramic coating, as posted with the Google review.</figcaption>
      </figure>
    </div>

    <ol class="points" role="list">
      {
        whyPoints.map((p, i) => (
          <li class="point">
            <div class="point__label">
              <span class="point__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="point__title">{p.title}</h3>
            </div>
            <figure class="point__quote">
              <blockquote>
                <p>{p.quote}</p>
              </blockquote>
              <figcaption>
                <span class="point__author">{p.author}</span>, Google review
              </figcaption>
            </figure>
            <p class="point__body">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .why__grid {
    display: grid;
    gap: 2.5rem 5rem;
  }
  .why__aside {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .why__head {
    margin-block-end: 0;
  }

  /* Google rating badge */
  .rating {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    justify-self: start;
    padding: 0.7rem 1rem 0.7rem 0.9rem;
    background: var(--st-black);
    color: var(--st-white);
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .rating__score {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 2.25rem;
    line-height: 1;
  }
  .rating__meta {
    display: grid;
    gap: 0.2rem;
  }
  .rating__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--st-gold);
  }
  .rating__stars :global(svg) {
    fill: currentColor;
  }
  .rating__count {
    font-family: var(--st-head-font);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--st-on-dark);
  }
  .rating :global(.rating__arrow) {
    margin-inline-start: 0.25rem;
    color: var(--st-gold);
  }
  .rating:hover {
    background: var(--st-gold);
    color: var(--st-black);
  }
  .rating:hover :is(.rating__stars, .rating__count, :global(.rating__arrow)) {
    color: var(--st-black);
  }

  .why__photo {
    display: none;
    margin: 0;
  }
  .why__photo :global(img) {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .why__photo figcaption {
    margin-block-start: 0.6rem;
    font-size: 0.8125rem;
    color: var(--st-ink-2);
  }

  /* The four points: label row, the customer's words large, then our promise */
  .points {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 3px solid var(--st-ink);
  }
  .point {
    display: grid;
    gap: 1rem;
    padding-block: 1.75rem 2rem;
    border-block-end: 1px solid var(--st-line-light);
  }
  .point__label {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  .point__num {
    font-family: var(--st-head-font);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    color: var(--st-gold-deep);
  }
  .point__title {
    flex: 1;
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }
  .point__quote {
    margin: 0;
  }
  .point__quote blockquote {
    position: relative;
    margin: 0;
    padding-inline-start: 1.6rem;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.85rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--st-ink);
    text-wrap: balance;
  }
  .point__quote blockquote::before {
    content: '“';
    position: absolute;
    inset-inline-start: -0.1rem;
    inset-block-start: -0.35rem;
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
    color: var(--st-gold);
  }
  .point__quote blockquote p::after {
    content: '”';
  }
  .point__quote figcaption {
    margin-block-start: 0.6rem;
    padding-inline-start: 1.6rem;
    font-size: 0.875rem;
    color: var(--st-ink-2);
  }
  .point__author {
    font-weight: 700;
    color: var(--st-ink);
  }
  .point__body {
    padding-inline-start: 1.6rem;
    max-inline-size: 36rem;
    color: var(--st-ink-2);
    font-size: 0.9375rem;
  }

  @media (min-width: 40rem) {
    .why__photo {
      display: block;
    }
  }
  @media (min-width: 60rem) {
    .why__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
    .why__aside {
      position: sticky;
      inset-block-start: calc(var(--st-head) + 2rem);
    }
    .point {
      grid-template-columns: 13rem 1fr;
      column-gap: 2rem;
      padding-block: 2.25rem 2.5rem;
    }
    .point__label {
      grid-row: span 2;
      flex-direction: column;
      align-items: start;
      gap: 0.6rem;
    }
    .point__title {
      flex: none;
    }
    .point__num {
      font-size: 2.75rem;
      font-weight: 600;
      line-height: 1;
      letter-spacing: 0;
    }
    .point__quote blockquote,
    .point__quote figcaption,
    .point__body {
      padding-inline-start: 0;
    }
    .point__quote blockquote::before {
      inset-inline-start: -1.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rating {
      transition: none;
    }
  }
</style>
