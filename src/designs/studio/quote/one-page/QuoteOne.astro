---
/**
 * Studio: the quote page (/quote/), where every "Get a quick quote" button
 * goes. Shereef chose it over the step-by-step flow (removed).
 *
 * A configurator: the 3D car stays in view while every choice sits in one
 * scrolling panel of chips, like the car-viewer test page. State, prices and
 * the WhatsApp text come from ../state.ts.
 */
import StudioPage from '../../site/StudioPage.astro';
import QIcon from '../QIcon.astro';
import { buildCatalog } from '../catalog';
import { bodyTypes, panels, wrapParts } from '../panels';
import { interiorItems, interiorMaterials, paintChips, polishConditions, slots, wrapFinishes } from '../state';
import { carModels } from '../models';
import type { Locale } from '@/i18n/translations';
import { quoteLabel, quoteAmount, quoteNumber } from '../labels';
import '../quote.css';
import './one.css';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const ar = locale === 'ar';
const t = (english: string, arabic: string) => ar ? arabic : english;
const label = (text: string) => quoteLabel(text, locale);
const catalog = await buildCatalog(locale);
const thisYear = 2026;
const years = Array.from({ length: thisYear + 1 - 1995 }, (_, i) => String(thisYear + 1 - i));
const aed = (n: number) => quoteAmount(n, locale);
const svc = (id: string) => catalog.services.find((s) => s.id === id)!;
const panelGroups = [
  { id: 'front', label: 'Front' },
  { id: 'side', label: 'Sides' },
  { id: 'top', label: 'Roof & pillars' },
  { id: 'rear', label: 'Rear' },
] as const;
---

<StudioPage
  app
  locale={locale}
  title={t("Get a quote on one page · WRP Detailing Dubai", "اطلب عرض سعر للعناية بسيارتك في دبي | WRP")}
  description={t("Choose your car, the services and the details on one page, see the price build up on a 3D car, and send it on WhatsApp.", "اختر سيارتك وخدمات العناية التي تحتاجها واطّلع على السعر التقديري. أرسل طلبك إلى استوديو WRP في دبي عبر النموذج أو واتساب.")}
>
  <main id="main" class="qo" tabindex="-1" data-qo>
    <form id="qo-form" class="qo-form" method="post" novalidate aria-label={t("Quote request", "طلب عرض سعر")}>
      <div class="st-wrap qo-head">
        <p class="qo-eyebrow">{t("Get a quote", "طلب عرض سعر")}</p>
        <h1 class="qo-h1">{t("Build your quote", "احصل على عرض سعر لسيارتك")}</h1>
        <p class="qo-lede">
          {t("Pick your car and what it needs; the price builds up as you go. Takes about two minutes.", "اختر نوع سيارتك والخدمات التي تحتاجها ليظهر لك السعر التقديري. يستغرق الطلب نحو دقيقتين.")}
        </p>
      </div>

      <!-- Configure: the car stays in view (sticky) for these sections. -->
      <div class="st-wrap qo-config">
        <div class="qo-stagecol">
          <div class="qo-stage">
            <div class="qo-viewer" data-qo-viewer></div>
            <div class="qo-views" role="group" aria-label={t("What the car shows", "خيارات معاينة السيارة")} data-qo-views>
              <button type="button" class="qo-view" data-qo-view="look" aria-pressed="true">{t("Colour", "اللون")}</button>
              <button type="button" class="qo-view" data-qo-view="ppf" aria-pressed="false" hidden>{t("PPF", "فيلم الحماية")}</button>
              <button type="button" class="qo-view" data-qo-view="wrap" aria-pressed="false" hidden>{t("Wrap", "التغليف")}</button>
              <button type="button" class="qo-view" data-qo-view="tint" aria-pressed="false" hidden>{t("Tint", "التظليل")}</button>
            </div>
            <p class="qo-stage__hint" data-qo-hint>{t("Drag to turn the car.", "اسحب لتدوير السيارة.")}</p>
          </div>
          <p class="qo-credit" data-qo-credit hidden>
            {t("3D car:", "مجسّم السيارة من تصميم")} <a href="https://skfb.ly/6sUFy" target="_blank" rel="noopener">Comrade1280</a>,
            <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>, {t("modified by WRP.", "بتعديل من WRP.")}
          </p>
          <div class="qo-mini" aria-live="polite">
            <span class="qo-mini__count" data-qo-count>{t("Nothing chosen yet", "لم تحدد أي خيارات بعد")}</span>
            <span class="qo-mini__total" data-qo-total>{t("Start with your car", "ابدأ باختيار سيارتك")}</span>
          </div>
        </div>

        <div class="qo-panel">
          <!-- 1. Car -->
          <section class="qo-sec" id="qo-car" aria-labelledby="qo-car-h" data-qo-mode="look">
            <h2 class="qo-h2" id="qo-car-h"><span class="qo-n">{quoteNumber(1, locale)}</span>{t("Your car", "سيارتك")}</h2>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Shape", "نوع الهيكل")}</legend>
              <div class="qo-bodies">
                {
                  bodyTypes.map((b) => (
                    <label class="qo-body">
                      <input class="visually-hidden" type="radio" name="body" value={b.id} />
                      <img src={`/models/cars/thumbs/${b.id}.webp`} alt="" width="960" height="420" decoding="async" />
                      <span class="qo-body__name">{label(b.label)}</span>
                      <span class="qo-body__hint">{label(b.hint)}</span>
                    </label>
                  ))
                }
              </div>
              <p class="qo-help">{t("SUVs and large cars take longer, so a few prices differ by size.", "تحتاج السيارات الكبيرة وسيارات الدفع الرباعي إلى وقت أطول، لذلك تختلف بعض الأسعار بحسب الحجم.")}</p>
            </fieldset>
            <div class="qo-row">
              <div class="qo-input qo-input--grow">
                <label for="qo-make">{t("Make & model", "الشركة والطراز")} <span class="qo-optional">{t("optional", "اختياري")}</span></label>
                <input id="qo-make" name="make" type="text" list="qo-models" autocomplete="off" autocapitalize="words" placeholder={t("e.g. Toyota Land Cruiser", "مثلاً تويوتا لاند كروزر")} />
                <datalist id="qo-models">{carModels.map((m) => <option value={m.name} />)}</datalist>
              </div>
              <div class="qo-input qo-input--year">
                <label for="qo-year">{t("Year", "سنة الصنع")} <span class="qo-optional">{t("optional", "اختياري")}</span></label>
                <select id="qo-year" name="year">
                  <option value="">{t("Year", "سنة الصنع")}</option>
                  {years.map((y) => <option value={y}>{quoteNumber(Number(y), locale, false)}</option>)}
                  <option value="older">{t("Older", "أقدم من ذلك")}</option>
                </select>
              </div>
            </div>
            <p class="qo-help" data-qo-model-hint aria-live="polite" hidden></p>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Colour", "اللون")} <span class="qo-optional">{t("optional", "اختياري")}</span></legend>
              <div class="qo-chips">
                {
                  paintChips.map((c) => (
                    <label class="qo-chip">
                      <input class="visually-hidden" type="radio" name="paint" value={c.id} />
                      <span>
                        <i class="qo-dot" style={`--c:${c.hex}`} data-other={c.id === 'other' ? '' : undefined} />
                        {label(c.label)}
                      </span>
                    </label>
                  ))
                }
              </div>
              <div class="qo-input" data-qo-paint-other hidden>
                <label for="qo-paint-other">{t("Which colour?", "ما لون السيارة؟")}</label>
                <input id="qo-paint-other" name="paintOther" type="text" maxlength="40" placeholder={t("e.g. Nardo grey", "مثلاً رمادي ناردو")} />
              </div>
            </fieldset>
          </section>

          <!-- 2. Services -->
          <section class="qo-sec" id="qo-services" aria-labelledby="qo-services-h" data-qo-mode="look">
            <h2 class="qo-h2" id="qo-services-h"><span class="qo-n">{quoteNumber(2, locale)}</span>{t("What it needs", "الخدمات المطلوبة")}</h2>
            <p class="qo-help qo-help--top">{t("Choose one or more.", "يمكنك اختيار أكثر من خدمة.")}</p>
            <div class="qo-opts qo-opts--2">
              {
                catalog.services.map((s) => (
                  <label class="qo-opt">
                    <input class="visually-hidden" type="checkbox" name="services" value={s.id} />
                    <span class="qo-opt__top">
                      <span class="qo-opt__name">{s.name}</span>
                      <span class="qo-opt__tick" aria-hidden="true"><QIcon name="check" size={14} /></span>
                    </span>
                    <span class="qo-opt__meta">{s.from ? `${t("From", "ابتداءً من")} ${aed(s.from)}` : t('Priced after inspection', 'يُحدَّد السعر بعد المعاينة')} · {s.time}</span>
                  </label>
                ))
              }
            </div>
          </section>

          <!-- 3. Details per service (shown for chosen services) -->
          <section class="qo-sec" id="qo-ppf" aria-labelledby="qo-ppf-h" data-qo-service="ppf" data-qo-mode="ppf" hidden>
            <h2 class="qo-h2" id="qo-ppf-h"><span class="qo-n">·</span>{svc('ppf').name}</h2>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Coverage", "مساحة التغطية")}</legend>
              <div class="qo-opts">
                {
                  catalog.ppf.presets.map((p) => (
                    <label class="qo-opt">
                      <input class="visually-hidden" type="radio" name="ppfPreset" value={p.id} />
                      <span class="qo-opt__top">
                        <span class="qo-opt__name">{p.name}</span>
                        <span class="qo-opt__tick" aria-hidden="true"><QIcon name="check" size={14} /></span>
                      </span>
                      <span class="qo-opt__meta">{p.note}</span>
                    </label>
                  ))
                }
              </div>
              <details class="qo-more" data-qo-panels>
                <summary>{t("Choose panels one by one", "اختر أجزاء الهيكل بشكل منفصل")} <span class="qo-count" data-qo-panel-count></span></summary>
                <p class="qo-help">{t("Or tap panels on the car.", "يمكنك أيضاً الضغط على الأجزاء في مجسّم السيارة.")}</p>
                <div class="qo-panels">
                  {
                    panelGroups.map((g) => (
                      <div class="qo-panels__group" role="group" aria-label={label(g.label)}>
                        <p class="qo-panels__label" aria-hidden="true">{label(g.label)}</p>
                        {panels
                          .filter((p) => p.group === g.id)
                          .map((p) => (
                            <label class="qo-check" data-qo-panel={p.id}>
                              <input type="checkbox" name="ppfPanel" value={p.id} />
                              {label(p.label)}
                            </label>
                          ))}
                      </div>
                    ))
                  }
                </div>
              </details>
            </fieldset>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Finish", "نوع اللمسة النهائية")}</legend>
              <div class="qo-chips">
                <label class="qo-chip"><input class="visually-hidden" type="radio" name="ppfFinish" value="gloss" /><span>{t("Gloss", "لامع")}</span></label>
                <label class="qo-chip"><input class="visually-hidden" type="radio" name="ppfFinish" value="matte" /><span>{t("Matte (satin)", "مطفي (ساتان)")}</span></label>
              </div>
            </fieldset>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Film", "نوع الفيلم")}</legend>
              <div class="qo-chips">
                <label class="qo-chip"><input class="visually-hidden" type="radio" name="ppfFilm" value="recommend" /><span>{t("Recommend for me", "أرغب في توصيتكم")}</span></label>
                {catalog.ppf.films.map((f, i) => (
                  <label class="qo-chip"><input class="visually-hidden" type="radio" name="ppfFilm" value={i === 0 ? 'avery' : 'stek'} /><span>{f.name}</span></label>
                ))}
              </div>
              <p class="qo-help">{catalog.ppf.films.map((f) => `${f.name}: ${f.lines.join(', ')}.`).join(' ')}</p>
            </fieldset>
            <label class="qo-toggle">
              <input type="checkbox" name="ppfCeramic" />
              <span>{t("Add ceramic coating on top of the film", "إضافة طلاء سيراميك فوق الفيلم")} <span class="qo-optional">{t("priced after inspection", "يُحدَّد السعر بعد المعاينة")}</span></span>
            </label>
          </section>

          <section class="qo-sec" id="qo-ceramic" aria-labelledby="qo-ceramic-h" data-qo-service="ceramic" data-qo-mode="look" hidden>
            <h2 class="qo-h2" id="qo-ceramic-h"><span class="qo-n">·</span>{svc('ceramic').name}</h2>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Package", "الباقة")}</legend>
              <div class="qo-opts">
                <label class="qo-opt">
                  <input class="visually-hidden" type="radio" name="ceramicPkg" value="recommend" />
                  <span class="qo-opt__top"><span class="qo-opt__name">{t("Recommend for me", "أرغب في توصيتكم")}</span><span class="qo-opt__tick" aria-hidden="true"><QIcon name="check" size={14} /></span></span>
                  <span class="qo-opt__meta">{t("We look at the paint and suggest one.", "نفحص الطلاء ونقترح الباقة المناسبة.")}</span>
                </label>
                {
                  catalog.ceramic.packages.map((p) => (
                    <label class="qo-opt">
                      <input class="visually-hidden" type="radio" name="ceramicPkg" value={p.id} />
                      <span class="qo-opt__top">
                        <span class="qo-opt__name">{p.name}</span>
                        <span class="qo-opt__tick" aria-hidden="true"><QIcon name="check" size={14} /></span>
                      </span>
                      <span class="qo-opt__meta">{p.features.slice(0, 2).join(' · ')}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <label class="qo-toggle"><input type="checkbox" name="ceramicWheels" /><span>{t("Wheels and glass too", "إضافة الجنوط والزجاج")}</span></label>
          </section>

          <section class="qo-sec" id="qo-polish" aria-labelledby="qo-polish-h" data-qo-service="polish" data-qo-mode="look" hidden>
            <h2 class="qo-h2" id="qo-polish-h"><span class="qo-n">·</span>{svc('polish').name}</h2>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("How does the paint look?", "ما حالة طلاء سيارتك؟")}</legend>
              <div class="qo-opts qo-opts--2">
                {
                  polishConditions.map((c) => (
                    <label class="qo-opt">
                      <input class="visually-hidden" type="radio" name="polish" value={c.id} />
                      <span class="qo-opt__top">
                        <span class="qo-opt__name">{label(c.label)}</span>
                        <span class="qo-opt__tick" aria-hidden="true"><QIcon name="check" size={14} /></span>
                      </span>
                      <span class="qo-opt__meta">{label(c.hint)}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </section>

          <section class="qo-sec" id="qo-wash" aria-labelledby="qo-wash-h" data-qo-service="wash" data-qo-mode="look" hidden>
            <h2 class="qo-h2" id="qo-wash-h"><span class="qo-n">·</span>{svc('wash').name}</h2>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Level", "مستوى العناية")}</legend>
              <div class="qo-opts">
                {
                  catalog.wash.levels.map((l) => (
                    <label class="qo-opt">
                      <input class="visually-hidden" type="radio" name="washLevel" value={String(l.level)} />
                      <span class="qo-opt__top">
                        <span class="qo-opt__name">{l.name}</span>
                        <span class="qo-opt__price" data-qo-wash-price={l.level} data-sedan={l.sedan} data-suv={l.suv}>
                          {aed(l.sedan)}
                        </span>
                      </span>
                      <span class="qo-opt__meta">{l.tagline}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </section>

          <section class="qo-sec" id="qo-tint" aria-labelledby="qo-tint-h" data-qo-service="tint" data-qo-mode="tint" hidden>
            <h2 class="qo-h2" id="qo-tint-h"><span class="qo-n">·</span>{svc('tint').name}</h2>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Film", "نوع الفيلم")}</legend>
              <div class="qo-opts">
                {
                  catalog.tint.options.map((o) => (
                    <label class="qo-opt">
                      <input class="visually-hidden" type="radio" name="tint" value={o.id} />
                      <span class="qo-opt__top">
                        <span class="qo-opt__name">{o.name}</span>
                        <span class="qo-opt__price">{ar ? `نفاذ الضوء ${quoteNumber(o.vlt, locale)}٪` : `${o.vlt}% VLT`}</span>
                      </span>
                      <span class="qo-opt__meta">{o.heat}. {o.note}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </section>

          <section class="qo-sec" id="qo-interior" aria-labelledby="qo-interior-h" data-qo-service="interior" data-qo-mode="look" hidden>
            <h2 class="qo-h2" id="qo-interior-h"><span class="qo-n">·</span>{svc('interior').name}</h2>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("What would you like done?", "ما الأعمال المطلوبة؟")}</legend>
              <div class="qo-opts qo-opts--2">
                {
                  interiorItems.map((i) => (
                    <label class="qo-opt">
                      <input class="visually-hidden" type="checkbox" name="interiorItem" value={i.id} />
                      <span class="qo-opt__top">
                        <span class="qo-opt__name">{label(i.label)}</span>
                        <span class="qo-opt__tick" aria-hidden="true"><QIcon name="check" size={14} /></span>
                      </span>
                      <span class="qo-opt__meta">{label(i.note)}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Material", "الخامة")} <span class="qo-optional">{t("optional", "اختياري")}</span></legend>
              <div class="qo-chips">
                {interiorMaterials.map((m) => (
                  <label class="qo-chip"><input class="visually-hidden" type="radio" name="interiorMaterial" value={m.id} /><span>{label(m.label)}</span></label>
                ))}
              </div>
            </fieldset>
          </section>

          <section class="qo-sec" id="qo-wrap" aria-labelledby="qo-wrap-h" data-qo-service="wrap" data-qo-mode="wrap" hidden>
            <h2 class="qo-h2" id="qo-wrap-h"><span class="qo-n">·</span>{svc('wrap').name}</h2>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Parts to wrap", "الأجزاء المراد تغليفها")} <span class="qo-optional">{t("or tap them on the car", "أو اضغط عليها في مجسّم السيارة")}</span></legend>
              <div class="qo-chips">
                {panels
                  .filter((p) => wrapParts.includes(p.id))
                  .map((p) => (
                    <label class="qo-chip" data-qo-panel={p.id}>
                      <input class="visually-hidden" type="checkbox" name="wrapPart" value={p.id} />
                      <span>{label(p.label)}</span>
                    </label>
                  ))}
              </div>
            </fieldset>
            <fieldset class="qo-field">
              <legend class="qo-legend">{t("Finish", "نوع اللمسة النهائية")}</legend>
              <div class="qo-chips">
                {wrapFinishes.map((f) => (
                  <label class="qo-chip">
                    <input class="visually-hidden" type="radio" name="wrapFinish" value={f.id} />
                    <span><i class="qo-dot" style={`--c:${f.hex}`} />{label(f.label)}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <label class="qo-toggle"><input type="checkbox" name="chromeDelete" /><span>{t("Chrome delete (window trims, badges, grille)", "تغطية الكروم (إطارات النوافذ والشعارات والشبك الأمامي)")}</span></label>
          </section>
        </div>
      </div>

      <!-- When, you, send: full width, the car no longer follows. -->
      <div class="st-wrap qo-finish">
        <section class="qo-sec" id="qo-when" aria-labelledby="qo-when-h">
          <h2 class="qo-h2" id="qo-when-h"><span class="qo-n">{quoteNumber(3, locale)}</span>{t("When suits you", "الموعد المناسب لك")}</h2>
          <fieldset class="qo-field">
            <legend class="qo-legend">{t("Day", "اليوم")}</legend>
            <div class="qo-days" data-qo-days role="radiogroup" aria-label={t("Day", "اليوم")}></div>
          </fieldset>
          <fieldset class="qo-field">
            <legend class="qo-legend">{t("Time", "الوقت")}</legend>
            <div class="qo-chips">
              {slots.map((s) => (
                <label class="qo-chip"><input class="visually-hidden" type="radio" name="slot" value={s.id} /><span>{label(s.label)} <small>{label(s.range)}</small></span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="qo-field">
            <legend class="qo-legend">{t("Handover", "تسليم السيارة")}</legend>
            <div class="qo-chips">
              <label class="qo-chip"><input class="visually-hidden" type="radio" name="handover" value="drop" /><span>{t("I’ll drop it off", "سأوصلها إلى الاستوديو")}</span></label>
              <label class="qo-chip"><input class="visually-hidden" type="radio" name="handover" value="collect" /><span>{t("Please collect it", "أرغب في استلامها من موقعي")}</span></label>
            </div>
            <div class="qo-input" data-qo-area hidden>
              <label for="qo-area">{t("Where from?", "من أين نستلم السيارة؟")} <span class="qo-optional">{t("area", "المنطقة")}</span></label>
              <input id="qo-area" name="area" type="text" maxlength="80" autocomplete="address-level2" placeholder={t("e.g. Dubai Marina", "مثلاً دبي مارينا")} />
              <p class="qo-help">{t("Collection is on request; we confirm it with you.", "تتوفر خدمة استلام السيارة عند الطلب، وسنتواصل معك لتأكيدها.")}</p>
            </div>
          </fieldset>
          <p class="qo-help">{catalog.contact.hours}.</p>
        </section>

        <section class="qo-sec" id="qo-you" aria-labelledby="qo-you-h">
          <h2 class="qo-h2" id="qo-you-h"><span class="qo-n">{quoteNumber(4, locale)}</span>{t("Your details", "بيانات التواصل")}</h2>
          <div class="qo-input">
            <label for="qo-name">{t("Name", "الاسم")}</label>
            <input id="qo-name" name="name" type="text" autocomplete="name" autocapitalize="words" maxlength="100" required aria-describedby="qo-name-err" />
            <p class="qo-err" id="qo-name-err">{t("Please tell us your name.", "يرجى إدخال اسمك.")}</p>
          </div>
          <div class="qo-input">
            <label for="qo-phone">{t("Mobile", "رقم الجوال")}</label>
            <input id="qo-phone" name="phone" type="tel" dir="ltr" autocomplete="tel" inputmode="tel" maxlength="20" placeholder="050 123 4567" required aria-describedby="qo-phone-err" />
            <p class="qo-err" id="qo-phone-err">{t("Please enter a mobile number we can reach, e.g. 050 123 4567.", "أدخل رقم جوال يمكننا التواصل معك عليه، مثل 050 123 4567.")}</p>
          </div>
          <div class="qo-input">
            <label for="qo-email">{t("Email", "البريد الإلكتروني")} <span class="qo-optional">{t("optional", "اختياري")}</span></label>
            <input id="qo-email" name="email" type="email" dir="ltr" autocomplete="email" inputmode="email" maxlength="120" aria-describedby="qo-email-err" />
            <p class="qo-err" id="qo-email-err">{t("That email doesn’t look complete, e.g. name@example.com.", "تحقّق من عنوان البريد الإلكتروني، مثل name@example.com.")}</p>
          </div>
          <fieldset class="qo-field">
            <legend class="qo-legend">{t("Best way to reach you", "كيف تفضّل أن نتواصل معك؟")}</legend>
            <div class="qo-chips">
              <label class="qo-chip"><input class="visually-hidden" type="radio" name="contactPref" value="whatsapp" /><span>{t("WhatsApp", "واتساب")}</span></label>
              <label class="qo-chip"><input class="visually-hidden" type="radio" name="contactPref" value="call" /><span>{t("Phone call", "مكالمة هاتفية")}</span></label>
            </div>
          </fieldset>
          <div class="qo-input">
            <label for="qo-notes">{t("Anything else?", "هل تود إضافة أي تفاصيل؟")} <span class="qo-optional">{t("optional", "اختياري")}</span></label>
            <textarea id="qo-notes" name="notes" rows="3" maxlength="1000" placeholder={t("Existing marks, dents, a deadline, a question…", "خدوش أو انبعاجات، موعد تحتاج السيارة قبله، أو سؤال تود طرحه…")}></textarea>
          </div>
          <label class="qo-toggle qo-consent">
            <input type="checkbox" name="consent" required aria-describedby="qo-consent-err" />
            <span>{t("WRP may contact me about this quote by WhatsApp, phone or email.", "أوافق على أن يتواصل معي فريق WRP بخصوص عرض السعر عبر واتساب أو الهاتف أو البريد الإلكتروني.")} <a href={ar ? "/ar/privacy/" : "/privacy/"} target="_blank" rel="noopener">{t("Privacy policy", "سياسة الخصوصية")}</a></span>
          </label>
          <p class="qo-err" id="qo-consent-err">{t("Please tick this so we can reply to you.", "ضع علامة في المربع حتى نتمكّن من الرد عليك.")}</p>
          <div class="qo-honeypot" aria-hidden="true">
            <label for="qo-form-check">{t("Leave this field empty", "اترك هذا الحقل فارغاً")}</label>
            <input id="qo-form-check" name="form_check" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </section>

        <section class="qo-sec qo-send" id="qo-send" aria-labelledby="qo-send-h">
          <h2 class="qo-h2" id="qo-send-h"><span class="qo-n">{quoteNumber(5, locale)}</span>{t("Your quote", "عرض السعر")}</h2>
          <div class="qo-summary" data-qo-summary></div>
          <div class="qo-problems" data-qo-problems role="alert" hidden></div>
          <div class="qo-actions" data-qo-actions>
            <a class="st-btn st-btn--primary" data-qo-wa href={catalog.contact.whatsapp} target="_blank" rel="noopener"><QIcon name="whatsapp" size={20} />{t("Send on WhatsApp", "إرسال عبر واتساب")}</a>
            <button type="submit" class="st-btn st-btn--light" disabled>{t("Send request", "إرسال الطلب")}</button>
          </div>
          <p class="qo-help">{t("This is a request, not a booking: nothing is charged. We reply with a price for your car and confirm the time.", "طلب عرض السعر مجاني ولا يؤكّد الحجز. سنردّ عليك بسعر الخدمة لسيارتك ونؤكّد الموعد معك.")}</p>
          <p class="qo-status" data-qo-status role="status" hidden></p>
          <div class="qo-done" data-qo-done hidden>
            <p class="qo-done__title" data-qo-done-title>{t("Request sent", "تم إرسال الطلب")}</p>
            <p data-qo-done-text></p>
            <button type="button" class="qo-textbtn" data-qo-restart>{t("Start a new quote", "ابدأ طلباً جديداً")}</button>
          </div>
        </section>
      </div>
    </form>

    <div class="qo-bar" data-qo-bar>
      <div class="qo-bar__sum">
        <span class="qo-bar__count" data-qo-count>{t("Nothing chosen yet", "لم تحدد أي خيارات بعد")}</span>
        <span class="qo-bar__total" data-qo-total>{t("Start with your car", "ابدأ باختيار سيارتك")}</span>
      </div>
      <a class="st-btn st-btn--primary qo-bar__go" href="#qo-send" data-qo-bar-go>{t("Review & send", "مراجعة الطلب وإرساله")}</a>
    </div>
  </main>

  <p class="visually-hidden" aria-live="polite" data-qo-live></p>

  <script type="application/json" id="qo-catalog" set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
  <script>
    import { start } from './one';
    start();
  </script>
</StudioPage>
