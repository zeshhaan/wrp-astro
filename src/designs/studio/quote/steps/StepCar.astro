---
import Screen from './Screen.astro';
import QIcon from './QIcon.astro';
import { bodyTypes } from '../panels';
import { carSilhouette } from '../viewer/CarViewer2D';
import { carModels } from '../models';
import { paintChips } from '../state';

const thisYear = 2026;
const years = Array.from({ length: thisYear + 1 - 1995 }, (_, i) => String(thisYear + 1 - i));
---

<Screen id="car" title="Your car" eyebrow="Step 1 of 6" lede="Tell us roughly what you drive. Two taps is enough; the rest is optional.">
  <div class="q-resume" data-q-resume hidden>
    <p><strong>Welcome back.</strong> Continue your quote? <span class="q-resume__sum" data-q-resume-sum></span></p>
    <div class="q-resume__actions">
      <button type="button" class="st-btn st-btn--gold" data-q-resume-yes>Continue</button>
      <button type="button" class="q-textbtn" data-q-resume-no>Start over</button>
    </div>
  </div>

  <fieldset class="q-field q-bodies">
    <legend class="q-legend">What shape is it?</legend>
    <div class="q-grid q-grid--2">
      {
        bodyTypes.map((b) => (
          <label class="q-card q-body">
            <input class="visually-hidden" type="radio" name="body" value={b.id} required />
            <span class="q-body__sil" set:html={carSilhouette(b.id)} />
            <span class="q-card__title">{b.label}</span>
            <span class="q-card__hint">{b.hint}</span>
            <span class="q-card__tick" aria-hidden="true"><QIcon name="check" size={16} /></span>
          </label>
        ))
      }
    </div>
    <p class="q-help">Not sure? Pick the closest. SUVs and large cars take longer, so a few prices differ by size.</p>
  </fieldset>

  <div class="q-row q-row--model">
    <div class="q-input">
      <label for="q-make">Make & model <span class="q-opt">optional</span></label>
      <input id="q-make" name="make" type="text" list="q-models" autocomplete="off" autocapitalize="words" enterkeyhint="next" placeholder="e.g. Toyota Land Cruiser" />
      <datalist id="q-models">
        {carModels.map((m) => <option value={m.name} />)}
      </datalist>
      <p class="q-hint" data-q-model-hint aria-live="polite"></p>
    </div>
    <div class="q-input q-input--year">
      <label for="q-year">Year <span class="q-opt">optional</span></label>
      <select id="q-year" name="year" class="q-select">
        <option value="">Year</option>
        {years.map((y) => <option value={y}>{y}</option>)}
        <option value="older">Older</option>
      </select>
    </div>
  </div>

  <fieldset class="q-field">
    <legend class="q-legend">Colour <span class="q-opt">optional</span></legend>
    <div class="q-look" data-q-viewer="look" aria-hidden="true"></div>
    <div class="q-chips q-chips--paint">
      {
        paintChips.map((c) => (
          <label class="q-chip q-paint">
            <input class="visually-hidden" type="radio" name="paint" value={c.id} />
            <span class:list={['q-paint__dot', c.id === 'other' && 'q-paint__dot--other']} style={`--dot:${c.hex}`} aria-hidden="true" />
            {c.label}
          </label>
        ))
      }
    </div>
    <div class="q-input q-reveal" data-q-when="paint=other" hidden>
      <label for="q-paint-other">Which colour?</label>
      <input id="q-paint-other" name="paintOther" type="text" autocomplete="off" enterkeyhint="next" placeholder="e.g. Nardo grey, pearl white" />
    </div>
  </fieldset>

  <p class="q-aside-note">
    <QIcon name="help" size={18} />
    <span>Prefer Arabic? <a href="/ar/contact-us/" lang="ar" hreflang="ar">العربية</a></span>
  </p>
</Screen>
