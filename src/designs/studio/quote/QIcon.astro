---
/** Line icons for the quote flow (24px grid, decorative). */
interface Props {
  name:
    | 'ppf' | 'ceramic' | 'polish' | 'wash' | 'tint' | 'interior' | 'wrap' | 'help'
    | 'check' | 'back' | 'close' | 'whatsapp' | 'phone' | 'camera' | 'clock' | 'edit' | 'car' | 'sofa' | 'key' | 'pin' | 'tag';
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'ppf' && <><path d="M12 3 5 6v5.5c0 4.4 3 7.8 7 9.5 4-1.7 7-5.1 7-9.5V6Z" /><path d="M8.5 9.5 15.5 16M12 7.5l5 5" opacity=".7" /></>}
  {name === 'ceramic' && <><path d="M12 3.5c3 4 5.5 7 5.5 10a5.5 5.5 0 0 1-11 0c0-3 2.5-6 5.5-10Z" /><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5" /></>}
  {name === 'polish' && <><circle cx="12" cy="12" r="4" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" /></>}
  {name === 'wash' && <><path d="M4 14h16l-1.5 6h-13Z" /><circle cx="8" cy="8" r="2" /><circle cx="13.5" cy="6" r="2.5" /><circle cx="17.5" cy="10" r="1.5" /></>}
  {name === 'tint' && <><path d="M3.5 17 8 7h11l1.5 10Z" /><path d="M8 7l4 10M13 7l3 10" opacity=".6" /><circle cx="18.5" cy="4" r="1.6" /></>}
  {name === 'interior' && <><path d="M7 3.5h5l1 10H8Z" /><path d="M8 13.5 6 20.5M13 13.5l5 1.5v5.5h-9" /></>}
  {name === 'wrap' && <><rect x="3.5" y="4" width="13" height="5" rx="1" /><path d="M16.5 6.5h3v5h-7.5v3" /><rect x="10.5" y="14.5" width="3" height="6" rx="1" /></>}
  {name === 'help' && <><circle cx="12" cy="12" r="8.5" /><path d="M9.6 9.4a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1.1.9-1.1 1.6v.5" /><circle cx="12" cy="16.8" r=".6" fill="currentColor" /></>}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'back' && <path d="M15 5l-7 7 7 7" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'whatsapp' && <><path d="M12 3.2a8.6 8.6 0 0 0-7.4 13l-1.2 4.4 4.5-1.2A8.6 8.6 0 1 0 12 3.2Z" /><path d="M9.1 7.9c.3 0 .5.1.6.4l.7 1.6c.1.2 0 .5-.1.7l-.5.6c.6 1.2 1.6 2.2 2.9 2.9l.6-.5c.2-.2.5-.2.7-.1l1.6.7c.3.1.4.4.4.7-.1 1.1-1 1.9-2.1 1.8-3.3-.4-5.9-3-6.3-6.3-.1-1.1.7-2 1.9-2.1Z" fill="currentColor" stroke="none" /></>}
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4-2.1 1.3a11 11 0 0 0 7.5 7.5l1.3-2.1 4 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />}
  {name === 'camera' && <><path d="M4 8h3l1.6-2.5h6.8L17 8h3v11H4Z" /><circle cx="12" cy="13" r="3.4" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'edit' && <path d="M4 20h4L19 9l-4-4L4 16Zm9-13 4 4" />}
  {name === 'car' && <><path d="M3.5 15.5v-3l2-4.5h13l2 4.5v3Z" /><circle cx="7.5" cy="16" r="1.8" /><circle cx="16.5" cy="16" r="1.8" /></>}
  {name === 'sofa' && <><path d="M4 11V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3" /><path d="M3 12a1.5 1.5 0 0 1 3 0v2h12v-2a1.5 1.5 0 0 1 3 0v5H3Z" /><path d="M5 17v2M19 17v2" /></>}
  {name === 'key' && <><circle cx="8" cy="15" r="3.5" /><path d="m10.5 12.5 8-8M16 7l2 2M14 9l1.5 1.5" /></>}
  {name === 'tag' && <><path d="M3.5 12.3V4.5a1 1 0 0 1 1-1h7.8l8.2 8.2a1 1 0 0 1 0 1.4l-7.4 7.4a1 1 0 0 1-1.4 0Z" /><circle cx="8" cy="8" r="1.4" /></>}
  {name === 'pin' && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
</svg>
