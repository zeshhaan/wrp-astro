---
import Icon from './Icon.astro';
import { proof, reviews } from './content';
import { rating, reviewCount, reviewsAr } from './contentAr';
import type { Locale } from '@/i18n/translations';

interface Props {
  locale?: Locale;
  /** Overrides the in-site links, e.g. to the Arabic Studio pages. */
  link?: (href: string) => string;
}
const { locale = 'en', link = (href: string) => href } = Astro.props;
const ar = locale === 'ar';
const w = ar
  ? {
      eyebrow: 'ماذا يقول عملاؤنا',
      title: 'آراء عملائنا',
      intro: `<strong>${rating}</strong> على Google من ${reviewCount} تقييم. هذه كلماتهم كما كتبوها بالإنجليزية، من دون تعديل.`,
      prev: 'المراجعات السابقة',
      next: 'المراجعات التالية',
      region: 'مراجعات العملاء، مرّر جانبياً لرؤية المزيد',
      stars: 'تقييم ٥ من ٥ نجوم',
      reviews: reviewsAr,
      more: 'اقرأ المزيد من المراجعات',
    }
  : {
      eyebrow: 'What our customers say',
      title: 'Client testimonials',
      intro: `<strong>${proof.rating}</strong> on Google from ${proof.reviewCountDisplay} reviews. These are their words, unedited.`,
      prev: 'Previous reviews',
      next: 'Next reviews',
      region: 'Customer reviews, scroll sideways for more',
      stars: '5 out of 5 stars',
      reviews,
      more: 'Read more reviews',
    };
---

<section class="reviews st-section st-white" id="reviews" aria-labelledby="reviews-title">
  <div class="st-wrap">
    <div class="reviews__head">
      <header class="st-head">
        <p class="st-eyebrow st-eyebrow--dark">{w.eyebrow}</p>
        <h2 id="reviews-title" class="st-h2">{w.title}</h2>
        <p class="st-intro" set:html={w.intro} />
      </header>
      <div class="reviews__nav">
        <button class="navbtn" type="button" data-prev aria-controls="review-track">
          <Icon name="arrow-left" size={22} class="flip" />
          <span class="visually-hidden">{w.prev}</span>
        </button>
        <button class="navbtn" type="button" data-next aria-controls="review-track">
          <Icon name="arrow-right" size={22} class="flip" />
          <span class="visually-hidden">{w.next}</span>
        </button>
      </div>
    </div>
  </div>

  <div class="track" id="review-track" tabindex="0" role="region" aria-label={w.region} data-track>
    <ul class="track__list" role="list">
      {
        w.reviews.map((r) => (
          <li class="review">
            <figure>
              <span class="review__stars" role="img" aria-label={w.stars}>
                {Array.from({ length: 5 }, () => <Icon name="star" size={16} />)}
              </span>
              <blockquote lang="en" dir="ltr">
                <p>{r.text}</p>
              </blockquote>
              <figcaption>
                <span class="review__name" dir="auto">{r.author}</span>
                <span class="review__service">{r.service}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="st-wrap reviews__foot">
    <a class="st-btn st-btn--dark" href={link(proof.reviewsUrl)}>{w.more}</a>
  </div>
</section>

<script>
  // Scroll-snap carousel with prev/next buttons. Native swipe and keyboard
  // scrolling do the real work; buttons page by one card and disable at the ends.
  for (const track of document.querySelectorAll<HTMLElement>('[data-track]')) {
    const section = track.closest('section');
    const prev = section?.querySelector<HTMLButtonElement>('[data-prev]');
    const next = section?.querySelector<HTMLButtonElement>('[data-next]');
    if (!prev || !next) continue;
    const step = () => {
      const card = track.querySelector<HTMLElement>('.review');
      const gap = parseFloat(getComputedStyle(track.querySelector('ul')!).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth * 0.8;
    };
    // Right to left, scrollLeft runs from 0 down to negative values and "next" is leftwards.
    const sign = getComputedStyle(track).direction === 'rtl' ? -1 : 1;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      const at = Math.abs(track.scrollLeft);
      prev.disabled = at <= 2;
      next.disabled = at >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -sign * step(), behavior: 'auto' }));
    next.addEventListener('click', () => track.scrollBy({ left: sign * step(), behavior: 'auto' }));
    if ('onscrollend' in window) track.addEventListener('scrollend', update);
    else {
      let t = 0;
      track.addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(update, 100); }, { passive: true });
    }
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<style>
  .reviews__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 2rem;
  }
  .reviews__head .st-head {
    margin-block-end: 0;
  }
  .reviews__nav {
    display: flex;
    gap: 0.5rem;
  }
  .navbtn {
    --st-accent: var(--st-white); /* dark surface */
    --st-on-accent: var(--st-black);
    display: inline-grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    background: var(--st-black);
    color: var(--st-white);
    border: 0;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .navbtn:hover:not(:disabled) {
    background: var(--st-ink-2);
  }
  .navbtn:disabled {
    background: var(--st-line-light);
    color: var(--st-ink-2);
    cursor: default;
  }
  .track {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--st-gutter-x);
    scrollbar-width: thin;
    scrollbar-color: var(--st-accent-deep) transparent;
    padding-block-end: 1rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      scroll-behavior: smooth;
    }
  }
  .track:focus-visible {
    outline: 3px solid var(--st-accent-deep);
    outline-offset: -3px;
  }
  .track__list {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0.25rem var(--st-gutter-x);
    list-style: none;
    inline-size: max-content;
  }
  .review {
    flex: none;
    inline-size: min(22rem, calc(100vw - 2 * var(--st-gutter-x) - 1.5rem));
    scroll-snap-align: start;
    display: flex;
  }
  .review figure {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    inline-size: 100%;
    padding: 1.5rem 1.5rem 1.25rem;
    background: var(--st-paper);
    border-block-end: 3px solid var(--st-accent);
  }
  .review__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--st-accent-deep);
  }
  .review blockquote {
    margin: 0;
    flex: 1;
    color: var(--st-ink);
    font-size: 0.975rem;
    line-height: 1.6;
  }
  .review blockquote p::before {
    content: '“';
  }
  .review blockquote p::after {
    content: '”';
  }
  .review figcaption {
    display: grid;
    gap: 0.15rem;
  }
  .review__name {
    font-weight: 700;
  }
  .review__service {
    font-size: 0.8125rem;
    color: var(--st-ink-2);
  }
  .reviews__foot {
    display: flex;
    justify-content: center;
    margin-block-start: 1.75rem;
  }
</style>
