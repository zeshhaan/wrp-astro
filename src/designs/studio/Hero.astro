---
import Icon from './Icon.astro';
import { proof, whatsappQuote } from './content';
import { heroVideo as hv } from './heroVideo';
---

<section class="hero" aria-labelledby="hero-title">
  <!--
    Background, back to front: an inlined ~30px blurred frame (paints with the HTML, no request),
    the sharp poster (the LCP image), then the video, which only starts downloading after the
    page has loaded and fades in once it is actually playing. Phones get a 9:16 crop.
  -->
  <div class="hero__media" style={`--ph-wide:url(${hv.placeholder.wide});--ph-tall:url(${hv.placeholder.tall})`} aria-hidden="true">
    <picture>
      <source media={hv.tallMedia} type="image/avif" srcset={hv.poster.tall.avif} />
      <source media={hv.tallMedia} type="image/webp" srcset={hv.poster.tall.webp} />
      <source media={hv.tallMedia} srcset={hv.poster.tall.jpg} width="720" height="1280" />
      <source type="image/avif" srcset={hv.poster.wide.avif} />
      <source type="image/webp" srcset={hv.poster.wide.webp} />
      <img class="hero__poster" src={hv.poster.wide.jpg} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    </picture>
    <video
      class="hero__video"
      data-hero-video
      data-wide-av1={hv.video.wide.av1}
      data-wide-h264={hv.video.wide.h264}
      data-tall-av1={hv.video.tall.av1}
      data-tall-h264={hv.video.tall.h264}
      data-tall-media={hv.tallMedia}
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      tabindex="-1"></video>
  </div>
  <button type="button" class="hero__pause" data-hero-pause aria-pressed="false" hidden>
    <span class="visually-hidden" data-hero-pause-label>Pause background video</span>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path class="i-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /><path class="i-play" d="M8 5.5v13l10.5-6.5z" /></svg>
  </button>
  <div class="st-wrap hero__inner">
    <div class="hero__main">
      <p class="st-eyebrow">Al Qusais, Dubai</p>
      <h1 id="hero-title" class="hero__title">PPF, ceramic coating &amp; car detailing in Dubai</h1>
    </div>
    <div class="hero__side">
      <p class="hero__lede">
        Paint protection film from Avery Dennison and STEK, ceramic coating, polish and paint correction,
        window tint, upholstery and hand washes, done properly and on time at our studio in Al Qusais Industrial
        Area 1.
      </p>
      <div class="hero__actions">
        <a class="st-btn st-btn--gold" href="/design-lab/studio/quote/">Get a quick quote <Icon name="arrow-right" size={18} /></a>
        <a class="st-btn st-btn--light" href={whatsappQuote} target="_blank" rel="noopener">
          <Icon name="whatsapp" />WhatsApp us
        </a>
        <a class="st-btn st-btn--ghost" href="#services">See services &amp; prices</a>
      </div>
      <a class="hero__rating" href={proof.reviewsUrl}>
        <span class="hero__stars" aria-hidden="true">
          {Array.from({ length: 5 }, () => <Icon name="star" size={16} />)}
        </span>
        <span><strong>{proof.rating}</strong> on Google · {proof.reviewCountDisplay} reviews</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-block-size: min(46rem, calc(100svh - var(--st-head)));
    padding-block: 7rem 3.5rem;
    color: var(--st-white);
    background: var(--st-black);
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--st-black);
  }
  /* Layer 1: the inlined blurred frame, scaled a touch so blurred edges stay off-screen. */
  .hero__media::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ph-wide) center / cover no-repeat;
    filter: blur(24px);
    transform: scale(1.1) translateZ(0);
  }
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .hero__video {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .hero__video.is-playing {
    opacity: 1;
  }
  @media (max-width: 40rem) {
    .hero__media::before {
      background-image: var(--ph-tall);
    }
  }
  .hero__pause {
    position: absolute;
    /* Top corner: the bottom one belongs to the floating WhatsApp/call buttons. */
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background: rgb(12 13 15 / 0.45);
    color: var(--st-white);
    cursor: pointer;
  }
  .hero__pause[hidden] {
    display: none;
  }
  .hero__pause path {
    fill: currentColor;
  }
  .hero__pause .i-play,
  .hero__pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .hero__pause[aria-pressed='true'] .i-play {
    display: block;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(12 13 15 / 0.55) 0%, rgb(12 13 15 / 0.45) 35%, rgb(12 13 15 / 0.92) 100%),
      linear-gradient(90deg, rgb(12 13 15 / 0.7), rgb(12 13 15 / 0.1) 70%);
  }
  .hero__inner {
    display: grid;
    gap: 1.5rem 4rem;
    align-items: end;
  }
  .hero__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(2.5rem, 1.6rem + 4.2vw, 5rem);
    line-height: 1.02;
    letter-spacing: 0.005em;
    max-inline-size: 14ch;
    margin-block-start: 0.75rem;
  }
  .hero__lede {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--st-on-dark);
    max-inline-size: 36rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.5rem;
  }
  .hero__rating {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-block-start: 1.5rem;
    min-block-size: 2.75rem;
    color: var(--st-on-dark);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .hero__rating strong {
    color: var(--st-white);
  }
  .hero__rating:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hero__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--st-gold);
  }
  @media (max-width: 29.99rem) {
    .hero__actions .st-btn {
      flex: 1 1 100%;
    }
  }
  @media (min-width: 60rem) {
    .hero {
      padding-block: 9rem 5rem;
    }
    .hero__inner {
      grid-template-columns: 1.15fr 1fr;
    }
  }
</style>

<script>
  import { startHeroVideo } from './heroVideoClient';
  startHeroVideo();
</script>
