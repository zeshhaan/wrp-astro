---
import Picture from '../shared/Picture.astro';
import Icon from './Icon.astro';
import { proof, stats, whatsappQuote } from './content';
import { statsAr, whatsappQuote as whatsappQuoteAr } from './contentAr';
import type { Locale } from '@/i18n/translations';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const w =
  locale === 'ar'
    ? {
        alt: 'غرفة المواد في WRP مع علب أفلام STEK وعينات جلد المقاعد ودواسات الأرضية',
        caption: 'غرفة المواد: عينات الأفلام والجلود والدواسات تراها بنفسك قبل أن تختار.',
        eyebrow: 'الأفلام والضمانات',
        title: 'حماية تثق بها',
        text: 'نركّب أفلام حماية طلاء ذاتية الإصلاح من علامتين عالميتين، STEK وAvery Dennison، بضمان يصل إلى ١٠ سنوات. زُر استوديونا في القصيص لترى عينات الأفلام وتلمسها بنفسك قبل أن تختار.',
        films: 'علامات الأفلام',
        stats: statsAr,
        quote: 'احصل على عرض سعر سريع',
        whatsapp: 'راسلنا على واتساب',
        whatsappHref: whatsappQuoteAr,
      }
    : {
        alt: 'WRP materials room with STEK film boxes, leather seat samples and floor mat samples',
        caption: 'The materials room: film, leather and mat samples you can see before you choose.',
        eyebrow: 'Films and warranties',
        title: 'Protection you can trust',
        text: 'We fit self-healing paint protection film from two global brands, STEK and Avery Dennison, with up to a 10-year warranty. Visit our Al Qusais studio to see and feel the film samples before you choose.',
        films: 'Film brands',
        stats,
        quote: 'Get a quick quote',
        whatsapp: 'WhatsApp us',
        whatsappHref: whatsappQuote,
      };
---

<section class="proof st-section st-dark" aria-labelledby="proof-title">
  <div class="st-wrap proof__grid">
    <figure class="proof__media">
      <Picture
        base="/review-images/venkat_k_3"
        alt={w.alt}
        sizes="(min-width: 60rem) 45vw, 100vw"
      />
      <figcaption>{w.caption}</figcaption>
    </figure>
    <div class="proof__text">
      <p class="st-eyebrow">{w.eyebrow}</p>
      <h2 id="proof-title" class="st-h2">{w.title}</h2>
      <p>{w.text}</p>
      <ul class="films" role="list" aria-label={w.films}>
        {
          proof.films.map((f) => (
            <li>
              <img src={f.logo} alt={f.name} width="160" height="48" loading="lazy" decoding="async" />
            </li>
          ))
        }
      </ul>
      <dl class="stats">
        {
          w.stats.map((s) => (
            <div class="stat">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="proof__actions">
        <a class="st-btn st-btn--primary" href="/design-lab/studio/quote/">{w.quote}</a>
        <a class="st-btn st-btn--light" href={w.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" />{w.whatsapp}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .proof__grid {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: center;
  }
  .proof__media :global(img) {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .proof__media figcaption {
    margin-block-start: 0.6rem;
    font-size: 0.8125rem;
    color: var(--st-mute);
  }
  .proof__text {
    display: grid;
    gap: 1.1rem;
  }
  .proof__text > p:not(.st-eyebrow) {
    color: var(--st-on-dark);
    max-inline-size: 36rem;
  }
  .films {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .films li {
    display: grid;
    place-items: center;
    padding: 0.75rem 1.1rem;
    background: var(--st-white);
    min-inline-size: 9rem;
  }
  .films img {
    block-size: 2rem;
    inline-size: auto;
    max-inline-size: 9rem;
    object-fit: contain;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 0.5rem 0 0;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--st-accent);
  }
  .stat dd {
    margin: 0;
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--st-white);
  }
  .stat dd:lang(ar) {
    font-size: 1.75rem;
    white-space: nowrap;
  }
  .stat dt {
    font-family: var(--st-head-font);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--st-mute);
  }
  .proof__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 60rem) {
    .proof__grid {
      grid-template-columns: 1fr 1.1fr;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 80rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
