---
/**
 * Studio: a deliberately conventional detailing-studio homepage.
 * The familiar Dubai-studio structure (contact bar, dark photo hero, about
 * split, services grid, CTA banner, why-us, reviews carousel, gallery, blog,
 * quote form, four-column footer, floating WhatsApp/call) in WRP's own black,
 * white and brass, with WRP's real photos, prices and Google reviews.
 */
import DesignShell from '../shared/DesignShell.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Services from './Services.astro';
import CtaBanner from './CtaBanner.astro';
import WhyUs from './WhyUs.astro';
import Proof from './Proof.astro';
import Testimonials from './Testimonials.astro';
import Projects from './Projects.astro';
import Lounge from './Lounge.astro';
import Social from './Social.astro';
import Blog from './Blog.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import FloatingContact from './FloatingContact.astro';
import { heroVideo } from './heroVideo';
import './theme.css';
import HeaderShowroom from './headers/HeaderShowroom.astro';
import HeaderArrivals from './headers/HeaderArrivals.astro';
import HeaderStorefront from './headers/HeaderStorefront.astro';
import HeaderFilmstrip from './headers/HeaderFilmstrip.astro';
import { getHeaderNav } from './headers/nav';
import type { HeaderVariantId } from './headers/variants';
import type { Locale } from '@/i18n/translations';
import { toLab } from './site/routes';

interface Props {
  /** One of the header candidates (/design-lab/studio/headers/) instead of the chosen one (G). */
  header?: HeaderVariantId;
  /** Language of the header candidate. The rest of the page is English either way. */
  locale?: Locale;
  /** The same page in the other language, for the header's language switch. */
  altHref?: string;
}

// The Studio homepage has no Arabic body yet, so its language switch goes to
// the Arabic header on the same page.
const { header = 'g', locale = 'en', altHref = '/design-lab/studio/headers/g/ar/' } = Astro.props;
// Service links stay inside the Design Lab, on the Studio service pages.
const liveNav = await getHeaderNav(locale);
const nav = { ...liveNav, services: liveNav.services.map((s) => ({ ...s, href: toLab(s.href) })) };
const candidates = {
  a: { Candidate: HeaderShowroom, props: {} },
  d: { Candidate: HeaderArrivals, props: {} },
  e: { Candidate: HeaderStorefront, props: {} },
  f: { Candidate: HeaderFilmstrip, props: {} },
  g: { Candidate: HeaderStorefront, props: { phone: 'showroom' } },
  h: { Candidate: HeaderStorefront, props: { phone: 'filmstrip' } },
} as const;
const { Candidate, props: candidateProps } = candidates[header];
const quoteHref = '/design-lab/studio/quote/';
---

<DesignShell
  concept="studio"
  title="WRP Detailing Dubai: PPF, ceramic coating, detailing and window tint"
  description="Paint protection film (Avery Dennison and STEK), ceramic coating, detailing, polish, window tint and upholstery in Al Qusais, Dubai. 5.0 on Google. Get a quick quote."
  fonts={['--font-oswald', '--font-inter', '--font-montserrat', ...(locale === 'ar' ? (['--font-ibm-plex-arabic'] as const) : [])]}
  themeColor="#0c0d0f"
  colorScheme="dark"
  preloads={[
    { href: heroVideo.poster.tall.avif, type: 'image/avif', media: heroVideo.tallMedia },
    { href: heroVideo.poster.wide.avif, type: 'image/avif', media: `not all and ${heroVideo.tallMedia}` },
  ]}
>
  <Candidate nav={nav} altHref={altHref} quoteHref={quoteHref} {...candidateProps} />
  <main id="main">
    <Hero />
    <About />
    <Services link={toLab} />
    <CtaBanner />
    <WhyUs />
    <Proof />
    <Testimonials />
    <Projects />
    <Lounge />
    <Social />
    <Blog />
    <Contact />
  </main>
  <Footer serviceHref={toLab} />
  <FloatingContact />
</DesignShell>
