---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { blogIds } from './content';

const all = await getCollection('blog');
const posts = blogIds
  .map((id) => all.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

{
  posts.length > 0 && (
    <section class="blog st-section st-white" id="blog" aria-labelledby="blog-title">
      <div class="st-wrap">
        <div class="blog__head">
          <header class="st-head">
            <p class="st-eyebrow st-eyebrow--dark">From the blog</p>
            <h2 id="blog-title" class="st-h2">Guides and advice</h2>
          </header>
          <a class="st-btn st-btn--dark" href="/blog/">All articles</a>
        </div>
        <ul class="posts" role="list">
          {posts.map((p) => {
            const date = p.data.updatedDate ?? p.data.pubDate;
            return (
              <li class="post">
                <p class="post__date">
                  <time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time>
                </p>
                <h3 class="post__title">
                  <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                </h3>
                <p class="post__desc">{p.data.description}</p>
                <span class="post__more" aria-hidden="true">
                  Read the guide <Icon name="arrow-right" size={16} />
                </span>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .blog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block-end: 2rem;
  }
  .blog__head .st-head {
    margin-block-end: 0;
  }
  .posts {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .post {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--st-paper);
    border-block-start: 3px solid var(--st-gold);
  }
  .post__date {
    font-size: 0.8125rem;
    color: var(--st-ink-2);
  }
  .post__title {
    font-family: var(--st-head-font);
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .post__title a {
    color: var(--st-ink);
    text-decoration: none;
  }
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post__title a:focus-visible {
    outline: none;
  }
  .post:has(a:focus-visible) {
    outline: 3px solid var(--st-gold-deep);
    outline-offset: 3px;
  }
  .post__desc {
    color: var(--st-ink-2);
    font-size: 0.9375rem;
  }
  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--st-head-font);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.9375rem;
    color: var(--st-gold-deep);
  }
  .post:hover .post__title a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--st-gold);
  }
</style>
