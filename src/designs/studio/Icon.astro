---
/** Small inline stroke icons (24px grid), decorative unless `label` is set. */
interface Props {
  name:
    | 'phone' | 'mail' | 'pin' | 'clock' | 'instagram' | 'whatsapp' | 'check' | 'star'
    | 'camera' | 'shield' | 'tag' | 'arrow-left' | 'arrow-right' | 'menu' | 'close' | 'map';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: className, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...a11y}
>
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4-2.1 1.3a11 11 0 0 0 7.5 7.5l1.3-2.1 4 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === 'pin' && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.8" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" /></>}
  {
    name === 'whatsapp' && (
      <>
        <path d="M12 3.2a8.6 8.6 0 0 0-7.4 13l-1.2 4.4 4.5-1.2A8.6 8.6 0 1 0 12 3.2Z" />
        <path
          d="M9.1 7.9c.3 0 .5.1.6.4l.7 1.6c.1.2 0 .5-.1.7l-.5.6c.6 1.2 1.6 2.2 2.9 2.9l.6-.5c.2-.2.5-.2.7-.1l1.6.7c.3.1.4.4.4.7-.1 1.1-1 1.9-2.1 1.8-3.3-.4-5.9-3-6.3-6.3-.1-1.1.7-2 1.9-2.1Z"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'star' && <path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8-4.3-4.1 5.9-.8Z" fill="currentColor" stroke="none" />}
  {name === 'camera' && <><path d="M4 8h3l1.6-2.5h6.8L17 8h3v11H4Z" /><circle cx="12" cy="13" r="3.4" /></>}
  {name === 'shield' && <><path d="M12 3 5 6v5.5c0 4.4 3 7.8 7 9.5 4-1.7 7-5.1 7-9.5V6Z" /><path d="m9 12 2.2 2.2L15.5 10" /></>}
  {name === 'tag' && <><path d="M3.5 12.3V4.5a1 1 0 0 1 1-1h7.8l8.2 8.2a1 1 0 0 1 0 1.4l-7.4 7.4a1 1 0 0 1-1.4 0Z" /><circle cx="8" cy="8" r="1.4" /></>}
  {name === 'arrow-left' && <path d="M19 12H5m6-6-6 6 6 6" />}
  {name === 'arrow-right' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'map' && <><path d="m3.5 6 5.5-2 6 2 5.5-2v14l-5.5 2-6-2-5.5 2Z" /><path d="M9 4v14m6-12v14" /></>}
</svg>
