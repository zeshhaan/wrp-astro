---
/**
 * The sign you see as you arrive on a floor. On the first floor and the
 * street it hangs on a beam, like the mezzanine's black steel beam.
 */
interface Props {
  code: string;
  name: string;
  tone: 'wall' | 'beam';
}
const { code, name, tone } = Astro.props;
---

<div class:list={['sign', `sign--${tone}`]}>
  <p class="sign__inner">
    <span class="sign__code" aria-hidden="true">{code}</span>
    <span class="sign__name">{name}</span>
  </p>
  {tone === 'beam' && <span class="sign__led" aria-hidden="true" />}
</div>

<style>
  .sign {
    position: relative;
    padding-inline: var(--mz-gutter);
  }
  .sign__inner {
    max-width: var(--mz-max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .sign__code {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    font-family: var(--mz-display);
    font-weight: 800;
    font-size: 0.9375rem;
    line-height: 1;
  }
  .sign--wall {
    padding-block: 2.5rem 0;
  }
  .sign--wall .sign__code {
    border: 1.5px solid var(--mz-ink);
  }
  .sign--beam {
    background: var(--mz-lamp);
    color: var(--mz-on-dark);
    padding-block: 1.1rem;
  }
  .sign--beam .sign__code {
    border: 2px solid var(--mz-brass);
    color: var(--mz-brass);
  }
  .sign__led {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: #f4ecd8;
    box-shadow: 0 0 6px rgb(244 236 216 / 0.7);
    transform-origin: left;
  }

  /* Decorative: the beam's light strip switches on as the beam scrolls into view.
     Progressive enhancement only (ui-behaviors/scroll-entry-exit-effects). */
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .sign__led {
        animation: led-on linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
    }
  }
  @keyframes led-on {
    from {
      transform: scaleX(0);
      opacity: 0.4;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>
