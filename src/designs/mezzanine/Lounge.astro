---
/**
 * The WRP Lounge, the climax of the page. A drawn floor plan of the first floor
 * sits beside the list of what's up there; pointing at either lights up the other.
 */
import Picture from '../shared/Picture.astro';
import { lounge } from '../data';

const zoneFor: Record<string, string> = {
  Billiards: 'billiards',
  'Board games': 'games',
  'Coffee & karak': 'coffee',
  'Big-screen TV': 'tv',
  'Air-conditioned': 'ac',
  'Materials room': 'materials',
  'Studio view': 'view',
};
const [tvPhoto, , materialsPhoto, fromBelowPhoto] = lounge.photos;
const [bigQuote, ...otherQuotes] = lounge.quotes;
const smallQuotes = [otherQuotes[0], otherQuotes[2], otherQuotes[3]];
---

<section class="lounge" id="lounge" aria-labelledby="lounge-title">
  <div class="wrap">
    <div class="intro">
      <h2 id="lounge-title">{lounge.name}</h2>
      <p class="pitch">{lounge.pitch}</p>
    </div>

    <div class="explore" data-plan>
      <figure class="plan">
        <svg
          viewBox="0 0 720 470"
          role="img"
          aria-labelledby="plan-title plan-desc"
          class="plan__svg"
        >
          <title id="plan-title">Plan of the WRP Lounge</title>
          <desc id="plan-desc">
            The first floor seen from above: a coffee counter and games shelf on the left, the billiards table in the
            middle, a sofa facing a big TV on the right, a materials room in the corner, and a glass wall along the
            front looking down on the bays.
          </desc>
          <defs>
            <pattern id="mz-carpet" width="14" height="10" patternUnits="userSpaceOnUse">
              <path d="M0 7 3.5 3 7 7 10.5 3 14 7" fill="none" stroke="#dfe4e0" stroke-width="1.2"></path>
            </pattern>
          </defs>

          <!-- floor -->
          <rect x="20" y="20" width="680" height="380" fill="#f3f5f3"></rect>
          <rect x="20" y="20" width="680" height="380" fill="url(#mz-carpet)"></rect>

          <!-- the bays below the glass, one floor down -->
          <g class="below">
            <path d="M40 470v-50M180 470v-50M320 470v-50M460 470v-50M600 470v-50" stroke="#c7cec9" stroke-width="3"></path>
          </g>

          <!-- Studio view: the glass wall -->
          <g class="zone" data-zone="view">
            <rect class="zone__hl" x="20" y="392" width="680" height="78" rx="4"></rect>
            <g class="below-cars">
              <rect x="70" y="428" width="80" height="34" rx="12"></rect>
              <rect x="210" y="428" width="80" height="34" rx="12"></rect>
              <rect x="490" y="428" width="80" height="34" rx="12"></rect>
            </g>
            <path class="glass-line" d="M20 396h680M20 404h680" stroke-width="2.5"></path>
            <path class="glass-mullions" d="M20 392v16M190 392v16M360 392v16M530 392v16M700 392v16" stroke-width="4"></path>
          </g>

          <!-- walls -->
          <path d="M20 400V20h680v380" fill="none" stroke="#15171a" stroke-width="8" stroke-linejoin="miter"></path>

          <!-- Materials room, top right -->
          <g class="zone" data-zone="materials">
            <rect class="zone__hl" x="484" y="24" width="212" height="162"></rect>
            <rect x="496" y="32" width="150" height="20" class="f-wall"></rect>
            <path d="M526 32v20M556 32v20M586 32v20M616 32v20" class="s-thin"></path>
            <rect x="500" y="84" width="14" height="66" class="f-glass"></rect>
            <rect x="522" y="84" width="14" height="66" class="f-glass"></rect>
            <rect x="590" y="100" width="40" height="34" rx="6" class="f-wall"></rect>
            <rect x="590" y="94" width="40" height="10" rx="4" class="f-lamp"></rect>
            <rect x="656" y="70" width="30" height="90" class="f-wall"></rect>
            <path d="M662 80h18M662 96h18M662 112h18M662 128h18M662 144h18" class="s-thin"></path>
          </g>
          <path d="M480 20v170h80M606 190h94" fill="none" stroke="#15171a" stroke-width="6"></path>
          <path d="M560 190v44M560 234a44 44 0 0 0 46-44" fill="none" stroke="#15171a" stroke-width="1.5"></path>

          <!-- Coffee & karak counter, top left -->
          <g class="zone" data-zone="coffee">
            <rect class="zone__hl" x="30" y="24" width="236" height="80" rx="4"></rect>
            <rect x="40" y="30" width="210" height="28" class="f-wall"></rect>
            <rect x="50" y="34" width="24" height="18" rx="2" class="f-lamp"></rect>
            <circle cx="96" cy="44" r="5" class="f-glass"></circle>
            <circle cx="112" cy="44" r="5" class="f-glass"></circle>
            <circle cx="70" cy="80" r="10" class="f-wall"></circle>
            <circle cx="115" cy="80" r="10" class="f-wall"></circle>
            <circle cx="160" cy="80" r="10" class="f-wall"></circle>
            <circle cx="205" cy="80" r="10" class="f-wall"></circle>
          </g>

          <!-- Air-conditioning units -->
          <g class="zone" data-zone="ac">
            <rect class="zone__hl" x="286" y="24" width="120" height="84" rx="4"></rect>
            <rect x="306" y="26" width="80" height="14" rx="3" class="f-wall"></rect>
            <path class="air" d="M316 54q8 8 0 16t0 16M346 54q8 8 0 16t0 16M376 54q8 8 0 16t0 16" fill="none" stroke-width="2.5" stroke-linecap="round"></path>
          </g>

          <!-- Board games: shelf on the wall and a small table -->
          <g class="zone" data-zone="games">
            <rect class="zone__hl" x="24" y="120" width="104" height="172" rx="4"></rect>
            <rect x="26" y="128" width="20" height="150" class="f-wall"></rect>
            <rect x="29" y="134" width="14" height="22" class="f-felt"></rect>
            <rect x="29" y="160" width="14" height="16" class="f-brass"></rect>
            <rect x="29" y="180" width="14" height="26" class="f-glass"></rect>
            <rect x="29" y="210" width="14" height="18" class="f-lamp"></rect>
            <rect x="29" y="232" width="14" height="20" class="f-felt"></rect>
            <rect x="29" y="256" width="14" height="16" class="f-brass"></rect>
            <rect x="72" y="182" width="40" height="40" rx="3" class="f-wall"></rect>
            <rect x="81" y="162" width="22" height="12" rx="3" class="f-wall"></rect>
            <rect x="81" y="230" width="22" height="12" rx="3" class="f-wall"></rect>
          </g>

          <!-- Billiards table -->
          <g class="zone" data-zone="billiards">
            <rect class="zone__hl" x="140" y="126" width="236" height="148" rx="6"></rect>
            <rect x="160" y="146" width="196" height="108" rx="8" fill="#3b2a1f"></rect>
            <rect x="172" y="158" width="172" height="84" rx="2" fill="#1f6b4f"></rect>
            <g fill="#15171a">
              <circle cx="172" cy="158" r="6"></circle><circle cx="258" cy="156" r="5"></circle><circle cx="344" cy="158" r="6"></circle>
              <circle cx="172" cy="242" r="6"></circle><circle cx="258" cy="244" r="5"></circle><circle cx="344" cy="242" r="6"></circle>
            </g>
            <g>
              <circle cx="300" cy="200" r="4.5" fill="#c9a45c"></circle>
              <circle cx="308" cy="195" r="4.5" fill="#b33a2e"></circle>
              <circle cx="308" cy="205" r="4.5" fill="#c9a45c"></circle>
              <circle cx="316" cy="190" r="4.5" fill="#15171a"></circle>
              <circle cx="316" cy="200" r="4.5" fill="#b33a2e"></circle>
              <circle cx="316" cy="210" r="4.5" fill="#c9a45c"></circle>
              <circle cx="212" cy="200" r="4.5" fill="#fff"></circle>
            </g>
            <path d="M118 236 205 204" stroke="#c9a45c" stroke-width="3.5" stroke-linecap="round"></path>
          </g>

          <!-- Sofa and big-screen TV -->
          <g class="zone" data-zone="tv">
            <rect class="zone__hl" x="500" y="236" width="184" height="148" rx="6"></rect>
            <rect x="524" y="254" width="136" height="16" rx="2" class="f-wall"></rect>
            <rect x="534" y="248" width="116" height="7" rx="2" class="f-lamp"></rect>
            <rect x="524" y="334" width="136" height="38" rx="8" fill="#8fa0b3" stroke="#15171a" stroke-width="2"></rect>
            <rect x="524" y="362" width="136" height="14" rx="6" fill="#71849a" stroke="#15171a" stroke-width="2"></rect>
            <path d="M569 336v26M615 336v26" stroke="#15171a" stroke-width="1.5"></path>
          </g>

          <!-- Stairs down to the bays -->
          <g class="stairs">
            <rect x="372" y="316" width="104" height="72" fill="#fff" stroke="#15171a" stroke-width="2"></rect>
            <path d="M385 316v72M398 316v72M411 316v72M424 316v72M437 316v72M450 316v72M463 316v72" stroke="#15171a" stroke-width="1.2"></path>
            <path d="M384 352h78m-10-8 10 8-10 8" fill="none" stroke="#15171a" stroke-width="2"></path>
          </g>
        </svg>
        <figcaption>
          The first floor from above. The glass wall runs along the front, over the bays; the stairs lead down to your
          car.
        </figcaption>
      </figure>

      <div class="amenities">
        <p class="hint" id="amenities-hint">What’s up there. Tap or point at one to find it on the plan.</p>
        <ul role="list" aria-describedby="amenities-hint">
          {
            lounge.amenities.map((a) => (
              <li>
                <button type="button" class="amenity" data-zone={zoneFor[a.name]} aria-pressed="false">
                  <span class="amenity__name">{a.name}</span>
                  <span class="amenity__detail">{a.detail}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="gallery">
      <figure class="shot shot--wide">
        <Picture base={tvPhoto.base} alt={tvPhoto.alt} sizes="(min-width: 56rem) 44rem, 100vw" />
        <figcaption>{tvPhoto.caption}</figcaption>
      </figure>
      <blockquote class="big-quote">
        <p>“{bigQuote.text}”</p>
        <footer>{bigQuote.author}, Google review</footer>
      </blockquote>
      <figure class="shot">
        <Picture base={materialsPhoto.base} alt={materialsPhoto.alt} sizes="(min-width: 56rem) 24rem, 50vw" />
        <figcaption>{materialsPhoto.caption}</figcaption>
      </figure>
      <figure class="shot">
        <Picture base={fromBelowPhoto.base} alt={fromBelowPhoto.alt} sizes="(min-width: 56rem) 24rem, 50vw" />
        <figcaption>{fromBelowPhoto.caption}</figcaption>
      </figure>
      <ul role="list" class="small-quotes">
        {
          smallQuotes.map((q) => (
            <li>
              <blockquote>
                <p>“{q.text}”</p>
                <footer>{q.author}</footer>
              </blockquote>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // Plan <-> list: pointing at an amenity lights its zone on the plan, and the reverse.
  const root = document.querySelector<HTMLElement>('[data-plan]');
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-zone]'));
    const zones = Array.from(root.querySelectorAll<SVGGElement>('g[data-zone]'));
    let pinned = '';
    const light = (key: string) => {
      root.dataset.active = key;
      for (const z of zones) z.classList.toggle('is-lit', z.dataset.zone === key);
      for (const b of buttons) b.classList.toggle('is-lit', b.dataset.zone === key);
    };
    const release = () => light(pinned);

    for (const b of buttons) {
      const key = b.dataset.zone ?? '';
      b.addEventListener('pointerenter', () => light(key));
      b.addEventListener('pointerleave', release);
      b.addEventListener('focus', () => light(key));
      b.addEventListener('blur', release);
      b.addEventListener('click', () => {
        pinned = pinned === key ? '' : key;
        for (const other of buttons) other.setAttribute('aria-pressed', String(other.dataset.zone === pinned));
        light(pinned || key);
      });
    }
    for (const z of zones) {
      const key = z.dataset.zone ?? '';
      z.addEventListener('pointerenter', () => light(key));
      z.addEventListener('pointerleave', release);
      z.addEventListener('click', () => {
        pinned = pinned === key ? '' : key;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.zone === pinned));
        light(pinned);
      });
    }
  }
</script>

<style>
  .lounge {
    padding: 3rem var(--mz-gutter) 4.5rem;
  }
  .wrap {
    max-width: var(--mz-max);
    margin-inline: auto;
  }
  .intro {
    display: grid;
    gap: 1rem;
    margin-block-end: 2.5rem;
  }
  h2 {
    font-family: var(--mz-display);
    font-weight: 800;
    font-size: clamp(3rem, 10vw, 7.5rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: var(--mz-ink);
  }
  .pitch {
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.5;
    max-width: 46ch;
    color: var(--mz-ink-2);
  }

  /* ---------- Plan + list ---------- */
  .explore {
    display: grid;
    gap: 1rem;
  }
  .plan {
    position: sticky;
    top: var(--mz-hh);
    z-index: 2;
    margin-inline: calc(var(--mz-gutter) * -1);
    padding: 0.75rem var(--mz-gutter) 0.5rem;
    background: var(--mz-glass-light);
  }
  .plan__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .plan figcaption {
    display: none;
    margin-block-start: 0.75rem;
    font-size: 0.875rem;
    color: var(--mz-ink-2);
    max-width: 60ch;
  }
  .f-wall {
    fill: #fff;
    stroke: #15171a;
    stroke-width: 2;
  }
  .f-glass {
    fill: var(--mz-glass);
    stroke: #15171a;
    stroke-width: 1.5;
  }
  .f-lamp {
    fill: #15171a;
  }
  .f-felt {
    fill: var(--mz-felt);
  }
  .f-brass {
    fill: var(--mz-brass);
  }
  .s-thin {
    stroke: #15171a;
    stroke-width: 1.2;
  }
  .glass-line {
    stroke: #6f8c83;
    transition: stroke 0.3s;
  }
  .glass-mullions {
    stroke: #15171a;
  }
  .below-cars rect {
    fill: #8a9690;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .air {
    stroke: #6f8c83;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .zone {
    transition: opacity 0.3s;
    cursor: pointer;
  }
  .zone__hl {
    fill: rgb(201 164 92 / 0.3);
    stroke: var(--mz-brass);
    stroke-width: 2;
    stroke-dasharray: 6 5;
    opacity: 0;
    transition: opacity 0.3s;
  }
  /* When something is lit, everything else dims like lamps switched off. */
  [data-active]:not([data-active='']) .zone:not(.is-lit),
  [data-active]:not([data-active='']) .stairs {
    opacity: 0.35;
  }
  .zone.is-lit .zone__hl {
    opacity: 1;
  }
  .zone.is-lit .air {
    opacity: 1;
  }
  .zone.is-lit .glass-line {
    stroke: var(--mz-felt);
  }
  .zone.is-lit .below-cars rect {
    opacity: 1;
  }

  .hint {
    font-size: 0.9375rem;
    color: var(--mz-ink-2);
    margin-block-end: 0.5rem;
  }
  .amenities ul {
    display: grid;
  }
  .amenity {
    all: unset;
    box-sizing: border-box;
    display: grid;
    gap: 0.1rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.7rem 0.9rem 0.75rem;
    border-radius: 0.5rem;
    cursor: pointer;
    position: relative;
    transition: background-color 0.2s;
  }
  .amenity::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8rem;
    bottom: 0.8rem;
    width: 4px;
    border-radius: 2px;
    background: var(--mz-felt);
    scale: 1 0;
    transition: scale 0.25s var(--mz-ease);
  }
  .amenity:focus-visible {
    outline: 3px solid var(--mz-felt);
    outline-offset: 0;
  }
  .amenity.is-lit {
    background: rgb(255 255 255 / 0.6);
  }
  .amenity.is-lit::before,
  .amenity[aria-pressed='true']::before {
    scale: 1 1;
  }
  .amenity__name {
    font-family: var(--mz-display);
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .amenity__detail {
    color: var(--mz-ink-2);
    font-size: 0.9375rem;
  }

  /* ---------- Photos and what people said ---------- */
  .gallery {
    display: grid;
    gap: 1.5rem;
    margin-block-start: 3.5rem;
  }
  .shot :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }
  .shot figcaption {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
    color: var(--mz-ink-2);
  }
  .big-quote {
    display: grid;
    align-content: center;
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .big-quote p {
    font-family: var(--mz-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--mz-felt-ink);
    text-wrap: balance;
  }
  .big-quote footer,
  .small-quotes footer {
    font-size: 0.9375rem;
    color: var(--mz-ink-2);
  }
  .small-quotes {
    display: grid;
    gap: 1.5rem;
  }
  .small-quotes blockquote {
    display: grid;
    gap: 0.4rem;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--mz-felt);
  }
  .small-quotes p {
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  @media (min-width: 40rem) and (max-width: 55.99rem) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
    .shot--wide,
    .big-quote,
    .small-quotes {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 56rem) {
    .lounge {
      padding-block: 4.5rem 6rem;
    }
    .intro {
      gap: 1.5rem;
      margin-block-end: 3.5rem;
    }
    .explore {
      grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
      gap: 3rem;
      align-items: center;
    }
    .plan {
      order: 2;
      position: static;
      margin: 0;
      padding: 1.5rem;
      background: #fff;
      box-shadow: 0 0 0 1px rgb(21 23 26 / 0.08);
    }
    .plan figcaption {
      display: block;
    }
    .gallery {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 2rem;
      margin-block-start: 5rem;
      align-items: start;
    }
    .shot--wide {
      grid-column: 1 / 8;
    }
    .big-quote {
      grid-column: 8 / 13;
      align-self: center;
    }
    .shot:nth-of-type(2) {
      grid-column: 1 / 5;
    }
    .shot:nth-of-type(3) {
      grid-column: 5 / 9;
    }
    .small-quotes {
      grid-column: 9 / 13;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .zone,
    .zone__hl,
    .air,
    .amenity,
    .amenity::before {
      transition: none;
    }
  }
</style>
