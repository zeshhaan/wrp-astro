---
/**
 * The hero is a cross-section of the studio, cut along the glass line.
 * Above the line: the result, a finished car under the studio lamps, and a customer's words on the glass.
 * Below the line: the craft, the team at work in the bay, and what we do.
 * The headline is split by the beam: the result above, the promise below.
 */
import Picture from '../shared/Picture.astro';
import { proof } from '../data';
import { heroCraft, heroQuote, heroResult, whatsappHello } from './building';

const lamps = [
  { x: '14%', drop: 6, delay: 0.15 },
  { x: '47%', drop: 34, delay: 0.4 },
  { x: '80%', drop: 14, delay: 0.65 },
];
const heroSizes = '(min-width: 60rem) 52vw, 100vw';
---

<section class="hero" aria-labelledby="hero-title">
  <figure class="slice slice--up">
    <Picture
      base={heroResult.base}
      alt={heroResult.alt}
      sizes={heroSizes}
      width={1200}
      height={1269}
      loading="eager"
      fetchpriority="high"
      style={`--pos:${heroResult.position}`}
    />
    <figcaption class="tag">Finished: Lexus LX, full detail</figcaption>
  </figure>

  <div class="ceiling" aria-hidden="true">
    {
      lamps.map((l) => (
        <span class="lamp" style={`--x:${l.x};--drop:${l.drop};--delay:${l.delay}s`}>
          <svg viewBox="0 0 60 56" width="60" height="56">
            <path d="M24 0h12v15l16 30c1.6 3.2-.4 5-3.6 5H11.6C8.4 50 6.4 48.2 8 45l16-30Z" fill="#15171a" />
            <ellipse cx="30" cy="49.5" rx="19" ry="3.2" fill="#f4ecd8" class="lamp__lens" />
          </svg>
          <span class="lamp__glow" />
        </span>
      ))
    }
  </div>

  <div class="glass" aria-hidden="true"></div>

  <div class="up-copy">
    <blockquote class="said">
      <p>“{heroQuote.text}”</p>
      <footer>{heroQuote.author}, Google review, {heroQuote.when}</footer>
    </blockquote>
  </div>

  <h1 class="h1" id="hero-title">
    <span class="h1__up">Looks brand new.</span>
    <span class="h1__down">Stays that way.</span>
  </h1>

  <div class="beam" aria-hidden="true"><span class="beam__led"></span></div>

  <div class="down-copy">
    <p class="down-line">
      Paint protection film, detailing, polish, ceramic coating, upholstery and window tint, done by hand in Al
      Qusais, Dubai. Films by Avery Dennison and STEK.
    </p>
    <div class="actions">
      <a class="btn" href="#quote">Price it for your car</a>
      <a class="text-link" href={whatsappHello} target="_blank" rel="noopener">Or message us on WhatsApp</a>
    </div>
    <p class="rating">
      <a href={proof.reviewsUrl}>Rated {proof.rating} on Google from {proof.reviewCountDisplay} reviews</a>
    </p>
  </div>

  <figure class="slice slice--down">
    <Picture
      base={heroCraft.base}
      alt={heroCraft.alt}
      sizes={heroSizes}
      width={1200}
      height={1680}
      loading="eager"
      style={`--pos:${heroCraft.position}`}
    />
    <figcaption class="tag">In the bay: the team on a Lexus</figcaption>
  </figure>
</section>

<style>
  .hero {
    container: hero / inline-size;
    --h1: clamp(2rem, calc((100cqi - 2rem) * 0.118), 4.5rem);
    --line: calc(var(--h1) * 1.02);
    --beam: 2.25rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows:
      min(58vw, 22rem)
      auto
      var(--line)
      var(--beam)
      var(--line)
      auto
      min(64vw, 24rem);
    grid-template-areas: 'up' 'gcopy' 'gline' 'beam' 'bline' 'bcopy' 'down';
    background: var(--mz-wall);
    overflow: clip;
  }

  /* ---------- Photo slices ---------- */
  .slice {
    position: relative;
    overflow: hidden;
    margin: 0;
    background: var(--mz-smoke);
  }
  .slice--up {
    grid-area: up;
  }
  .slice--down {
    grid-area: down;
    background: var(--mz-wall-2);
  }
  .slice :global(picture) {
    display: contents;
  }
  .slice :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
  }
  /* Mobile: the photo melts into the smoked-glass panel below it. */
  .slice--up::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--mz-smoke));
  }
  .tag {
    position: absolute;
    z-index: 1;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
    background: rgb(21 23 26 / 0.78);
    color: var(--mz-on-dark);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .slice--down .tag {
    top: auto;
    bottom: 0.75rem;
  }

  /* ---------- Above the line: smoked glass, and what a customer said ---------- */
  .ceiling {
    display: none;
  }
  .glass {
    grid-row: gcopy-start / gline-end;
    grid-column: 1;
    background:
      linear-gradient(100deg, transparent 38%, rgb(255 255 255 / 0.05) 46%, transparent 54%),
      linear-gradient(100deg, transparent 58%, rgb(255 255 255 / 0.035) 62%, transparent 66%),
      var(--mz-smoke);
  }
  .up-copy {
    grid-area: gcopy;
    padding: 0.25rem 1rem 1.25rem;
    color: var(--mz-on-dark);
    max-width: 38rem;
    position: relative;
  }
  .said {
    display: grid;
    gap: 0.4rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--mz-brass);
  }
  .said p {
    color: #dfe6e3;
    font-size: 1.0625rem;
    line-height: 1.45;
    max-width: 40ch;
  }
  .said footer {
    color: var(--mz-on-dark-2);
    font-size: 0.875rem;
  }

  /* ---------- The headline, split by the beam ---------- */
  .h1 {
    grid-row: gline-start / bline-end;
    grid-column: 1;
    display: grid;
    grid-template-rows: var(--line) var(--beam) var(--line);
    margin: 0;
    padding-inline: 1rem;
    font-family: var(--mz-display);
    font-weight: 800;
    font-size: var(--h1);
    line-height: 1;
    letter-spacing: -0.035em;
    position: relative;
    z-index: 1;
    text-wrap: nowrap;
  }
  .h1__up,
  .h1__down {
    display: block;
    text-box: trim-both cap alphabetic;
  }
  .h1__up {
    grid-row: 1;
    align-self: end;
    padding-bottom: 0.2em;
    color: var(--mz-glass);
  }
  .h1__down {
    grid-row: 3;
    align-self: start;
    padding-top: 0.22em;
    color: var(--mz-ink);
  }

  /* ---------- The beam: the glass line ---------- */
  .beam {
    grid-area: beam;
    grid-column: 1 / -1;
    position: relative;
    background: var(--mz-lamp);
  }
  .beam__led {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: #f4ecd8;
    box-shadow:
      0 0 6px rgb(244 236 216 / 0.8),
      0 2px 14px rgb(201 164 92 / 0.5);
    transform-origin: left;
  }

  /* ---------- Below the line: the craft ---------- */
  .down-copy {
    grid-area: bcopy;
    padding: 1.25rem 1rem 1.75rem;
    max-width: 38rem;
  }
  .down-line {
    font-size: 1.0625rem;
    color: var(--mz-ink-2);
    max-width: 44ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-block: 1.25rem 0.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    background: var(--mz-felt);
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .btn:hover {
    background: var(--mz-felt-ink);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
  }
  .text-link:hover {
    text-decoration-thickness: 2.5px;
  }
  .rating {
    font-size: 0.9375rem;
    color: var(--mz-ink-2);
  }
  .rating a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-underline-offset: 0.25em;
  }

  /* ---------- Desktop: side by side, one continuous building ---------- */
  @media (min-width: 60rem) {
    .hero {
      --H: clamp(36rem, calc(100svh - var(--mz-hh)), 54rem);
      --pw: 50cqi;
      --beam: calc(var(--H) * 0.065);
      /* Line the hero copy up with the page container below it. */
      --pad: max(var(--mz-gutter), calc((100cqi - var(--mz-max)) / 2));
      --h1: min(calc((100cqi - var(--pw) - var(--pad) - 2.5rem) * 0.12), calc(var(--H) * 0.12));

      grid-template-columns: minmax(0, 1fr) var(--pw);
      grid-template-rows:
        calc(var(--H) * 0.14)
        calc(var(--H) * 0.33 - var(--line))
        var(--line)
        var(--beam)
        var(--line)
        calc(var(--H) * 0.465 - var(--line));
      grid-template-areas:
        'ceiling up'
        'gcopy up'
        'gline up'
        'beam beam'
        'bline down'
        'bcopy down';
    }
    .slice--up::after {
      display: none;
    }
    /* A steel mullion where the page meets the photo. */
    .slice--up::before {
      content: '';
      position: absolute;
      z-index: 1;
      left: 0;
      top: calc(var(--H) * 0.14);
      bottom: 0;
      width: 5px;
      background: var(--mz-lamp);
    }
    .tag {
      left: 1.25rem;
      top: 1.25rem;
    }
    .slice--down .tag {
      bottom: 1.25rem;
    }
    .up-copy,
    .down-copy,
    .h1 {
      padding-inline: var(--pad) 2rem;
    }
    .up-copy {
      align-self: end;
      padding-block: 0 1.25rem;
    }
    .said p {
      font-size: 1.125rem;
    }
    .down-copy {
      padding-block: calc(var(--H) * 0.03) 0;
    }
    .down-line {
      font-size: 1.125rem;
    }

    /* The ceiling, with the studio's pendant lamps hanging in front of the glass. */
    .ceiling {
      display: block;
      grid-area: ceiling;
      position: relative;
      z-index: 2;
      background: linear-gradient(to bottom, var(--mz-wall) 30%, #cfd4d0);
    }
    .lamp {
      --u: calc(var(--H) / 780);
      position: absolute;
      left: var(--x);
      top: 0;
      width: calc(var(--u) * 64);
      padding-top: calc(var(--drop) * var(--u));
    }
    .lamp::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      width: 1.5px;
      height: calc(var(--drop) * var(--u) + 2px);
      background: var(--mz-lamp);
    }
    .lamp svg {
      width: 100%;
      height: auto;
      position: relative;
      z-index: 1;
    }
    .lamp__glow {
      position: absolute;
      left: 50%;
      top: 100%;
      width: 260%;
      aspect-ratio: 1.6;
      translate: -50% -38%;
      background: radial-gradient(
        closest-side,
        rgb(255 240 210 / 0.55),
        rgb(201 164 92 / 0.22) 45%,
        transparent
      );
      pointer-events: none;
    }
  }

  /* ---------- The one orchestrated moment: the studio lights come on ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .lamp__glow {
      animation: lamp-on 0.9s var(--delay) both;
    }
    .lamp__lens {
      animation: lens-on 0.9s var(--delay) both;
    }
    .beam__led {
      animation: led-run 1.1s 0.8s var(--mz-ease) both;
    }
  }
  @keyframes lamp-on {
    0% { opacity: 0; }
    20% { opacity: 0.7; }
    28% { opacity: 0.15; }
    45%, 100% { opacity: 1; }
  }
  @keyframes lens-on {
    0% { fill: #3a3d40; }
    20% { fill: #f4ecd8; }
    28% { fill: #55585a; }
    45%, 100% { fill: #f4ecd8; }
  }
  @keyframes led-run {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
</style>
