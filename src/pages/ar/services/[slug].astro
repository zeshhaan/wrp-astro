---
/**
 * The Arabic service pages, /ar/services/<slug>/, in the Studio design: from their translated entries.
 */
import { getBaseSlug, getLocalizedServices } from '@/i18n/content';
import type { GetStaticPaths } from 'astro';
import ServicePage from '@/designs/studio/site/ServicePage.astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const services = await getLocalizedServices('ar');
  return services.map((service) => ({
    params: { slug: getBaseSlug(service.id) },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
---

<ServicePage service={service} locale="ar" />
