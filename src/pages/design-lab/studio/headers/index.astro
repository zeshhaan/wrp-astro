---
export const prerender = true;

import DesignShell from '@/designs/shared/DesignShell.astro';
import WrpLogo from '@/components/WrpLogo.astro';
import { headerVariants } from '@/designs/studio/headers/variants';
---

<DesignShell
  concept="lab"
  title="WRP Design Lab: headers"
  description="Candidate headers for the Studio redesign, each on the full homepage, in English and Arabic."
  fonts={['--font-oswald', '--font-inter', '--font-montserrat']}
  themeColor="#0c0d0f"
  colorScheme="dark"
>
  <main class="lab">
    <header class="lab__head">
      <WrpLogo class="lab__mark" label="WRP by YACO Automotive" />
      <p class="lab__eyebrow">Design Lab · Studio</p>
      <h1>Pick a header</h1>
      <p class="lab__lede">
        Round 2. A stays from the first round; D, E and F are new, built on your notes: the logo centred, square
        corners, a secondary bar on top, and every service visible without a hover or a click. G and H are E on wide
        screens with two phone layouts to compare: A's, and F's frames as an endless carousel. Each one is on the full
        Studio homepage. Try them on a phone and a laptop, scroll down and back up, and switch to Arabic. The bar at
        the bottom switches between them.
      </p>
      <p class="lab__lede">
        <strong>Picked: G.</strong> It is now the header on the <a href="/design-lab/studio/">Studio homepage</a>. The
        others stay here for now.
      </p>
      <p class="lab__lede">
        Every one carries the same links as the live site’s navigation today (the six service pages, Portfolio,
        Reviews, About, Blog and Contact), as plain links in the page’s HTML, so search engines see no change to the
        site’s internal links whichever one is chosen.
      </p>
    </header>

    <ol class="lab__list" role="list">
      {
        headerVariants.map((v) => (
          <li class="card">
            <span class="card__letter" aria-hidden="true">{v.id.toUpperCase()}</span>
            <span class="card__name">
              {v.id.toUpperCase()}. {v.name}
            </span>
            <span class="card__line">{v.idea}</span>
            <span class="card__links">
              <a href={`/design-lab/studio/headers/${v.id}/`}>English</a>
              <a href={`/design-lab/studio/headers/${v.id}/ar/`} lang="ar">العربية</a>
            </span>
          </li>
        ))
      }
    </ol>

    <footer class="lab__foot">
      <p>Preview build only. Nothing here is indexed, and the live site is unchanged.</p>
      <p><a href="/design-lab/">All Design Lab pages</a></p>
    </footer>
  </main>
</DesignShell>

<style>
  :root {
    --ink: #0c0d0f;
    --coal: #17191c;
    --line: #2c3035;
    --text: #d4d7db;
    --mute: #a3a8ae;
    --gold: #c9a45c;
    color-scheme: dark;
  }
  body {
    background: var(--ink);
    color: var(--text);
    font-family: var(--font-inter), 'Inter', system-ui, sans-serif;
  }
  .lab {
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }
  .lab__mark {
    display: block;
    block-size: 2.5rem;
    inline-size: auto;
    color: #fff;
    margin-block-end: 2.5rem;
  }
  .lab__eyebrow {
    color: var(--gold);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    margin-block: 0.5rem 1rem;
    color: #fff;
    font-family: var(--font-oswald), 'Oswald', sans-serif;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    font-weight: 500;
    text-transform: uppercase;
  }
  .lab__lede a {
    color: var(--gold);
  }
  .lab__lede {
    max-inline-size: 42rem;
    margin-block-end: 0.75rem;
    line-height: 1.6;
  }
  .lab__list {
    display: grid;
    gap: 1rem;
    margin-block: 2.5rem;
  }
  @media (min-width: 56rem) {
    .lab__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: var(--coal);
    overflow: hidden;
  }
  .card__letter {
    position: absolute;
    inset-block-start: -1.5rem;
    inset-inline-end: 0.5rem;
    color: transparent;
    -webkit-text-stroke: 1px rgb(201 164 92 / 0.35);
    font-family: var(--font-oswald), 'Oswald', sans-serif;
    font-size: 8rem;
    font-weight: 700;
    line-height: 1;
  }
  .card__name {
    color: #fff;
    font-family: var(--font-oswald), 'Oswald', sans-serif;
    font-size: 1.5rem;
    text-transform: uppercase;
  }
  .card__line {
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .card__links {
    display: flex;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }
  .card__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--gold);
    color: var(--gold);
    text-decoration: none;
    font-weight: 600;
  }
  .card__links a:first-child {
    background: var(--gold);
    color: var(--ink);
  }
  .lab__foot {
    color: var(--mute);
    font-size: 0.875rem;
  }
  .lab__foot a {
    color: #fff;
  }
</style>
