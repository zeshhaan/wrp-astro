---
/**
 * The service pages with a lead form in the hero, one route per candidate
 * layout: /design-lab/studio/services/<slug>/form-a/ … form-d/.
 * See src/designs/studio/site/sections/LeadForm.astro for the four layouts.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ServicePage from '@/designs/studio/site/ServicePage.astro';
import type { LeadVariant } from '@/designs/studio/site/sections/LeadForm.astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const variants: LeadVariant[] = ['a', 'b', 'c', 'd'];
  const services = await getCollection('services');
  return services
    .filter((s) => !s.id.startsWith('ar/'))
    .flatMap((service) => variants.map((v) => ({ params: { slug: service.id, form: `form-${v}` }, props: { service, variant: v } })));
}) satisfies GetStaticPaths;

const { service, variant } = Astro.props;
---

<ServicePage service={service} heroForm={variant} />
