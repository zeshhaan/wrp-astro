---
/**
 * Studio previews of the three pillar pages, at /design-lab/studio/wrap/,
 * /reinforce/ and /protect/. Same copy as the live pages (content/pillars.ts).
 */
import type { GetStaticPaths } from 'astro';
import PillarPage from '@/designs/studio/site/PillarPage.astro';
import { pillars } from '@/designs/studio/site/content/pillars';

export const prerender = true;

export const getStaticPaths = (() =>
  (['wrap', 'reinforce', 'protect'] as const).map((pillar) => ({ params: { pillar }, props: { pillar } }))) satisfies GetStaticPaths;

const { pillar } = Astro.props;
---

<PillarPage slug={pillar} copy={pillars[`en/${pillar}`]} />
