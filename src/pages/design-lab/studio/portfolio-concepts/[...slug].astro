---
export const prerender = true;

import PortfolioConcept from '@/designs/studio/site/portfolio/PortfolioConcept.astro';
import { portfolioConcepts, type PortfolioConceptId } from '@/designs/studio/site/portfolio/concepts';

export function getStaticPaths() {
  return portfolioConcepts.flatMap((c) => [
    { params: { slug: c.id }, props: { id: c.id, locale: 'en' as const } },
    { params: { slug: `${c.id}/ar` }, props: { id: c.id, locale: 'ar' as const } },
  ]);
}

const { id, locale } = Astro.props as { id: PortfolioConceptId; locale: 'en' | 'ar' };
---

<PortfolioConcept concept={id} locale={locale} />
