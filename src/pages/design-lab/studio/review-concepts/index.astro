---
export const prerender = true;

import DesignShell from '@/designs/shared/DesignShell.astro';
import WrpLogo from '@/components/WrpLogo.astro';
import { reviewConcepts } from '@/designs/studio/site/reviews/concepts';
---

<DesignShell
  concept="lab"
  title="WRP Design Lab: reviews page"
  description="Concept directions for the Studio reviews page, each as the full page."
  fonts={['--font-oswald', '--font-inter', '--font-montserrat']}
  themeColor="#0c0d0f"
  colorScheme="dark"
>
  <main class="lab">
    <header class="lab__head">
      <WrpLogo class="lab__mark" label="WRP by YACO Automotive" />
      <p class="lab__eyebrow">Design Lab · Studio</p>
      <h1>Pick a reviews page</h1>
      <p class="lab__lede">
        Three playful directions for the reviews page. Each one is the whole page, with the same words, title,
        description and review data for search engines as the live page today; only the design and the things you can
        play with change. The bar at the bottom of each page switches between them. Try them on a phone and a laptop,
        and try them with the keyboard too.
      </p>
      <p class="lab__lede">
        All three work without a mouse: every control is a real button or radio button, moving content can be paused,
        and with “reduce motion” switched on in your phone or computer settings nothing moves on its own. Arabic comes
        once you pick one.
      </p>
      <p class="lab__lede">
        The page today: <a href="/design-lab/studio/reviews/">Studio reviews page</a>.
      </p>
    </header>

    <ol class="lab__list" role="list">
      {
        reviewConcepts.map((c) => (
          <li class="card">
            <span class="card__letter" aria-hidden="true">{c.id.toUpperCase()}</span>
            <span class="card__name">
              {c.id.toUpperCase()}. {c.name}
            </span>
            <span class="card__line">{c.idea}</span>
            <span class="card__links">
              <a href={`/design-lab/studio/review-concepts/${c.id}/`}>Open {c.name}</a>
            </span>
          </li>
        ))
      }
    </ol>

    <footer class="lab__foot">
      <p>Preview build only. Nothing here is indexed, and the live site is unchanged.</p>
      <p><a href="/design-lab/">All Design Lab pages</a></p>
    </footer>
  </main>
</DesignShell>
<style>
  :root {
    --ink: #0c0d0f;
    --coal: #17191c;
    --line: #2c3035;
    --text: #d4d7db;
    --mute: #a3a8ae;
    --accent: #ffffff;
    color-scheme: dark;
  }
  body {
    background: var(--ink);
    color: var(--text);
    font-family: var(--font-inter), 'Inter', system-ui, sans-serif;
  }
  .lab {
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }
  .lab__mark {
    display: block;
    block-size: 2.5rem;
    inline-size: auto;
    color: #fff;
    margin-block-end: 2.5rem;
  }
  .lab__eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    margin-block: 0.5rem 1rem;
    color: #fff;
    font-family: var(--font-oswald), 'Oswald', sans-serif;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    font-weight: 500;
    text-transform: uppercase;
  }
  .lab__lede a {
    color: var(--accent);
  }
  .lab__lede {
    max-inline-size: 42rem;
    margin-block-end: 0.75rem;
    line-height: 1.6;
  }
  .lab__list {
    display: grid;
    gap: 1rem;
    margin-block: 2.5rem;
  }
  @media (min-width: 56rem) {
    .lab__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: var(--coal);
    overflow: hidden;
  }
  .card__letter {
    position: absolute;
    inset-block-start: -1.5rem;
    inset-inline-end: 0.5rem;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.35);
    font-family: var(--font-oswald), 'Oswald', sans-serif;
    font-size: 8rem;
    font-weight: 700;
    line-height: 1;
  }
  .card__name {
    color: #fff;
    font-family: var(--font-oswald), 'Oswald', sans-serif;
    font-size: 1.5rem;
    text-transform: uppercase;
  }
  .card__line {
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .card__links {
    display: flex;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }
  .card__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .card__links a:first-child {
    background: var(--accent);
    color: var(--ink);
  }
  .lab__foot {
    color: var(--mute);
    font-size: 0.875rem;
  }
  .lab__foot a {
    color: #fff;
  }
</style>
