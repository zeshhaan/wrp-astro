---
/**
 * Studio previews of the site's pages, English and Arabic, each at its live
 * path under /design-lab/studio (/design-lab/studio/wrap/,
 * /design-lab/studio/ar/more-about-wrp/, …). Every page renders its Studio
 * template with the live page's own copy (site/content/*.ts). Service pages
 * have their own route (services/[slug].astro).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { Locale } from '@/i18n/translations';
import PillarPage from '@/designs/studio/site/PillarPage.astro';
import AboutPage from '@/designs/studio/site/AboutPage.astro';
import ContactPage from '@/designs/studio/site/ContactPage.astro';
import ReviewsPage from '@/designs/studio/site/ReviewsPage.astro';
import PortfolioPage from '@/designs/studio/site/PortfolioPage.astro';
import BlogIndexPage from '@/designs/studio/site/BlogIndexPage.astro';
import BlogPostPage from '@/designs/studio/site/BlogPostPage.astro';
import LegalPage, { type LegalSlug } from '@/designs/studio/site/LegalPage.astro';
import { pillars } from '@/designs/studio/site/content/pillars';
import { about } from '@/designs/studio/site/content/about';
import { contact } from '@/designs/studio/site/content/contact';
import { portfolio } from '@/designs/studio/site/content/portfolio';
import { blog } from '@/designs/studio/site/content/blog';

export const prerender = true;

export const getStaticPaths = (async () => {
  // getStaticPaths runs on its own: everything it uses is defined inside it.
  const at = (locale: Locale, path: string) => (locale === 'en' ? path : `ar/${path}`);
  // Blog posts as the live routes list them: English at /blog/<id>/; Arabic at
  // /ar/blog/<id>/, falling back to the English post where there is no
  // translation (src/pages/ar/blog/[...slug].astro).
  const posts = await getCollection('blog');
  const arPosts = posts.filter((p) => p.id.startsWith('ar/'));
  const enPosts = posts.filter((p) => !p.id.startsWith('ar/'));
  const arSlugs = new Set(arPosts.map((p) => p.id.replace('ar/', '')));
  const blogPaths = [
    ...enPosts.map((post) => ({ locale: 'en' as const, slug: post.id, post })),
    ...arPosts.map((post) => ({ locale: 'ar' as const, slug: post.id.replace('ar/', ''), post })),
    ...enPosts.filter((p) => !arSlugs.has(p.id)).map((post) => ({ locale: 'ar' as const, slug: post.id, post })),
  ].map(({ locale, slug, post }) => ({
    params: { page: at(locale, `blog/${slug}`) },
    props: { kind: 'post' as const, locale, slug, post },
  }));
  const pages = (['en', 'ar'] as const).flatMap((locale) => [
    ...(['wrap', 'reinforce', 'protect'] as const).map((slug) => ({
      params: { page: at(locale, slug) },
      props: { kind: 'pillar' as const, locale, slug },
    })),
    { params: { page: at(locale, 'more-about-wrp') }, props: { kind: 'about' as const, locale, slug: '' } },
    { params: { page: at(locale, 'contact-us') }, props: { kind: 'contact' as const, locale, slug: '' } },
    { params: { page: at(locale, 'reviews') }, props: { kind: 'reviews' as const, locale, slug: '' } },
    { params: { page: at(locale, 'portfolio') }, props: { kind: 'portfolio' as const, locale, slug: '' } },
    { params: { page: at(locale, 'blog') }, props: { kind: 'blog' as const, locale, slug: '' } },
    // Credits is English only, as live.
    ...(locale === 'en' ? (['privacy', 'terms', 'credits'] as const) : (['privacy', 'terms'] as const)).map((slug) => ({
      params: { page: at(locale, slug) },
      props: { kind: 'legal' as const, locale, slug: slug as string },
    })),
  ]);
  return [...pages, ...blogPaths];
}) satisfies GetStaticPaths;

const { kind, locale, slug } = Astro.props;
const post = 'post' in Astro.props ? (Astro.props.post as CollectionEntry<'blog'>) : undefined;
const Content = post ? (await render(post)).Content : undefined;

// Services a post links to, merged with its frontmatter list: the same rule as
// the live blog routes.
async function relatedServicesOf(entry: CollectionEntry<'blog'>, arabic: boolean) {
  type Id = CollectionEntry<'blog'>['data']['relatedServices'][number];
  const valid = new Set<Id>(['ceramic-coating', 'paint-protection-film', 'polish', 'window-film', 'premium-car-wash', 'leather-upholstery', 'car-mats', 'graphene-coating']);
  const body = entry.body || '';
  const mentioned = (await getCollection('services'))
    .filter((s) => {
      const id = arabic ? s.id.replace(/^ar\//, '') : s.id;
      const esc = id.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
      const patterns = [new RegExp(`/services/${esc}/?`, 'i')];
      if (!arabic) patterns.push(new RegExp(`https?://[^\\s"']+/services/${esc}/?`, 'i'));
      return patterns.some((rx) => rx.test(body));
    })
    .map((s) => s.id.replace(/^ar\//, ''));
  return Array.from(new Set([...(entry.data.relatedServices ?? []), ...mentioned])).filter((id): id is Id => valid.has(id as Id));
}
const related = post ? await relatedServicesOf(post, locale === 'ar') : [];
---

{kind === 'pillar' && <PillarPage slug={slug as 'wrap'} copy={pillars[`${locale}/${slug}`]} locale={locale} />}
{kind === 'about' && <AboutPage copy={about[locale]} locale={locale} />}
{kind === 'contact' && <ContactPage copy={contact[locale]} locale={locale} />}
{kind === 'reviews' && <ReviewsPage locale={locale} />}
{kind === 'portfolio' && <PortfolioPage copy={portfolio[locale]} locale={locale} />}
{kind === 'blog' && <BlogIndexPage copy={blog[locale]} locale={locale} />}
{kind === 'legal' && <LegalPage slug={slug as LegalSlug} locale={locale} />}
{
  kind === 'post' && post && Content && (
    <BlogPostPage {...post.data} relatedServices={related} locale={locale} slug={slug}>
      <Content />
    </BlogPostPage>
  )
}
