---
export const prerender = true;

import DesignShell from '@/designs/shared/DesignShell.astro';
import WrpLogo from '@/components/WrpLogo.astro';

const pages = [
  {
    href: '/',
    name: 'Homepage',
    line: 'Video hero, services and prices, why WRP, reviews, work, the lounge, blog and the contact form.',
  },
  {
    href: '/design-lab/studio/headers/',
    name: 'Headers to choose from',
    line: 'Showroom, Arrivals board, Storefront and Filmstrip, each on the full homepage in English and Arabic.',
  },
  {
    href: '/quote/',
    name: 'Quote',
    line: 'Everything in one panel beside a live 3D car, with the price building up as you choose.',
  },
  {
    href: '/design-lab/studio/car-viewer/',
    name: '3D car viewer (test page)',
    line: 'Every car, mode and colour of the quote viewer, for checking the 3D models.',
  },
];
---

<DesignShell
  concept="lab"
  title="WRP Design Lab: Studio"
  description="The Studio redesign of wrpdetailing.ae, page by page, for review before it goes live."
  fonts={['--font-oswald', '--font-inter', '--font-montserrat']}
  themeColor="#0c0d0f"
  colorScheme="dark"
>
  <main class="lab">
    <header class="lab__head">
      <WrpLogo class="lab__mark" label="WRP by YACO Automotive" />
      <p class="lab__eyebrow">Design Lab</p>
      <h1>The Studio redesign</h1>
      <p class="lab__lede">
        Studio is the chosen direction for the new wrpdetailing.ae. These are its pages, for review on a phone and a
        laptop before it goes live.
      </p>
    </header>

    <ul class="lab__list" role="list">
      {
        pages.map((p) => (
          <li>
            <a class="card" href={p.href}>
              <span class="card__name">{p.name}</span>
              <span class="card__line">{p.line}</span>
              <span class="card__path">{p.href}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer class="lab__foot">
      <p>
        Studio is the site's design now; the homepage and quote links above are the live pages. The header
        candidates and the car viewer are review pages: not indexed, and their forms are not connected.
      </p>
      <p><a href="/">Homepage</a></p>
    </footer>
  </main>
</DesignShell>

<style>
  :root {
    --ink: #0c0d0f;
    --coal: #17191c;
    --line: #2c3035;
    --text: #d4d7db;
    --mute: #a3a8ae;
    --gold: #c9a45c;
    color-scheme: dark;
  }
  body {
    background: var(--ink);
    color: var(--text);
    font-family: var(--font-inter), 'Inter', system-ui, sans-serif;
  }
  .lab {
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }
  .lab__mark {
    display: block;
    block-size: 2.5rem;
    inline-size: auto;
    color: #fff;
    margin-block-end: 2.5rem;
  }
  .lab__eyebrow {
    color: var(--gold);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-oswald), 'Oswald', 'Arial Narrow', sans-serif;
    font-weight: 600;
    font-size: clamp(2.2rem, 1.4rem + 3.5vw, 3.75rem);
    line-height: 1.02;
    text-transform: uppercase;
    color: #fff;
    margin-block-start: 0.5rem;
  }
  .lab__lede {
    margin-block-start: 1rem;
    max-width: 52ch;
    color: var(--mute);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .lab__list {
    margin-block-start: clamp(2rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 0.75rem;
  }
  .card {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.4rem 1.5rem;
    background: var(--coal);
    border: 1px solid var(--line);
    border-block-start: 3px solid var(--gold);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: var(--gold);
  }
  .card:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
  .card__name {
    font-family: var(--font-oswald), 'Oswald', 'Arial Narrow', sans-serif;
    font-weight: 500;
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
  }
  .card__line {
    line-height: 1.5;
  }
  .card__path {
    margin-block-start: 0.25rem;
    font-size: 0.8125rem;
    color: var(--gold);
  }
  .lab__foot {
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
    color: var(--mute);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    font-size: 0.9375rem;
  }
  .lab__foot a {
    color: #fff;
  }
</style>
