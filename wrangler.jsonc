/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wrp-astro",
	"account_id": "fa7eb70f2bedd4013dba6420fd975f92",
	"main": "./src/worker.ts",
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"compatibility_date": "2026-02-25",
	"compatibility_flags": [
		"nodejs_compat_v2",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wrp-contact-forms",
			"database_id": "45b2fc45-c9ed-45f4-ad9f-2a29b35b263d"
		}
	],
	/**
	 * Lead CRM (zeshhaan/leads-crm): each website lead is handed over to it
	 * (src/lib/crm-handoff.ts). Production talks to WRP's private CRM,
	 * `wrp-crm`, behind Cloudflare Access; previews talk to the public demo.
	 */
	"services": [
		{ "binding": "CRM", "service": "wrp-crm", "entrypoint": "LeadIntake" }
	],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "wrpdetailing.ae",
			"custom_domain": true
		},
		{
			"pattern": "www.wrpdetailing.ae",
			"custom_domain": true
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			// Both are verified destination addresses on this account. A send to
			// anything not listed here is rejected by the runtime.
			"allowed_destination_addresses": [
				"wrp.detailing@gmail.com",
				"work.zeeshan@gmail.com"
			]
		}
	],
	/**
	 * Worker Previews (`npx wrangler preview`, or Workers Builds on any
	 * non-main branch). Previews do NOT inherit the settings above.
	 * Docs: https://developers.cloudflare.com/workers/previews/
	 *
	 * The production D1 database (DB) and the EMAIL binding are deliberately
	 * left out, so a Preview can never write a real lead or email a customer:
	 * the contact form (/api/contact) and the quote form's Astro Action
	 * (src/actions) run their checks, then only send a marked test lead to the
	 * demo CRM (CRM below) and save or email nothing.
	 *
	 * The Astro adapter adds SESSION (KV) and IMAGES bindings to this block at
	 * build time. Previews don't auto-provision KV, so SESSION points at a
	 * preview-only namespace, kept apart from production's.
	 */
	"previews": {
		"vars": {
			"ENVIRONMENT": "preview"
		},
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "1699339660f84d6b90ba9268a8018e76"
			}
		],
		// The demo CRM (demo data, public), never WRP's real one: a preview's test
		// leads show up at https://leads-crm.zeeshanmh215.workers.dev, marked
		// "Sent from: Website preview".
		"services": [
			{ "binding": "CRM", "service": "leads-crm", "entrypoint": "LeadIntake" }
		]
	}
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" }
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
